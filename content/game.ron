            extra_effects: [Dispel(count: 1)],
            yells: [
                "Reverting to the last version that worked. It's from 2019.",
                "Ctrl+Z, but for my whole week.",
                "Rolling back. The forward fix was another prompt.",
                "Restoring from backup. Yes, I made backups. Someone had to.",
