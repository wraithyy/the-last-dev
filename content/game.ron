            (name: "Emergency Coffee, Unbranded", icon: "coffee_pot", price: 20, mana_pct: 40,
             description: "Restores 40% of your mana. Brenda says it is a framework coffee: all three quotes were coffee."),
            // Brenda's Wing 5 and 6 pages (docs/ILMARI_1_0.md D.2.1): a rubber band, and a shelf each for the Lab and the crane.
            (name: "Rubber Band (The Missing One)", icon: "rubber_band", price: 5, mana_pct: 5,
             description: "Restores 5% of your mana, which is a stretch. It is the rubber band the Roomba parts were missing."),
            (name: "Ethics Hotline Hold Music (Cassette)", icon: "microphone", price: 30, mana_pct: 25,
             description: "Restores 25% of your mana. Forty minutes of hold music, then a voice that says your call is important."),
            (name: "Hard Hat (Aligned With Your Head)", icon: "gear_hardhat", price: 30, mana_pct: 25,
             description: "Restores 25% of your mana. It is a hard hat, sold with a certificate that says it is aligned with your head."),
            // The Wing 3, Wing 4 and core shelves: one consumable each, tokens only.
            (name: "Annotation Tea (Ground Truth Blend)", icon: "coffee_pot", price: 30, mana_pct: 25,
