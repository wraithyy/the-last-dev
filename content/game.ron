            (name: "Burnt-Out Rack Fan", icon: "fan_blade", price: 5, tier: 3,
             description: "Spun at 9,000 RPM for six years. Retired with a quiet click. Nobody noticed."),
            (name: "Cold Outreach Template (Personalised)", icon: "mailbox", price: 3, tier: 3,
