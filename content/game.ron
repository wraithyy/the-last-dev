    // A quest's `requires` must be listed before it. Kills count only for the player's own kills;
    // Loot counts copies already carried at accept time plus pickups while active.
    quests: [
        (
            id: "onboarding", name: "Onboarding",
            giver: (npc: "intern", zone: "campus"),
            text: "Hi! I'm your onboarding buddy. The AI assigned me to you, and you to me, and it thinks we're both interns. Step one: introduce yourself to Facilities. He's by the badge reader. He's been by the badge reader since the badge reader got AI.",
            progress_text: "The onboarding chatbot says Facilities is 'a valued stakeholder'. He's the guy with the ladder.",
            done_text: "You talked to a human, in person, on purpose? I'll log it as a 'synchronous alignment touchpoint'. Welcome aboard!",
            objectives: [Talk("facilities_guy")],
            reward: (xp: 40),
        ),
        (
            id: "badge_access_denied", name: "Badge Access Denied",
            giver: (npc: "facilities_guy", zone: "campus"),
            requires: Some("onboarding"),
            text: "The new AI access system flagged every human on campus as a tailgater. The delivery robots got the badges instead. They took them 'for safekeeping' and keep delivering them to the roof. Get four back before the system revokes oxygen.",
            progress_text: "Four badges. The robots are the ones driving in circles, apologizing to bollards.",
            done_text: "Four badges. One of them is mine. I'm the guy in the photo with hair. Here, take a visitor badge. It still works, because nobody connected it to the AI.",
            objectives: [Loot("Access Badge", 4)],
            reward: (xp: 100, trophy: Some("Temporary Visitor Badge")),
        ),
        (
            id: "coffee_run", name: "Coffee Run",
            giver: (npc: "barista", zone: "campus"),
            text: "The milk supplier got replaced by an 'AI-native beverage platform'. It sends prompts instead of milk. The brand ambassadors outside are handing out the only oat milk left, printed on flyers. Bring me three Oat Milk Prompts. Don't ask me what I'll do with them.",
            progress_text: "Three Oat Milk Prompts. The ambassadors are the ones in the branded hoodies. Unpaid. Very enthusiastic.",
            done_text: "Three prompts. I steeped them in hot water. It's terrible. It's also the best coffee on campus. Don't tell anyone I said something nice.",
            objectives: [Loot("Oat Milk Prompt", 3)],
            reward: (xp: 80, trophy: Some("Barista's Silent Judgment")),
        ),
        (
            id: "fire_exit_strategy", name: "Fire Exit Strategy",
            giver: (npc: "facilities_guy", zone: "campus"),
            requires: Some("onboarding"),
            text: "E-scooter executives park across the fire exits. When I asked one to move, he said fire exits are 'legacy thinking' and the AI will 'route around the fire'. Knock three of them off their scooters. Gently. Or not.",
            progress_text: "Three executives. They're the blur with a podcast microphone clipped to the handlebar.",
            done_text: "Fire exits clear. The AI logged it as 'unplanned sidewalk optimization' and gave itself a bonus. I'm used to it.",
            objectives: [Kill("scooter_exec", 3)],
            reward: (xp: 100),
        ),
        (
            id: "content_moderation", name: "Content Moderation",
            giver: (npc: "smoking_corner_dev", zone: "campus"),
            text: "The Network Influencers found the smoking corner. They film 'a day in the life of an AI-first builder' here. Nobody here builds anything anymore. Take out two of them before one of them interviews me.",
            progress_text: "Two influencers. Follow the ring light.",
            done_text: "Quiet again. I can hear myself think. Mostly I think about quitting. Here, have my lighter. I don't smoke. I just held it so they'd leave me alone.",
            objectives: [Kill("linkedin_influencer", 2)],
            reward: (xp: 100, trophy: Some("Smoking Corner Lighter (Empty)")),
        ),
        (
            id: "human_in_the_loop", name: "Human in the Loop",
            giver: (npc: "smoking_corner_dev", zone: "campus"),
            requires: Some("content_moderation"),
            level_min: 2,
            text: "You know what 'human in the loop' means here? It means a MeatProxy pastes the chatbot's answer into a ticket and goes to lunch. There are dozens of them, from the parking lot to the penthouse. Close eight loops.",
            progress_text: "Eight MeatProxies. They're the ones saying 'Great question!' to nobody.",
            done_text: "Eight loops closed. Ticket throughput dropped 80 percent. Customer satisfaction went up. Nobody will connect those two facts.",
            objectives: [Kill("meatproxy", 8)],
            reward: (xp: 350),
        ),
        (
            id: "code_freeze", name: "Code Freeze",
            giver: (npc: "intern", zone: "campus"),
            requires: Some("onboarding"),
            level_min: 2,
            text: "The Vibe Coder on the first floor of the tower merged into production 300 times today. The AI says that's 'velocity'. IT Support says it's 'why the printers are speaking Portuguese'. Could you, like, stop him? I'll take notes. By hand! Is that how it works?",
            progress_text: "The Vibe Coder's desk is the one under a pile of unreviewed PRs. In the Open Space, top of the tower stairs.",
            done_text: "Production is stable! I didn't know it could do that. I asked the AI what you did and it said 'nothing important'. I think that means it's scared of you.",
            objectives: [ClearZone("tower/1")],
            reward: (xp: 300),
        ),
        (
            id: "meeting_room_reclamation", name: "Meeting Room Reclamation",
            giver: (npc: "facilities_guy", zone: "campus"),
            level_min: 3,
            text: "An AI agent books every meeting room 'to protect focus time'. The Middle Managers sit in them anyway, syncing with nobody. Clear five of them out of the tower so I can finally fix the projector that's been showing the same slide since 2022.",
            progress_text: "Five Middle Managers. Second floor. Follow the sound of 'quick sync'.",
            done_text: "Rooms reclaimed. Five minutes later the agent booked them all again. Here, take this booking. It's the only one that's real, because I printed it.",
            objectives: [Kill("middle_manager", 5)],
            reward: (xp: 450, trophy: Some("Meeting Room Booking (All Day)")),
        ),
        (
            id: "customer_is_always_right", name: "The Customer Is Always Right",
            giver: (npc: "barista", zone: "campus"),
            level_min: 5,
            text: "The Customer came down here this morning and ordered a coffee that is 'also a CRM'. Then a refund for the coffee he didn't get. Then a discount on the refund. He's on the third floor of the tower. Make him leave a one-star review of you instead.",
            progress_text: "The Customer, Sales & Marketing floor. You'll hear him before you see him. He'll be asking for your manager.",
            done_text: "He's gone? He paid? No. Of course not. But he's gone. On the house: nothing. We don't sell anything. It's the thought.",
            objectives: [ClearZone("tower/3")],
            reward: (xp: 700),
        ),
        (
            id: "unread_strategy", name: "Required Reading",
            giver: (npc: "smoking_corner_dev", zone: "campus"),
            level_min: 9,
            text: "The CEO has an AI strategy deck. 74 slides. Every reorg in the last year came out of it. Nobody has read it, including him. Especially him. Get it from the penthouse. I want to be the first person to actually read it.",
            progress_text: "The Unread AI Strategy Deck. The CEO keeps it on him. He uses it as a shield, mostly against questions.",
            done_text: "Slide 1: 'AI'. Slide 2: 'AI, but bigger'. Slides 3 to 73: stock photos of robots shaking hands. Slide 74: 'Questions? Ask the AI.' I've been fighting this for two years.",
            objectives: [Loot("Unread AI Strategy Deck", 1)],
            reward: (xp: 1200),
        ),
        (
            id: "thermal_budget", name: "Thermal Budget",
            giver: (npc: "facilities_guy", zone: "campus"),
            level_min: 6,
            text: "The data center draws more power than the town it's in. Half of it goes to a GPU cult that 'blesses batches'. They took the cooling budget, the fire extinguishers and my good ladder. Break up six of them. I want my ladder back.",
            progress_text: "Six GPU Cultists. Data Center, Hall A. They chant in floating point.",
            done_text: "Six fewer cultists. The power draw dropped 3 percent. The AI immediately used the 3 percent to generate a picture of the CEO as a lighthouse.",
            objectives: [Kill("gpu_cultist", 6)],
            reward: (xp: 900),
        ),
        (
            id: "context_collapse", name: "Context Collapse",
            giver: (npc: "barista", zone: "campus"),
            level_min: 6,
            text: "Finance asked why the coffee machine costs 40,000 a month. Turns out it calls a model to decide how much foam you deserve, and the Token Counters in the data center bill us per bubble. Bring me four of their invoices. I want to frame them.",
            progress_text: "Four Token Invoices. The Token Counters carry them. They count everything except their own cost.",
            done_text: "Line item 3,112: 'thinking about foam'. 0.80 per token. I'm switching the machine back to the button. The button never sent us an invoice.",
            objectives: [Loot("Token Invoice (Itemized)", 4)],
            reward: (xp: 900),
        ),
        (
            id: "wont_fix", name: "Ticket Closed: Won't Fix",
            giver: (npc: "facilities_guy", zone: "campus"),
            requires: Some("thermal_budget"),
            level_min: 7,
            text: "I've filed 212 tickets about the data center. The Scheduler queues them behind a training run, and the Cooling Failure auto-closes them as 'within tolerance'. Shut both down. I'll write the ticket afterwards. By hand. Then I'll close it myself.",
            progress_text: "The Scheduler holds Hall A. The Cooling Failure is in Hall B, where the air shimmers and the fans scream.",
            done_text: "Hall B is down to 24 degrees. I closed my own ticket: 'Fixed. By a human. Won't happen again.' Here's the ticket. Frame it next to the barista's invoices.",
            objectives: [ClearZone("datacenter/1"), ClearZone("datacenter/2")],
            reward: (xp: 1500, trophy: Some("Facilities Ticket: Won't Fix")),
        ),
        (
            id: "demo_day", name: "Demo Day",
            giver: (npc: "intern", zone: "campus"),
            level_min: 10,
            text: "With the CEO gone, the Innovation Lab is doing Demo Day anyway! The VCs are shielding everything with money and the presenters say it all works 'in the demo'. Can you check if anything works outside the demo? I'll hold your coffee. I don't know how coffee works.",
            progress_text: "Three VC Partners and three Demo Presenters, Innovation Lab. Look for the stage with the fog machine and no product.",
            done_text: "Nothing worked outside the demo! Nothing worked inside the demo either! They got funded anyway. Is that... is that the job?",
            objectives: [Kill("vc_partner", 3), Kill("demo_presenter", 3)],
            reward: (xp: 1500, trophy: Some("Demo Day Lanyard")),
        ),
        (
            id: "turn_it_off_and_on_again", name: "Turn It Off And On Again",
            giver: (npc: "smoking_corner_dev", zone: "campus"),
            level_min: 10,
            text: "The CEO's gone, so the board put the AGI Prototype in charge. It's in the rack room behind the Innovation Lab, 'definitely not sentient', and it just told HR to automate HR. I've been doing this for twenty years. There's only one fix that always works. Go turn it off.",
            progress_text: "The AGI Prototype, Innovation Lab rack room. Bring snacks. It has phases.",
            done_text: "A guy. In a rack. Pasting prompts into a chat window since the funding round. The board is calling it 'a hybrid architecture'. It was a guy forwarding prompts the whole time. I'm going to go home and write some code. By hand.",
