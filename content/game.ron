            (name: "Scrubs Of The Loop", icon: "gear_hoodie", slot: Hoodie, rarity: Epic, ilvl: 20, role: Some(Healer), set: Some("human_in_the_loop"), source: Ilmari, drops_from: Some("il_cio"),
             visual: (color: (0.35, 0.75, 0.6), style: 2),
