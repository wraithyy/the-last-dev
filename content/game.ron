// The Last Dev content: all balance numbers and every line of text live here.
// Times are milliseconds, distances meters, *_pct are integer percents.
// Unit stats are authored for the unit's own `level`; spawning it at another level
// scales HP, damage and XP by `mob_scaling` (see docs/FORMULAS.md).
(
    config: (
        gcd_base_ms: 1500,
        gcd_floor_ms: 1000,
        queue_window_ms: 400,
        pushback_ms: 500,
        pushback_max: 2,
        crit_damage_pct: 150,
        loot_range_m: 6.0,
        xp_per_level: 450,
        white_hit_pct: 95,
        spell_hit_pct: 96,
        // Out-of-combat only: every interval, percent of max HP / max mana.
        regen: (interval_ms: 2000, hp_pct: 4, mana_pct: 5),
        player_yell_cooldown_ms: 20000,
        mob_scaling: (hp_pct_per_level: 12, damage_pct_per_level: 10, xp_pct_per_level: 10),
        xp_rules: (above_pct_per_level: 5, above_max_levels: 4, below_pct_per_level: 20, gray_level_diff: 3),
        // Co-op: enemy max HP +55% per group member beyond the first (docs/FORMULAS.md).
        group_hp_pct_per_player: 55,
        // Co-op: enemy damage +30% per group member beyond the first.
        group_damage_pct_per_player: 30,
        // Co-op: bosses add this much more per extra member (a trio faces 160% + 40%).
        group_boss_damage_pct_per_player: 20,
        // Co-op: every 2 members beyond the first, each trash pack spawns one more member.
        group_pack_growth_players: 2,
        // Pulling a pack also pulls idle trash of other packs within this radius.
        pack_link_m: 7.0,
        // Non-boss enemies hit this much harder than authored (bosses are tuned on their own).
        trash_damage_pct: 110,
        // Players stay in combat this long after a pull they kited away resets.
        combat_lock_ms: 5000,
    ),
    // Player growth; index 0 = level 1. Bonuses are cumulative on top of the class unit's stats
    // (`hp_bonus` scaled by the class's `level_hp_pct`).
    levels: [
        (xp_to_next: 450, hp_bonus: 0, mana_bonus: 0, spell_power_bonus: 0, xp_reward_pct: 100),
        (xp_to_next: 900, hp_bonus: 35, mana_bonus: 40, spell_power_bonus: 10, xp_reward_pct: 120),
        (xp_to_next: 1500, hp_bonus: 70, mana_bonus: 80, spell_power_bonus: 20, xp_reward_pct: 120),
        (xp_to_next: 2400, hp_bonus: 105, mana_bonus: 160, spell_power_bonus: 30, xp_reward_pct: 130),
        (xp_to_next: 3800, hp_bonus: 140, mana_bonus: 120, spell_power_bonus: 40, xp_reward_pct: 145),
        (xp_to_next: 6000, hp_bonus: 175, mana_bonus: 200, spell_power_bonus: 50, xp_reward_pct: 165),
        (xp_to_next: 9300, hp_bonus: 210, mana_bonus: 320, spell_power_bonus: 60, xp_reward_pct: 235),
        (xp_to_next: 14400, hp_bonus: 245, mana_bonus: 280, spell_power_bonus: 70, xp_reward_pct: 335),
        (xp_to_next: 22200, hp_bonus: 280, mana_bonus: 240, spell_power_bonus: 80, xp_reward_pct: 335),
        (xp_to_next: 0, hp_bonus: 315, mana_bonus: 360, spell_power_bonus: 90, xp_reward_pct: 375),
    ],
    auras: [
        (key: "code_smell", name: "Code Smell", icon: "code_smell", harmful: true),
        (key: "guardrails", name: "Guardrails", icon: "guardrails", harmful: false),
        (key: "git_blame", name: "git blame", icon: "git_blame", harmful: true,
            periodic: Some((interval_ms: 3000, base: 12, coefficient_pct: 30)), spread_radius_m: 12.0),
        (key: "caffeine", name: "On-Call Caffeine", icon: "caffeine", harmful: false, haste_pct: 30),
        (key: "rubber_duck", name: "Rubber Duck", icon: "rubber_duck", harmful: true, stun: true),
        (key: "review_fatigue", name: "Review Fatigue", icon: "review_fatigue", harmful: true, cast_time_pct: 20),
        (key: "standup", name: "Daily Stand-up", icon: "standup", harmful: true, stun: true),
        (key: "retrospective", name: "Retrospective", icon: "retrospective", harmful: false, damage_done_pct: 25),
        (key: "quick_sync", name: "Quick Sync", icon: "quick_sync", harmful: true, stun: true),
        (key: "overpromise", name: "Overpromise", icon: "overpromise", harmful: true, damage_taken_pct: 5, max_stacks: 8),
        (key: "thought_leadership", name: "Thought Leadership", icon: "thought_leadership", harmful: true,
