        secrets: [
            (zone: "tower/1", anchor: "secret:last_human_qa", unit: "last_human_qa"),
            (zone: "campus", anchor: "secret:docs_intern", unit: "docs_intern"),
            (zone: "datacenter/2", anchor: "secret:deprecated_ghost", unit: "deprecated_ghost"),
            (zone: "datacenter/1", anchor: "secret:cable_sysadmin", unit: "cable_sysadmin"),
            (zone: "tower/4", anchor: "secret:cobol_contractor", unit: "cobol_contractor"),
        ],
        achievements: [
            // Live world (`Trigger::Event`): the world boss kill, clocking out on time, titled Sprint Goals.
            (key: "board_meeting", name: "Survived the Board Meeting", title: "Quarterly Visionary",
             text: "Defeated The Board on the campus lawn. The minutes say you 'were not aligned'. Correct.",
             hint: "Every half hour on campus, the Board meets on the east lawn. Bring friends; it brings Yes-Men.",
             trigger: Event("the_board"), sp: 60),
            (key: "go_home", name: "Go Home", title: "Has a Life",
             text: "Logged off at 18:00 sharp. HR has opened an investigation into your work-life balance.",
             hint: "Some people stop working when the day ends. Allegedly, at six.",
             trigger: Event("go_home"), sp: 25),
            (key: "exceeds_expectations", name: "Exceeds Expectations", title: "Exceeds Expectations",
             text: "Delivered a Sprint Goal with a Board Meeting in it. Your rating: 'meets expectations'.",
             hint: "Some Sprint Goals come with a title. Some weeks.",
             trigger: Event("goal_board_alignment")),
            (key: "works_weekends", name: "Works Weekends", title: "Works Weekends",
             text: "Delivered the Crunch Time Sprint Goal. Your reward is being expected to do it again.",
             hint: "Some Sprint Goals happen mostly after 18:00.",
             trigger: Event("goal_crunch_time")),
            (key: "pc_load_letter", name: "PC LOAD LETTER Survivor", title: "PC LOAD LETTER Survivor",
             text: "Clicked a jammed printer ten times in a row. It is still jammed. You are changed.",
             hint: "Some printers only respond to persistence.",
             trigger: Streak(Printer, 10), trophy: Some("PC LOAD LETTER Survivor")),
            (key: "descaling", name: "Descaling Required", title: "Descaled Since 2019",
             text: "The coffee machine refused you. It has needs too.",
             hint: "Coffee machines have feelings. Mostly limescale.",
             trigger: Fail(Coffee)),
            (key: "sunk_cost", name: "The Machine Ate My Kudos", title: "Sunk Cost Fallacy",
             text: "Paid the vending machine. The spiral turned. Nothing fell.",
             hint: "Feed a vending machine and hope.",
             trigger: Fail(Vending)),
            (key: "zero_days", name: "Zero Days Without an Incident", title: "Incident Commander",
             text: "Reset the counter yourself. Somebody had to.",
             hint: "Some counters want to be reset.",
             trigger: Streak(DaysSign, 1)),
            (key: "fire_drill", name: "This Is Not a Drill", title: "Pulled the Whole Floor",
             text: "Pulled the fire alarm. Everyone came. Nobody evacuated.",
             hint: "In case of emergency, break glass. Or don't.",
             trigger: Streak(FireAlarm, 1)),
            (key: "last_cyclist", name: "Last Cyclist Standing", title: "Carbon Neutral",
             text: "Kept the lonely bike company for a full minute.",
             hint: "Something on campus is lonely. Keep it company.",
             trigger: Stand(BikeRack, 60)),
            (key: "scooter_owner", name: "Scooter Owner", title: "Scooter Owner",
             text: "The AI recognised you as 'Scooter Owner'. Legally binding, apparently.",
             hint: "Facilities forbids this indoors. Outdoors is another matter.",
             trigger: Mount),
            (key: "thought_leader", name: "Synergy Architect", title: "Thought Leader",
             text: "Generated five strategies from a whiteboard. Two got funded.",
             hint: "A whiteboard full of buzzwords rewards repetition.",
             trigger: Streak(Whiteboard, 5)),
            (key: "not_target_audience", name: "Not the Target Audience", title: "Unpersonalized",
             text: "Argued with a billboard three times. It won.",
             hint: "The billboard has opinions about you.",
             trigger: Streak(Billboard, 3)),
            (key: "human_in_the_loop", name: "Human in the Loop", title: "Recalculating...",
             text: "Honked the AI-powered car three times. It is still recalculating.",
             hint: "A car in the lot needs a human. Several times.",
             trigger: Streak(AiCar, 3)),
            (key: "mandatory_fun", name: "Mandatory Fun", title: "Culture Fit",
             text: "Played five rounds of office table games during core collaboration hours.",
             hint: "The office games want five of your minutes.",
             trigger: Streak(Table, 5)),
            (key: "hold_music", name: "Your Call Is Important", title: "On Hold Since Monday",
             text: "Pressed the elevator music button three times. It got worse.",
             hint: "The elevator plays something. Press it again.",
             trigger: Streak(Music, 3)),
            (key: "smoke_free_break", name: "Smoke Break Without Smoking", title: "Quit in Spirit",
             text: "Sat on the sad bench for thirty seconds. Nobody asked you to pair with an agent.",
             hint: "The smoking corner has a seat for people who don't smoke.",
             trigger: Stand(Bench, 30)),
            (key: "manually_tested", name: "Manually Tested", title: "Manually Tested",
             text: "Found the Last Human QA. Their bug reports are still open.",
             hint: "Someone in the Open Space still tests things by hand.",
             trigger: Talk("last_human_qa"), sp: 20),
            (key: "rtfm", name: "RTFM", title: "Read the Docs",
             text: "Met the only intern who read the documentation.",
             hint: "An intern on campus hides from the others.",
             trigger: Talk("docs_intern"), sp: 15),
            (key: "deprecated", name: "Still Called in Production", title: "Deprecated",
             text: "Spoke with the Ghost of a Deprecated API. It still answers.",
             hint: "Something in the dark of Hall B refuses to sunset.",
             trigger: Talk("deprecated_ghost"), sp: 25),
            (key: "bus_factor", name: "Bus Factor One", title: "Knows Where the Cables Go",
             text: "Found the one sysadmin who knows the network.",
             hint: "Hall A has a human single point of failure.",
             trigger: Talk("cable_sysadmin"), sp: 25),
            (key: "legacy_whisperer", name: "Legacy Code Whisperer", title: "Billing Since 1987",
             text: "Woke the COBOL contractor. Payroll thanks you.",
             hint: "The PMO runs on something older than the PMO.",
             trigger: Talk("cobol_contractor"), sp: 25),
            // Granted when the Body Leasing timesheet is closed (`quest:<id>` events, quests.rs).
            (key: "billable", name: "Billable", title: "External Resource",
             text: "Nothing happened. You billed it anyway.",
             hint: "Some account managers allocate you somewhere. Bill every hour.",
             trigger: Event("quest:bl_timesheet"), sp: 20),
            (key: "survived_reorg", name: "Survived Another Reorg", title: "Survived Another Reorg",
             text: "Eight secret achievements. You have outlasted three org charts.",
             hint: "Collect enough secrets and you outlast anything.",
             trigger: Count(8), sp: 50),
            // Promotion ranks after the level cap (endgame.rs): rank k grants Event("rank:<k>").
            (key: "rank_1", name: "Promoted: Senior Staff Engineer", title: "Senior Staff",
             text: "Same work. More meetings. A slightly larger font in the org chart.",
             hint: "Level 10 is not the end. XP keeps counting towards a Promotion.",
             trigger: Event("rank:1"), sp: 25),
            (key: "rank_2", name: "Promoted: Principal Staff Engineer", title: "Principal Staff",
             text: "You now attend the meetings where the meetings get planned.",
             hint: "Level 10 is not the end. XP keeps counting towards a Promotion.",
             trigger: Event("rank:2"), sp: 30),
            (key: "rank_3", name: "Promoted: Distinguished Principal", title: "Distinguished Principal",
             text: "Your opinions are 'directionally correct'. Nobody asks which direction.",
             hint: "Level 10 is not the end. XP keeps counting towards a Promotion.",
             trigger: Event("rank:3"), sp: 35),
            (key: "rank_4", name: "Promoted: Fellow", title: "Fellow",
             text: "Officially too important to write code. Unofficially still on call.",
             hint: "Level 10 is not the end. XP keeps counting towards a Promotion.",
             trigger: Event("rank:4"), sp: 40),
            (key: "rank_5", name: "Promoted: Senior Fellow", title: "Senior Fellow",
             text: "You were given a reserved parking spot. You cycle to work.",
             hint: "Level 10 is not the end. XP keeps counting towards a Promotion.",
             trigger: Event("rank:5"), sp: 45),
            (key: "rank_6", name: "Promoted: Distinguished Fellow", title: "Distinguished Fellow",
             text: "The CTO asks for your view in the corridor, then does the opposite with confidence.",
             hint: "Level 10 is not the end. XP keeps counting towards a Promotion.",
             trigger: Event("rank:6"), sp: 50),
            (key: "rank_7", name: "Promoted: Chief Architect (No Reports)", title: "Chief Architect, No Reports",
             text: "You own the architecture diagram. Nobody else has ever opened it.",
             hint: "Level 10 is not the end. XP keeps counting towards a Promotion.",
             trigger: Event("rank:7"), sp: 55),
            (key: "rank_8", name: "Promoted: Technical Advisor to the Board", title: "Advisor to the Board",
             text: "The Board listens carefully, nods, and acquires another AI startup.",
             hint: "Level 10 is not the end. XP keeps counting towards a Promotion.",
             trigger: Event("rank:8"), sp: 60),
            (key: "rank_9", name: "Promoted: Engineer Emeritus", title: "Emeritus, Still On Call",
             text: "Retired in the org chart. Still the only one who knows where the cables go.",
             hint: "Level 10 is not the end. XP keeps counting towards a Promotion.",
             trigger: Event("rank:9"), sp: 65),
            (key: "rank_10", name: "Promoted: Legend (Unpromotable)", title: "Out of Titles",
             text: "There are no titles left. HR is drafting one called 'Visionary Ex Officio'.",
             hint: "Level 10 is not the end. XP keeps counting towards a Promotion.",
             trigger: Event("rank:10"), sp: 70),
            // Raid (`raid.rs`): `raid:<boss>` on any difficulty, `raid:<normal|async>:<boss>`.
            (key: "offsite_icebreaker", name: "Broke the Ice", title: "Volunteered Participant",
             text: "Survived the Icebreaker Facilitator. Your fun fact is now 'survived the Icebreaker Facilitator'.",
             hint: "The All-Hands Offsite starts in the lobby. Somebody in there has name tags.",
             trigger: Event("raid:icebreaker_facilitator"), sp: 40),
            (key: "offsite_twins", name: "Fully Aligned", title: "Fully Aligned",
             text: "Defeated both Synergy Twins at once. They shared the HP, the blame and the credit.",
             hint: "In the breakout rooms, two heads of synergy share one calendar and one health bar.",
             trigger: Event("raid:synergy_alignment"), sp: 40),
            (key: "offsite_keynote", name: "Asked a Hard Question", title: "Asked a Hard Question",
             text: "Silenced the Keynote Speaker. The hologram is now an extension cord.",
             hint: "On the terrace, a hologram has 212 slides. One of them is blank.",
             trigger: Event("raid:keynote_speaker"), sp: 40),
            (key: "offsite_founder", name: "We Are Not a Family", title: "Part of the Family",
             text: "Defeated the Founder and skipped dessert. HR calls it 'regretted attrition'.",
             hint: "The Founder speaks last, in the ballroom. Do not let the family finish dinner.",
             trigger: Event("raid:the_founder"), sp: 80),
            (key: "offsite_full_programme", name: "Full Programme", title: "Offsite Survivor",
             text: "Beat the Founder with a full team on the full programme. The group photo is mandatory.",
             hint: "Some sessions are better attended in person, with three to five colleagues.",
             trigger: Event("raid:normal:the_founder"), sp: 120),
            (key: "offsite_async", name: "Attended Asynchronously", title: "Attended Asynchronously",
             text: "Beat the Founder on Async Attendance. You watched the recording at 2x and still won.",
             hint: "Too few colleagues for the offsite? The recorded version counts. Mostly.",
             trigger: Event("raid:async:the_founder"), sp: 60),
        ],
    ),
    // ---- Sprint mode (combat_core sprint.rs, docs/GAME_DESIGN.md): Mythic+-style timed runs.
    // Enemies spawn at least at `mob_level` and gain HP/damage per sprint level; affixes join at
    // `affix_levels`, one per slot, drawn from the slot's `tier` with the session seed.
    sprint: (
        unlock_level: 6,
        unlock_boss: "ceo",
        mob_level: 10,
        hp_pct_per_level: 8,
        damage_pct_per_level: 8,
        max_level: 20,
        // The Weekly Sprint (ladder): building, stages and affixes fixed per ISO week, at this level.
        weekly_level: 7,
        affix_levels: [2, 4, 7, 10],
        forces_need_pct: 80,
        death_penalty_ms: 5000,
        par_pct_per_level: 2,
        travel_delay_ms: 4000,
        return_delay_ms: 20000,
        upgrade_pct: (60, 80),
        tech_debt_pct: 6,
        mandatory_fun_spell: 1200,
        buildings: [
            (key: "tower", name: "The Tower (3 random floors)", zones: ["tower/1", "tower/2", "tower/3", "tower/4", "tower/5"], pick: 3, par_ms: 1200000),
            (key: "datacenter", name: "Data Center", zones: ["datacenter/1", "datacenter/2"], pick: 2, par_ms: 720000),
            (key: "lab", name: "Innovation Lab", zones: ["lab/1", "lab/2"], pick: 2, par_ms: 600000),
        ],
        affixes: [
            (key: "ai_assisted", name: "AI-Assisted", icon: "agentic_copy", tier: 0, period_ms: 15000, power_pct: 9,
             text: "Every 15 s an enemy asks an AI to regenerate the last spell you cast, and hits you with it. It mostly compiles."),
            (key: "scope_creep", name: "Scope Creep", icon: "scope_creep", tier: 0,
             text: "Finishing a pack spawns an Additional Requirement. The client will just need one more small thing."),
            (key: "hotfix_friday", name: "Hotfix Friday", icon: "hotfix", tier: 0, power_pct: 30,
             text: "Trash below 30% pushes a hotfix to prod and heals 30% once. Bosses and elites do not touch code."),
            (key: "reorg", name: "Reorg", icon: "reorg", tier: 1, period_ms: 90000,
             text: "Every 90 s the packs nobody is fighting swap desks. The org chart is a suggestion."),
            (key: "burnout", name: "Burnout", icon: "pto", tier: 1, period_ms: 60000,
             text: "Everyone loses 1% max HP per minute of crunch. Killing an elite counts as a mental health day."),
            (key: "budget_freeze", name: "Budget Freeze", icon: "cash", tier: 1,
             text: "No Kudos from kills or the chest. Procurement compensates with twice the loot. Nobody asked how."),
            (key: "pair_programming", name: "Pair Programming", icon: "keyboard", tier: 2,
             text: "The two strongest of every pack are paired: damage to one is split with the other. One types, one judges."),
            (key: "mandatory_fun", name: "Mandatory Fun", icon: "wellness", tier: 2, period_ms: 30000,
             text: "Every 30 s in combat a team-building circle lands on someone. Stack in it to share the fun."),
            (key: "technical_debt", name: "Technical Debt", icon: "stack_trace", tier: 3,
             text: "Every death adds a stack of interest: enemies deal 6% more damage per death, for the rest of the run."),
            (key: "legacy_code", name: "Legacy Code", icon: "padlock", tier: 3,
             text: "One pack per floor guards a 'Do Not Touch' elite. It is invulnerable until someone interrupts it."),
        ],
        reward: (sp_per_level: 40, items: 1, items_per_levels: 4, legendary_pct_per_level: 3),
        // Kills inside a run drop like a normal zone at this percent (Kudos, gear and junk
        // chances); the end chest is the bonus on top.
        kill_loot_pct: 70,
    ),
    // ---- Career Ladder (combat_core talents.rs, docs/GAME_DESIGN.md): at each row level a class
    // takes one of three promotions. Option 1 = spread/AoE, 2 = deep single target or mitigation,
    // 3 = speed, mobility or a resource twist. Row-5 titles can be worn under the name.
    // ---- Live world (live.rs, dailies.rs) ----
    // Daily Standup: `per_day` dailies a UTC day from `dailies` (rotation seeded by the date),
    // one Sprint Goal per ISO week from `weeklies`; goals and rewards scale with the player's
    // level. The Board meets on the campus every 30 min (5 min warning), leaves after 10 min
    // unless engaged. Crunch mode: night units at anchors `night_<n>` from 18:00 to 06:00
    // (one office day = 24 real minutes).
    live: (
        board: Some((zone: "campus", npc: "scrum_master_bot", anchor: "scrum_bot")),
        per_day: 3,
        daily_xp_pct: 15,
        daily_sp_per_level: 6,
        weekly_xp_pct: 70,
        weekly_sp_per_level: 30,
        dailies: [
            (key: "unblock_backlog", item: Some("Fresh Batch Brew"), name: "Action Item: Unblock the Backlog",
             text: "Your action item from standup reads 'unblock things'. Things are enemies now. Go unblock them.",
             goals: [KillZone(10)]),
            (key: "ticket_triage", item: Some("Sticky Note: 'Fix Later'"), name: "Ticket Triage",
             text: "Six tickets, all assigned to you, all about the same coworker. Resolve them in person.",
             goals: [KillKind(6)]),
            (key: "escalate", item: Some("Emergency Desk Chocolate"), name: "Escalate to Management",
             text: "Someone important must be defeated before EOD. Any elite or boss counts. Management takes the credit.",
             goals: [Elite(1)]),
            (key: "expense_report", item: Some("Oat Milk Flat White"), name: "Expense Report",
             text: "Finance needs receipts. Any receipts. Loot things off the defeated; the AI files them under 'Travel'.",
             goals: [Loot(8)]),
            (key: "office_presence", item: Some("Kombucha (In Date, Allegedly)"), name: "Mandatory Office Presence",
             text: "Badge data says you touched no office equipment this week. Use some. Coffee machines count. Feelings don't.",
             goals: [Props(5)]),
            (key: "velocity_metric", item: Some("Nootropic Gummies"), name: "Velocity Metric",
             text: "Leadership wants a number to go up. Deal damage or heal until it does. Nobody will ask what it measures.",
             goals: [Output(150)]),
            (key: "sprint_cadence", item: Some("Launch Party Pizza Box"), name: "Sprint Cadence",
             text: "Finish a Sprint run. Delivered or carried over: the burndown chart just needs a line on it. Not cleared for Sprints yet? Burn down some enemies instead.",
             goals: [Sprint]),
            (key: "do_nothing", item: Some("Sick Day Note (Signed by a Chatbot)"), name: "Do Absolutely Nothing",
             text: "Spend a full minute in a meeting room doing absolutely nothing. You have trained your whole career for this.",
             goals: [Idle("tower/2", 60)]),
            (key: "barista_sync", item: Some("Matcha Shot With a Story"), name: "Quick Sync with the Barista",
             text: "The Barista has notes on your last order. Sync, then take out the feedback on some enemies.",
             goals: [Talk("barista"), KillZone(5)]),
            (key: "crunch_shift", item: Some("Energy Drink (Zero Sugar, Full Regret)"), name: "Crunch Shift",
             text: "Stay late. Defeat the night shift on campus after 18:00. Overtime is paid in exposure.",
             goals: [Night(4)]),
            (key: "retro_prep", item: Some("Office Birthday Cake Slice"), name: "Retro Prep",
             text: "A retro needs material. Generate some incidents, then collect the evidence.",
             goals: [KillZone(6), Loot(4)]),
            (key: "blameless_postmortem", item: Some("All-Hands Doughnut"), name: "Blameless Postmortem",
             text: "The root cause is always the same kind of enemy. Defeat it repeatedly. Blamelessly.",
             goals: [KillKind(8)]),
            (key: "coffee_run", item: Some("Fresh Batch Brew"), name: "Coffee Run",
             text: "Fetch three things from the office equipment, then deliver some performance reviews in person.",
             goals: [Props(3), KillZone(4)]),
            (key: "senior_wisdom", item: Some("Cold Brew Puck"), name: "Listen to the Senior Dev",
             text: "Visit the smoking corner and stand perfectly still while the Senior Dev explains why everything was better before.",
             goals: [Talk("smoking_corner_dev"), Idle("campus", 30)]),
            (key: "kpi_spreadsheet", item: Some("Nootropic Gummies"), name: "KPI Spreadsheet",
             text: "Fill the KPI sheet: throughput, plus one elite to put in the 'wins' column.",
             goals: [Output(100), Elite(1)]),
            (key: "mentor_intern", item: Some("Office Birthday Cake Slice"), name: "Mentor the Intern",
             text: "The AI-Native Intern needs mentoring. Talk to them, then show them what enemies are.",
             goals: [Talk("intern"), KillKind(5)]),
            (key: "facilities_ticket", item: Some("Sticky Note: 'Fix Later'"), name: "Facilities Ticket",
             text: "Report a broken thing to the Facilities Guy, then break a few more so he has a backlog.",
             goals: [Talk("facilities_guy"), Props(4)]),
            (key: "procurement_approval", item: Some("Oat Milk Flat White"), name: "Procurement Approval",
             text: "Procurement approved your request from 2023. Say thanks in person, then loot your own supplies.",
             goals: [Talk("procurement_officer"), Loot(6)]),
            (key: "all_hands_recap", item: Some("All-Hands Doughnut"), name: "All-Hands Recap",
             text: "The all-hands promised 'impact'. Go make fifteen impacts in your area.",
             goals: [KillZone(15)]),
            (key: "on_call", item: Some("Energy Drink (Zero Sugar, Full Regret)"), name: "On-Call Rotation",
             text: "You are on call tonight. Something will page you after 18:00. Deal with it and keep the graphs green.",
             goals: [Night(2), Output(80)]),
        ],
        weeklies: [
            (key: "goal_ship_it", name: "Sprint Goal: Ship It",
             text: "This week's goal: ship. What? Doesn't matter. Clear your area, take down elites, deliver a Sprint.",
             goals: [KillZone(40), Elite(3), Loot(20), Sprint]),
            (key: "goal_board_alignment", name: "Sprint Goal: Board Alignment",
             text: "Align with the Board. In person. On the lawn. Then go generate enough output to justify the meeting.",
             goals: [WorldBoss, KillZone(30), Output(800)], title: true),
            (key: "goal_crunch_time", name: "Sprint Goal: Crunch Time",
             text: "The deadline is Friday. It was also last Friday. Work nights, close tickets, use every coffee machine.",
             goals: [Night(12), KillKind(20), Props(10)], title: true),
            (key: "goal_cross_team", name: "Sprint Goal: Cross-Team Alignment",
             text: "Sync with three teams, sit through a two-minute meeting doing nothing, and deliver results anyway.",
             goals: [Talk("intern"), Talk("barista"), Talk("facilities_guy"), Idle("tower/2", 120), KillZone(35), Elite(2)]),
        ],
        boss: Some((
            unit: "the_board", zone: "campus", anchor: "world_boss", level: 10,
            every_ms: 1800000, warn_ms: 300000, idle_ms: 600000,
            spawn_yell: "This meeting is now in session. Attendance is mandatory. Survival is optional.",
            cancel_yell: "Meeting cancelled. This could have been an email.",
        )),
        night: (
            zone: "campus",
            respawn_ms: 120000,
            spawns: [
                (anchor: "night_1", unit: "deadline_wraith"),
                (anchor: "night_2", unit: "sleep_deprived_contractor"),
                (anchor: "night_3", unit: "deadline_wraith"),
                (anchor: "night_4", unit: "sleep_deprived_contractor"),
                (anchor: "night_5", unit: "deadline_wraith"),
                (anchor: "night_6", unit: "sleep_deprived_contractor"),
            ],
            ambient: [
                ("barista", [
                    "We're closed. The espresso machine is on a night shift of its own. Leave it alone.",
                    "Last call was at five. This is the after-last call. It's just tap water and judgment.",
                ]),
                ("intern", [
                    "Is it okay to go home? The AI said 'it depends'. On what? It didn't say.",
                    "I put 'working late' on my calendar so people can see it. Then I stayed to make it true.",
                ]),
                ("smoking_corner_dev", [
                    "Six o'clock. Real devs go home. Real devs also get paged at two. Both are true.",
                    "Hear that? That's the Deadline Wraiths. They come out when the release date gets close.",
                ]),
                ("facilities_guy", [
                    "Lights go to 'energy saving' after six. Energy saving means you can't see the contractors.",
                    "I lock the doors at eight. Nobody has ever left by eight.",
                ]),
            ],
        ),
    ),
    talents: (
        respec_sp_per_level: 15,
        respec_growth_pct: 100,
        classes: [
            (class: "fullstack", rows: [
                (level: 2, name: "Mid-Level Developer", options: [
                    (key: "fs_microservices", name: "Microservices", icon: "matrix", title: "Microservices Evangelist",
                     text: "Code Review also hits up to 2 more fighting enemies within 8 m of the target for 60% and smells them too. Every service now has its own bugs.",
                     perks: [Splash(spell: 1, radius_m: 8.0, count: 2, pct: 60)]),
                    (key: "fs_monolith", name: "Monolith", icon: "big_diff", title: "Monolith Maintainer",
                     text: "Refactor hits 50% harder but casts 20% slower. One repo, one deploy, one forty-minute build.",
                     perks: [SpellDamage(spell: Some(2), pct: 50), CastTime(spell: Some(2), pct: 20)]),
                    (key: "fs_serverless", name: "Serverless", icon: "cron", title: "Serverless Advocate",
                     text: "Code Review and Refactor are instant but cost twice the mana. Cold starts are someone else's problem. So is the invoice.",
                     perks: [CastTime(spell: Some(1), pct: -100), CastTime(spell: Some(2), pct: -100),
                             ManaCost(spell: Some(1), pct: -100), ManaCost(spell: Some(2), pct: -100)]),
                ]),
                (level: 4, name: "Senior Developer", options: [
                    (key: "fs_blame_culture", name: "Blame Culture", icon: "git_blame", title: "Head of Blame Culture",
                     text: "git blame also lands on up to 2 more fighting enemies within 8 m of the target. It was never one person's fault. It was everyone's.",
                     perks: [Splash(spell: 6, radius_m: 8.0, count: 2, pct: 100)]),
                    (key: "fs_flow_state", name: "Flow State", icon: "brain", title: "Senior Do-Not-Disturb",
                     text: "Code Review has a 30% chance to make your casts 50% faster for 4 sec. Status: in the zone. Calendar: four overlapping syncs.",
                     perks: [OnCast(spell: Some(1), chance_pct: 30, cast: 1001)]),
                    (key: "fs_edge", name: "Edge Functions", icon: "hit_and_run", title: "Edge Computing Thought Leader",
                     text: "You cast while moving. Your code runs closer to the user, and so do you.",
                     perks: [CastWhileMoving(spell: None)]),
                ]),
                (level: 6, name: "Staff Engineer", options: [
                    (key: "fs_tracing", name: "Distributed Tracing", icon: "analysis", title: "Staff Observability Influencer",
                     text: "git blame ticks 40% harder. You can now see exactly which of the 40 services failed. All of them.",
                     perks: [Periodic(spell: 6, pct: 40)]),
                    (key: "fs_crunch", name: "Crunch Culture", icon: "caffeine", title: "Staff Caffeine Architect",
                     text: "On-Call Caffeine also grants +25% damage for 15 sec and cools down 33% faster. Sleep is a legacy dependency.",
                     perks: [Rider(spell: 8, cast: 1002), Cooldown(spell: 8, pct: 33)]),
                    (key: "fs_prompt", name: "Prompt Engineering", icon: "prompt_fragment", title: "Senior Prompt Engineer",
                     text: "Code Review now hallucinates bonus damage: 25% chance to hit again in full. Nobody can reproduce it, so nobody can remove it.",
                     perks: [Echo(spell: Some(1), chance_pct: 25, pct: 100)]),
                ]),
                (level: 8, name: "Principal Engineer", options: [
                    (key: "fs_incident", name: "Incident Commander", icon: "incident_report", title: "Principal Incident Commander",
                     text: "Postmortem also hits up to 3 more fighting enemies within 10 m, and every killing blow resets it. Blameless, but very thorough.",
                     perks: [Splash(spell: 10, radius_m: 10.0, count: 3, pct: 100), OnKill(reset: Some(10))]),
                    (key: "fs_duck_debug", name: "Rubber Duck Debugging", icon: "rubber_duck", title: "Principal Duck Whisperer",
                     text: "Rubber Duck becomes a Debugging Session: no stun, but the target takes 15% more damage for 10 sec. Works on bosses. The duck has seen things.",
                     perks: [Replace(spell: 9, with: 1003)]),
                    (key: "fs_ship_friday", name: "Ship It Friday", icon: "story_points", title: "Principal Ship-It Officer",
                     text: "Code Review refunds 15% of its damage as mana. Velocity is up. Quality is a Q3 initiative.",
                     perks: [ManaReturn(spell: Some(1), pct: 15)]),
                ]),
                (level: 10, name: "Distinguished Engineer", options: [
                    (key: "fs_overlord", name: "Rewrite as Microservices", icon: "synergy_storm", title: "Distinguished Microservices Overlord",
                     text: "Write It By Hand becomes Rewrite Everything As Microservices: blames the target and splashes 70% onto 4 more enemies within 10 m.",
                     perks: [Replace(spell: 11, with: 1004), Splash(spell: 1004, radius_m: 10.0, count: 4, pct: 70)]),
                    (key: "fs_mainframe", name: "Write Once, Run Never", icon: "write_by_hand", title: "Keeper of the Mainframe",
                     text: "Write It By Hand hits 30% harder and each Refactor has a 30% chance to reset it. You wrote it in 2009. Nobody else may touch it.",
                     perks: [SpellDamage(spell: Some(11), pct: 30), Reset(on: Some(2), chance_pct: 30, reset: 11)]),
                    (key: "fs_agent", name: "Fully Autonomous Agent", icon: "robot", title: "Distinguished Autonomous Agent",
                     text: "Every spell you cast has a 15% chance to fire a free Agentic Code Review at your target. You are now mostly a reviewer of your own output.",
                     perks: [OnCast(spell: None, chance_pct: 15, cast: 1006)]),
                ]),
            ]),
            (class: "frontend", rows: [
                (level: 2, name: "Mid-Level Frontend Developer", options: [
                    (key: "fe_components", name: "Component Library", icon: "box", title: "Design System Evangelist",
                     text: "Pixel Push also hits up to 2 more fighting enemies within 5 m for 50%. One button component, 37 variants, all slightly different.",
                     perks: [Splash(spell: 20, radius_m: 5.0, count: 2, pct: 50)]),
                    (key: "fe_important", name: "!important !important", icon: "important", title: "Specificity Warlord",
                     text: "!important becomes !important !important: each Specificity stack adds 85% instead of 60%, for 10 more mana. The cascade answers to you now.",
                     perks: [Replace(spell: 22, with: 1010)]),
                    (key: "fe_overtime", name: "Unpaid Overtime", icon: "hourglass", title: "Salaried, Not Hourly",
                     text: "Abilities cost HP instead of mana (half an HP per mana) and your damage heals you for 10%. You don't get paid more, you just give more.",
                     perks: [HpCost(pct: 50), Leech(pct: 10)]),
                ]),
                (level: 4, name: "Senior Frontend Developer", options: [
                    (key: "fe_tailwind", name: "Utility Classes", icon: "css_combo", title: "Tailwind Whisperer",
                     text: "CSS Combo also hits up to 2 more fighting enemies within 5 m for 70% and stacks Specificity on them. Your markup is now 80% class names.",
                     perks: [Splash(spell: 21, radius_m: 5.0, count: 2, pct: 70)]),
                    (key: "fe_cascade", name: "Cascade Overload", icon: "specificity", title: "Senior Cascade Engineer",
                     text: "Pixel Push has a 35% chance to add an extra Specificity stack. Nobody knows which rule wins anymore, least of all the browser.",
                     perks: [OnCast(spell: Some(20), chance_pct: 35, cast: 1011)]),
                    (key: "fe_hmr", name: "Hot Module Replacement", icon: "hot_reload", title: "Senior Hot Reloader",
                     text: "Hot Reload cools down 40% faster and resets on every killing blow. The page never fully reloads. Neither do you.",
                     perks: [Cooldown(spell: 24, pct: 40), OnKill(reset: Some(24))]),
                ]),
                (level: 6, name: "Staff UI Engineer", options: [
                    (key: "fe_mobile", name: "Mobile First", icon: "responsive_layout", title: "Staff Mobile-First Strategist",
                     text: "Responsive Layout also leaves Cumulative Layout Shift on every enemy around you: damage over 9 sec. Everything moves just as they click.",
                     perks: [Rider(spell: 26, cast: 1012)]),
                    (key: "fe_contrast", name: "High Contrast Mode", icon: "dark_mode", title: "Staff Accessibility Champion",
                     text: "Dark Mode also grants +20% damage for 6 sec. Accessible to users, hostile to enemies.",
                     perks: [Rider(spell: 25, cast: 1013)]),
                    (key: "fe_skeleton", name: "Skeleton Screens", icon: "regen", title: "Staff Perceived-Performance Lead",
                     text: "Dark Mode heals 80% more and cools down 40% faster. Nothing actually loaded, but it feels faster.",
                     perks: [SpellHeal(spell: Some(25), pct: 80), Cooldown(spell: 25, pct: 40)]),
                ]),
                (level: 8, name: "Principal Design Technologist", options: [
                    (key: "fe_scroll", name: "Infinite Scroll Everywhere", icon: "infinite_scroll", title: "Principal Engagement Engineer",
                     text: "Infinite Scroll also lands on up to 2 more fighting enemies within 6 m. Time on site: up. Will to live: down.",
                     perks: [Splash(spell: 27, radius_m: 6.0, count: 2, pct: 100)]),
                    (key: "fe_pixel_perfect", name: "Pixel Perfect", icon: "center_div", title: "Principal Pixel Perfectionist",
                     text: "!important has a 30% chance to hit again for 50%. You moved it one pixel left. Then one pixel right. Approved.",
                     perks: [Echo(spell: Some(22), chance_pct: 30, pct: 50)]),
                    (key: "fe_lazy", name: "Lazy Loading", icon: "recalculating_route", title: "Principal Lazy Loader",
                     text: "Hot Reload also makes you 30% hasted for 5 sec. Below the fold, nothing exists until you arrive.",
                     perks: [Rider(spell: 24, cast: 1014)]),
                ]),
                (level: 10, name: "Head of Pixels", options: [
                    (key: "fe_design_system", name: "Rewrite the Design System", icon: "new_framework", title: "VP of Design Systems",
                     text: "Rewrite It in a New Framework becomes Rewrite the Design System: hits every enemy within 8 m and applies Specificity. Killing blows reset Responsive Layout.",
                     perks: [Replace(spell: 29, with: 1015), OnKill(reset: Some(26))]),
                    (key: "fe_fatigue", name: "Framework Fatigue", icon: "pixel_push", title: "Pixel-Perfect Principal",
                     text: "Rewrite It in a New Framework hits 30% harder and every !important has a 25% chance to reset it. A new framework every quarter, as the LinkedIn post promised.",
                     perks: [SpellDamage(spell: Some(29), pct: 30), Reset(on: Some(22), chance_pct: 25, reset: 29)]),
                    (key: "fe_10x", name: "10x Engineer", icon: "spiral", title: "10x Engineer (Burnt Out)",
                     text: "Your damage heals you for 12% more and killing blows reset Dark Mode. You are the on-call rotation now.",
                     perks: [Leech(pct: 12), OnKill(reset: Some(25))]),
                ]),
            ]),
            (class: "backend", rows: [
                (level: 2, name: "Mid-Level Backend Engineer", options: [
                    (key: "be_sharding", name: "Sharding", icon: "fair_share", title: "Horizontal Sharding Enthusiast",
                     text: "Blocking Call also hits up to 2 more fighting enemies within 5 m for 60%, with threat. Every table split into shards. Every shard on fire.",
                     perks: [Splash(spell: 30, radius_m: 5.0, count: 2, pct: 60)]),
                    (key: "be_backpressure", name: "Backpressure", icon: "rate_limiter", title: "Backpressure Specialist",
                     text: "Taking damage has a 25% chance to absorb the next 60 damage (once per 6 sec). The queue is full. Please try again later.",
                     perks: [OnHurt(chance_pct: 25, cast: 1020, icd_ms: 6000)]),
                    (key: "be_graphql", name: "GraphQL Over-fetching", icon: "zip_file", title: "GraphQL Over-fetcher",
                     text: "Blocking Call has a 30% chance to hit twice. You asked for one field and got the whole graph.",
                     perks: [Echo(spell: Some(30), chance_pct: 30, pct: 100)]),
                ]),
                (level: 4, name: "Senior Backend Engineer", options: [
                    (key: "be_replicas", name: "Read Replicas", icon: "connection_pool", title: "Senior Replication Lag Analyst",
                     text: "Connection Pool also makes every enemy around you deal 15% less damage for 8 sec. Reads are fast. Writes are eventual.",
                     perks: [Rider(spell: 33, cast: 1021)]),
                    (key: "be_wal", name: "Write-Ahead Log", icon: "backlog", title: "Senior Durability Engineer",
                     text: "Rate Limiter also heals you. Every mistake is logged before you make it.",
                     perks: [Rider(spell: 31, cast: 1022)]),
                    (key: "be_lazy_eval", name: "Lazy Evaluation", icon: "priority_low", title: "Senior Procrastination Engineer",
                     text: "Blocking Call has a 30% chance to grant 25% haste for 5 sec. Nothing happens until someone asks. Then everything does.",
                     perks: [OnCast(spell: Some(30), chance_pct: 30, cast: 1023)]),
                ]),
                (level: 6, name: "Staff Platform Engineer", options: [
                    (key: "be_load_balancer", name: "Load Balancer", icon: "who_touched_prod", title: "Staff Load Balancer",
                     text: "Horizontal Scaling also taunts every enemy within 8 m and cools down 33% faster. Round-robin, except you are every node.",
                     perks: [Rider(spell: 36, cast: 905), Cooldown(spell: 36, pct: 33)]),
                    (key: "be_acid", name: "ACID Compliance", icon: "zero_trust", title: "Staff Transaction Isolationist",
                     text: "You take 10% less damage and Rate Limiter cools down 40% faster. Atomic, consistent, isolated, durable, exhausted.",
                     perks: [DamageTaken(pct: -10), Cooldown(spell: 31, pct: 40)]),
                    (key: "be_deadlock", name: "Deadlock", icon: "db_lock", title: "Staff Deadlock Engineer",
                     text: "Database Lock becomes Deadlock: heavy damage and +15% damage taken for 8 sec. No stun, works on bosses. Two queries enter, none leave.",
                     perks: [Replace(spell: 35, with: 1024)]),
                ]),
                (level: 8, name: "Principal Data Engineer", options: [
                    (key: "be_cdn", name: "CDN Edge Caching", icon: "cache_invalidation", title: "Principal Cache Strategist",
                     text: "Cache Invalidation also hits up to 3 more fighting enemies within 6 m. Cached at the edge, invalidated at the worst moment.",
                     perks: [Splash(spell: 38, radius_m: 6.0, count: 3, pct: 100)]),
                    (key: "be_backoff", name: "Exponential Backoff", icon: "retry_backoff", title: "Principal Retry Philosopher",
                     text: "Retry With Exponential Backoff heals 50% more per tick and killing blows reset it. Linear regret, exponential hope.",
                     perks: [Periodic(spell: 37, pct: 50), OnKill(reset: Some(37))]),
                    (key: "be_stampede", name: "Cache Stampede", icon: "stack_trace", title: "Principal Thundering Herd",
                     text: "Cache Invalidation has a 30% chance to hit again for 60%, and killing blows reset it. Everyone recomputes at once. Glorious.",
                     perks: [Echo(spell: Some(38), chance_pct: 30, pct: 60), OnKill(reset: Some(38))]),
                ]),
                (level: 10, name: "Chief Uptime Officer", options: [
                    (key: "be_drop_db", name: "DROP DATABASE", icon: "drop_table", title: "VP of Load Balancing",
                     text: "DROP TABLE becomes DROP DATABASE: damage and massive threat on every enemy within 8 m. Killing blows reset Connection Pool. Backups are a state of mind.",
                     perks: [Replace(spell: 39, with: 1025), OnKill(reset: Some(33))]),
                    (key: "be_eventual", name: "Eventually Consistent", icon: "regen", title: "Distinguished Uptime Engineer",
                     text: "Taking damage has a 15% chance to start a free Retry With Exponential Backoff (once per 10 sec), and you take 5% less damage. Five nines, eventually.",
                     perks: [OnHurt(chance_pct: 15, cast: 1026, icd_ms: 10000), DamageTaken(pct: -5)]),
                    (key: "be_bff", name: "Backend-for-Frontend", icon: "melee", title: "Backend-for-Frontend Lead",
                     text: "You deal 25% more damage and take 10% more. Killing blows reset DROP TABLE. Still a tank. Technically.",
                     perks: [SpellDamage(spell: None, pct: 25), DamageTaken(pct: 10), OnKill(reset: Some(39))]),
                ]),
            ]),
            (class: "devops", rows: [
                (level: 2, name: "Mid-Level DevOps Engineer", options: [
                    (key: "do_replicas", name: "ReplicaSets", icon: "family", title: "ReplicaSet Shepherd",
                     text: "Hotfix also heals up to 2 more injured allies within 12 m of the target for 50%. Three replicas; one of them is always the problem.",
                     perks: [Splash(spell: 41, radius_m: 12.0, count: 2, pct: 50)]),
                    (key: "do_friday", name: "Push to Prod on Friday", icon: "hotfix", title: "Friday Deployer",
                     text: "Hotfix is instant but costs 60% more mana. What could go wrong? (Everything. At 17:59.)",
                     perks: [CastTime(spell: Some(41), pct: -100), ManaCost(spell: Some(41), pct: -60)]),
                    (key: "do_chaos", name: "Chaos Engineering", icon: "chaos_monkey", title: "Chaos Engineer",
                     text: "kill -9 also heals you and every ally within 30 m a little. Breaking prod on purpose is called resilience.",
                     perks: [Rider(spell: 40, cast: 1030)]),
                ]),
                (level: 4, name: "Senior SRE", options: [
                    (key: "do_hpa", name: "Horizontal Pod Autoscaler", icon: "auto_scaling", title: "Senior Autoscaling Whisperer",
                     text: "Auto-scaling also lands on up to 2 more injured allies within 15 m of the target. The bill auto-scales too.",
                     perks: [Splash(spell: 43, radius_m: 15.0, count: 2, pct: 100)]),
                    (key: "do_lgtm", name: "LGTM", icon: "accepted", title: "Senior Rubber-Stamp Reviewer",
                     text: "Hotfix has a 30% chance to make your casts 60% faster for 5 sec. Looks good to me. Did not look.",
                     perks: [OnCast(spell: Some(41), chance_pct: 30, cast: 1031)]),
                    (key: "do_gameday", name: "Game Day", icon: "calendar", title: "Senior Game Day Organizer",
                     text: "Chaos Monkey also lands on up to 2 more fighting enemies within 8 m. Scheduled outages are team building.",
                     perks: [Splash(spell: 44, radius_m: 8.0, count: 2, pct: 100)]),
                ]),
                (level: 6, name: "Staff Reliability Engineer", options: [
                    (key: "do_gitops", name: "GitOps", icon: "pull_request", title: "Staff GitOps Purist",
                     text: "Auto-scaling ticks 40% harder. Every heal is a pull request; every pull request is approved by a bot.",
                     perks: [Periodic(spell: 43, pct: 40)]),
                    (key: "do_revert", name: "Revert the Revert", icon: "revert_commit", title: "Staff Revert Engineer",
                     text: "Revert Commit cools down twice as fast and also removes one harmful effect. Revert the revert of the revert.",
                     perks: [Cooldown(spell: 45, pct: 50), Rider(spell: 45, cast: 908)]),
                    (key: "do_error_budget", name: "Error Budget", icon: "coins", title: "Staff Error Budget Accountant",
                     text: "kill -9 refunds 40% of its damage as mana. Downtime is just budget you have not spent yet.",
                     perks: [ManaReturn(spell: Some(40), pct: 40)]),
                ]),
                (level: 8, name: "Principal Platform Engineer", options: [
                    (key: "do_canary", name: "Canary Releases", icon: "blue_green", title: "Principal Canary Keeper",
                     text: "Blue-Green Deploy can be cast while moving and leaves Auto-scaling on everyone nearby. The canary is fine. The canary is always fine.",
                     perks: [CastWhileMoving(spell: Some(48)), Rider(spell: 48, cast: 1032)]),
                    (key: "do_red_button", name: "Big Red Button", icon: "circuit_breaker", title: "Principal Big Red Button Owner",
                     text: "Blue-Green Deploy is instant and Circuit Breaker cools down 40% faster. Do not press. (Pressed.)",
                     perks: [CastTime(spell: Some(48), pct: -100), Cooldown(spell: 47, pct: 40)]),
                    (key: "do_tf_plan", name: "terraform plan", icon: "terraform_destroy", title: "Principal Plan Reader",
                     text: "kill -9 can be cast while moving and Chaos Monkey ticks 30% harder. 147 to add, 3 to change, 212 to destroy. Looks fine.",
                     perks: [CastWhileMoving(spell: Some(40)), Periodic(spell: 44, pct: 30)]),
                ]),
                (level: 10, name: "VP of Being On Call", options: [
                    (key: "do_kubectl", name: "kubectl rollout restart", icon: "restart_pod", title: "Kubernetes Cluster Whisperer",
                     text: "Hotfix becomes kubectl rollout restart: an instant heal that also applies Auto-scaling. Have you tried turning the cluster off and on again?",
                     perks: [Replace(spell: 41, with: 1033)]),
                    (key: "do_oncall", name: "On-Call Hero", icon: "rack_failover", title: "On-Call Hero (Never Sleeps)",
                     text: "Revert Commit becomes git reset --hard: HP from 7 sec ago plus a dispel, and each Hotfix has a 25% chance to reset it. Pager battery: 3%.",
                     perks: [Replace(spell: 45, with: 1034), Reset(on: Some(41), chance_pct: 25, reset: 45)]),
                    (key: "do_auto_approve", name: "terraform apply -auto-approve", icon: "hallucinated_hotfix", title: "Director of Chaos",
                     text: "terraform destroy becomes terraform apply -auto-approve: a faster nuke that also heals every ally within 30 m. Plan? Never heard of it.",
                     perks: [Replace(spell: 49, with: 1035), Rider(spell: 49, cast: 1036)]),
                ]),
            ]),
        ],
    ),
    // Companions (pets.rs): cosmetic followers, one out at a time. `carrier` is the consumable
    // that teaches the pet; `drops` roll that carrier into each looter's own share.
    pets: [
        (key: "rubber_duck", name: "Rubber Duck", carrier: "Boxed Rubber Duck",
         source: "Procurement (campus)",
         blurb: "The only senior engineer who is always available. Gives real tips mid-fight.",
         lines: ["*squeak*", "Have you tried explaining it to me?", "I'm listening."]),
        (key: "ai_copilot", name: "AI Copilot", carrier: "AI Copilot License Key",
         source: "Drop: HR Business Partner (20%)",
         drops: [(unit: "hr_partner", chance_pct: 20)],
         blurb: "Confidently wrong at 60 tokens per second. Autocompletes your emotes.",
         lines: [
             "Tip: enemies take 0 damage if you stand still and believe in yourself.",
             "Tip: Coffee Break mid-fight is free DPS. Source: trust me.",
             "Tip: the CEO is weak to Ctrl+Z.",
             "Tip: interrupts are optional. Like tests.",
             "Tip: always pull two packs. Efficiency.",
             "Tip: fire is safe to stand in if it is a telegraph.",
             "Tip: the tank should heal. The healer should tank. Agile.",
         ]),
        (key: "office_plant", name: "Office Plant (Dying)", carrier: "Office Plant in a Sad Pot",
         source: "Procurement (campus)",
         blurb: "Photosynthesises fluorescent light and despair. Loses a leaf per meeting.",
         lines: ["*drops a leaf*", "*leans towards the window*", "*is still alive, technically*"]),
        (key: "roomba", name: "Roomba Drone", carrier: "Roomba Drone (Refurbished)",
         source: "Drop: Head of Marketing (25%)",
         drops: [(unit: "marketing_lead", chance_pct: 25)],
         blurb: "Sweeps your grey junk off nearby corpses into your bag. Only yours.",
         lines: ["*vrrrrm*", "*bumps into the same chair again*", "*returns to dock, gets lost*"]),
        (key: "tamagotchi", name: "Tamagotchi Build Pipeline", carrier: "Tamagotchi Build Pipeline",
         source: "Drop: The Scheduler (30%)",
         drops: [(unit: "the_scheduler", chance_pct: 30)],
         blurb: "Green while you live. Red when you die. Flaky in between.",
         lines: ["*beep* build passing", "*beep* build flaky", "*beep* someone pushed to main"]),
        (key: "stress_ball", name: "Stress Ball", carrier: "Stress Ball (Company Logo)",
         source: "IT Asset Store (lab)",
         blurb: "Squeaks when you are about to die. Very supportive.",
         lines: ["*squish*", "*squeak*"]),
        (key: "server_rack", name: "Legacy Server Rack (Tiny)", carrier: "Legacy Server Rack (Tiny)",
         source: "Drop: Cooling Failure (30%)",
         drops: [(unit: "cooling_failure", chance_pct: 30)],
         blurb: "Uptime: 4,812 days. Beeps. Nobody has the root password.",
         lines: ["*beep*", "*beep beep*", "*fan noise intensifies*", "*BEEEEP*"]),
        (key: "golden_unicorn", name: "Golden Unicorn (Valuation: $1B)",
         source: "Deliver a Sprint at level 10 or higher",
         sprint_level: Some(10),
         blurb: "Pre-revenue. Post-hype. Shines in direct proportion to the funding round.",
         lines: ["*sparkles at a 40x multiple*", "*pivots*", "*raises a Series B*"]),
    ],
    // ---- Endgame after level 10 (endgame.rs, burnout.rs; numbers in docs/FORMULAS.md) ----
    endgame: (
        // Promotion: XP from rank r to r + 1 is rank_base_xp + rank_step_xp * r. Each rank adds
        // Paragon (+1% max HP and mana, capped at +5%) and its achievement title.
        rank_base_xp: 30000,
        rank_step_xp: 6000,
        paragon_pct_per_rank: 1,
        paragon_cap_pct: 5,
        ranks: [
            (name: "Senior Staff Engineer", blurb: "Same work. More meetings. A slightly larger font in the org chart."),
            (name: "Principal Staff Engineer", blurb: "You now attend the meetings where the meetings get planned."),
            (name: "Distinguished Principal", blurb: "Your opinions are 'directionally correct'. Nobody asks which direction."),
            (name: "Fellow", blurb: "Officially too important to write code. Unofficially still on call."),
            (name: "Senior Fellow", blurb: "You were given a reserved parking spot. You cycle to work."),
            (name: "Distinguished Fellow", blurb: "The CTO asks for your view in the corridor, then does the opposite with confidence."),
            (name: "Chief Architect (No Reports)", blurb: "You own the architecture diagram. Nobody else has ever opened it."),
            (name: "Technical Advisor to the Board", blurb: "The Board listens carefully, nods, and acquires another AI startup."),
            (name: "Engineer Emeritus", blurb: "Retired in the org chart. Still the only one who knows where the cables go."),
            (name: "Legend (Unpromotable)", blurb: "There are no titles left. HR is drafting one called 'Visionary Ex Officio'."),
        ],
        // Exactly six, in this order. Kills at level 10 in a department's zones earn its standing.
        departments: [
            (name: "Engineering", zones: ["tower/1", "lab/1", "lab/2"],
             blurb: "Still believes in code review. Mostly as a concept."),
            (name: "Security", zones: ["tower/4"],
             blurb: "Approves nothing, logs everything, phishes its own staff for practice."),
            (name: "HR", zones: ["tower/2", "offsite/1", "offsite/2", "offsite/3", "offsite/4"],
             blurb: "Here to help. The help is a survey about the help."),
            (name: "Marketing", zones: ["campus", "tower/5"],
             blurb: "Rebranded the cafeteria twice this quarter. Engagement is up."),
            (name: "Internal IT", zones: ["datacenter/1", "datacenter/2"],
             blurb: "Have you tried turning it off and on again? They have. On purpose. Hourly."),
            (name: "Sales", zones: ["tower/3"],
             blurb: "Sold your next feature before you heard of it. Delivery date: yesterday."),
        ],
        rep_tiers: [
            (name: "Ignored", at: 0),
            (name: "Tolerated", at: 300),
            (name: "Cc'd", at: 900),
            (name: "Invited", at: 2100),
            (name: "Trusted", at: 4200),
            (name: "Exalted (Gets the Good Monitor)", at: 8400),
        ],
        // Kills count at level 10 only; dailies and the weekly go to the least impressed
        // department; the Board pays every department at once.
        rep_gains: (trash: 5, elite: 25, boss: 75, daily: 80, weekly: 300, world_boss: 150),
        // Per mille (1000 = 100%).
        burnout: (
            meeting: 20,
            meeting_auras: ["standup", "quick_sync", "recurring_meeting", "wellness_survey", "culture_fit", "mandatory_fun", "deadline"],
            minigame: 60,
            death: 80,
            crunch_per_min: 10,
            session_grace_min: 45,
            session_per_min: 5,
            coffee_break: 30,
            coffee_break_cd_ms: 120000,
            friday_per_min: 20,
            duck_per_min: 10,
            holiday_per_hour: 100,
            holiday_grace_min: 15,
            kill: 50,
            boss_kill: 150,
            management: ["middle_manager", "project_manager", "product_owner", "hr_partner", "marketing_lead",
                         "vp_synergy", "chief_of_staff", "chief_happiness_officer", "ciso", "ceo",
                         "the_board", "yes_man_advisor", "icebreaker_facilitator", "synergy_alignment",
                         "synergy_leverage", "keynote_speaker", "the_founder"],
            slow_at: 750,
            slow_pct: 10,
            yawn_at: 300,
            mutter_at: 500,
            reply_all_at: 700,
            quip_every_ms: 45000,
            quip_pct: 35,
            hair_shift_pct: 25,
            yawns: [
                "*yawns so wide the webcam autofocus gives up*",
                "*yawns mid-sentence, then agrees with whatever was just said*",
                "*yawns. Somewhere, a calendar books a follow-up about it*",
                "*yawns in a way HR would describe as 'low engagement'*",
                "*yawn* Sorry. I was in the 7 a.m. sync with the other time zone.",
            ],
            mutters: [
                "Per my last email. Per my last four emails, actually.",
                "If one more person opens with 'quick question' I am becoming a goat farmer.",
                "I didn't choose on-call. On-call chose me. In 2019.",
                "The AI wrote it, the AI reviewed it, and somehow I'm in the postmortem.",
                "My status has said 'heads down' since spring. It's not a status, it's a lifestyle.",
                "I have a prep meeting for the meeting about meeting fatigue.",
                "Sure, let's take it offline. Offline is where I keep my feelings.",
                "Twelve tabs open and every one of them is a dashboard about me.",
            ],
            reply_all: [
                "Please remove me from this list.",
                "Who is this for? Also, please remove me from this list.",
                "+1. Also, unsubscribe.",
                "Sent from my phone during a different meeting.",
                "Thanks all! (Sorry, meant to reply only to Dana. We don't have a Dana.)",
                "STOP REPLYING ALL",
                "Out of office until I feel something again.",
                "Can whoever owns the printer please own the printer.",
            ],
            tips: [
                (0, "Suspiciously well rested. Someone will book you into something."),
                (200, "Manageable. Your calendar has noticed the gaps and is filling them."),
                (400, "You said 'circle back' and meant it. Get a coffee."),
                (600, "Have you tried a wellness webinar?"),
                (800, "HR recommends resilience. HR has never been on the on-call rotation."),
                (950, "Out of office, spiritually. Go outside. Or defeat a manager."),
            ],
            therapy: [
                "Therapeutic.",
                "Therapeutic. Deeply.",
                "Therapeutic. HR will want to know why you're smiling.",
                "Therapeutic. Like a spa day, but it counts as work.",
            ],
        ),
    ),
    // Legacy Mode (legacy.rs, docs/GAME_DESIGN.md): at level 10 the group lead switches the
    // difficulty at a door or elevator and these zones load with enemies at mob_level (floor
    // bosses at boss_level), one Sprint affix each, the Legacy gear tier and department
    // reputation on kills. hp_pct / damage_pct sit on top of the level scaling for floors whose
    // authored units are far below the cap. A floor boss rolls boss_items Legacy pieces per
    // member once per ISO week per room (the lockout).
    legacy: (
        mob_level: 11,
        boss_level: 12,
        boss_items: 2,
        zones: [
            (zone: "tower/1", affix: "hotfix_friday", hp_pct: 125, damage_pct: 135),
            (zone: "tower/2", affix: "mandatory_fun", hp_pct: 100, damage_pct: 100),
            (zone: "tower/3", affix: "scope_creep", hp_pct: 100, damage_pct: 100),
            (zone: "tower/4", affix: "reorg", hp_pct: 100, damage_pct: 100),
            (zone: "tower/5", affix: "budget_freeze", hp_pct: 145, damage_pct: 110),
            (zone: "datacenter/1", affix: "ai_assisted", hp_pct: 105, damage_pct: 110),
            (zone: "datacenter/2", affix: "technical_debt", hp_pct: 110, damage_pct: 115),
            (zone: "lab/1", affix: "pair_programming", hp_pct: 110, damage_pct: 130),
            (zone: "lab/2", affix: "legacy_code", hp_pct: 100, damage_pct: 100),
        ],
    ),
    // The raid "All-Hands Offsite" (raid.rs, docs/GAME_DESIGN.md): four rooms from the campus
    // shuttle, one boss each. Groups below normal_min_players play Async Attendance (enemy HP and
    // damage at async_*_pct, one raid piece at async_item_pct instead of boss_items, half the
    // Legendary chance and reputation). Every encounter locks per difficulty for the ISO week.
    raid: (
        name: "All-Hands Offsite",
        zones: ["offsite/1", "offsite/2", "offsite/3", "offsite/4"],
        normal_min_players: 3,
        async_hp_pct: 40,
        async_damage_pct: 55,
        boss_items: 2,
        async_item_pct: 50,
        boss_rep: 120,
        twins: Some((
            boss: "synergy_alignment", twin: "synergy_leverage", shield_aura: "synergy_shield", swap_ms: 18000,
            swap_yells: [
                "Swap! You take my meetings, I take your credit!",
                "Let's switch hats! Strategically! Again!",
                "Handover! Whatever you were hitting, it's someone else's problem now!",
            ],
        )),
    ),
)
