// The Last Dev content: all balance numbers and every line of text live here.
// Times are milliseconds, distances meters, *_pct are integer percents.
// Unit stats are authored for the unit's own `level`; spawning it at another level
// scales HP, damage and XP by `mob_scaling` (see docs/FORMULAS.md).
(
    config: (
        gcd_base_ms: 1500,
        gcd_floor_ms: 1000,
        queue_window_ms: 400,
        pushback_ms: 500,
        pushback_max: 2,
        crit_damage_pct: 150,
        loot_range_m: 6.0,
        xp_per_level: 400,
        white_hit_pct: 95,
        spell_hit_pct: 96,
        // Out-of-combat only: every interval, percent of max HP / max mana.
        regen: (interval_ms: 2000, hp_pct: 4, mana_pct: 5),
        player_yell_cooldown_ms: 20000,
        mob_scaling: (hp_pct_per_level: 12, damage_pct_per_level: 10, xp_pct_per_level: 10),
        xp_rules: (above_pct_per_level: 5, above_max_levels: 4, below_pct_per_level: 20, gray_level_diff: 3),
        // Co-op: enemy max HP +40% per group member beyond the first (docs/FORMULAS.md).
        group_hp_pct_per_player: 40,
        // Co-op: enemy damage +15% per group member beyond the first.
        group_damage_pct_per_player: 15,
    ),
    // Player growth; index 0 = level 1. Bonuses are cumulative on top of the class unit's stats
    // (`hp_bonus` scaled by the class's `level_hp_pct`).
    levels: [
        (xp_to_next: 400, hp_bonus: 0, mana_bonus: 0, spell_power_bonus: 0),
        (xp_to_next: 600, hp_bonus: 35, mana_bonus: 40, spell_power_bonus: 10),
        (xp_to_next: 800, hp_bonus: 70, mana_bonus: 80, spell_power_bonus: 20),
        (xp_to_next: 1000, hp_bonus: 105, mana_bonus: 160, spell_power_bonus: 30),
        (xp_to_next: 1200, hp_bonus: 140, mana_bonus: 120, spell_power_bonus: 40),
        (xp_to_next: 1400, hp_bonus: 175, mana_bonus: 200, spell_power_bonus: 50),
        (xp_to_next: 1600, hp_bonus: 210, mana_bonus: 320, spell_power_bonus: 60),
        (xp_to_next: 1800, hp_bonus: 245, mana_bonus: 280, spell_power_bonus: 70),
        (xp_to_next: 2000, hp_bonus: 280, mana_bonus: 240, spell_power_bonus: 80),
        (xp_to_next: 0, hp_bonus: 315, mana_bonus: 360, spell_power_bonus: 90),
    ],
    auras: [
        (key: "code_smell", name: "Code Smell", icon: "code_smell", harmful: true),
        (key: "guardrails", name: "Guardrails", icon: "guardrails", harmful: false),
        (key: "git_blame", name: "git blame", icon: "git_blame", harmful: true,
            periodic: Some((interval_ms: 3000, base: 12, coefficient_pct: 30)), spread_radius_m: 12.0),
        (key: "caffeine", name: "On-Call Caffeine", icon: "caffeine", harmful: false, haste_pct: 30),
        (key: "rubber_duck", name: "Rubber Duck", icon: "rubber_duck", harmful: true, stun: true),
        (key: "review_fatigue", name: "Review Fatigue", icon: "review_fatigue", harmful: true, cast_time_pct: 20),
        (key: "standup", name: "Daily Stand-up", icon: "standup", harmful: true, stun: true),
        (key: "retrospective", name: "Retrospective", icon: "retrospective", harmful: false, damage_done_pct: 25),
        (key: "quick_sync", name: "Quick Sync", icon: "quick_sync", harmful: true, stun: true),
        (key: "overpromise", name: "Overpromise", icon: "overpromise", harmful: true, damage_taken_pct: 5, max_stacks: 8),
        (key: "thought_leadership", name: "Thought Leadership", icon: "thought_leadership", harmful: true,
            periodic: Some((interval_ms: 3000, base: 9))),
        (key: "deadline", name: "Deadline", icon: "deadline", harmful: true, expire_damage: 110),
        (key: "billable_hours", name: "Billable Hours", icon: "billable_hours", harmful: false,
            periodic: Some((interval_ms: 2000, base: 16, heal: true))),
        (key: "unread_spec", name: "Unread Spec", icon: "unread_spec", harmful: true,
            damage_taken_pct: 10, max_stacks: 5, stack_on_repeat_cast: true),
        (key: "scope_creep", name: "Scope Creep", icon: "scope_creep", harmful: false, damage_done_pct: 12, max_stacks: 20),
        (key: "agi_pivot", name: "Pivot to AGI", icon: "agi_pivot", harmful: false, cast_time_pct: -30),
        (key: "wellness_survey", name: "Mandatory Wellness Survey", icon: "wellness_survey", harmful: true, silence: true),
        (key: "culture_fit", name: "Culture Fit Assessment", icon: "culture_fit", harmful: true, damage_taken_pct: 15),
        (key: "ab_winner", name: "A/B Test: Variant B Won", icon: "ab_winner", harmful: false, damage_done_pct: 30),
        (key: "ab_loser", name: "A/B Test: Variant B Lost", icon: "ab_loser", harmful: true, damage_taken_pct: 30),
        (key: "viral_loop", name: "Viral Loop", icon: "viral_loop", harmful: true,
            periodic: Some((interval_ms: 2000, base: 6)), max_stacks: 3),
        (key: "rebranded", name: "Rebranded", icon: "rebranded", harmful: false, damage_taken_pct: -50),
        (key: "phished", name: "Phished", icon: "phished", harmful: true, stun: true),
        (key: "password_rotation", name: "Mandatory Password Rotation", icon: "password_rotation", harmful: true, cast_time_pct: 40),
        (key: "locked_out", name: "Locked Out", icon: "locked_out", harmful: true, stun: true),
        // ---- campus, data center, innovation lab ----
        (key: "brand_awareness", name: "Brand Awareness", icon: "brand_awareness", harmful: true,
            periodic: Some((interval_ms: 3000, base: 7))),
        (key: "batch_blessing", name: "Batch Size Blessing", icon: "batch_blessing", harmful: false, damage_done_pct: 20),
        (key: "job_pending", name: "Your Job Is Pending", icon: "job_pending", harmful: true, stun: true),
        (key: "overheating", name: "Thermal Runaway", icon: "overheating", harmful: true, school: Physical,
            periodic: Some((interval_ms: 2000, base: 3)), max_stacks: 20),
        // Re-applied right after Thermal Runaway, so Rollback's dispel (newest first) takes this instead.
        (key: "hot_aisle", name: "Hot Aisle", icon: "hot_aisle", harmful: true, cast_time_pct: 10),
        (key: "demo_works", name: "Works in the Demo", icon: "demo_works", harmful: false, damage_done_pct: 40),
        (key: "demo_crashed", name: "Demo Crashed", icon: "demo_crashed", harmful: true, stun: true),
        (key: "series_b", name: "Series B", icon: "series_b", harmful: false),
        (key: "prompt_injected", name: "Ignore Previous Instructions", icon: "prompt_injected", harmful: true, silence: true),
        (key: "alignment_training", name: "Alignment Training", icon: "alignment_training", harmful: false, reflect: true),
        (key: "self_improvement", name: "Recursive Self-Improvement", icon: "self_improvement", harmful: false,
            damage_done_pct: 8, max_stacks: 25),
        // ---- player classes: Frontend, Backend, DevOps ----
        (key: "specificity", name: "Specificity", icon: "specificity", harmful: true, max_stacks: 5),
        (key: "dark_mode", name: "Dark Mode", icon: "dark_mode", harmful: false, damage_taken_pct: -50),
        (key: "infinite_scroll", name: "Infinite Scroll", icon: "infinite_scroll", harmful: true, school: Physical,
            periodic: Some((interval_ms: 2000, base: 8, coefficient_pct: 30))),
        (key: "centered", name: "Perfectly Centered", icon: "center_div", harmful: true, stun: true),
        (key: "rate_limiter", name: "429 Too Many Requests", icon: "rate_limiter", harmful: false, damage_taken_pct: -20),
        (key: "db_lock", name: "Database Lock", icon: "db_lock", harmful: true, stun: true),
        (key: "horizontal_scaling", name: "Horizontal Scaling", icon: "horizontal_scaling", harmful: false, max_hp_pct: 30),
        (key: "retry_backoff", name: "Retry With Exponential Backoff", icon: "retry_backoff", harmful: false,
            periodic: Some((interval_ms: 2000, base: 14, coefficient_pct: 40, heal: true))),
        (key: "auto_scaling", name: "Auto-scaling", icon: "auto_scaling", harmful: false,
            periodic: Some((interval_ms: 3000, base: 14, coefficient_pct: 35, heal: true))),
        (key: "chaos_monkey", name: "Chaos Monkey", icon: "chaos_monkey", harmful: true,
            periodic: Some((interval_ms: 3000, base: 12, coefficient_pct: 35))),
        (key: "circuit_breaker", name: "Circuit Breaker", icon: "circuit_breaker", harmful: false),
    ],
    spells: [
        // ---- player ----
        (
            id: 1, name: "Code Review", icon: "code_review", school: Arcane,
            range_m: 30.0, cast_ms: 2000, mana: 35, gcd: true, cooldown_ms: 0,
            description: "Reads the code nobody, human or AI, actually read. Deals arcane damage and applies Code Smell for 12 sec.",
            effect: Damage(
                base: 65, coefficient_pct: 70,
                apply_aura: Some((aura: "code_smell", duration_ms: 12000)),
            ),
            yells: [
                "Who approved this? Oh. The AI approved itself.",
                "Line one: no. Line two: also no.",
                "This function has forty parameters and a vibe.",
                "Did anyone, at any point, read this?",
                "Fullstack means I review the CSS and the SQL. Both are wrong.",
                "Why is the password in the README? Why is there a README?",
            ],
        ),
        (
            id: 2, name: "Refactor", icon: "refactor", school: Arcane,
            range_m: 30.0, cast_ms: 2500, mana: 55, gcd: true, cooldown_ms: 0,
            description: "Rewrites whatever the AI generated last sprint. Deals heavy arcane damage. Consumes Code Smell for +35% damage.",
            effect: Damage(
                base: 95, coefficient_pct: 85,
                consume_aura: Some((aura: "code_smell", bonus_pct: 35)),
            ),
            yells: [
                "Rewriting this before it becomes load-bearing.",
                "Deleting three thousand lines of generated code. Feels great.",
                "Same behavior. Half the hallucinations.",
                "Frontend, backend, blame: I own the whole stack.",
                "Three abstraction layers for one if-statement. Not anymore.",
            ],
        ),
        (
            id: 3, name: "Guardrails", icon: "guardrails", school: Arcane,
            range_m: 30.0, cast_ms: 0, mana: 40, gcd: true, cooldown_ms: 30000,
            target: Ally, learn_level: 3,
            description: "The thing leadership calls 'slowing down innovation'. Absorbs the next 100 damage for up to 10 sec. Cast on a targeted teammate, or yourself.",
            effect: Absorb(aura: "guardrails", amount: 100, duration_ms: 10000),
            yells: [
                "Adding tests. Yes, real ones.",
                "Input validation, rate limits and a little hope.",
                "Compliance called. They want guardrails.",
                "Somebody has to think about production.",
            ],
        ),
        (
            id: 4, name: "Reject PR", icon: "reject_pr", school: Arcane,
            range_m: 25.0, cast_ms: 0, mana: 0, gcd: false, cooldown_ms: 20000,
            learn_level: 2,
            description: "No, the 4,000-line AI pull request is not 'basically done'. Interrupts spellcasting and locks arcane spells for 4 sec.",
            effect: Interrupt(lockout_ms: 4000),
            yells: [
                "Request changes.",
                "Not merging a four thousand line diff called misc fixes.",
                "Closed as won't fix. Like the strategy.",
                "No. Write it again. By hand. With intent.",
            ],
        ),
        (
            id: 6, name: "git blame", icon: "git_blame", school: Arcane,
            range_m: 30.0, cast_ms: 0, mana: 30, gcd: true, cooldown_ms: 0,
            learn_level: 4,
            description: "Finds out who wrote this. Deals arcane damage every 3 sec for 18 sec. If the target dies, the blame moves on to the nearest colleague.",
            effect: Aura(aura: "git_blame", duration_ms: 18000),
            yells: [
                "git blame says it was me. Three years ago. Under protest.",
                "Written by the AI, committed by the intern, approved by... oh no.",
                "Every line has an author. Most of them regret it.",
                "Blame isn't a culture. It's a command.",
            ],
        ),
        (
            id: 7, name: "Rollback", icon: "rollback", school: Arcane,
            range_m: 30.0, cast_ms: 0, mana: 45, gcd: true, cooldown_ms: 15000,
            target: Ally, learn_level: 5,
            description: "Back to the last version that worked. Instantly heals and removes one harmful effect. Targets a teammate if you have one selected, otherwise you.",
            effect: Heal(base: 80, coefficient_pct: 100),
            extra_effects: [Dispel(count: 1)],
            yells: [
                "Reverting to the last version that worked. It's from 2019.",
                "Ctrl+Z, but for my whole week.",
                "Rolling back. The forward fix was another prompt.",
                "Restoring from backup. Yes, I made backups. Someone had to.",
            ],
        ),
        (
            id: 8, name: "On-Call Caffeine", icon: "caffeine", school: Arcane,
            range_m: 30.0, cast_ms: 0, mana: 20, gcd: false, cooldown_ms: 90000,
            target: Ally, learn_level: 6,
            description: "The pager went off at 3 a.m. and so did you. Increases haste by 30% for 15 sec. Can be forced on a targeted teammate, which is what on-call rotations are for.",
            effect: Aura(aura: "caffeine", duration_ms: 15000),
            yells: [
                "Pager went off at 3 a.m. I have become coffee.",
                "Fourth espresso. I can hear the servers.",
                "On call, on caffeine, on the edge.",
                "Sleep is a feature we deprecated.",
            ],
        ),
        (
            id: 9, name: "Rubber Duck", icon: "rubber_duck", school: Physical,
            range_m: 20.0, cast_ms: 0, mana: 25, gcd: true, cooldown_ms: 25000,
            learn_level: 7,
            description: "Makes the target explain its own code, out loud. Stuns for 3 sec. Bosses are too important to explain anything.",
            effect: Aura(aura: "rubber_duck", duration_ms: 3000),
            yells: [
                "Explain it to the duck. Slowly. Without slides.",
                "The duck has more context than the roadmap.",
                "Even the duck asked for requirements.",
                "Quack means 'did you read the error message?'",
            ],
        ),
        (
            id: 10, name: "Postmortem", icon: "postmortem", school: Arcane,
            range_m: 30.0, cast_ms: 0, mana: 40, gcd: true, cooldown_ms: 8000,
            learn_level: 8,
            description: "A blameless review of what went wrong, written while it is still going wrong. Deals arcane damage, tripled on targets below 25% health.",
            effect: Damage(
                base: 50, coefficient_pct: 60,
                execute: Some((below_pct: 25, bonus_pct: 200)),
            ),
            yells: [
                "Root cause: a prompt. Contributing factor: also a prompt.",
                "Blameless postmortem. I'm only blaming the process. And you.",
                "Root cause: I know a little about everything, so it is my fault.",
                "Timeline: shipped Friday. Died Friday. Learned nothing.",
            ],
        ),
        (
            id: 11, name: "Write It By Hand", icon: "write_by_hand", school: Physical,
            range_m: 30.0, cast_ms: 4000, mana: 90, gcd: true, cooldown_ms: 30000,
            learn_level: 9,
            description: "No autocomplete, no agent, no suggestions. Just you and a mechanical keyboard. Deals enormous physical damage.",
            effect: Damage(base: 220, coefficient_pct: 200),
            yells: [
                "No autocomplete. No agent. Just me and a mechanical keyboard.",
                "Writing it by hand. Like a craftsman. Like a lunatic.",
                "Every character typed with intent and spite.",
                "Artisanal, hand-crafted, fully reviewed code. Behold.",
            ],
        ),
        // Off the action bar: own key (V). Co-op only: needs a dead teammate as the target.
        (
            id: 13, name: "Have You Tried Turning It Off and On Again", icon: "rack_failover", school: Arcane,
            range_m: 30.0, cast_ms: 6000, mana: 60, gcd: true, cooldown_ms: 0,
            target: DeadAlly, learn_level: 1,
            description: "Level one IT support, applied to a colleague. Brings a dead teammate back where they fell with 30% health and 20% mana. 6 sec cast, out of combat only. No ticket required.",
            effect: Resurrect(hp_pct: 30, mana_pct: 20),
            yells: [
                "Have you tried turning it off and on again?",
                "Is it plugged in? Is YOU plugged in?",
                "Rebooting colleague. Please do not unplug during the update.",
                "Closing your ticket as 'works on my machine'.",
            ],
        ),

        // ---- Frontend (melee) ----
        (
            id: 20, name: "Pixel Push", icon: "pixel_push", school: Physical,
            range_m: 5.0, cast_ms: 0, mana: 18, gcd: true, cooldown_ms: 0,
            description: "Nudges the target one pixel to the left, hard. Deals physical damage and adds a stack of Specificity (up to 5).",
            effect: Damage(
                base: 28, coefficient_pct: 50,
                apply_aura: Some((aura: "specificity", duration_ms: 20000)),
            ),
            yells: [
                "One pixel. The designer will notice. The AI never does.",
                "Moving it left. No, the other left. Shipping it.",
                "It looked fine in the Figma.",
                "Margin: -1px. Problem solved, forever, probably.",
            ],
        ),
        (
            id: 21, name: "CSS Combo", icon: "css_combo", school: Physical,
            range_m: 5.0, cast_ms: 0, mana: 28, gcd: true, cooldown_ms: 6000,
            description: "Three selectors, two pseudo-classes and a prayer. Deals physical damage and adds two stacks of Specificity.",
            effect: Damage(
                base: 40, coefficient_pct: 60,
                apply_aura: Some((aura: "specificity", duration_ms: 20000)),
            ),
            extra_effects: [Aura(aura: "specificity", duration_ms: 20000)],
            yells: [
                "div > div > div:nth-child(3) ~ span. You're welcome.",
                "Cascading. Like my sprint commitments.",
                "The AI wrote it inline. I'm writing it with spite.",
                "Flexbox in, grid out, flexbox again.",
            ],
        ),
        (
            id: 22, name: "!important", icon: "important", school: Physical,
            range_m: 5.0, cast_ms: 0, mana: 30, gcd: true, cooldown_ms: 0,
            learn_level: 2,
            description: "Overrides everything, fixes nothing. Deals physical damage, +60% per stack of Specificity it consumes.",
            effect: Damage(
                base: 30, coefficient_pct: 50,
                consume_aura: Some((aura: "specificity", bonus_pct: 60)),
            ),
            yells: [
                "!important. Like every ticket the PM files.",
                "Specificity war won. Codebase lost.",
                "When in doubt: !important. When not in doubt: also !important.",
                "Overridden. Like the design system.",
            ],
        ),
        (
            id: 23, name: "Lighthouse Audit", icon: "lighthouse_audit", school: Physical,
            range_m: 5.0, cast_ms: 0, mana: 0, gcd: false, cooldown_ms: 15000,
            learn_level: 3,
            description: "Scores the target's cast 12/100 for accessibility. Interrupts spellcasting and locks that school for 4 sec.",
            effect: Interrupt(lockout_ms: 4000),
            yells: [
                "Performance: 12. Accessibility: no.",
                "Your cast blocks the main thread.",
                "Largest Contentful Pain detected.",
                "That spell has no alt text.",
            ],
        ),
        (
            id: 24, name: "Hot Reload", icon: "hot_reload", school: Physical,
            range_m: 25.0, cast_ms: 0, mana: 15, gcd: true, cooldown_ms: 15000,
            learn_level: 4,
            description: "Saves the file and is instantly somewhere else, state lost. Dashes to the target, deals physical damage and adds a stack of Specificity.",
            effect: Charge(stop_m: 2.0),
            extra_effects: [Damage(
                base: 20, coefficient_pct: 30,
                apply_aura: Some((aura: "specificity", duration_ms: 20000)),
            )],
            yells: [
                "Saved. Reloaded. Where was I? Here. Now.",
                "Hot reload: state lost, enthusiasm intact.",
                "Webpack took four minutes. I took one second.",
                "Change detected. Me.",
            ],
        ),
        (
            id: 25, name: "Dark Mode", icon: "dark_mode", school: Physical,
            range_m: 0.0, cast_ms: 0, mana: 25, gcd: false, cooldown_ms: 20000,
            target: Caster, learn_level: 5,
            description: "Nobody can hit what they can't see on #121212, and your eyes finally rest. Heals you and reduces damage taken by 50% for 6 sec.",
            effect: Aura(aura: "dark_mode", duration_ms: 6000),
            extra_effects: [Heal(base: 90, coefficient_pct: 120)],
            yells: [
                "Switching to dark mode. My soul was already there.",
                "Contrast ratio too low to be targeted.",
                "Light mode is for people who sleep.",
            ],
        ),
        (
            id: 26, name: "Responsive Layout", icon: "responsive_layout", school: Physical,
            range_m: 0.0, cast_ms: 0, mana: 35, gcd: true, cooldown_ms: 8000,
            target: Caster, area: Some((radius_m: 6.0, allies: false)), learn_level: 6,
            description: "Breakpoints for everyone. Deals physical damage to all enemies within 6 m.",
            effect: Damage(base: 35, coefficient_pct: 45),
            yells: [
                "Mobile, tablet, desktop, smart fridge. All of you.",
                "Media query: everyone within six metres.",
                "It's responsive. It responds by hitting you.",
            ],
        ),
        (
            id: 27, name: "Infinite Scroll", icon: "infinite_scroll", school: Physical,
            range_m: 5.0, cast_ms: 0, mana: 22, gcd: true, cooldown_ms: 0,
            learn_level: 7,
            description: "The footer is a myth. Deals physical damage every 2 sec for 12 sec.",
            effect: Aura(aura: "infinite_scroll", duration_ms: 12000),
            yells: [
                "Keep scrolling. There's no footer. There never was.",
                "Engagement metrics: up. Your HP: down.",
                "Lazy-loading your suffering.",
            ],
        ),
        (
            id: 28, name: "Center the Div", icon: "center_div", school: Physical,
            range_m: 5.0, cast_ms: 0, mana: 20, gcd: true, cooldown_ms: 25000,
            learn_level: 8,
            description: "The hardest problem in computer science, solved on the target. Stuns for 3 sec. Bosses refuse to be centered.",
            effect: Aura(aura: "centered", duration_ms: 3000),
            yells: [
                "Vertically AND horizontally. Witness me.",
                "The AI suggested a table. I suggested violence.",
                "place-items: center. Hold still.",
            ],
        ),
        (
            id: 29, name: "Rewrite It in a New Framework", icon: "new_framework", school: Physical,
            range_m: 5.0, cast_ms: 0, mana: 55, gcd: true, cooldown_ms: 30000,
            learn_level: 9,
            description: "Same app, new framework, all-new bugs, released this morning. Deals enormous physical damage.",
            effect: Damage(base: 150, coefficient_pct: 150),
            yells: [
                "This framework came out today. It's already legacy.",
                "Rewriting in something with a cooler logo.",
                "Same bugs, better developer experience.",
                "npm install hope. 1,400 vulnerabilities found.",
            ],
        ),

        // ---- Backend (tank) ----
        (
            id: 30, name: "Blocking Call", icon: "blocking_call", school: Physical,
            range_m: 5.0, cast_ms: 0, mana: 15, gcd: true, cooldown_ms: 0,
            description: "Synchronous, single-threaded, and right in their face. Deals physical damage and a lot of extra threat.",
            effect: Damage(base: 25, coefficient_pct: 40),
            extra_effects: [Threat(amount: 30)],
            yells: [
                "Nothing proceeds until I return. I may not return.",
                "await you. Forever.",
                "This call blocks. So do I.",
                "Timeout set to infinity. Like this meeting.",
            ],
        ),
        (
            id: 31, name: "Rate Limiter", icon: "rate_limiter", school: Physical,
            range_m: 0.0, cast_ms: 0, mana: 30, gcd: true, cooldown_ms: 20000,
            target: Caster,
            description: "429 Too Many Requests. Absorbs the next 120 damage and reduces damage taken by 20% for up to 10 sec.",
            effect: Absorb(aura: "rate_limiter", amount: 120, duration_ms: 10000),
            yells: [
                "429. Try again later. Or never.",
                "You've exceeded your quota of hitting me.",
                "One punch per second, per IP, per lifetime.",
            ],
        ),
        (
            id: 32, name: "Who Touched Prod?", icon: "who_touched_prod", school: Physical,
            range_m: 30.0, cast_ms: 0, mana: 0, gcd: false, cooldown_ms: 8000,
            learn_level: 2,
            description: "The one question that makes everyone turn around. Forces the target to attack you, with 10% more threat than its current favourite.",
            effect: Taunt,
            yells: [
                "WHO TOUCHED PROD?",
                "Somebody deployed on a Friday. Look at me.",
                "Eyes on me. Not the intern. Me.",
                "Which one of you merged without a review?",
            ],
        ),
