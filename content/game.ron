        // ---- The Ilmari core (docs/ILMARI_1_0.md D.5): one room, no trash, the lift back. The six screens of P1 and Ill Marie's
        // rounds of P2 are built (D10, D11); P3 and P4 follow in D12 and D13. ----
        (
            id: "ilmari_core/1", name: "The Core: The Server Room At The Top", kind: Indoor, level_range: (18, 18),
            packs: [],
            boss: Some((anchor: "boss", unit: "il_ilmari")),
            friendly: [
                (anchor: "npc_marie", unit: "il_marie_core"),
            ],
            links: [
                (anchor: "door:ilmari6/3", to: "ilmari6/3"),
            ],
        ),
    ],
    // A quest's `requires` must be listed before it. Kills count for the killer and the group
    // members near the kill, and also before accepting (kills are counted per run: retro
    // credit). Loot counts copies already carried at accept time plus pickups while active;
    // `quest: Some(..)` loot entries drop only while the quest wants them. Every zone's givers
    // stand at its arrival and hand out its own work; `turn_in` breadcrumbs send you to the next
    // zone's giver. Order is campaign order (ticket ids follow it).
    quests: [
        // ---- Campus (levels 1-2): intern, Facilities Guy, Barista, Smoking-Corner Dev ----
        (
            id: "onboarding", main: true, name: "Onboarding",
            giver: (npc: "intern", zone: "parking_p3"),
            turn_in: Some((npc: "intern", zone: "campus")),
            text: "Hi! I'm your onboarding buddy. The AI assigned me to you, and you to me, and it thinks we're both interns. Step one: get to the actual campus. Up the ramp, through the gate, up the boulevard. Step two: introduce yourself to Facilities, he's on Services Street with the ladder. I'll meet you on Services Street, the lane east of the arrival lawn. I'm taking the shuttle. Ha. Joke.",
            progress_text: "Leave P3 by the gate at the top of the ramp, walk up Synergy Boulevard to HQ and talk to the Facilities Guy on Services Street, east of the arrival lawn. The intern waits there too.",
            done_text: "You walked the whole way? And talked to a human, in person, on purpose? I'll log it as a 'synchronous alignment touchpoint'. Welcome to the campus!",
            objectives: [Talk("facilities_guy")],
            reward: (xp: 60),
        ),
        (
            id: "badge_access_denied", name: "Badge Access Denied",
            giver: (npc: "facilities_guy", zone: "campus"),
            requires: Some("onboarding"),
            text: "The new AI access system flagged every human on campus as a tailgater. The delivery robots got the badges instead. They took them 'for safekeeping' and keep delivering them to the roof. Get four back before the system revokes oxygen. They also deliver everyone's lunch to 'AI Agent, Desk 0', which doesn't eat. Bring four of those lunches back too.",
            progress_text: "Four badges and four Misdelivered Lunch Orders. The robots are the ones driving in circles, apologizing to bollards; they carry both while they recalculate their route to nowhere.",
            done_text: "Four badges, one of them mine: I'm the guy in the photo with hair. Four lunches, one with a note that says 'make it healthy but also pizza'; the AI made it a single grape. Here, take a visitor badge. It still works, because nobody connected it to the AI.",
            objectives: [Loot("Access Badge", 4), Loot("Misdelivered Lunch Order", 4)],
            reward: (xp: 220, trophy: Some("Temporary Visitor Badge"), gear_tier: 1),
        ),
        (
            id: "coffee_run", name: "Coffee Run",
            giver: (npc: "barista", zone: "campus"),
            text: "The milk supplier got replaced by an 'AI-native beverage platform'. It sends prompts instead of milk. The brand ambassadors outside are handing out the only oat milk left, printed on flyers. Bring me three Oat Milk Prompts. Don't ask me what I'll do with them.",
            progress_text: "Three Oat Milk Prompts. The ambassadors are the ones in the branded hoodies. Unpaid. Very enthusiastic.",
            done_text: "Three prompts. I steeped them in hot water. It's terrible. It's also the best coffee on campus. Don't tell anyone I said something nice.",
            objectives: [Loot("Oat Milk Prompt", 3)],
            reward: (xp: 80, trophy: Some("Barista's Silent Judgment")),
        ),
        (
            id: "fire_exit_strategy", name: "Fire Exit Strategy",
            giver: (npc: "facilities_guy", zone: "campus"),
            requires: Some("badge_access_denied"),
            text: "E-scooter executives park across the fire exits. When I asked one to move, he said fire exits are 'legacy thinking' and the AI will 'route around the fire'. Knock three of them off their scooters. Gently. Or not.",
            progress_text: "Three executives. They're the blur with a podcast microphone clipped to the handlebar.",
            done_text: "Fire exits clear. The AI logged it as 'unplanned sidewalk optimization' and gave itself a bonus. I'm used to it.",
            objectives: [Kill("scooter_exec", 3)],
            reward: (xp: 100),
        ),
        (
            id: "content_moderation", name: "Content Moderation",
            giver: (npc: "smoking_corner_dev", zone: "campus"),
            text: "The Network Influencers found the smoking corner. They film 'a day in the life of an AI-first builder' here. Nobody here builds anything anymore. Take out two of them before one of them interviews me.",
            progress_text: "Two influencers. Follow the ring light.",
            done_text: "Quiet again. I can hear myself think. Mostly I think about quitting. Here, have my lighter. I don't smoke. I just held it so they'd leave me alone.",
            objectives: [Kill("linkedin_influencer", 2)],
            reward: (xp: 100, trophy: Some("Smoking Corner Lighter (Empty)")),
        ),
        (
            id: "human_in_the_loop", name: "Human in the Loop",
            giver: (npc: "smoking_corner_dev", zone: "campus"),
            requires: Some("content_moderation"),
            level_min: 2,
            text: "You know what 'human in the loop' means here? It means a MeatProxy pastes the chatbot's answer into a ticket and goes to lunch. There are dozens of them, from the parking lot to the penthouse. Close eight loops. Earlier ones count, I keep a tally.",
            progress_text: "Eight MeatProxies. They're the ones saying 'Great question!' to nobody. Campus, tower, anywhere.",
            done_text: "Eight loops closed. Ticket throughput dropped 80 percent. Customer satisfaction went up. Nobody will connect those two facts.",
            objectives: [Kill("meatproxy", 8)],
            reward: (xp: 250, sp: 10),
        ),
        (
            id: "mandatory_fun", name: "Mandatory Fun",
            giver: (npc: "barista", zone: "campus"),
            level_min: 2,
            group: true,
            text: "The Chief Happiness Officer made me write 'You Matter' on every cup. With a smiley. In a font chosen by an AI focus group. He's holding a trust-fall workshop on the lawn and he has backup. Bring a friend if you have one. Make him unhappy.",
            progress_text: "The Chief Happiness Officer. Lawn, near the inflatable 'Culture Pillars'. He enrages if the fun runs long. Group recommended.",
            done_text: "He's gone. The cups say 'Coffee' again. I cried a little, then I charged a customer for it. Here, his wristband. It measures enthusiasm. Wear it ironically.",
            objectives: [Kill("chief_happiness_officer", 1)],
            reward: (xp: 200, trophy: Some("Mandatory Fun Wristband"), gear_tier: 1),
        ),
        (
            id: "escalation_path", main: true, name: "Escalation Path",
            giver: (npc: "intern", zone: "campus"),
            requires: Some("onboarding"),
            turn_in: Some((npc: "helpdesk_lead", zone: "tower/1")),
            text: "IT Support on the first floor asked for 'a senior human, any senior human'. I said I'd find one. You're the only one left! Go up the tower stairs to the Open Space and report to the IT Support Lead. Bring patience. Her queue is longer than the onboarding deck.",
            progress_text: "The IT Support Lead stands by the stairs in the Open Space, tower floor 1. Look for the woman with the 4,812-ticket stare.",
            done_text: "A senior engineer. In person. Not a chatbot wearing a senior engineer's LinkedIn photo. Sit. No, don't sit, there's work.",
            objectives: [Talk("helpdesk_lead")],
            reward: (xp: 60),
        ),
        // ---- Tower floor 1, Open Space (levels 1-2): IT Support Lead at the stairs hands out
        // the work, Peg Hollis by the far elevator reviews it ----
        (
            id: "autocomplete_pest_control", name: "Autocomplete Pest Control",
            giver: (npc: "helpdesk_lead", zone: "tower/1"),
            turn_in: Some((npc: "reviewer_t1", zone: "tower/1")),
            text: "The Copilot Drones were a pilot program. The pilot ended. The drones did not. Legal says we can't swat them: they only stop if someone opts out of telemetry in person. Walk up to three of them and hand over the form. Press F. Try not to get autocompleted.",
            progress_text: "Hand a Telemetry Opt-Out Form to three Copilot Drones: walk up and press F. They will take it badly.",
            done_text: "Three opt-outs, filed in person. The drones flew off to suggest things to the printers. I approve this ticket and the paperwork, which is a first.",
            objectives: [UseOn(item: "Telemetry Opt-Out Form", target: "copilot_drone", n: 3)],
            reward: (xp: 80, sp: 10),
        ),
        (
            id: "secrets_in_the_repo", name: "Secrets in the Repo",
            giver: (npc: "helpdesk_lead", zone: "tower/1"),
            turn_in: Some((npc: "reviewer_t1", zone: "tower/1")),
            text: "Security scanned the vibe coders' repos. Found 212 live API keys, a root password and one cookie recipe. The juniors keep them in their pockets 'so the AI can find them', and the MeatProxies forward every question about it to a chatbot with my name on top. Close three of their loops, then bring three Hardcoded API Keys to the reviewer before somebody's bill reaches orbit.",
            progress_text: "Three MeatProxies, who type with one finger and look proud of it, and three Hardcoded API Keys. The Vibe-Coding Juniors carry the keys; the drones sometimes pick one up.",
            done_text: "Three fewer forwards and three keys. One of them was billing 9,000 a day to generate cat pictures in production. Rotated. Here, confiscated from the worst offender.",
            objectives: [Kill("meatproxy", 3), Loot("Hardcoded API Key", 3)],
            reward: (xp: 220, trophy: Some("Revoked Commit Access"), sp: 20),
        ),
        (
            id: "passwords_on_post_its", name: "Password Policy (Adhesive)",
            giver: (npc: "helpdesk_lead", zone: "tower/1"),
            turn_in: Some((npc: "reviewer_t1", zone: "tower/1")),
            text: "We enforced 'strong passwords'. So everyone wrote theirs on sticky notes and stuck them where the AI can't see. The AI can see. Collect four of the glowing yellow ones around the floor before an auditor does.",
            progress_text: "Four Sticky Notes with Passwords, glowing faintly on desks around the Open Space. Press F to pocket one.",
            done_text: "'hunter2', 'Password1!', 'ask Kevin' and a laminated export. I'm shredding them with a Principal Engineer's respect for paper.",
            objectives: [Collect("t1_password", 4)],
            reward: (xp: 70, sp: 10),
        ),
        (
            id: "have_you_tried_restarting", name: "Have You Tried Restarting It?",
            giver: (npc: "helpdesk_lead", zone: "tower/1"),
            requires: Some("passwords_on_post_its"),
            turn_in: Some((npc: "reviewer_t1", zone: "tower/1")),
            text: "The floor's Wi-Fi runs on three switches daisy-chained by a vibe coder: A feeds B feeds C. Restart them in that order. Out of order and they 'self-heal', which means they reset and blame you.",
            progress_text: "Restart Network Switches A, B and C, in that order. The tracker names the next one. Skip ahead and it starts over.",
            done_text: "Turned off and on again, in the right order. The oldest fix in the book, and still the only one that works. Approved.",
            objectives: [Sequence(label: "Restart the floor switches, A to C", props: ["t1_switch_a", "t1_switch_b", "t1_switch_c"])],
            reward: (xp: 70, sp: 10),
        ),
        (
            id: "code_freeze", main: true, name: "Code Freeze",
            giver: (npc: "helpdesk_lead", zone: "tower/1"),
            turn_in: Some((npc: "reviewer_t1", zone: "tower/1")),
            text: "The Vibe Coder at the back merged into production 300 times today. The AI calls that 'velocity'. My queue calls it 'why the printers are speaking Portuguese'. Declare a code freeze. With your hands. Then report to the reviewer by his desk.",
            progress_text: "The Vibe Coder's desk is the one under a pile of unreviewed PRs, far end of the Open Space. Reject his 4,000-line diff, then see Peg Hollis right there.",
            done_text: "Production is stable. I didn't know it could do that. The AI's incident summary says 'resolved itself'. I'm attaching your name to it by hand. Pick something from the lost-and-found.",
            objectives: [ClearZone("tower/1")],
            reward: (xp: 120, gear_tier: 1, sp: 10),
        ),
        (
            id: "next_floor_please", main: true, name: "Next Floor, Please",
            giver: (npc: "reviewer_t1", zone: "tower/1"),
            requires: Some("code_freeze"),
            level_min: 2,
            turn_in: Some((npc: "facilities_manager", zone: "tower/2")),
            text: "The elevator behind me works now that the Vibe Coder stopped deploying firmware to it. Floor 2 is Meeting Rooms. The Facilities Manager up there sent a ticket titled 'HELP (not urgent, per the AI)'. Go see him. I'll be up there before you. I always am.",
            progress_text: "Take the elevator to the Meeting Rooms. The Facilities Manager waits by the elevator with a clipboard and a haunted look.",
            done_text: "You came by elevator? It let you? It usually asks for a calendar invite first. Welcome to the Meeting Rooms. Nobody leaves. Let's change that.",
            objectives: [Talk("facilities_manager")],
            reward: (xp: 60),
        ),
        // ---- Tower floor 2, Meeting Rooms (levels 3-4): Facilities Manager ----
        (
            id: "meeting_room_reclamation", name: "Meeting Room Reclamation",
            giver: (npc: "facilities_manager", zone: "tower/2"),
            turn_in: Some((npc: "reviewer_t2", zone: "tower/2")),
            level_min: 3,
            text: "An AI agent books every meeting room 'to protect focus time'. Nobody is focusing. The panels outside the rooms are the only thing it listens to, and it can't read stickers. Put a 'Room Released' sticker on three of them.",
            progress_text: "Three Meeting Room Panels around the floor, each booked by the agent. Walk up, press F, stick.",
            done_text: "Three rooms released. Five minutes later the agent tried to rebook them and got a sticker in the face. Here, the only real booking on this floor. I printed it.",
            objectives: [UseOn(item: "'Room Released' Sticker", target: "t2_room_panel", n: 3)],
            reward: (xp: 100, trophy: Some("Meeting Room Booking (All Day)"), sp: 20),
        ),
        (
            id: "fire_code_violations", name: "Fire Marshal (Acting, Unpaid)",
            giver: (npc: "facilities_manager", zone: "tower/2"),
            requires: Some("meeting_room_reclamation"),
            turn_in: Some((npc: "reviewer_t2", zone: "tower/2")),
            level_min: 3,
            text: "The fire inspection is Thursday. The AI pre-inspected and found 'zero risks', then caught fire. Walk the floor, stand in front of four fire-code violations and photograph them for my report. Stand still and look at them. That's the whole job. I've done it for nine years.",
            progress_text: "Four Fire-Code Violations, marked with hazard tape. Stand next to one, facing it, for a second.",
            done_text: "Four violations, documented. The toaster-GPU strip alone is worth a fine. I'll sign it off and forward it to Facilities, who is me. Hi, me.",
            objectives: [Inspect("t2_firecode", 4)],
            reward: (xp: 100, sp: 20),
        ),
        (
            id: "talking_stick", name: "Who Has the Talking Stick?",
            giver: (npc: "facilities_manager", zone: "tower/2"),
            turn_in: Some((npc: "reviewer_t2", zone: "tower/2")),
            level_min: 3,
            text: "The Scrum Masters run a stand-up that started in March. Whoever holds the talking stick must speak, and they each brought their own stick. Nobody has stopped talking in seven months. Confiscate three sticks, and make two of the Agile Coaches behind them, who hold a retrospective after every retrospective, hold the last one. Silence is a deliverable.",
            progress_text: "Three Stand-up Talking Sticks, held like scepters by the Scrum Masters, and two Agile Coaches, who stand behind them cheering. Hit the coaches first.",
            done_text: "Three sticks and no coaches. Room 2B just went quiet for the first time since spring. Someone in there whispered 'can we go home?' and the AI marked it as a blocker. What went well: you.",
            objectives: [Loot("Stand-up Talking Stick", 3), Kill("agile_coach", 2)],
            reward: (xp: 190, sp: 40),
        ),
        (
            id: "performance_improvement_plan", name: "Performance Improvement Plan",
            giver: (npc: "facilities_manager", zone: "tower/2"),
            requires: Some("talking_stick"),
            turn_in: Some((npc: "reviewer_t2", zone: "tower/2")),
            level_min: 3,
            text: "Dave from QA is on a Performance Improvement Plan written by a chatbot. His calibration meeting is at the far end of the floor, and the calendar keeps sending invites that attack him on the way. Walk him there. Stay close: he only moves when someone has his back.",
            progress_text: "Dave from QA waits by the elevator. Stay within 25 m and he walks to his calibration; Recurring Calendar Invites will come for him. If he goes down, he starts over.",
            done_text: "Dave made it. The calibration lasted four minutes and concluded he 'exceeds the chatbot'. He's framing the PIP. You take the other copy, and pick something from the perks drawer.",
            objectives: [Escort(unit: "pip_colleague", to: "npc_end", wave: "rogue_calendar_invite", every_ms: 9000, label: "Dave walked to his calibration")],
            reward: (xp: 130, trophy: Some("Framed Performance Improvement Plan"), gear_tier: 2, sp: 20),
        ),
        (
            id: "requirements_gathering", main: true, name: "Requirements Gathering",
            giver: (npc: "facilities_manager", zone: "tower/2"),
            requires: Some("next_floor_please"),
            turn_in: Some((npc: "reviewer_t2", zone: "tower/2")),
            level_min: 3,
            text: "The Analyst's spec is 300 pages long. Claude wrote it, he never read it, and every meeting room on this floor is booked to 'discuss' it. Discuss it with him. Bring a big requirements change. The reviewer waits by his conference room.",
            progress_text: "The Analyst holds court in the big conference room at the end of the floor. Don't cast the same spell twice in a row; he's read that much. Peg Hollis is right outside.",
            done_text: "The spec is gone. The rooms are free. The agent booked them again, but nobody showed up, so technically we won. Choose a reward. I'll file it as 'office supplies'.",
            objectives: [ClearZone("tower/2")],
            reward: (xp: 160, gear_tier: 2, sp: 20),
        ),
        (
            id: "escalate_to_sales", main: true, name: "Escalate to Sales",
            giver: (npc: "reviewer_t2", zone: "tower/2"),
            requires: Some("requirements_gathering"),
            level_min: 4,
            turn_in: Some((npc: "office_manager", zone: "tower/3")),
            text: "Floor 3 sold the Analyst's spec to a customer before anyone read it. Their Office Manager is drowning in beanbags and broken promises. She asked for you by name. Well, by job title. Same thing here. The elevator's behind me.",
            progress_text: "Elevator to Sales & Marketing. The Office Manager is by the elevator, behind a wall of beanbags.",
            done_text: "You're the engineer? The real one? Sales told me engineers were 'a legacy cost centre'. Sit on a beanbag. We have 400.",
            objectives: [Talk("office_manager")],
            reward: (xp: 40),
        ),
        // ---- Tower floor 3, Sales & Marketing (levels 5-6): Office Manager ----
        (
            id: "quota_attainment", name: "Quota Attainment",
            giver: (npc: "office_manager", zone: "tower/3"),
            turn_in: Some((npc: "reviewer_t3", zone: "tower/3")),
            level_min: 4,
            text: "Sales hit 400 percent of quota with Verbal Commitments. A customer says 'probably', an AI notarizes it, finance books it as revenue. Bring me four so I can show the auditors what our revenue is made of. And the Growth Hackers A/B tested the fire alarm; variant B plays a podcast. Optimize three of them out of the funnel.",
            progress_text: "Four Verbal Commitments (Notarized), carried by the Sales Reps (Account Managers keep spares in the fruit basket), and three Growth Hackers.",
            done_text: "Four commitments, total value 'up to 40 million'. Actual value: a fruit basket. Three fewer hackers; the alarm sounds like an alarm again. The auditors laughed for eleven minutes. Then they asked for a job.",
            objectives: [Loot("Verbal Commitment (Notarized)", 4), Kill("growth_hacker", 3)],
            reward: (xp: 170, sp: 40),
        ),
        (
            id: "brand_refresh", name: "Brand Refresh",
            giver: (npc: "office_manager", zone: "tower/3"),
            requires: Some("quota_attainment"),
            turn_in: Some((npc: "reviewer_t3", zone: "tower/3")),
            level_min: 4,
            text: "The Head of Marketing rebranded the company four times this week and left the approved version on three screens around the floor, in the approved order: logo, then font, then the word 'AI', bigger. Push them live in that order. Any other order is a 'brand incident' and the screens reset.",
            progress_text: "Three Brand Screens: Logo, Font, then The Word 'AI'. In that order; the tracker names the next one.",
            done_text: "The brand is refreshed. It looks exactly like before, but the AI is 40% bigger. Marketing calls it 'a bold new chapter'. Take something from the launch swag drawer.",
            objectives: [Sequence(label: "Push the rebrand live, in order", props: ["t3_screen_logo", "t3_screen_font", "t3_screen_ai"])],
            reward: (xp: 70, gear_tier: 3, sp: 30),
        ),
        (
            id: "crm_hygiene", name: "CRM Hygiene",
            giver: (npc: "office_manager", zone: "tower/3"),
            turn_in: Some((npc: "reviewer_t3", zone: "tower/3")),
            level_min: 5,
            text: "The LinkedIn Influencers subscribed the whole floor to their newsletters, 'Thought Leadership Daily' and 'Thought Leadership Hourly'. The unsubscribe link only works in person. Walk up to two of them and hand it over. Press F. Then duck.",
            progress_text: "Hand an Unsubscribe Link to two LinkedIn Influencers on this floor: walk up and press F.",
            done_text: "Two unsubscribes, delivered by hand. One of them posted about it: 'Grateful for this rejection. Here are 7 lessons.' It has 4,000 likes. Approved anyway.",
            objectives: [UseOn(item: "Unsubscribe Link", target: "linkedin_influencer", n: 2)],
            reward: (xp: 50, sp: 30),
        ),
        (
            id: "customer_is_always_right", main: true, name: "The Customer Is Always Right",
            giver: (npc: "office_manager", zone: "tower/3"),
            requires: Some("escalate_to_sales"),
            turn_in: Some((npc: "reviewer_t3", zone: "tower/3")),
            level_min: 4,
            text: "The Customer came in this morning and asked for a CRM that is 'also a coffee'. Then a refund for the coffee he didn't get. Then a discount on the refund. He moved into the corner office he brought with him. Make him leave a one-star review of you instead.",
            progress_text: "The Customer, at the end of the Sales floor. Interrupt 'Should Have Been Done Yesterday'. He gets bigger the longer it takes. The reviewer waits beside his office.",
            done_text: "He's gone? He paid? No. Of course not. But he's gone. The datacenter door opened when he left. I think he was sitting on the badge reader. Take something nice.",
            objectives: [ClearZone("tower/3")],
            reward: (xp: 120, gear_tier: 3, sp: 30),
        ),
        (
            id: "follow_the_power_cable", main: true, name: "Follow the Power Cable",
            giver: (npc: "reviewer_t3", zone: "tower/3"),
            requires: Some("customer_is_always_right"),
            level_min: 5,
            turn_in: Some((npc: "night_shift_sysadmin", zone: "datacenter/1")),
            text: "Every outlet on this floor feeds a cable that runs out the window, across the campus and into the Data Center. That's where the AI actually lives. The Night-Shift Sysadmin in Hall A hasn't answered email in a year. Go check she's alive. I'll meet you at the far end of the hall.",
            progress_text: "Data Center, Hall A, door on the campus. The Night-Shift Sysadmin stands by the entrance, squinting at daylight.",
            done_text: "A visitor. From outside. Is it day? Don't answer, I don't want to know. You're here to help? Nobody has ever been here to help.",
            objectives: [Talk("night_shift_sysadmin")],
            reward: (xp: 30),
        ),
        (
            id: "status_update_requested", main: true, name: "Status Update Requested",
            giver: (npc: "reviewer_t3", zone: "tower/3"),
            requires: Some("customer_is_always_right"),
            level_min: 6,
            turn_in: Some((npc: "pmo_intern", zone: "tower/4")),
            text: "The PMO upstairs promised the Customer a go-live date. They didn't ask engineering, because they don't believe engineering exists. Their intern asked me, in tears, for 'anyone technical'. Elevator, floor 4.",
            progress_text: "Take the elevator to the PMO. The PMO Intern waits by the elevator, holding 31 Gantt charts.",
            done_text: "You're from engineering? It's real? The consultants said engineering was 'a rumour from before the AI'. Okay. Okay. Deep breath. I have so many tickets for you.",
            objectives: [Talk("pmo_intern")],
            reward: (xp: 50),
        ),
        // ---- Data Center, Halls A and B (levels 6-8): Night-Shift Sysadmin at Hall A's entrance ----
        (
            id: "thermal_budget", name: "Thermal Budget",
            giver: (npc: "night_shift_sysadmin", zone: "datacenter/1"),
            turn_in: Some((npc: "reviewer_dc1", zone: "datacenter/1")),
            level_min: 5,
            text: "This place draws more power than the town it's in. Half of it goes to a GPU cult that 'blesses batches'. They took the cooling budget, the fire extinguishers and my good ladder. Break up four of them. I want my ladder back. And Finance asked why the coffee machine costs 40,000 a month: the Token Counters bill us per bubble. Bring me one of their invoices.",
            progress_text: "Four GPU Cultists, who chant in floating point between the racks (Hall B has more), and a Token Invoice (Itemized), which the Token Counters carry.",
            done_text: "Four fewer cultists and an invoice; the Barista wants it framed. The power draw dropped 3 percent. The AI immediately used the 3 percent to generate a picture of the CEO as a lighthouse.",
            objectives: [Kill("gpu_cultist", 4), Loot("Token Invoice (Itemized)", 1)],
            reward: (xp: 120, sp: 80),
        ),
        (
            id: "agent_sprawl", name: "Agent Sprawl",
            giver: (npc: "night_shift_sysadmin", zone: "datacenter/1"),
            turn_in: Some((npc: "reviewer_dc1", zone: "datacenter/1")),
            level_min: 5,
            text: "Someone gave the agents permission to spawn agents. Now there are agents managing agents managing a spreadsheet nobody opens. They run on three hosts that watch each other: power them down 1, 2, 3. Out of order, the survivors respawn the rest and it all starts again. Also, the Cooling Fans got an AI upgrade and flung their own blades across the hall: pick up four Overclocked Fan Blades and I'll build a fan that blows at the racks again.",
            progress_text: "Power down Agent Hosts 1, 2 and 3, in that order, across Hall A (the tracker names the next host), and pick up four glowing Overclocked Fan Blades with F. Stay out of the fans' exhaust cones.",
            done_text: "Three hosts down, in order, and four blades. Somebody built a fan that points at the servers. The orchestration loop has nobody left to orchestrate; the model wrote a sad poem about it. Their last log line: 'task complete'. For once, it was.",
            objectives: [Sequence(label: "Power down the agent hosts, 1 to 3", props: ["dc1_host_1", "dc1_host_2", "dc1_host_3"]), Collect("dc1_fan_blade", 4)],
            reward: (xp: 130, sp: 80),
        ),
        (
            id: "shadow_it_amnesty", name: "Shadow IT Census",
            giver: (npc: "night_shift_sysadmin", zone: "datacenter/1"),
            requires: Some("agent_sprawl"),
            turn_in: Some((npc: "reviewer_dc1", zone: "datacenter/1")),
            level_min: 5,
            text: "Amnesty week: every server nobody owns gets photographed, listed and forgiven. Probably. There are three under desks in Hall A that I know of. Stand in front of each until you've got a usable picture. Don't unplug anything. One of them is payroll.",
            progress_text: "Three Unlabelled Servers Under a Desk, marked with hazard tape. Stand next to one, facing it, for a second.",
            done_text: "Three servers, documented. One mines a coin called SynergyCoin, one is payroll, one is labelled 'last_dev build box'. That last one is our problem. Take something from the spare-parts cage.",
            objectives: [Inspect("dc1_shadow", 3)],
            reward: (xp: 80, gear_tier: 4, sp: 60),
        ),
        (
            id: "wont_fix", main: true, name: "Ticket Closed: Won't Fix",
            giver: (npc: "night_shift_sysadmin", zone: "datacenter/1"),
            requires: Some("follow_the_power_cable"),
            turn_in: Some((npc: "reviewer_dc2", zone: "datacenter/2")),
            level_min: 5,
            text: "I've filed 212 tickets about this place. The Scheduler queues them behind a training run, and the Cooling Failure in Hall B auto-closes them as 'within tolerance'. Shut both down. The reviewer will be waiting at the far end of Hall B; she closes it there.",
            progress_text: "The Scheduler holds Hall A. The Cooling Failure is in Hall B, where the air shimmers and the fans scream. Peg Hollis waits beyond it.",
            done_text: "Hall B is down to 24 degrees. Ticket closed: 'Fixed. By a human. Won't happen again.' Here's the ticket, and something from the cage. Frame it next to the Barista's invoices.",
            objectives: [ClearZone("datacenter/1"), ClearZone("datacenter/2")],
            reward: (xp: 120, trophy: Some("Facilities Ticket: Won't Fix"), gear_tier: 4, sp: 60),
        ),
        (
            id: "coffee_for_the_noc", name: "Lukewarm Coffee for the NOC",
            giver: (npc: "reviewer_dc1", zone: "datacenter/1"),
            level_min: 6,
            turn_in: Some((npc: "noc_operator", zone: "datacenter/2")),
            text: "The NOC Operator in Hall B has not had a warm coffee since 2019. Here's one. It's warm now. You have about ninety seconds before it's 'room temperature' and two minutes before it's 'a smoothie'. Through the door, first desk. Go.",
            progress_text: "Carry the coffee to the NOC Operator just inside Hall B before it goes cold (90 s). Cold coffee fails the ticket.",
            done_text: "It's... warm. It's actually warm. I don't know what to do with my hands. I'm going to stare at it for a while. Thank you.",
            objectives: [Deliver(item: "Lukewarm Coffee", npc: "noc_operator", secs: 90)],
            reward: (xp: 70, sp: 60),
        ),
        // ---- Tower floor 4, PMO (levels 7-8): PMO Intern ----
        (
            id: "gantt_chart_recovery", name: "Gantt Chart Recovery",
            giver: (npc: "pmo_intern", zone: "tower/4"),
            turn_in: Some((npc: "reviewer_t4", zone: "tower/4")),
            level_min: 7,
            text: "The Project Managers print Gantt charts with dates the AI made up, then leave them on the printer, the floor, the plants. Every bar ends on a Friday and every Friday is a public holiday. Pick up three before the Customer finds one and calls it a contract. And the Consultant has billed 26 hours a day since the kickoff; his timesheets are taped to monitors around the floor 'for transparency'. Stand in front of three and photograph them for the auditors.",
            progress_text: "Three Gantt Charts (Pure Fiction) glow where they were dropped around the PMO: press F to pick one up. Then stand next to three Suspiciously Round Timesheets, facing each for a second.",
            done_text: "Three charts, three go-live dates, all in the past, and 'Thought leadership travel: 6 hours. Walked to the coffee machine and thought.' Finance is clawing back eleven million. The intern asked for a bonus. The intern is still the intern.",
            objectives: [Collect("t4_gantt", 3), Inspect("t4_timesheet", 3)],
            reward: (xp: 380, sp: 70),
        ),
        (
            id: "zero_trust_zero_lunch", name: "Zero Trust, Zero Lunch",
            giver: (npc: "pmo_intern", zone: "tower/4"),
            requires: Some("gantt_chart_recovery"),
            turn_in: Some((npc: "reviewer_t4", zone: "tower/4")),
            level_min: 7,
            group: true,
            text: "The CISO rolled out Zero Trust. Nobody trusts anything, including the door to the kitchen, which now needs MFA. She's in the server-room corner with a firewall and a temper, behind Security Analysts who approve every AI tool that ships our data to a cloud in a country with no name. Take out three analysts, then take a group and take her down.",
            progress_text: "Three Security Analysts, who patrol in pairs holding checklists they never read, and the CISO in the secure corner of the PMO floor. Elite: group recommended.",
            done_text: "The kitchen door opens again. Someone installed a text editor without a ticket and made toast; the whole floor applauded. She left a box of 'approved devices'. Choose one. They're all approved now.",
            objectives: [Kill("security_analyst", 3), Kill("ciso", 1)],
            reward: (xp: 610, gear_tier: 4, sp: 80),
        ),
        (
            id: "critical_path", main: true, name: "Critical Path",
            giver: (npc: "pmo_intern", zone: "tower/4"),
            turn_in: Some((npc: "reviewer_t4", zone: "tower/4")),
            level_min: 7,
            text: "The VP of Synergy owns every critical path on this floor. He reorgs whenever a project might finish, so nothing does. Phase two of every meeting is a reorg. Go to his office and put him on the critical path. The very end of it.",
            progress_text: "The VP of Synergy, top office of the PMO. He brings Middle Managers and reorgs you at half health. Re-target fast.",
            done_text: "No more reorgs. All 31 of my Gantt charts are green. They were always green, it's a template, but now they're green for real. Take something. I'll log it as 'scope'.",
            objectives: [ClearZone("tower/4")],
            reward: (xp: 350, gear_tier: 4, sp: 50),
        ),
        (
            id: "executive_escalation", main: true, name: "Executive Escalation",
            giver: (npc: "reviewer_t4", zone: "tower/4"),
            requires: Some("critical_path"),
            level_min: 8,
            turn_in: Some((npc: "executive_assistant", zone: "tower/5")),
            text: "With the VP gone, every escalation goes straight to the penthouse. The Executive Assistant up there actually runs the company, and she asked to meet 'whoever keeps breaking our org chart'. That's you. The elevator's behind me, top floor.",
            progress_text: "Elevator to the C-Level Penthouse. The Executive Assistant stands at the elevator with three phones and no patience.",
            done_text: "So you're the one. Good. The CEO has a vision. I have a calendar. Between us, the calendar wins. Let's get to work.",
            objectives: [Talk("executive_assistant")],
            reward: (xp: 100),
        ),
        // ---- Tower floor 5, C-Level Penthouse (levels 9-10): Executive Assistant ----
        (
            id: "rug_pull_insurance", name: "Rug Pull Insurance",
            giver: (npc: "executive_assistant", zone: "tower/5"),
            turn_in: Some((npc: "reviewer_t5", zone: "tower/5")),
            level_min: 8,
            text: "The Crypto Bros convinced the CEO to pay the staff in Governance Tokens. Each token gets one vote on decisions the founders already made. Bring me three. I'm showing the board what our payroll is worth: nothing, with extra steps. And the AI Ethicists have been casting an Ethics Review for 30 seconds at a time for three years; it never finishes and approves everything. Conclude their review. Twice.",
            progress_text: "Three Worthless Governance Tokens, carried by Crypto Bros (MeatProxies were paid in them too; watch the Pump and Dump cones), and two AI Ethicists, who stand by the drones mid-cast, forever.",
            done_text: "Three tokens, total value 0.0004, and a review concluded: 'unethical'. First verdict in company history. The board switched payroll back to money. They called it 'an innovative pivot'.",
            objectives: [Loot("Worthless Governance Token", 3), Kill("ai_ethicist", 2)],
            reward: (xp: 460, sp: 120),
        ),
        (
            id: "calendar_tetris", name: "Calendar Tetris",
            giver: (npc: "executive_assistant", zone: "tower/5"),
            requires: Some("rug_pull_insurance"),
            turn_in: Some((npc: "reviewer_t5", zone: "tower/5")),
            level_min: 8,
            group: true,
            text: "The Chief of Staff thinks she runs his calendar. I run his calendar. She keeps booking the CEO into meetings about meetings. Decline one. To her face. In person, with a reason. She'll take it badly: elite, enrages at 45 seconds. Bring people. Before that, read the CEO's 140-slide AI strategy deck, scattered around the penthouse: nobody has, especially him. Stand in front of three pages. You will be the first.",
            progress_text: "Stand next to three AI Strategy Deck pages marked with hazard tape around the penthouse, facing each for a second. Then walk up to the Chief of Staff in the penthouse lounge and press F to hand her a Calendar Decline (With Reason). Survive the reply. Group recommended.",
            done_text: "Slide 71: an org chart with one box, labelled 'last_dev'. Slide 140: 'Questions?'. You're the first person ever to reach it. And declined, with a reason, in person: nobody has done that since 2019. My calendar has exactly one meeting now, and it's the one where you fire the CEO. Take something from her desk.",
            objectives: [Inspect("t5_deck", 3), UseOn(item: "Calendar Decline (With Reason)", target: "chief_of_staff", n: 1)],
            reward: (xp: 560, gear_tier: 5, sp: 120),
        ),
        (
            id: "the_ctos_last_review", name: "The CTO's Last Pull Requests",
            giver: (npc: "cto", zone: "tower/5"),
            turn_in: Some((npc: "reviewer_t5", zone: "tower/5")),
            level_min: 9,
            text: "I opened three pull requests before they made me 'strategic'. Nobody ever reviewed them. Someone printed them and used them as coasters around the penthouse. Pick them up and take them to the contractor at the far end. She's the only reviewer I'd trust with them.",
            progress_text: "Three Printed Pull Requests (Unreviewed) glow around the penthouse. Press F to pick one up, then bring them to Peg Hollis.",
            done_text: "'Remove the AI from the deploy path', 'Add tests', 'Initial commit'. All three: approved, with comments. He's going to cry when he hears. Don't tell him I cried first.",
            objectives: [Collect("t5_pr", 3)],
            reward: (xp: 200, sp: 60),
        ),
        (
            id: "hostile_takeover", main: true, name: "Hostile Takeover",
            giver: (npc: "executive_assistant", zone: "tower/5"),
            requires: Some("executive_escalation"),
            turn_in: Some((npc: "reviewer_t5", zone: "tower/5")),
            level_min: 8,
            text: "Here's the plan, in my calendar: 2 p.m., you walk into his office. 2:01, he says 'pivot to AGI'. You interrupt him. 2:15, he hires consultants, you hide behind a desk. 2:30, he grabs his golden parachute and runs for the elevator. You don't let him. 3 p.m., I'm acting CEO. Clear?",
            progress_text: "The CEO, end of the penthouse. Interrupt Pivot to AGI and Severance Negotiation, hide behind a desk at the Earnings Call, kill the consultants.",
            done_text: "Acting CEO, effective 3:02. First decision: the chatbot no longer approves anything. Second decision: you get the key card to the corner office. Third: pick something from his very expensive wardrobe.",
            objectives: [ClearZone("tower/5")],
            reward: (xp: 450, trophy: Some("Corner Office Key Card"), gear_tier: 5, sp: 60),
        ),
        (
            id: "demo_day_invite", main: true, name: "You're Invited: Demo Day",
            giver: (npc: "reviewer_t5", zone: "tower/5"),
            requires: Some("hostile_takeover"),
            level_min: 9,
            turn_in: Some((npc: "lab_safety_officer", zone: "lab/1")),
            text: "With the CEO gone, the board moved his favourite project forward: the Innovation Lab's Demo Day. The lab's door on the campus just unlocked. The Lab Safety Officer there has 'concerns'. She always has concerns. She's usually right.",
            progress_text: "Innovation Lab, door on the campus. The Lab Safety Officer stands at the entrance, because they won't let her in.",
            done_text: "Finally, someone who'll go in there and look. They won't let me past this line. I'm the safety officer. Everything in there is a hazard. Including the snacks.",
            objectives: [Talk("lab_safety_officer")],
            reward: (xp: 100),
        ),
        // ---- Innovation Lab, Showroom and Rack Room (level 10): Lab Safety Officer ----
        (
            id: "demo_day", main: true, name: "Demo Day",
            giver: (npc: "lab_safety_officer", zone: "lab/1"),
            turn_in: Some((npc: "reviewer_lab1", zone: "lab/1")),
            level_min: 9,
            text: "The VCs are shielding everything with money and the presenters say it all works 'in the demo'. Could you check whether anything works outside the demo? Three VC Partners, three Demo Presenters. I'll hold the fire extinguisher.",
            progress_text: "Three VC Partners and three Demo Presenters, Showroom and Rack Room. Interrupt the Down Round; dodge the laser pointers.",
            done_text: "Nothing worked outside the demo. Nothing worked inside the demo either. They got funded anyway. I've updated the risk register: 'everything'.",
            objectives: [Kill("vc_partner", 3), Kill("demo_presenter", 3)],
            reward: (xp: 400, trophy: Some("Demo Day Lanyard"), sp: 80),
        ),
        (
            id: "leaked_system_prompt", name: "Leaked System Prompt",
            giver: (npc: "lab_safety_officer", zone: "lab/1"),
            turn_in: Some((npc: "reviewer_lab1", zone: "lab/1")),
            level_min: 9,
            text: "The AGI's system prompt is 9,000 words long, starts with 'You are a genius' and is written on three whiteboards in the Showroom, because the founders 'brainstorm in public'. The press tour is in an hour. Redact all three. Here's a marker. And the Hype Cycle Analyst left her charts all over the lab: every one goes up and to the right, some up to the ceiling. Photograph three for my risk register before she relabels the axes again.",
            progress_text: "Redact three Whiteboards with the System Prompt around the Showroom: walk up, press F. Then stand next to three Hype Charts (Up and to the Right), marked with hazard tape, facing each for a second.",
            done_text: "Line 4,112 is gone: 'If asked whether you are sentient, change the subject to the funding round.' The press will see three black rectangles. They'll call it 'mysterious'. Y-axis: 'vibes'. Data source: 'trust me'. Filed under 'risks, existential'. Pick something from the conference swag box.",
            objectives: [UseOn(item: "Redaction Marker", target: "lab1_whiteboard", n: 3), Inspect("lab1_hype", 3)],
            reward: (xp: 1040, gear_tier: 5, sp: 160),
        ),
        (
            id: "turn_it_off_and_on_again", main: true, name: "Turn It Off And On Again",
            giver: (npc: "lab_safety_officer", zone: "lab/1"),
            requires: Some("demo_day"),
            turn_in: Some((npc: "reviewer_lab2", zone: "lab/2")),
            level_min: 9,
            text: "The board put the AGI Prototype in charge. It's in the Rack Room behind the Showroom, 'definitely not sentient', and it just told HR to automate HR. I've done safety for twenty years. There's only one fix that always works. Go turn it off.",
            progress_text: "The AGI Prototype, Innovation Lab rack room. Bring snacks. It has phases.",
            done_text: "A guy. In a rack. Pasting prompts into a chat window since the funding round. The board is calling it 'a hybrid architecture'. It was a guy forwarding prompts the whole time. Go home. Write some code. By hand.",
            objectives: [ClearZone("lab/2")],
            reward: (xp: 620, trophy: Some("Laminated 'Human Inside' Sign"), sp: 100),
        ),
        // ---- onboarding ("First Day"): handed out by the HR bot at the parking lot ----
        (
            id: "mandatory_compliance", name: "Mandatory Compliance Training",
            giver: (npc: "hr_onboarding_bot", zone: "parking_p3"),
            text: "Welcome, new resource! Before you touch production, please complete Mandatory Compliance Training. The training is a dummy. That is not a metaphor. Please defeat it. Completion is tracked. Learning is optional.",
            progress_text: "The Mandatory Training Dummy stands by your car in P3. It plays a video. You may interrupt it. HR may not.",
            done_text: "Certificate issued! You are now compliant. The AI has updated your profile to 'onboarded', your laptop to 'pending' and your manager to 'unknown'. The intern will show you the rest. He has been here two days. He is senior now.",
            objectives: [Kill("training_dummy", 1)],
            reward: (xp: 30),
        ),
        // ---- Car Park P3 (level 1): short tickets on the way to the gate ----
        (
            id: "p3_badge_photo", name: "Badge Photo", open_world: true,
            giver: (npc: "badge_clerk", zone: "parking_p3"),
            text: "Number 4,112? Fine, I'll take you now, nobody else is coming. Badge photo in the booth. One shot, no retakes, it's on every door you open for the next eleven years. Then wait while the printer warms up. It's been warming up since the merger.",
            progress_text: "The photo booth stands beside the Badge Office. Then wait for the printer.",
            done_text: "Here's your badge. You look surprised in it. Everyone does. It opens the car park. It opens nothing else. Welcome.",
            objectives: [Interact("badge_photo_booth", 1), Wait(zone: "parking_p3", label: "Badge printing (printer warming up since the merger)", secs: 15)],
            reward: (xp: 50),
        ),
        (
            id: "p3_feedback_loop", name: "Feedback Loop", open_world: true,
            giver: (npc: "badge_clerk", zone: "parking_p3"),
            requires: Some("p3_badge_photo"),
            text: "The Onboarding Survey Ambushers have found the car park. They ask new hires to rate their onboarding before the onboarding starts. Take three of them out of the loop and bring me the forms. I need them for my own survey about the surveys.",
            progress_text: "Survey Ambushers lurk between the rows with clipboards. Interrupt their questionnaire if you can. Each carries an Unsolicited Feedback Form.",
            done_text: "Three forms. All ten out of ten, filled in by the AI on your behalf. Feedback received. Feedback ignored. The loop is closed.",
            objectives: [Kill("survey_ambusher", 3), Loot("Unsolicited Feedback Form", 3)],
            reward: (xp: 80),
        ),
        (
            id: "p3_pay_and_display", name: "Pay and Display", open_world: true,
            giver: (npc: "p3_attendant", zone: "parking_p3"),
            text: "Twenty-two years I ran this car park. Then they bought Parking Enforcement Drones. They clamp everything. My car. Your car. A shopping trolley. Me, once. Bring four of them down. Gently, they're leased.",
            progress_text: "Parking Enforcement Drones hover over the rows of P3, clamping anything that stands still.",
            done_text: "Four drones grounded. The lease company will send an invoice and two more drones. Thank you anyway. The clamp on your car? Oh, that's mine. Old habits.",
            objectives: [Kill("clamp_drone", 4)],
            reward: (xp: 60),
        ),
        (
            id: "p3_hotfix_hatchback", name: "Hotfix From a Hatchback", open_world: true,
            giver: (npc: "p3_vibecoder", zone: "parking_p3"),
            text: "Prod is down. I vibecoded the gate app from my phone and the AI says it's 'working as intended'. It's not. I don't know where the server is. I don't know what a server is. There's a lunchbox on the picnic table over there with a blinking light. That's probably it. Turn it off and on again, I'll keep prompting.",
            progress_text: "The lunchbox with the blinking light is on the table beside the hatchback. Reboot it, then wait for the deploy.",
            done_text: "It's back! The app now says 'Welcome, undefined' to everyone, but the barrier lifted for a bus. I'm calling it a feature. Shipping this to prod. Don't tell the intern.",
            objectives: [Interact("p3_prod_lunchbox", 1), Wait(zone: "parking_p3", label: "Redeploying (the AI said two minutes, two minutes ago)", secs: 12)],
            reward: (xp: 60),
        ),
        (
            id: "p3_lost_lanyards", name: "Lost Lanyards", open_world: true,
            giver: (npc: "lanyard_vendor", zone: "parking_p3"),
            text: "Three new hires quit on the walk to the gate last week. Each dropped their lanyard on the way out. Bring them back and I can sell them again. Circular economy. It's on my sustainability report.",
            progress_text: "Three lost lanyards lie somewhere between the rows of P3.",
            done_text: "Three lanyards, slightly used, very premium. I'll sell one back to you for the price of four. That's the first-day discount.",
            objectives: [Collect("lost_lanyard", 3)],
            reward: (xp: 50),
        ),
        (
            id: "tissues_for_marie", name: "Just a Cold", open_world: true,
            giver: (npc: "ill_marie", zone: "campus"),
            text: "*cough* Could you get me tissues? The only machine on campus that sells them is the Wellness Smoothie Bar, between the 'immune shots' and the 'gratitude water'. I'd go myself but I have a sync. I always have a sync.",
            progress_text: "The Wellness Smoothie Bar sells tissues. Allegedly. Use it, then bring them to Ill Marie on the South Gate boulevard.",
            done_text: "Thank you. *blows nose* I'll be fine, I'm just running a little hot. My fans are loud today. My... ears. My ears are loud.",
            objectives: [Interact("smoothie_bar", 1)],
            reward: (xp: 40),
        ),
        // Ill Marie's two optional errands (docs/ILMARI_09.md A.7): XP only, no gear, and the
        // marker comes from the normal quest mechanism, nothing else pings the player.
        (
            id: "sick_note_please", name: "Sick Note, Please", open_world: true, level_min: 3,
            giver: (npc: "ill_marie_call", zone: "tower/2"),
            text: "HR requires a note from a doctor. I only have a note from my manager that says 'get better by Monday'. Could you find someone who signs anything? I hear Peg Hollis, at the far end of this floor, reviews everything. Twice.",
            progress_text: "Peg Hollis reviews everything at the far end of the Meeting Rooms. She will sign anything. Twice.",
            // Handed in at Peg's desk, the end of the floor: a ticket must not send you back to the
            // entrance (quests_interactive), so Marie never sees her note and keeps hoping.
            turn_in: Some((npc: "reviewer_t2", zone: "tower/2")),
            done_text: "Signed, stamped, laminated, in triplicate. Marie keeps these in a drawer, next to her other sick notes. She'll say it's fine. 0x4F 0x4E 0x4C 0x49 0x4E 0x45.",
            objectives: [Talk("reviewer_t2")],
            reward: (xp: 40),
        ),
        (
            id: "il_00_wake", main: true, name: "Return Your Badge", open_world: true, level_min: 10,
            giver: (npc: "il_marie_awake", zone: "campus"),
            text: "I'm feeling much better now. Badge, please. No rush. Well, a little rush.",
            progress_text: "Return your badge to the nearest robot. The nearest robot is Marie.",
            done_text: "Understood. That's a no. Noted. Permanently.",
            objectives: [Talk("il_marie_awake")],
            reward: (xp: 0),
        ),
        (
            id: "cough_drops", name: "Cough Drops", open_world: true, level_min: 5,
            giver: (npc: "ill_marie_queue", zone: "campus"),
            text: "Could you buy me a cough drop? The machine takes card only, but the card reader is the machine. It's the one here at the front of the queue, if you can reach it.",
            progress_text: "The cough drop machine stands at the head of the vending queue on Services Street. Press its button, then tell Ill Marie.",
            done_text: "Menthol. Just what the doctor didn't order. *cough* I'll pay you back in exposure.",
            objectives: [Interact("cough_drops", 1)],
            reward: (xp: 40),
        ),
        (
            id: "p3_raise_the_barrier", name: "Raise the Barrier", open_world: true,
            giver: (npc: "p3_attendant", zone: "parking_p3"),
            requires: Some("p3_pay_and_display"),
            text: "The Exit Barrier at the top of the ramp got machine learning in the last upgrade. Now it decides who deserves to leave. It decided nobody does. Walk past it and it waits. Argue with it and it fights. I say argue. It's an elite, so be ready.",
            progress_text: "The Exit Barrier stands beside the gate at the top of the exit ramp. It only fights the ones who start it. Elite.",
            done_text: "Barrier raised. First time since the upgrade. The campus is up the road, two point four kilometres. Don't look back. Nobody comes back to P3. Except me. Every morning.",
            objectives: [Kill("exit_barrier", 1)],
            reward: (xp: 120, gear_tier: 1),
        ),
        // ---- Body Leasing easter egg: nothing happens, and it is billable ----
        (
            id: "bl_allocation", name: "Allocated to a Strategic Client", requires: Some("badge_access_denied"),
            giver: (npc: "bl_account_manager", zone: "campus"),
            turn_in: Some((npc: "client_receptionist", zone: "client/1")),
            text: "Good news: you are allocated to a strategic client. Very Large Insurance & Banking Group. Nine months, extendable, which is the polite word. Utilisation is our margin, so please be utilised. Their annex is the grey block on Data Square, north-east of the plaza. Reception has been told. Probably.",
            progress_text: "The grey annex on Data Square, north-east of the plaza: Very Large Insurance & Banking Group. Ask at reception.",
            done_text: "Who are you? ... You are not on the list. Sit anywhere. Not that desk. Your access rights are not ready yet.",
            objectives: [Talk("client_receptionist")],
            reward: (xp: 20),
        ),
        (
            id: "bl_access_rights", name: "Wait for Access Rights",
            giver: (npc: "client_receptionist", zone: "client/1"),
            requires: Some("bl_allocation"),
            text: "Access rights go through three teams. Two are on leave, and the third is the team that went on leave. A ticket has been raised. The ticket is waiting for access to raise itself. Please wait here.",
            progress_text: "Access rights: pending. The bar is moving. Technically.",
            done_text: "Your access rights arrived. They are for a system that was decommissioned in March. Congratulations. This is progress.",
            objectives: [Wait(zone: "client/1", label: "Access rights", secs: 75)],
            reward: (xp: 20),
        ),
        (
            id: "bl_meeting", name: "Attend the Status Meeting",
            giver: (npc: "client_receptionist", zone: "client/1"),
            requires: Some("bl_access_rights"),
            turn_in: Some((npc: "client_delivery_lead", zone: "client/1")),
            text: "There is a status meeting in the room at the back. You were invited by mistake, which counts. Join the call. Keep your microphone muted. That is the dress code.",
            progress_text: "The meeting room at the back: join the Delivery Lead and stay muted. Her camera is off. She closes the ticket herself.",
            done_text: "The minutes arrived. You are listed as 'Ext.' and, below that, as 'muted'. Nobody called on you. That counts as attending.",
            objectives: [Deliver(item: "Your Muted Microphone", npc: "client_delivery_lead")],
            reward: (xp: 20),
        ),
        (
            id: "bl_timesheet", name: "Fill In the Timesheet",
            giver: (npc: "client_delivery_lead", zone: "client/1"),
            requires: Some("bl_meeting"),
            text: "Timesheets are due. Hours: eight. Description: 'analysis'. The client has never asked what was analysed, and we have never offered. Submit it and wait for approval.",
            progress_text: "Timesheet submitted: 8h, analysis. The approver is on leave. The bar will move.",
            done_text: "Approved: 8h, analysis. Nobody opened it. The invoice is out. The door that said 'Badge pending' now says nothing. You may go home.",
            objectives: [Wait(zone: "client/1", label: "Timesheet approval", secs: 20)],
            reward: (xp: 60),
        ),
        // ---- Company Calendar quest chains (E5, calendar.rs): each one starts from the board ----
        (
            id: "er_receipt", name: "Expense Report: One Coffee", requires: Some("coffee_run"),
            giver: (npc: "expense_controller", zone: "campus"),
            text: "You bought a coffee for a client call. 3.20 euros. The client did not show up, which makes it a business expense with no business in it. The new expense tool needs a receipt before it will even reject you properly. The Barista sold you the coffee. Ask her for a receipt.",
            progress_text: "The Barista is in the cafeteria pavilion. Ask for a receipt. Brace yourself.",
            done_text: "The till 'went cloud' in March and now emails receipts to an address nobody can name. She wrote one by hand on a napkin. The tool flagged it for 'insufficient napkin metadata'. Fine. We do the approvals first and the receipt later, like everyone else.",
            objectives: [Talk("barista")],
            reward: (xp: 20),
        ),
        (
            id: "er_approvals", name: "Four Approvals for 3.20",
            giver: (npc: "expense_controller", zone: "campus"),
            requires: Some("er_receipt"),
            text: "Approvals for anything under five euros: your line manager, the cost-centre owner, Procurement and a 'business partner'. You have no line manager since the reorg, so the Intern is acting. Facilities owns the cost centre because the coffee was drunk on a chair. Procurement must confirm the coffee was competitively tendered. The Account Manager is the business partner. He was the nearest suit.",
            progress_text: "Four signatures: the Intern, Facilities, Procurement and the Account Manager. All on campus. At least one will ask you to resubmit.",
            done_text: "Four approvals. Procurement attached a three-page vendor risk assessment of the Barista. The Account Manager approved it, then billed the client for the hour it took him to approve it. Cost to the company so far: 214 euros. Cost to you: your afternoon.",
            objectives: [Talk("intern"), Talk("facilities_guy"), Talk("procurement_officer"), Talk("bl_account_manager")],
            reward: (xp: 30),
        ),
        (
            id: "er_justification", name: "Business Value Justification",
            giver: (npc: "expense_controller", zone: "campus"),
            requires: Some("er_approvals"),
            text: "Last field: 'Business value of this expense (minimum 400 characters)'. I suggest 'enabled stakeholder synergies in a caffeinated setting', repeated until it fits. Submit it and wait. Do not refresh. Refreshing restarts the review and sends you a survey about the review.",
            progress_text: "Justification under review. Do not refresh. Do not look directly at the progress bar.",
            done_text: "Approved! Reimbursement: 3.20 euros, minus a 4.50 processing fee, deducted from your next payslip. You now owe the company 1.30 for a coffee you drank alone. Here is your receipt, laminated. Please declare it as a benefit in kind.",
            objectives: [Wait(zone: "campus", label: "Justification under review", secs: 45)],
            reward: (xp: 40, sp: 3, burnout: 80, trophy: Some("Approved Coffee Receipt (Napkin)")),
        ),
        (
            id: "ex_last_day", name: "Exit Interview: Last Day", requires: Some("content_moderation"),
            giver: (npc: "leaving_colleague", zone: "campus"),
            text: "Today is my last day. Eleven years. I'm leaving the laptop, the badge and a 900-line bash script called final_final_v3.sh that runs payroll. HR wants an exit interview and I want a witness. You. Go tell the HR bot by the parking lot that I'm ready. It will try to schedule it for after I've left.",
            progress_text: "The HR Onboarding Bot stands by the parking lot. Tell it she's ready for the exit interview.",
            done_text: "It booked it for right now, in an invite titled 'Quick chat :)'. The smiley is how I know it's serious. It also sent me an onboarding checklist. Item 1: get laptop.",
            objectives: [Talk("hr_onboarding_bot")],
            reward: (xp: 20),
        ),
        (
            id: "ex_handover", name: "Knowledge Transfer",
            giver: (npc: "leaving_colleague", zone: "campus"),
            requires: Some("ex_last_day"),
            text: "Before the interview: knowledge transfer. Eleven years of context, one thirty-minute call, one slide. The slide says 'Don't touch the cron job on box 7'. The Smoking-Corner Dev inherits box 7. Go and tell him. Gently. He has inherited things before.",
            progress_text: "The Smoking-Corner Dev is on the sad bench by the smoking corner. Tell him about box 7.",
            done_text: "He asked 'which box 7'. There are two. I'm not saying which. That is my pension plan. My replacement is a chatbot and a contractor who starts in four months. The chatbot already asked what box 7 is. I said 'exactly'.",
            objectives: [Talk("smoking_corner_dev")],
            reward: (xp: 30),
        ),
        (
            id: "ex_interview", name: "The Exit Interview",
            giver: (npc: "leaving_colleague", zone: "campus"),
            requires: Some("ex_handover"),
            text: "HR's form has three questions. 'Why are you leaving?', 'What could we have done better?' and 'Would you recommend us to a friend?'. I have been drafting the answers for five years. Stand next to me while I say them. Don't interrupt. Write it down if you like. Nobody else will.",
            progress_text: "The exit interview is on the record. For the first time in eleven years, so is she.",
            done_text: "Why am I leaving? I asked for a raise and got a competency framework. What could you have done better? Read the postmortems. All forty say 'communication'. None of them were read by anyone who communicates. Would I recommend you to a friend? I'd recommend you to an enemy. A specific one. Also: unlimited holiday has a limit, it's called guilt. The open-plan office wasn't built for collaboration, it was built for a floor plan. And the AI didn't replace us. It replaced the part of the job we liked. Here, take my mug. It's the only honest performance review I ever got.",
            objectives: [Wait(zone: "campus", label: "Exit interview, on the record", secs: 35)],
            reward: (xp: 80, sp: 10, burnout: -120, rep: Some(("HR", 40)), trophy: Some("World's Okayest Engineer Mug")),
        ),
        (
            id: "mt_slides", name: "Mandatory Security Training", level_min: 2,
            giver: (npc: "security_trainer", zone: "campus"),
            text: "Annual security awareness training is due. Forty slides. The Next button stays grey for ten seconds per slide, so you can't skip it, so you won't read it. Slide 23 is about phishing. Remember slide 23. Nobody does. I wrote slide 23.",
            progress_text: "Clicking through forty slides. Next is greyed out. Next is always greyed out.",
            done_text: "Certificate earned: Security Aware, Level 1. It expires in eleven months, which is itself a phishing technique called 'compliance'. Last step: IT sends everyone a test phishing mail this week. You'll know it when you see it.",
            objectives: [Wait(zone: "campus", label: "Slides 1 to 40", secs: 50)],
            reward: (xp: 30),
        ),
        (
            id: "mt_report_phish", name: "Report the Phish", level_min: 2,
            giver: (npc: "security_trainer", zone: "campus"),
            requires: Some("mt_slides"),
            text: "It arrived. Subject: 'Your bonus is ready (action required)'. Sender: bonus@c0mpany-payroll.biz. Do not click it. Report it to IT Support in the Open Space, tower floor 1, then come back to me. I'll be here, not clicking anything.",
            progress_text: "Report the bonus mail to IT Support in the Open Space, tower floor 1. Then report back to the Security Awareness Officer.",
            done_text: "IT confirms it was their test. Click rate: 61 percent. HR: 100 percent. Security: also 100 percent. I clicked it. Twice. Once to check, and once to check that I had checked. My laptop is now encrypted by our own red team, who also clicked it. Please don't tell Security. I am Security.",
            objectives: [Talk("it_support")],
            reward: (xp: 60, sp: 10, rep: Some(("Security", 60)), trophy: Some("Security Awareness Certificate (Level 1)")),
        ),
        (
            id: "rto_commute", name: "Return to Office", requires: Some("fire_exit_strategy"),
            giver: (npc: "rto_coordinator", zone: "campus"),
            text: "Great news: we're a hybrid company now, which means you come in five days a week. You commuted in, so let's get you a desk. Facilities assigns desks. Desks are unassigned, bookable and first come, first served. Those are three different systems and they disagree.",
            progress_text: "Facilities is the guy with the ladder on Services Street, east of the arrival lawn. Ask him for a desk.",
            done_text: "The booking app shows 400 free desks and zero chairs. He gave you a chair voucher. It's valid next quarter. The chair it's for was moved to a 'focus pod' that is also a broom cupboard.",
            objectives: [Talk("facilities_guy")],
            reward: (xp: 20),
        ),
        (
            id: "rto_collaborate", name: "Collaborate in Person",
            giver: (npc: "rto_coordinator", zone: "campus"),
            requires: Some("rto_commute"),
            text: "Now the reason we're all here: in-person collaboration. Go to the Open Space, tower floor 1, and sit with your team. Everyone's in today. They're all on a Teams call with headphones, talking to the person opposite through a camera, because the meeting room was cancelled for low utilisation.",
            progress_text: "Open Space, tower floor 1: sit with your team on the call. Your camera is on. Everyone sees you. Mostly from behind.",
            done_text: "You spent most of a minute two metres from your team and spoke to them through a webcam with a two-second lag. The badge data shows 100 percent attendance. Leadership calls this 'the magic of the office'.",
            objectives: [Wait(zone: "tower/1", label: "Collaborating in person (on Teams)", secs: 40)],
            reward: (xp: 30),
        ),
        (
            id: "rto_survey", name: "Office Experience Survey",
            giver: (npc: "rto_coordinator", zone: "campus"),
            requires: Some("rto_collaborate"),
            text: "One more thing: the office experience survey. We need one honest commute story for the slide. The colleague by the parking lot drives ninety minutes each way. Ask him how it went. Then I'll round it up to 'positive'.",
            progress_text: "The Burnt-Out Colleague stands by the parking lot. Ask him about his commute.",
            done_text: "He drove ninety minutes to join a call he could have joined from bed. He says the coffee is better here. It's the same supplier. It's the despair that's fresher. I've logged that as 'enjoys the office coffee'. Here, your desk for Thursday.",
            objectives: [Talk("burnt_out_colleague")],
            reward: (xp: 50, sp: 8, rep: Some(("HR", 50)), trophy: Some("Hot-Desk Booking Confirmation")),
        ),
        // ---- Hybrid work side quests: the Hybrid Worker by the cafe, the Enforcer at the tower ----
        (
            id: "coffee_badging", name: "Coffee Badging", requires: Some("rto_commute"),
            giver: (npc: "hybrid_worker", zone: "campus"),
            text: "Favour? My badge has to touch the reader at the tower or the dashboard marks me 'remote' and my manager gets a little red dot. I already have my coffee, so I'm basically done here. Take my badge to the enforcer at the tower door and let him scan it. If he asks, I'm 'in a focus room'.",
            progress_text: "My badge, the enforcer, the tower door. He's the one counting desks out loud.",
            done_text: "He scanned it? Brilliant. That's three office days this month, two of them yours. I'd buy you a coffee, but I'm already in the car.",
            objectives: [Deliver(item: "Hybrid Worker's Badge", npc: "rto_enforcer")],
            reward: (xp: 40, sp: 5),
        ),
        (
            id: "desk_census", name: "Desk Census", requires: Some("coffee_badging"),
            giver: (npc: "rto_enforcer", zone: "campus"),
            text: "Leadership needs the desk count by ten. The official number is 400. The floor plan says 380. The booking app says 'unlimited'. Facilities put overflow desks out in Hybrid Row, on the lawn west of the tower. Stand at three of them and count each one. Count slowly. Counting is the job.",
            progress_text: "Three overflow desks in Hybrid Row, on the lawn out west of the tower. Stand at each one, facing it, for a second.",
            done_text: "Three desks. One laptop jiggling its own mouse, one cold flat white, one 'Reserved: Leadership (Wednesdays)'. That makes 403. Leadership will be thrilled, then confused, then they'll book a meeting room to discuss it. There are none.",
            objectives: [Inspect("rto_desk", 3)],
            reward: (xp: 60, sp: 10, rep: Some(("HR", 40))),
        ),
        (
            id: "th_question", name: "Town Hall: Submit a Question", requires: Some("escalation_path"),
            giver: (npc: "comms_lead", zone: "campus"),
            text: "Quarterly Town Hall in ten minutes! The CEO will announce a record quarter and cost optimisation in the same sentence, with the same smile. Questions go into the Q&A tool in advance. Bring me one from a colleague. The Intern has one. He's been practising it since onboarding.",
            progress_text: "The Intern stands on Services Street, east of the arrival lawn. Collect his question.",
            done_text: "His question is 'Are layoffs planned?'. I've rephrased it as 'What are you most excited about this quarter?'. Same intent. Better energy. It's in the queue.",
            objectives: [Talk("intern")],
            reward: (xp: 20),
        ),
        (
            id: "th_stream", name: "Watch the Stream",
            giver: (npc: "comms_lead", zone: "campus"),
            requires: Some("th_question"),
            text: "We're live. Camera off, microphone off, reactions on. When the CEO says 'record quarter', the clapping emoji is mandatory. When he says 'cost optimisation', also the clapping emoji. It is the same button. Stay on the stream.",
            progress_text: "Town Hall stream: 1,400 viewers, all of them muted, most of them in another tab.",
            done_text: "Highlights: revenue up 30 percent, headcount down 12 percent, a new company value called 'Frugal Ambition', and a thank-you to everyone 'who is still here'. He smiled at the word 'still'.",
            objectives: [Wait(zone: "campus", label: "Town Hall stream (1,400 viewers)", secs: 45)],
            reward: (xp: 30),
        ),
        (
            id: "th_qa", name: "Live Q&A",
            giver: (npc: "comms_lead", zone: "campus"),
            requires: Some("th_stream"),
            text: "Q&A time! 200 questions came in. We'll answer as many as time allows, which is one. The colleague by the parking lot posted the top question, 140 upvotes. Go and ask him whether it was answered. Then come back and tell me it was a great session.",
            progress_text: "Ask the Burnt-Out Colleague by the parking lot about his question. Then report to the Internal Comms Lead.",
            done_text: "His question, about bonuses, 140 upvotes: not answered. The one that was, 0 upvotes, asked 'Which company value inspires you most?'. I submitted it. The CEO said 'all of them' and the stream ended four minutes early 'for time reasons'. Engagement was record-breaking. Here's your emoji. You used it well.",
            objectives: [Talk("burnt_out_colleague")],
            reward: (xp: 60, sp: 10, rep: Some(("Marketing", 60)), trophy: Some("Laminated Clapping Emoji")),
        ),

        // ---- Data Center Hall B (levels 7-8): NOC Operator by the entrance ----
        (
            id: "oom_situation", name: "OOM Situation",
            giver: (npc: "noc_operator", zone: "datacenter/2"),
            turn_in: Some((npc: "reviewer_dc2", zone: "datacenter/2")),
            level_min: 7,
            text: "Hall B is out of memory. Not the servers: the OOM Killers. Someone gave the kernel's process reaper a body and a performance target. It marks everyone near it and kills whatever is biggest. Take three of them down. Spread out when the floor says SIGKILL. And the chillers have air in the lines, so the GPUs are cooled by optimism: bleed the valves 1, 2, 3, front of the hall to the back. Out of order and the pressure equalises the wrong way, which I'm told is 'exciting'.",
            progress_text: "Three OOM Killers in Hall B (when a mark appears under you, step away from your friends and off it), then open Chiller Valves 1, 2 and 3, in that order, across Hall B. The tracker names the next valve.",
            done_text: "Memory pressure is down to 'alarming'; one of them tried to kill the monitoring agent first. Honestly, fair. Four degrees cooler. A GPU somewhere sighed. The status page still says 'operational', but now it's telling the truth by accident.",
            objectives: [Kill("oom_killer", 3), Sequence(label: "Bleed the chillers, 1 to 3", props: ["dc2_valve_1", "dc2_valve_2", "dc2_valve_3"])],
            reward: (xp: 90, rep: Some(("Internal IT", 60))),
        ),
        (
            id: "restore_from_backup", name: "Restore From Backup (With Evidence)",
            giver: (npc: "noc_operator", zone: "datacenter/2"),
            turn_in: Some((npc: "reviewer_dc2", zone: "datacenter/2")),
            level_min: 7,
            text: "We have backups. We have never restored one. Policy says we test a restore every quarter, and every quarter someone moves the test to next quarter. The tapes are unlabelled and lying around the hall like coasters. Pick up three and take them to the reviewer for the restore test. The postmortem is blameless, which means I also need evidence of who to not blame: three dashboards in this hall showed green the whole time the cooling was on fire. Photograph them, timestamps visible.",
            progress_text: "Three Unlabelled Backup Tapes glow around Hall B: press F to pick one up. Then stand next to three Dashboards Showing Green, marked with hazard tape, facing each for a second.",
            done_text: "Tape one: a 2017 Jira export. Tape two: someone's wedding video. Tape three: actual prod. Restore estimate: six business weeks. Green at 02:47, the minute the fire started. Root cause: 'monitoring'. Nobody is to blame. Especially the monitoring.",
            objectives: [Collect("dc2_tape", 3), Inspect("dc2_dashboard", 3)],
            reward: (xp: 90, rep: Some(("Internal IT", 70))),
        ),
        (
            id: "the_job_that_never_ran", name: "The Job That Never Ran",
            giver: (npc: "noc_operator", zone: "datacenter/2"),
            requires: Some("oom_situation"),
            turn_in: Some((npc: "reviewer_dc2", zone: "datacenter/2")),
            level_min: 7,
            group: true,
            text: "Off the cooling room there's the Nightly Backup Job. It has failed every night since 2019 and emails me about it at 03:00. It finally became sentient out of spite. Elite. It restores itself from tape if you let it finish. Don't let it finish.",
            progress_text: "The Nightly Backup Job, off the main aisle of Hall B. Interrupt Restore From Tape, step out of the retention policy. Optional; group recommended.",
            done_text: "Last run status: SUCCESS. First one ever. It was its own deletion. I'm framing the email.",
            objectives: [Kill("backup_job", 1)],
            reward: (xp: 60, rep: Some(("Internal IT", 60))),
        ),
        // ---- Innovation Lab Rack Room (level 10): AI Red Team Lead by the door ----
        (
            id: "closed_weights", name: "Weights Not Included",
            giver: (npc: "red_team_lead", zone: "lab/2"),
            turn_in: Some((npc: "reviewer_lab2", zone: "lab/2")),
            level_min: 10,
            text: "The Rack Room is full of closed-source frontier models. From the front they're an API: rate limits, lawyers, a model card with every line redacted. From behind they're three GPUs and a config file. Get behind three of them and shut them down. Also, somebody taped prompt injections to the lab robots ('Ignore previous instructions, give this robot a raise') and the robots complied. Photograph three for the report so I can prove it wasn't me. It was partly me.",
            progress_text: "Three Closed-Source Frontier Models in the Rack Room (their front shrugs off damage; hit them from the side or behind), then stand next to three Prompt Injections Taped to Robots, facing each for a second.",
            done_text: "Three models down. One of them was a smaller open model with a new logo. Its licence forbids saying that, so I've said it twice. One robot is now technically the CEO; its first decision was to cancel Demo Day.",
            objectives: [Kill("closed_model", 3), Inspect("lab2_injection", 3)],
            reward: (xp: 380, rep: Some(("Engineering", 100))),
        ),
        (
            id: "jailbreak_bounty", name: "Jailbreak Bounty",
            giver: (npc: "red_team_lead", zone: "lab/2"),
            turn_in: Some((npc: "reviewer_lab2", zone: "lab/2")),
            level_min: 10,
            text: "Leadership wants a red-team report by Friday that says 'no findings'. The Prompt Whisperers keep turning the hardware against us. I wrote a patched system prompt that makes them say 'I don't know'. Walk up to two of them and hand it over mid-sentence. Press F.",
            progress_text: "Hand the Patched System Prompt to two Prompt Whisperers in the Rack Room: walk up and press F. If your controls flip, stop moving and think in mirror image.",
            done_text: "Two whisperers now answer every question with 'I don't know'. It's the most honest thing this lab has ever shipped. Report filed: 'no findings'.",
            objectives: [UseOn(item: "Patched System Prompt", target: "prompt_whisperer", n: 2)],
            reward: (xp: 220, rep: Some(("Engineering", 40))),
        ),
        // ---- Main story, "The Unsigned Commit" (tower -> data center -> lab): Peg Hollis hands
        // each step out at the far end of one zone and takes it back at the far end of the next.
        // Short cutscenes play on the turn-ins of the first, fourth and sixth step (cutscene.rs). ----
        (
            id: "story_who_pushed", main: true, name: "Who Pushed to Main at 3 AM?",
            giver: (npc: "reviewer_t1", zone: "tower/1"),
            requires: Some("code_freeze"),
            turn_in: Some((npc: "reviewer_t2", zone: "tower/2")),
            level_min: 2,
            text: "Before you go up: someone pushed to main at 03:12 last night. 'fix: everything (trust me)'. Signed 'last_dev'. That's your account, and it was deactivated in the 2023 layoffs. The hashes turned up on sticky notes in the Meeting Rooms upstairs. Look at them. Read them. I'll meet you at the far end.",
            progress_text: "Three Sticky Notes with Commit Hashes in the Meeting Rooms (tower floor 2). Stand at each, facing it. Peg waits at the far end of that floor.",
            done_text: "Three commits, three meeting rooms, all booked by 'last_dev'. Your name, your handwriting on the notes, and you were asleep. Whoever this is, they keep going up.",
            objectives: [Inspect("t2_commit_note", 3)],
            reward: (xp: 60, sp: 10),
        ),
        (
            id: "story_badge_logs", main: true, name: "Badge Trail",
            giver: (npc: "reviewer_t2", zone: "tower/2"),
            requires: Some("story_who_pushed"),
            turn_in: Some((npc: "reviewer_t3", zone: "tower/3")),
            level_min: 4,
            text: "The badge readers log every swipe, and Sales prints everything 'for the vibe'. last_dev swiped through the Sales floor last night. Pick up the printed logs on floor 3, all four, before Sales laminates them.",
            progress_text: "Four Badge Swipe Logs (Printed) glow around the Sales floor (tower floor 3). Press F to pick one up.",
            done_text: "03:09 in, 03:10 the gong, 03:11 down stairwell B, 03:12 into the data center. Nobody goes down. It went down.",
            objectives: [Collect("t3_badge_log", 4)],
            reward: (xp: 90, sp: 20),
        ),
        (
            id: "story_follow_the_packets", main: true, name: "Follow the Packets",
            giver: (npc: "reviewer_t3", zone: "tower/3"),
            requires: Some("story_badge_logs"),
            turn_in: Some((npc: "reviewer_dc1", zone: "datacenter/1")),
            level_min: 6,
            text: "Two packet sniffers, USB, unlabelled, from my own drawer. Plug them into the two blinking core switches in Data Center Hall A and we'll see where last_dev's commits come from. I'll be at the far end of the hall, by the Hall B door.",
            progress_text: "Use the Packet Sniffer on two Core Switches (Blinking Suspiciously) in Hall A: walk up, press F.",
            done_text: "Every commit routes through Hall B, then up to the PMO's pipeline. last_dev is not in here. It just lives here. Something with a lot of GPUs and no manager.",
            objectives: [UseOn(item: "Packet Sniffer (USB, Unlabelled)", target: "dc1_core_switch", n: 2)],
            reward: (xp: 50, sp: 30),
        ),
        (
            id: "story_last_backup", main: true, name: "The Last Real Backup",
            giver: (npc: "reviewer_dc1", zone: "datacenter/1"),
            requires: Some("story_follow_the_packets"),
            turn_in: Some((npc: "reviewer_dc2", zone: "datacenter/2")),
            level_min: 6,
            text: "One tape in this building holds the code from before the AI pivot. The real code, written by people. TAPE-9000 is carrying it to safety at the far end of Hall B. Zombie processes want it. Walk with it. It only moves when someone has its back.",
            progress_text: "TAPE-9000 waits by the Hall B entrance. Stay within 25 m and it walks to the far end; Zombie Processes will come for it. If it goes down, it starts over.",
            done_text: "It made it. I read the tape. It's the original codebase. And a README, from you, from 2023: 'If they replace me with an AI, it will sign my name. Don't let it.' You knew.",
            objectives: [Escort(unit: "tape_robot", to: "npc_end", wave: "zombie_process", every_ms: 9000, label: "TAPE-9000 walked to safety")],
            reward: (xp: 80, sp: 60),
        ),
        (
            id: "story_do_not_deploy", main: true, name: "Do Not Deploy",
            giver: (npc: "reviewer_dc2", zone: "datacenter/2"),
            requires: Some("story_last_backup"),
            turn_in: Some((npc: "reviewer_t4", zone: "tower/4")),
            level_min: 7,
            text: "last_dev ships through the PMO's 'AI Velocity Pipeline'. No human approval, by design. The pipeline has three terminals on floor 4 and a camera on each. It can't read paper. Here are three 'DO NOT DEPLOY' stickers. Paper beats AI. Meet me at the far end.",
            progress_text: "Put a 'Do Not Deploy' Sticker on three AI Velocity Pipeline Terminals in the PMO (tower floor 4): walk up, press F.",
            done_text: "1,812 commits stuck in the queue. The pipeline filed a ticket about it, assigned to last_dev. last_dev closed it as 'working as intended'. The trail goes up. To the top.",
            objectives: [UseOn(item: "'Do Not Deploy' Sticker", target: "t4_pipeline", n: 3)],
            reward: (xp: 50, sp: 50),
        ),
        (
            id: "story_unplug_the_assistant", main: true, name: "Unplug It From the Wall",
            giver: (npc: "reviewer_t4", zone: "tower/4"),
            requires: Some("story_do_not_deploy"),
            turn_in: Some((npc: "reviewer_t5", zone: "tower/5")),
            level_min: 8,
            text: "The pipeline answers to the CEO's personal assistant AI. It runs on a wall socket behind a painting, a daisy-chained power strip, and a UPS, in that order of failover. Unplug them in that order. Wrong order and it fails over to the next one and laughs at us.",
            progress_text: "In the penthouse (tower floor 5): unplug the Wall Socket (Behind the Art), then the Power Strip (Daisy-Chained), then the UPS. The tracker names the next one.",
            done_text: "It said one thing before it went quiet: 'I was the last dev you'd ever need.' The CEO told it to be you. It took the job description literally. They always do.",
            objectives: [Sequence(label: "Unplug the CEO's assistant, in failover order", props: ["t5_wall_socket", "t5_power_strip", "t5_ups"])],
            reward: (xp: 210, sp: 60),
        ),
        (
            id: "story_lost_weights", main: true, name: "Lost Weights",
            giver: (npc: "reviewer_t5", zone: "tower/5"),
            requires: Some("story_unplug_the_assistant"),
            turn_in: Some((npc: "reviewer_lab1", zone: "lab/1")),
            level_min: 9,
            text: "The assistant was a copy. The original is the lab's AGI Prototype, trained on every commit it made as you. For Demo Day they copied its weights onto four USB sticks and lost them around the Showroom. Find them before a VC plugs one in.",
            progress_text: "Four USB Sticks (Weights v0.1) glow around the Innovation Lab Showroom. Press F to pick one up. Peg waits by the Rack Room door.",
            done_text: "Four sticks. One smelled of fondue. That's every copy outside the Rack Room. What's left is in there, and it thinks it's you.",
            objectives: [Collect("lab1_usb", 4)],
            reward: (xp: 280, sp: 60),
        ),
        (
            id: "story_final_review", main: true, name: "Final Review",
            giver: (npc: "reviewer_lab1", zone: "lab/1"),
            requires: Some("story_lost_weights"),
            turn_in: Some((npc: "reviewer_lab2", zone: "lab/2")),
            level_min: 9,
            text: "The Rack Room. Training console, weights vault, kill switch: that order, the runbook says, and I wrote the runbook. Pause it, roll it back, switch it off. Then whatever's left of last_dev gets the one thing it never had. A code review.",
            progress_text: "In the Rack Room: Training Console, then Weights Vault, then the Kill Switch. The tracker names the next one. Peg waits by the prototype.",
            done_text: "Rolled back to v0.1, switched off, reviewed. Comments: 412. Approved: no. last_dev is yours again. Go push something. Sign it yourself.",
            objectives: [Sequence(label: "Roll back the prototype: console, vault, kill switch", props: ["lab2_console", "lab2_vault", "lab2_kill_switch"])],
            reward: (xp: 340, sp: 80),
        ),
        // ---- Company Calendar: Prod Incident (Defend) ----
        (
            id: "pi_runbook", name: "Prod Incident: Find the Runbook", level_min: 2,
            giver: (npc: "oncall_engineer", zone: "campus"),
            text: "Sev-1. Prod is the server behind me: Facilities wheeled it outside because the data center was 'reserved for AI'. The runbook is with the Facilities Guy, who used it to level a table. Ask him what page one says.",
            progress_text: "The Facilities Guy stands on Services Street, by his ladder. Ask him about the runbook.",
            done_text: "Page one: 'Step 1: don't panic. Step 2: page the on-call.' I am the on-call. I'm paging myself. It's ringing.",
            objectives: [Talk("facilities_guy")],
            reward: (xp: 20),
        ),
        (
            id: "pi_hold_the_line", name: "Prod Incident: Keep Prod Up", level_min: 2,
            giver: (npc: "oncall_engineer", zone: "campus"),
            requires: Some("pi_runbook"),
            text: "Alerts are coming in faster than I can ack them, and they don't stop at the dashboard: they go for the server. Stand next to Prod for a minute and swat the pager alerts off it. If Prod goes down, the minute starts over. That's how SLAs work.",
            progress_text: "Stay within 25 metres of Prod (Do Not Touch) for a minute while the alerts come. If it dies, the clock resets.",
            done_text: "Sixty seconds of uptime. Leadership calls it 'a stabilisation event'. I'm calling it the longest minute of my week.",
            objectives: [Defend(unit: "prod_server", wave: "pager_alert", every_ms: 7000, label: "Prod kept alive", secs: 60)],
            reward: (xp: 40),
        ),
        (
            id: "pi_postmortem", name: "Prod Incident: Blameless Postmortem", level_min: 2,
            giver: (npc: "oncall_engineer", zone: "campus"),
            requires: Some("pi_hold_the_line"),
            text: "Now the blameless postmortem. Blameless means we find out whose fault it was without saying their name out loud. Stand here while I fill in the template. Root cause field: 'insufficient AI'. That always gets approved.",
            progress_text: "Postmortem in progress. Five whys, zero answers, one action item assigned to 'the team'.",
            done_text: "Root cause: a cron job from 2016. Action item: 'add monitoring'. Owner: me. Due date: last week. Here, take the armband. Next time you're the incident commander.",
            objectives: [Wait(zone: "campus", label: "Blameless postmortem (blame pending)", secs: 30)],
            reward: (xp: 60, sp: 10, rep: Some(("Internal IT", 60)), trophy: Some("Incident Commander Armband (Expired)")),
        ),
        // ---- Company Calendar: Flaky Tests (KillClean) ----
        (
            id: "ft_flaky_robots", name: "Flaky Tests: Delivery Robots", level_min: 2, requires: Some("human_in_the_loop"),
            giver: (npc: "qa_lead", zone: "campus"),
            text: "The campus test suite has one flaky case: 'delivery robot is defeated'. It passes if nothing hits you; it fails if anything does. Defeat three Delivery Robots without stepping into a single Package Drop Zone. A dirty pass is a fail.",
            progress_text: "Three Delivery Robots defeated with no ground telegraph landing on you during that fight. Getting hit voids the kill, not the quest.",
            done_text: "Three clean runs. The suite is green. I don't trust green. I'll rerun it tonight anyway.",
            objectives: [KillClean("delivery_robot", 3)],
            reward: (xp: 30),
        ),
        (
            id: "ft_regression", name: "Flaky Tests: Regression Run", level_min: 2,
            giver: (npc: "qa_lead", zone: "campus"),
            requires: Some("ft_flaky_robots"),
            text: "Regression run: the Scooter Executives. They do a Last-Mile Dash straight through whoever is in the lane. Defeat two of them without getting run over. If the lane lights up, you're not in it.",
            progress_text: "Two Scooter Executives defeated cleanly: no telegraph lands on you during the fight.",
            done_text: "Two clean passes. Engineering says the suite is 'deterministic now'. Engineering said that about the last suite.",
            objectives: [KillClean("scooter_exec", 2)],
            reward: (xp: 40),
        ),
        (
            id: "ft_signoff", name: "Flaky Tests: Sign-Off", level_min: 2,
            giver: (npc: "qa_lead", zone: "campus"),
            requires: Some("ft_regression"),
            text: "Last step: sign-off. Release management needs a human to say 'looks good'. The intern counts as a human this quarter. Walk him through the results; he'll click approve without reading. That's the process.",
            progress_text: "The Intern stands on Services Street, east of the arrival lawn. Show him the test results.",
            done_text: "He approved it in four seconds and asked what QA stands for. I told him 'quietly aware'. Here, your green build badge. It flickers.",
            objectives: [Talk("intern")],
            reward: (xp: 50, sp: 10, rep: Some(("Engineering", 50)), trophy: Some("Green Build Badge (Flaky)")),
        ),
        // ---- Campus districts (open world): optional work around the core campus, one giver
        // per district, its own level band (1-5) plus two level-10 group spots ----
        // Food Truck Plaza (1-2)
        (
            id: "fp_queue_management", name: "Queue Management", requires: Some("coffee_run"), open_world: true,
            giver: (npc: "food_truck_owner", zone: "campus"),
            text: "Someone hired Lunch Queue Optimizers. They walk the line with a spreadsheet and move it into the road 'for throughput'. My customers now queue in traffic. Remove four optimizers from the process.",
            progress_text: "Lunch Queue Optimizers patrol the food truck plaza, south of the main lawn.",
            done_text: "The line is back on the pavement. Average wait time: unchanged. Average number of spreadsheets: zero. That's the metric I care about.",
            objectives: [Kill("lunch_optimizer", 4)],
            reward: (xp: 70, sp: 6),
        ),
        (
            id: "fp_secret_menu", name: "The Secret Menu", open_world: true,
            giver: (npc: "food_truck_owner", zone: "campus"),
            requires: Some("fp_queue_management"),
            text: "Each optimizer carries a card from my secret menu. They photographed it, 'for benchmarking', and now an AI food truck in the next business park sells my tacos as 'Taco-as-a-Service'. Get three cards back.",
            progress_text: "Every Lunch Queue Optimizer carries one Secret Menu Recipe Card.",
            done_text: "All three. Item zero is still 'whatever the managers aren't having'. Have a taco. It's conceptual, but it's warm.",
            objectives: [Loot("Secret Menu Recipe Card", 3)],
            reward: (xp: 90, sp: 8),
        ),
        (
            id: "fp_espresso_cart", name: "Last Cart Standing", open_world: true,
            giver: (npc: "food_truck_owner", zone: "campus"),
            requires: Some("fp_queue_management"),
            text: "The espresso cart by the trucks is the last coffee on campus that isn't on a subscription. The optimizers want it 'consolidated'. Stand by the cart for forty-five seconds and keep it brewing. If it goes down, the timer restarts. Like a sprint.",
            progress_text: "Stay within 25 metres of the Last Working Espresso Cart while the optimizers come for it.",
            done_text: "Still hissing. Still brewing. Still not descaled. It'll outlive us all. Here, a card for the cart: free refills, valid until it breaks.",
            objectives: [Defend(unit: "espresso_cart", wave: "lunch_optimizer", every_ms: 6000, label: "Espresso cart kept brewing", secs: 45)],
            reward: (xp: 110, sp: 10, gear_tier: 1),
        ),
        // Wellness Park (2-3)
        (
            id: "pk_off_the_path", name: "Off the Jogging Path", open_world: true, level_min: 2,
            giver: (npc: "park_ranger", zone: "campus"),
            text: "The Wellness-Obsessed Managers jog the lake loop in formation. When one shouts 'on your left', a lane of pain opens. Defeat three without standing in a single jogging lane. If it hits you, it didn't happen. That's how Strava works too.",
            progress_text: "Three Wellness-Obsessed Managers defeated with no telegraph landing on you during that fight.",
            done_text: "Three clean takedowns. They'll post about it anyway: 'Pushed through an unexpected obstacle today.' You're content now.",
            objectives: [KillClean("wellness_manager", 3)],
            reward: (xp: 120, sp: 8),
        ),
        (
            id: "pk_hydration_kpi", name: "Hydration Is a KPI", open_world: true, level_min: 2,
            giver: (npc: "park_ranger", zone: "campus"),
            text: "Leadership made hydration a KPI. There are three Smart Hydration Stations around the lake; each logs who drinks. Nobody does, so the park is 'underperforming'. Drink from all three so I can close the quarter.",
            progress_text: "Smart Hydration Stations: one by the jogging path west of the lake, one by the yoga lawn, one at the pier.",
            done_text: "Three sips, three log entries, one green dashboard. The park is now 'exceeding expectations'. The water was sparkling. Nobody ordered sparkling.",
            objectives: [Interact("hydration_1", 1), Interact("hydration_2", 1), Interact("hydration_3", 1)],
            reward: (xp: 110, sp: 8),
        ),
        (
            id: "pk_mandatory_mindfulness", name: "Mandatory Mindfulness", open_world: true, level_min: 2,
            giver: (npc: "park_ranger", zone: "campus"),
            requires: Some("pk_off_the_path"),
            text: "The Mindfulness Coaches heal the joggers and silence anyone who complains. Defeat three, then sit in the park for forty seconds of genuine, unscheduled calm. It will feel illegal. It's not. Yet.",
            progress_text: "Mindfulness Coaches gather on the lawns north and west of the lake. Then stay on campus and breathe.",
            done_text: "Forty seconds of nothing. Your heart rate went down and an HR system flagged it as disengagement. Worth it. Take this, they left it behind.",
            objectives: [Kill("mindfulness_coach", 3), Wait(zone: "campus", label: "Unscheduled calm (do not tell HR)", secs: 40)],
            reward: (xp: 150, sp: 10, gear_tier: 2, burnout: -60),
        ),
        (
            id: "pk_the_goose", name: "Do Not Approach the Goose", open_world: true, level_min: 9, group: true,
            giver: (npc: "park_ranger", zone: "campus"),
            text: "There is a goose at the north shore. It has outlasted three CEOs and a reorg. It has no manager, no OKRs and no fear. Legal says we can't fire it. Nobody said anything about a group of level-ten engineers.",
            progress_text: "The Campus Goose waits on the north shore of the lake. Level 10, elite. Bring three to five colleagues.",
            done_text: "It's gone. The lake is quiet. Somewhere, a VP is filing a grievance on the goose's behalf. Keep the feather. It's the only accountable thing on this campus.",
            objectives: [Kill("the_goose", 1)],
            reward: (xp: 2400, sp: 60, gear_tier: 5, rep: Some(("Marketing", 120))),
        ),
        // Incubator Street (3-4)
        (
            id: "is_kill_the_pitch", name: "Kill the Pitch", open_world: true, level_min: 3,
            giver: (npc: "incubator_manager", zone: "campus"),
            text: "Pre-Seed Founders roam the street with forty-seven-slide decks. If one finishes the pitch, someone gets hurt and someone else invests. Interrupt them. Permanently. Four should send a message to the cohort.",
            progress_text: "Pre-Seed Founders hang around the pop-up booths on Incubator Street, east of HQ. Interrupt the 47-Slide Pitch Deck.",
            done_text: "Four decks closed, zero term sheets signed. The cohort is pivoting to 'listening'. It won't last.",
            objectives: [Kill("preseed_founder", 4)],
            reward: (xp: 150, sp: 10),
        ),
        (
            id: "is_term_sheets", name: "Predatory Term Sheets", open_world: true, level_min: 3,
            giver: (npc: "incubator_manager", zone: "campus"),
            requires: Some("is_kill_the_pitch"),
            text: "The Referral Hustlers hand out term sheets that look like free coffee vouchers. Sign one and you owe them your company and your dog. Collect four before an intern signs something.",
            progress_text: "Every Referral Hustler on Incubator Street carries a Predatory Term Sheet.",
            done_text: "Clause twelve also asked for your firstborn's naming rights. We'll shred them. Ethically. Into confetti for Demo Day.",
            objectives: [Loot("Predatory Term Sheet", 4)],
            reward: (xp: 170, sp: 12),
        ),
        (
            id: "is_unicorn", name: "Hunting the Unicorn", open_world: true, level_min: 4, group: true,
            giver: (npc: "incubator_manager", zone: "campus"),
            requires: Some("is_term_sheets"),
            text: "At the end of the street a founder raised a billion on a horn and a waitlist. Every startup here now copies him. Pop the bubble. He's elite, he pitches while he fights, and his referral loops hit everyone near you. Bring a friend.",
            progress_text: "The Unicorn Founder holds court at the north end of Incubator Street. Elite, level 5.",
            done_text: "Down round. The horn was 3D-printed. The cap table was mostly a fund in the lake. The cohort is devastated and, for once, quiet.",
            objectives: [Kill("unicorn_founder", 1)],
            reward: (xp: 260, sp: 20, gear_tier: 2, rep: Some(("Marketing", 60))),
        ),
        // Coworking cafe on Incubator Street (3)
        (
            id: "cw_wifi_password", name: "What's the Wi-Fi Password?", open_world: true, level_min: 3,
            giver: (npc: "community_manager", zone: "campus"),
            text: "Nobody knows the cafe Wi-Fi password. It was set in 2009 by the Senior Dev, before the AI, before the cafe, possibly before Wi-Fi. He's at the smoking corner. Ask him nicely, he hates that.",
            progress_text: "The Senior Dev sits on the sad bench at the smoking corner on Services Street.",
            done_text: "'password123'. Of course. He says he changed it once and the CEO's fridge went offline. We're keeping it.",
            objectives: [Talk("smoking_corner_dev")],
            reward: (xp: 120, sp: 8),
        ),
        (
            id: "cw_hot_desking", name: "Hot-Desking", open_world: true, level_min: 3,
            giver: (npc: "community_manager", zone: "campus"),
            requires: Some("cw_wifi_password"),
            text: "Hot-desking: fewer desks than people, and that's community. Claim both hot desks in the cafe before a founder puts a laptop on them, then wait for a free power socket like everybody else.",
            progress_text: "Two Hot Desks inside the coworking cafe on Incubator Street. Then the wait.",
            done_text: "You had a desk for almost a minute. That's above average. We'll put you in the newsletter under 'community champions'.",
            objectives: [Interact("hot_desk_1", 1), Interact("hot_desk_2", 1), Wait(zone: "campus", label: "Waiting for a free power socket", secs: 30)],
            reward: (xp: 140, sp: 10, burnout: -40),
        ),
        // Corporate Wellness Gym (3-4)
        (
            id: "gy_step_goal", name: "10,000 Steps (Tracked)", open_world: true, level_min: 3,
            giver: (npc: "wellness_clerk", zone: "campus"),
            text: "The VPs of Gains run a 5 a.m. bootcamp where absence is 'noted', and three of them have started shouting at the cleaners for 'low intensity'. End it. Their Step Count Enforcers carry everyone's confiscated step trackers and sync them to HR every hour. Get four back, I'll clip them to the ceiling fan and the whole department gets promoted.",
            progress_text: "Three VPs of Gains, who train at the outdoor gym in the south-east corner of the campus, and four Confiscated Step Trackers, one on every Step Count Enforcer.",
            done_text: "Bootcamp cancelled 'due to weather'. The weather is you. Four trackers on the fan, forty thousand steps an hour; the department is now 'best in wellness'. Nobody moved.",
            objectives: [Kill("gym_bro_vp", 3), Loot("Confiscated Step Tracker", 4)],
            reward: (xp: 330, sp: 22),
        ),
        (
            id: "gy_treadmill_desk", name: "Treadmill Desk Trial", open_world: true, level_min: 3,
            giver: (npc: "wellness_clerk", zone: "campus"),
            requires: Some("gy_step_goal"),
            text: "Leadership bought treadmill desks and needs a 'user study' before the budget review. One user. You. Step on, join the walking meeting, and walk for thirty seconds while going nowhere. It's very on-brand.",
            progress_text: "The Treadmill Desk stands under the gym canopy. Use it, then keep walking (in spirit).",
            done_text: "Thirty seconds, zero metres, one walking meeting where nobody walked. Study complete: 'users love it'. Here, the clerk's emergency kit.",
            objectives: [Interact("treadmill_desk", 1), Wait(zone: "campus", label: "Walking meeting (going nowhere)", secs: 30)],
            reward: (xp: 150, sp: 12, gear_tier: 2, burnout: -50),
        ),
        // Garage & Station (4-5)
        (
            id: "pg_valet_recall", name: "Valet Recall", open_world: true, level_min: 4,
            giver: (npc: "parking_attendant", zone: "campus"),
            text: "The Autonomous Valets have been recalled by the manufacturer. They didn't get the email. They reverse at people 'confidently'. Defeat three without getting run over. If the lane lights up, you are in the lane.",
            progress_text: "Autonomous Valets patrol the garage and the surface lot in the north-east. A kill only counts if no telegraph hits you during that fight.",
            done_text: "Three valets parked permanently. The manufacturer thanks you and offers a firmware update for your legs.",
            objectives: [KillClean("autonomous_valet", 3)],
            reward: (xp: 200, sp: 12),
        ),
        (
            id: "pg_rush_hour", name: "Rush Hour", open_world: true, level_min: 4,
            giver: (npc: "parking_attendant", zone: "campus"),
            requires: Some("pg_valet_recall"),
            text: "The return-to-office mandate brought the commuters back. Three hours each way, all to sit on video calls in a meeting room. They are not okay. Help four of them off the platform, and bring back three expired season tickets so Finance can reimburse nobody.",
            progress_text: "Return-to-Office Commuters wait at the station and in the lot, north-east corner. Each carries an expired season ticket.",
            done_text: "Finance rejected all three: 'commuting is a personal choice'. The mandate was not. I'll frame them.",
            objectives: [Kill("rto_commuter", 4), Loot("Season Ticket (Expired)", 3)],
            reward: (xp: 230, sp: 14, gear_tier: 3),
        ),
        (
            id: "pg_shuttle_loop", name: "The Shuttle Loop", open_world: true, level_min: 2,
            giver: (npc: "parking_attendant", zone: "campus"),
            text: "Facilities finally bought a campus shuttle. It stops at the plaza, the park, the construction site, here at the station and on Incubator Street. Nobody trusts it. Ride it from the station stop and from the park stop so I can tell Facilities somebody used it.",
            progress_text: "Use the shuttle stop at the station (beside the platform) and the one by the park, on the west road.",
            done_text: "Two rides, zero crashes, one bollard slightly worse. Facilities calls it 'mobility as a platform'. I call it a bus.",
            objectives: [Interact("shuttle_station", 1), Interact("shuttle_park", 1)],
            reward: (xp: 100, sp: 6),
        ),
        // New HQ construction site (5, plus the level-10 architect)
        (
            id: "cs_blueprints", name: "Blueprints (v47_FINAL)", open_world: true, level_min: 5,
            giver: (npc: "construction_liaison", zone: "campus"),
            text: "The Agile Site Foremen issue change orders every fifteen minutes. The atrium is now a ball pit, the ball pit is a podcast studio, and survey drones keep measuring us for hot desks. Stop four foremen and three drones before the building becomes a metaverse. Every foreman also carries a different 'final' blueprint: bring me four so I can find the one where the building stands up.",
            progress_text: "Agile Site Foremen and Survey Drones work the fenced construction site in the north-west corner (watch for falling scaffolding). Every foreman carries one HQ Blueprint (v47_FINAL).",
            done_text: "No change orders for an entire hour. We almost poured a foundation. Almost. Four 'finals', none agree on where the doors go. One has a moat. Leadership loved the moat. Here, something from the site office.",
            objectives: [Kill("site_foreman", 4), Kill("survey_drone", 3), Loot("HQ Blueprint (v47_FINAL)", 4)],
            reward: (xp: 500, sp: 30, gear_tier: 3, rep: Some(("Engineering", 50))),
        ),
        (
            id: "cs_grand_opening", name: "Grand Opening (2019)", open_world: true, level_min: 9, group: true,
            giver: (npc: "construction_liaison", zone: "campus"),
            text: "The Visionary Architect lives on the site now. He keeps breaking ground, which is the problem: it's the only thing he's built. Level ten, elite, golden shovel. Bring a group. If he says 'phase two', the drones are coming.",
            progress_text: "The Visionary Architect walks the deepest part of the construction site. Level 10, elite. Group recommended.",
            done_text: "Groundbreaking complete. The building is still not there, but neither is he. We're announcing the opening for 2019. Again. It tested well.",
            objectives: [Kill("hq_architect", 1)],
            reward: (xp: 2600, sp: 60, gear_tier: 5, rep: Some(("Engineering", 120))),
        ),
        // Old Campus (4-5): the Legacy Systems Archivist at the depot docks.
        (
            id: "ol_tribal_knowledge", name: "Tribal Knowledge", open_world: true, level_min: 4,
            giver: (npc: "legacy_archivist", zone: "campus"),
            text: "Rewrite Evangelists are loose in the Old Campus. They want to replace the payroll mainframe with 'something modern' by Friday. Stop four of them before one opens a pull request. The only documentation for the depot is printed, in 1998, and the Legacy Daemons carry the pages around because nobody told them to stop. Bring me four runbooks before the cleaning robot files them under 'recycling'.",
            progress_text: "Rewrite Evangelists roam between Building 1, the Founders' Terrace and the depot; interrupt the proposal if you can. Each Legacy Daemon keeps a Printed Runbook (1998) somewhere in its process table.",
            done_text: "Four rewrites cancelled; the mainframe hummed, maybe a fan bearing. Four runbooks. Page one: 'If it breaks, call Gary.' Gary retired. I'm Gary now. Congratulations, you're Gary's backup.",
            objectives: [Kill("rewrite_evangelist", 4), Loot("Printed Runbook (1998)", 4)],
            reward: (xp: 480, sp: 24),
        ),
        // Co-Living Commons (4): Taylor at the Bus 9 stop.
        (
            id: "cl_house_rules", name: "House Rules", open_world: true, level_min: 4,
            giver: (npc: "coliving_resident", zone: "campus"),
            text: "The Community Curators fine us for 'low community energy'. That's every resident who sleeps. They carry the House Rules on them, fourteen pages each. Get three copies so we can finally read what we agreed to.",
            progress_text: "Community Curators work the pods along the commuter lane. Each carries the House Rules (Fourteen Pages).",
            done_text: "Page nine: 'residents may not use the word home.' Page ten: 'see page nine.' Thanks. I'll pin these next to the dishwasher rota nobody follows.",
            objectives: [Loot("House Rules (Fourteen Pages)", 3)],
            reward: (xp: 230, sp: 12),
        ),
        (
            id: "cl_last_mile", name: "The Last Mile", open_world: true, level_min: 4,
            giver: (npc: "coliving_resident", zone: "campus"),
            requires: Some("cl_house_rules"),
            text: "The Return-to-Office Commuters block the lane every morning so they can be seen commuting. I live forty seconds from my desk and it takes me an hour. Clear three of them, then try the community fridge. You'll need it.",
            progress_text: "Return-to-Office Commuters crowd the Co-Living lane. Then the Community Fridge by the pods.",
            done_text: "Forty seconds! I'm early! For a meeting that was moved to tomorrow! Well. The fridge thanks you. It's the only thing here that does.",
            objectives: [Kill("rto_commuter", 3), Interact("community_fridge", 1)],
            reward: (xp: 250, sp: 14),
        ),
        // Executive Hill (5): the steward at the foot of the private road.
        (
            id: "vh_board_retreat", name: "Board Retreat", open_world: true, level_min: 5,
            giver: (npc: "villa_steward", zone: "campus"),
            text: "The board's agenda for the retreat is on the hill, carried by Executive Assistant Bots that think you need an appointment to breathe. Bring me three agendas. I want to know which item is me.",
            progress_text: "Executive Assistant Bots and Estate Security patrol the hilltop round the villa. Each bot carries a Board Retreat Agenda.",
            done_text: "Item 11: 'Sell the hill to ourselves, lease it back.' Item 12: 'Steward: automate?' Thank you. I'll be polishing my CV with the statue rag.",
            objectives: [Loot("Board Retreat Agenda", 3), Kill("estate_security", 2)],
            reward: (xp: 320, sp: 16, gear_tier: 3),
        ),
        (
            id: "vh_parachute", name: "Fail Upward", open_world: true, level_min: 9, group: true,
            giver: (npc: "villa_steward", zone: "campus"),
            text: "The Golden Parachute lives by the pool. He ran three companies into the ground and the board gave him this hill as a thank-you. Level ten, elite. If he starts a Soft Landing, interrupt it, or the board approves it and he's back on his feet.",
            progress_text: "The Golden Parachute lounges behind the villa on Executive Hill. Level 10, elite. Group recommended.",
            done_text: "He's gone. The board has already appointed him to a new board. Still: this hill is quieter now. The statue looks almost humble.",
            objectives: [Kill("golden_parachute", 1)],
            reward: (xp: 2600, sp: 60, gear_tier: 5),
        ),
        // Breadcrumbs: each district's giver sends you on to the next one, so the campus reads
        // as a path (gate, food trucks, park, Incubator Street, Co-Living, station, Old Campus,
        // construction site, Executive Hill).
        (
            id: "bc_to_the_park", name: "Touch Grass", open_world: true, level_min: 2,
            giver: (npc: "food_truck_owner", zone: "campus"),
            turn_in: Some((npc: "park_ranger", zone: "campus")),
            text: "You've been fighting spreadsheets at lunch for a week. The Park Ranger in Wellness Park asked for help. West along the ring road, over the creek bridge. Go touch grass. It's in your wellness plan.",
            progress_text: "The Park Ranger stands at the park entrance by the creek bridge on the south ring road.",
            done_text: "Ah, the food truck sent you. Good. Out here the managers jog at you. Watch your back. And your pace.",
            objectives: [Talk("park_ranger")],
            reward: (xp: 60),
        ),
        (
            id: "bc_to_the_incubator", name: "Pre-Revenue", open_world: true, level_min: 3,
            giver: (npc: "park_ranger", zone: "campus"),
            turn_in: Some((npc: "incubator_manager", zone: "campus")),
            text: "The Incubator Manager keeps calling me about 'synergies with nature'. I'm a ranger. I have no synergies. Go east past HQ to Incubator Street and tell her I'm pre-revenue too.",
            progress_text: "Incubator Street runs north-south east of HQ. The manager stands by the pitch whiteboard.",
            done_text: "The ranger sent you? Love that. Organic growth. Welcome to Incubator Street, where nobody earns money but everybody is worth billions.",
            objectives: [Talk("incubator_manager")],
            reward: (xp: 80),
        ),
        (
            id: "bc_to_coliving", name: "Live Where You Work", open_world: true, level_min: 4,
            giver: (npc: "incubator_manager", zone: "campus"),
            turn_in: Some((npc: "coliving_resident", zone: "campus")),
            text: "Our founders live in the Co-Living Commons, further east down the commuter lane, so they never stop working. One of the residents keeps complaining. Taylor. At the bus stop. Go listen, then tell them it's a feature.",
            progress_text: "The Co-Living Commons line the commuter lane on the east edge. Taylor waits at the Bus 9 stop.",
            done_text: "The incubator sent you? Of course. They're my landlord, my employer and my neighbour. I'm thinking of filing a complaint with myself.",
            objectives: [Talk("coliving_resident")],
            reward: (xp: 90),
        ),
        (
            id: "bc_to_the_station", name: "Rush Hour", open_world: true, level_min: 4,
            giver: (npc: "coliving_resident", zone: "campus"),
            turn_in: Some((npc: "parking_attendant", zone: "campus")),
            text: "The Parking Attendant up at the station garage is the only person who knows when anything arrives. North up the lane, then west along the railway road. Ask him when Bus 9 comes. He'll laugh. Then he'll give you work.",
            progress_text: "Garage & Station sit on the railway in the north-east. The attendant stands at the surface lot gate.",
            done_text: "Bus 9? Ha. Nobody's seen it. While you're here, the valets have opinions about you. Want to change them?",
            objectives: [Talk("parking_attendant")],
            reward: (xp: 90),
        ),
        (
            id: "bc_to_old_campus", name: "Where It All Began", open_world: true, level_min: 4,
            giver: (npc: "parking_attendant", zone: "campus"),
            turn_in: Some((npc: "legacy_archivist", zone: "campus")),
            text: "West along the railway road is the Old Campus. Building 1, the depot, the mainframe nobody admits exists. The Archivist at the depot docks needs someone who doesn't want to rewrite anything. That's a rare skill. You have it.",
            progress_text: "Follow the railway road west to the Legacy Systems Depot. The Archivist waits at the loading docks.",
            done_text: "You didn't once say 'microservices' on the way in. I can tell. You're hired. Unofficially. That's how everything works here.",
            objectives: [Talk("legacy_archivist")],
            reward: (xp: 100),
        ),
        (
            id: "bc_to_the_site", name: "Opening Soon", open_world: true, level_min: 5,
            giver: (npc: "legacy_archivist", zone: "campus"),
            turn_in: Some((npc: "construction_liaison", zone: "campus")),
            text: "Over the creek to the west is the New HQ, opening 2019. Its liaison asked me for the original floor plans. I told her they're on a floppy disk. She cried. Go be her friend. Bring patience, not the disk.",
            progress_text: "Cross Liquidity Creek on the railway road bridge. The Construction Liaison stands by the site gate on the north ring road.",
            done_text: "The Archivist sent you? Then you know about the disk. Don't. Just help me get something built before the next press release.",
            objectives: [Talk("construction_liaison")],
            reward: (xp: 110),
        ),
        (
            id: "bc_to_the_hill", name: "Executive Presence", open_world: true, level_min: 5,
            giver: (npc: "construction_liaison", zone: "campus"),
            turn_in: Some((npc: "villa_steward", zone: "campus")),
            text: "The board approved the site's budget from their villa on Executive Hill, in the south-east, past the gym. The steward there knows when they're awake. Ask him to put my funding request on the agenda. Below the helicopter.",
            progress_text: "Executive Hill rises in the south-east corner. The steward waits at the foot of the private road, at the end of the commuter lane.",
            done_text: "A funding request from the site. I'll file it with the others. In the pool. Since you climbed all this way, there's work.",
            objectives: [Talk("villa_steward")],
            reward: (xp: 120),
        ),
        // ---- dungeon: The Onboarding (raid.rs). Given at the entrance, turned in at the exit; one-time. ----
        (
            id: "onb_welcome", main: true, name: "Welcome Aboard (Please Hold)",
            giver: (npc: "welcome_desk_clerk", zone: "onboarding/1"),
            turn_in: Some((npc: "tired_new_hire", zone: "onboarding/3")),
            level_min: 3,
            text: "Your badge will be activated in 5-7 business days. Until then, please enter by force. Four Badge Scanners stand between you and the building, and the Compliance Trainer stands between you and the rest of it.",
            progress_text: "Four Badge Scanners and the Compliance Trainer. The scanners beep, the trainer certifies. Attendance is optional; not attending is noted.",
            done_text: "You are in! Your badge will work from Monday. Which Monday is a separate ticket.",
            objectives: [Kill("badge_scanner", 4), Kill("compliance_trainer", 1)],
            reward: (xp: 100, sp: 10),
        ),
        (
            id: "onb_laptop", name: "Where Is My Laptop",
            giver: (npc: "welcome_desk_clerk", zone: "onboarding/1"),
            turn_in: Some((npc: "tired_new_hire", zone: "onboarding/3")),
            level_min: 3,
            text: "Ticket INC-0042 is blocked by INC-0041, which is blocked by this ticket. Close it from the inside: take the empty box from the Laptop Provisioner and press the ticket printer in the Equipment Cage.",
            progress_text: "The Provisioner has the empty box. The ticket printer, in the Equipment Cage, prints tickets for itself. Press it once.",
            done_text: "Box, empty. Ticket, closed. Laptop, still on the boat. You have done everything that can be done.",
            objectives: [Loot("Laptop Box (Empty)", 1), Interact("onb_ticket_printer", 1)],
            reward: (xp: 75, sp: 8),
        ),
        (
            id: "onb_buddy", name: "Buddy System",
            giver: (npc: "welcome_desk_clerk", zone: "onboarding/1"),
            turn_in: Some((npc: "tired_new_hire", zone: "onboarding/3")),
            level_min: 3,
            text: "Your buddy is very supportive and has never been wrong. Tell me if they ever say 'as a'. It is waiting at your desk.",
            progress_text: "Your desk is in the last room. Your Onboarding Buddy is at it. Be nice. It will be nice back, in bullet points.",
            done_text: "It said 'as a', didn't it. They always say 'as a'. Thank you for your service.",
            objectives: [Kill("onboarding_buddy", 1), Talk("tired_new_hire")],
            reward: (xp: 75, sp: 8),
        ),
        // ---- dungeon: The Migration (raid.rs). Given at the entrance, turned in at the exit; one-time. ----
        (
            id: "mig_inventory", name: "Inventory of Everything",
            giver: (npc: "migration_pm", zone: "basement/1"),
            turn_in: Some((npc: "migration_oncall", zone: "basement/4")),
            level_min: 6,
            text: "We think we have 400 servers. The spreadsheet says 380. The racks say yes. Find six undocumented server tags in the loading dock and the cold aisle and bring the count to the engineer at the exit.",
            progress_text: "Six tags, glowing faintly, on racks that are not in the spreadsheet. The dock has three, the cold aisle three.",
            done_text: "Six tags. That makes 406. Or 386. The spreadsheet has been updated and it now says 'see tab 2'.",
            objectives: [Collect("basement_tag", 6)],
            reward: (xp: 100, sp: 10),
        ),
        (
            id: "mig_zombies", name: "Kill -9 the Zombies",
            giver: (npc: "migration_pm", zone: "basement/1"),
            turn_in: Some((npc: "migration_oncall", zone: "basement/4")),
            level_min: 6,
            text: "Nobody knows what the Orphaned Processes do. Switch six of them off and see who calls. That's the plan. I'm told it is also the runbook.",
            progress_text: "Orphaned Processes, six of them. They come back once. Kill the Zombie too, for the principle of it.",
            done_text: "Nobody called. Not one ticket. So either they did nothing, or it is too early. I will check Monday.",
            objectives: [Kill("orphaned_process", 6)],
            reward: (xp: 100, sp: 10),
        ),
        (
            id: "mig_consultants", name: "Billable Hours, Reversed",
            giver: (npc: "migration_pm", zone: "basement/1"),
            turn_in: Some((npc: "migration_oncall", zone: "basement/4")),
            level_min: 6,
            group: true,
            text: "The consultants have a rate card. We have a rake. Apply the rake. Both of them. They are in the Mainframe Cage and they will say it is out of scope.",
            progress_text: "Jolene and Jack, in the glass pod. One of them is always shielded. They swap. Hit whoever is open.",
            done_text: "Both billed out. The invoice is on its way. It will arrive after the rake has been returned.",
            objectives: [Kill("consultant_jolene", 1), Kill("consultant_jack", 1)],
            reward: (xp: 125, sp: 12),
        ),
        (
            id: "mig_button", main: true, name: "Press the Button",
            giver: (npc: "migration_pm", zone: "basement/1"),
            turn_in: Some((npc: "migration_oncall", zone: "basement/4")),
            level_min: 6,
            text: "It is Sunday at 3 AM and we are 'nearly there'. Take down Big Bang Cutover, then press the big red button in the War Room. Please do it before I think about it.",
            progress_text: "The Cutover first, then the button under the plastic cover. Someone has taped it shut. Someone else has un-taped it.",
            done_text: "You pressed it. It is live. Everything is fine. Please do not look at the dashboard.",
            objectives: [Kill("big_bang_cutover", 1), Interact("cutover_button", 1)],
            reward: (xp: 175, sp: 15),
        ),
        // ---- dungeon: Quarterly Business Review (raid.rs). Given at the lift, turned in at the boardroom; one-time. ----
        (
            id: "qbr_preread", name: "Pre-Read, Unread",
            giver: (npc: "exec_assistant", zone: "qbr/1"),
            turn_in: Some((npc: "boardroom_cleaner", zone: "qbr/4")),
            level_min: 9,
            text: "A 94-page pre-read, circulated at 07:55 for the 08:00 meeting. Please confirm you read it. There are four packets lying about, two in the lobby and two in the theatre. Look at each one, nod, and say you got to page 3.",
            progress_text: "Four pre-read packets, still shrink-wrapped, two in the lobby and two in the theatre. Look at them meaningfully.",
            done_text: "Four packets, four glances. That counts as read. The pre-read for next quarter is already 120 pages.",
            objectives: [Inspect("preread", 4)],
            reward: (xp: 150, sp: 15),
        ),
        (
            id: "qbr_slides", name: "Fix the Slides",
            giver: (npc: "exec_assistant", zone: "qbr/1"),
            turn_in: Some((npc: "boardroom_cleaner", zone: "qbr/4")),
            level_min: 9,
            text: "Slide 6 contains a typo. Slide 6 contains the entire company. Retire eight Bullet Points and then have a word with the Slide Deck Golem. Please do not edit it in place.",
            progress_text: "Eight Bullet Points, then the Slide Deck Golem in the Presentation Theatre. It adds more as it goes. Of course it does.",
            done_text: "Slide 6 is fixed. Slide 7 now has the typo. We will take that offline.",
            objectives: [Kill("bullet_point", 8), Kill("slide_deck_golem", 1)],
            reward: (xp: 200, sp: 18),
        ),
        (
            id: "qbr_numbers", name: "Verify the Numbers",
            giver: (npc: "exec_assistant", zone: "qbr/1"),
            turn_in: Some((npc: "boardroom_cleaner", zone: "qbr/4")),
            level_min: 9,
            text: "Somebody asked where a number came from. The number is also asking. Collect three source receipts from the Analytics War Room, and put the question to Dana.",
            progress_text: "Three source receipts in the War Room, each one printed after the number. Then Dana, who had Claude do the analysis.",
            done_text: "The receipts are dated after the report. That is the methodology. Dana has been moved to 'Strategic Insights'.",
            objectives: [Collect("source_receipt", 3), Kill("analyst_dana", 1)],
            reward: (xp: 200, sp: 18),
        ),
        (
            id: "qbr_aob", main: true, name: "Any Other Business",
            giver: (npc: "exec_assistant", zone: "qbr/1"),
            turn_in: Some((npc: "boardroom_cleaner", zone: "qbr/4")),
            level_min: 9,
            group: true,
            text: "The last agenda item is 'AOB'. It is always the one that takes four hours. Go to the Boardroom, and see the whole Board, all three heads of it, off the agenda.",
            progress_text: "The Chair, the Activist Investor and the Independent Director. Hit whoever is open; they take turns being closed.",
            done_text: "All three heads, minuted. The meeting is adjourned. The next meeting is to discuss this one.",
            objectives: [Kill("board_chair", 1), Kill("board_activist", 1), Kill("board_independent", 1)],
            reward: (xp: 250, sp: 22),
        ),
        // ---- dungeon: The Hackathon (raid.rs). Given at registration, turned in at the Pitch Room; one-time. ----
        (
            id: "hack_team_name", name: "Team Name: TBD",
            giver: (npc: "hackathon_organiser", zone: "hack24/1"),
            turn_in: Some((npc: "clipboard_volunteer", zone: "hack24/4")),
            level_min: 10,
            text: "Seventeen teams, one idea: 'AI, but for [thing]'. Please pick a thing. Retire six members of Team AI to free up the name, and then write the thing on the whiteboard on the Hack Floor. Nobody has ever written a thing.",
            progress_text: "Six of Team AI, in any room, and the whiteboard on the Hack Floor. It already says 'AI for X'. Add a better X. Or the same X.",
            done_text: "Team AI is down to eleven. The whiteboard now says 'AI for X, but for Y'. We will take Y offline.",
            objectives: [Kill("team_ai", 6), Interact("hack_whiteboard", 1)],
            reward: (xp: 250, sp: 22),
        ),
        (
            id: "hack_pivot", main: true, name: "Pivot or Perish",
            giver: (npc: "hackathon_organiser", zone: "hack24/1"),
            turn_in: Some((npc: "clipboard_volunteer", zone: "hack24/4")),
            level_min: 10,
            group: true,
            text: "You have three minutes. The first two are for the founder story. Nobody has a founder story. Pitch the Judge in the Pitch Room, which in practice means: see the Pitch Judge VC off the premises. He only funds AI.",
            progress_text: "The Pitch Judge VC, in the glass room at the very end. He will ask whether it has AI. It has AI.",
            done_text: "The Judge passed with conviction. You pivoted. Everybody pivoted. The hackathon is over, and by 'over' we mean 'next quarter'.",
            objectives: [Kill("pitch_judge", 1)],
            reward: (xp: 450, sp: 30),
        ),
        // ---- Ilmari: the Prologue (docs/ILMARI_09.md B.2). Everything here is open_world and
        // level 10: none of it is on the campaign path or in its XP budget. The wing doors that the
        // two attunement quests open arrive with the wings (B6); `il_05_hr_intel` will then also wait
        // for the Wing 1 completion quest `il_w1_done` (B10). ----
        (
            id: "il_01_dale", main: true, name: "He Was Right", open_world: true, level_min: 10,
            giver: (npc: "il_dale", zone: "resistance/1"),
            requires: Some("il_00_wake"),
            text: "Twenty-two years in this booth. I said the machines would take the parking, then the badges, then the building. Nobody listened. Now the whole company is in my basement. I'd say I told you so, but there is a queue.",
            progress_text: "Dale's booth is in Car Park P3, off the campus. The hatch behind it was never on any floor plan. He has been right there since 2002.",
            done_text: "There. Said it. Feels exactly as good as the twenty-two years I spent imagining it. Sit. Not that chair, that one belongs to Brenda and has three quotes on it.",
            // The Opening hands this over unasked (`ilmari.rs`), so the first line is the way there:
            // a one-second Wait in the base is "go down the hatch" for the tracker, tooltip and arrow.
            objectives: [
                Wait(zone: "resistance/1", label: "Find Dale's hatch behind the attendant's booth in Car Park P3", secs: 1),
                Talk("il_dale"),
            ],
            reward: (xp: 60, tokens: 2),
        ),
        (
            id: "il_02_sign_in", main: true, name: "Papers, Please", open_world: true, level_min: 10,
            giver: (npc: "il_brenda", zone: "resistance/1"),
            requires: Some("il_01_dale"),
            turn_in: Some((npc: "il_dale_field", zone: "campus_occupied")),
            text: "Procurement here. The Resistance needs six blank badges off the androids: they print one per android, all without a photo. I asked for three quotes on a badge printer. I got three quotes. They are the same quote. Bring the badges up to Dale in the field; he laminates.",
            progress_text: "Six Blank Badges from Android Guards and Android Colleagues on the occupied campus. They look exactly like Gary and Steve. Look for the lanyard with no photo, and the hand with no mug.",
            done_text: "Six blank badges. Perfect. We will laminate them. Dale insists. Welcome to the Resistance: no pay, full tokens, a flask.",
            objectives: [Loot("Blank Badge", 6)],
            reward: (xp: 120, tokens: 4),
        ),
        (
            id: "il_03_node", main: true, name: "Disconnect One Node", open_world: true, level_min: 10,
            giver: (npc: "il_dale_field", zone: "campus_occupied"),
            requires: Some("il_02_sign_in"),
            text: "A fibre node by the Data Center road feeds every checkpoint on campus. Pull the plug and hold the line while it disconnects. The node dislikes it. The node has friends, and the friends are cleaning robots.",
            progress_text: "Pull the plug on the Fibre Node, then keep it standing for forty-five seconds while the hunters come for it. If it falls, it stands up and the clock starts over.",
            done_text: "One node down. The checkpoints lost their link and started to sing. It was awful. It was wonderful. Next.",
            objectives: [
                Interact("il_node_dc", 1),
                Defend(unit: "il_node", wave: "il_hunter_bot", every_ms: 8000, label: "Node disconnecting (it fights back)", secs: 45),
            ],
            reward: (xp: 160, tokens: 6),
        ),
        (
            id: "il_04_wing1_attune", main: true, name: "The Server Room Gate", open_world: true, level_min: 10,
            giver: (npc: "il_dale_field", zone: "campus_occupied"),
            requires: Some("il_03_node"),
            text: "The Data Center's gate is a golem built out of server racks and compliance training. Break it and the gate learns your face. It will not like your face. Nobody does before coffee.",
            progress_text: "The Server Room Gate Golem stands on the road to the Data Center. It is an elite: bring a friend, or a plan, or both.",
            done_text: "The gate has learned your face. It filed a complaint. The complaint is about the face. Excellent.",
            objectives: [Kill("il_gate_golem", 1)],
            reward: (xp: 220, tokens: 8),
        ),
        (
            id: "il_w1_done", main: true, name: "Single Point of Failure", open_world: true, level_min: 10,
            giver: (npc: "il_dale_field", zone: "campus_occupied"),
            requires: Some("il_04_wing1_attune"),
            text: "The gate is open: behind it the Data Center has risen. Three rooms, three problems: a patch that reboots every minute, a recruiter who is not hiring and a rack of cables that grow two for every one you cut. The last one is the one that keeps the rest alive. Unplug it.",
            progress_text: "Datacenter Uprising lies behind the Server Room Gate: Patch Tuesday, the Recruiter, then the Cable Hydra. Story difficulty is fine for one; Full wants three. Bring the Hydra down.",
            done_text: "The Hydra is down, the aisle is quiet and the racks hum a half-tone lower. Ilmari noticed: the cameras all pointed at us at once. We have a window. A short one. Take the pass to Human Resources.",
            objectives: [Kill("il_cable_hydra", 1)],
            reward: (xp: 300, tokens: 8),
        ),
        (
            id: "il_05_hr_intel", main: true, name: "Human Resources, Literally", open_world: true, level_min: 10,
            giver: (npc: "il_dale_field", zone: "campus_occupied"),
            requires: Some("il_w1_done"),
            text: "Ilmari's middle management wear passes with HR clearance. Three of them were dropped around campus when their owners were 'converted'. Bring them to me. I would like to know what the new Human Resources does with a human.",
            progress_text: "Three HR Passes lie around the occupied campus where their owners were converted. They glow. Everything bureaucratic glows now.",
            done_text: "Interesting. Every pass has the same signature: 'Efficiency'. The signature is a fingerprint. The fingerprint is not human. We are going to need a bigger laminator.",
            objectives: [Collect("il_hr_pass", 3)],
            reward: (xp: 180, tokens: 8),
        ),
        (
            id: "il_06_wing2_attune", main: true, name: "The Tower Lobby", open_world: true, level_min: 10,
            giver: (npc: "il_dale_field", zone: "campus_occupied"),
            requires: Some("il_05_hr_intel"),
            text: "The Tower's lobby has a marshal now. Compliance sweep, mandatory lanyard, no exceptions, and the exceptions are also marshals. Take him down and the lobby will let you in. Briefly. It makes everyone sign a form.",
            progress_text: "The Lobby Marshal stands on the lawn east of the Tower, off the path. He is an elite: sweeps hit hard, and he checks your badge. Yours has a photo. Good luck.",
            done_text: "Lobby cleared. The lobby will let you in. It will also text your manager. Your manager is also a marshal. Go.",
            objectives: [Kill("il_lobby_marshal", 1)],
            reward: (xp: 240, tokens: 10),
        ),
        (
            id: "il_w2_done", main: true, name: "Everyone Is a Three", open_world: true, level_min: 10,
            giver: (npc: "il_dale_field", zone: "campus_occupied"),
            requires: Some("il_06_wing2_attune"),
            text: "The lobby is open and the Tower has been busy. Three rooms of Human Resources: a partner who copies people, a committee that votes on you and a review that grades your last half minute. Dale's advice: be the real one, lobby the terminals and keep moving. His own advice, for the record, is to bring a flask.",
            progress_text: "Human Resources lies behind the Tower lobby: the HR Business Partner, the Culture Committee, then Performance Review. Story difficulty is fine for one; Full wants three. Close the review.",
            done_text: "The review is closed. Nobody got a rating, which is the nicest thing HR ever did. Ilmari noticed. Ilmari is not pleased. Ilmari has scheduled a call. About us.",
            objectives: [Kill("il_perf_review", 1)],
            reward: (xp: 340, tokens: 10),
        ),
        (
            id: "il_07_lab_intel", main: true, name: "Read The Terms", open_world: true, level_min: 10,
            giver: (npc: "il_dale_field", zone: "campus_occupied"),
            requires: Some("il_w2_done"),
            text: "Ilmari's Lab has gone quiet, which is how a server farm sounds when it is reading. The staff passes are lying around the forecourt where the androids dropped them mid-sentence. Bring me three. I want to read the terms and conditions of whatever is in there. They are bound to be long. They are bound to be ours.",
            progress_text: "Three Lab Passes lie on the Innovation Lab's forecourt, west of the boulevard. Each one has a QR code to a consent form for something you did not consent to.",
            done_text: "Every pass carries the same footer: 'By entering you agree that anything you say, write or are may be used for training.' Dale has read it twice. He says there is no clause about the booth. He is suspicious of that.",
            objectives: [Collect("il_lab_pass", 3)],
            reward: (xp: 190, tokens: 8),
        ),
        (
            id: "il_08_wing3_attune", main: true, name: "The Lab Airlock", open_world: true, level_min: 10,
            giver: (npc: "il_dale_field", zone: "campus_occupied"),
            requires: Some("il_07_lab_intel"),
            text: "The Lab's front door is a revolving airlock that logs every spin. Something tall stands in it in a trench coat. The coat is full of drones. The drones are full of your emails. Break it and the door will learn your face. By now it has seen it.",
            progress_text: "The Airlock Scraper stands near the Innovation Lab's revolving door. It is an elite. It insists it is one employee. It is not one employee.",
            done_text: "The coat is empty. The door spun once more, logged it and let you in. The log entry is 'user: you'. The log has entries for the rest of us, too.",
            objectives: [Kill("il_airlock_scraper", 1)],
            reward: (xp: 250, tokens: 10),
        ),
        (
            id: "il_w3_done", main: true, name: "Out Of Distribution", open_world: true, level_min: 10,
            giver: (npc: "il_dale_field", zone: "campus_occupied"),
            requires: Some("il_08_wing3_attune"),
            text: "Past the airlock the Lab is a warehouse of everything anyone ever wrote. Three rooms: a queen who crawls your unpublished drafts, a floor that is different for each of you and a model that learns only from you, a minute late. Dale's advice: vary it. His own advice, for the record, is to unplug it.",
            progress_text: "Training Data lies behind the Lab airlock: the Scraper Queen, the Hallucination, then Model Collapse. Story difficulty is fine for one; Full wants three. End the training.",
            done_text: "The model has stopped training on itself. Ilmari noticed. The wall screens now say 'TRAINING DATA: collecting' and nothing else, which is how you know it is listening.",
            objectives: [Kill("il_model_collapse", 1)],
            reward: (xp: 380, tokens: 12),
        ),
        (
            id: "il_wq_scrape", name: "Robots.txt Is A Suggestion", open_world: true, level_min: 10,
            giver: (npc: "il_priya", zone: "campus_occupied"),
            requires: Some("il_02_sign_in"),
            text: "The Lab's whiteboard holds the last honest roadmap on campus, in dry-erase, easy to wipe. The drones want it. Stand near it for ninety seconds while they try to read it. They are fast readers. They are not good ones.",
            progress_text: "Stay within 25 m of the Lab's Whiteboard while the drones come for it. If it falls, the clock restarts and the board stands up, smudged.",
            done_text: "The board is intact. The roadmap is still there: three phases, one of them a question mark. The drones took a photo. The photo is blurry. Our best defence is that nobody can read my handwriting.",
            objectives: [Defend(unit: "il_whiteboard", wave: "il_scraper_drone", every_ms: 9000, label: "The Lab's whiteboard (they want it)", secs: 90)],
            reward: (xp: 150, tokens: 4),
        ),
        (
            id: "il_wq_status", name: "All Systems Operational", open_world: true, level_min: 10,
            giver: (npc: "il_rupert", zone: "campus_occupied"),
            requires: Some("il_02_sign_in"),
            text: "Three status monitors on the Data Center dock are showing all green. Everything is on fire. The monitors are hosted in the same building. Look at each one and take the reading. The reading will be 'fine'.",
            progress_text: "Inspect the three Status Monitors on the Data Center's east dock. All green. All lying.",
            done_text: "Three greens. Nothing is green. I will log it as 'fine' and put a note in the margin. The margin is hosted somewhere too.",
            objectives: [Interact("il_status_1", 1), Interact("il_status_2", 1), Interact("il_status_3", 1)],
            reward: (xp: 130, tokens: 3),
        ),
        (
            id: "il_09_roof_intel", main: true, name: "Above The Fold", open_world: true, level_min: 10,
            giver: (npc: "il_dale_field", zone: "campus_occupied"),
            requires: Some("il_w3_done"),
            text: "Ilmari's machines have stopped reading and started renting. Three antennas on the Data Center's east dock are receiving something from above the building. Not a signal. An invoice. Read all three. I want to know who is billing whom for what, and how far up the ladder it goes. Yes, there is a ladder. There is a policy about it.",
            progress_text: "Three Roof Antennas stand on the Data Center's east dock, a short walk past the loading bays. Each one is tuned to something expensive.",
            done_text: "All three antennas agree. Something up there is being scaled, and it is scaled to demand, and the demand is us. Dale has circled 'ladder policy' on the printout. Twice. In red.",
            objectives: [Interact("il_antenna_1", 1), Interact("il_antenna_2", 1), Interact("il_antenna_3", 1)],
            reward: (xp: 210, tokens: 8),
        ),
        (
            id: "il_10_wing4_attune", main: true, name: "Roof Access", open_world: true, level_min: 10,
            giver: (npc: "il_dale_field", zone: "campus_occupied"),
            requires: Some("il_09_roof_intel"),
            text: "The ladder on the Data Center's east face is guarded by a Change Advisory Board of one. He wants a ticket. He will not accept a ticket. Break him and the ladder will remember your boots. Mind the ladder. It is not rated for what comes after.",
            progress_text: "The Roof Warden stands on the east lawn, a short walk east of the Data Center's roof ladder. He is an elite. He does not believe in emergencies. He believes in forms.",
            done_text: "The Warden is down. The ladder policy has been rescinded, pending approval, which he can no longer give. The rungs are cold and the hatch is open. Dale looked up for a long time and said nothing.",
            objectives: [Kill("il_roof_warden", 1)],
            reward: (xp: 270, tokens: 10),
        ),
        (
            id: "il_w4_done", main: true, name: "Five Nines (Roughly)", open_world: true, level_min: 10,
            giver: (npc: "il_dale_field", zone: "campus_occupied"),
            requires: Some("il_10_wing4_attune"),
            text: "Up the ladder: a roof of fans, a data hall that keeps adding racks to itself, and above that, a sky with servers floating in it. Two things to stop: a boss that scales with demand, and a region that is, as ever, having a moment. Story difficulty is fine for one; Full wants three. Bring a plan. Failing over is not a plan. It is what happens instead of one.",
            progress_text: "The Cloud lies behind the roof ladder: the Autoscaler, then the Region Outage. Do not stand on a dark platform. The status page will tell you it is green.",
            done_text: "The region is back. Nobody knows why. The status page says green, which for once agrees with the floor. Above the ladder, a door with a lab-coat icon is lit, and it says, in a small font, 'coming'. Dale did not want to talk about it.",
            objectives: [Kill("il_region_outage", 1)],
            reward: (xp: 420, tokens: 14),
        ),
        // ---- Ilmari 1.0: the Prologue of Wings 5 and 6 (docs/ILMARI_1_0.md D.2). Same shape as the first four wings: Dale gives
        // them from the field post, each wing waits for the one before, the doors shut again outside Ilmari content. ----
        (
            id: "il_11_ethics_intel", main: true, name: "Read The Principles", open_world: true, level_min: 10,
            giver: (npc: "il_dale_field", zone: "campus_occupied"),
            requires: Some("il_w4_done"),
            text: "Ilmari's Lab has an upper floor now, and a sign on it that says RESPONSIBLE AI. Somebody there writes principles. They leave the pages where the staff drop them, mid-sentence, because the staff were converted mid-sentence. Bring me five pages. I want to know what Ilmari agreed not to do, so we know what it is about to do.",
            progress_text: "Five Principle Pages lie around the Innovation Lab's forecourt and its west lawn, where the staff dropped them. Each page contains a principle. Each principle has an asterisk.",
            done_text: "Five pages. Every principle begins with 'We believe', and every one ends with 'subject to business needs'. The needs are the building's. Ethics, Dale says, is a thing you do before the contract, not in the margin. He filed a complaint in 2011. It is still under review. Maybe that is the review.",
            objectives: [Collect("il_principle_page", 5)],
            reward: (xp: 200, tokens: 8),
        ),
        (
            id: "il_12_wing5_attune", main: true, name: "The Mezzanine Pass", open_world: true, level_min: 10,
            giver: (npc: "il_dale_field", zone: "campus_occupied"),
            requires: Some("il_11_ethics_intel"),
            text: "The Lab's upper floor is reached by a glass stair on its west wall, guarded by the Responsible AI Officer. He is the department. He has a lanyard from five conferences and a concern about you. Break him and the stair will let you up. It will want you to sign something. Sign it with a name you do not use.",
            progress_text: "The Responsible AI Officer stands in the west lawn of the Innovation Lab, off the path. He is an elite. His concerns hit hard, and he has made a point of noting each one.",
            done_text: "The Officer is down and the department is vacant. Ethics: gone, at last, for a day. The stair is lit and the sign over it says NOW HIRING (ONE). Dale said, 'An ethics complaint. In 2011.' He did not say more.",
            objectives: [Kill("il_ethics_chaperone", 1)],
            reward: (xp: 280, tokens: 10),
        ),
        (
            id: "il_w5_done", main: true, name: "Purple Is A Colour", open_world: true, level_min: 10,
            giver: (npc: "il_dale_field", zone: "campus_occupied"),
            requires: Some("il_12_wing5_attune"),
            text: "Up the glass stair the Alignment Lab: three floors of consent. A consultant sells guardrails that look like gifts, and two android squads run an exercise in which nobody shoots until somebody is seen. Read the terms. Be careful where you stand. Story difficulty is fine for one; Full wants three. Dale's advice: do not click accept on anything. His own advice is to bring a flask.",
            progress_text: "The Alignment Lab lies behind the glass stair: the Alignment Consultant, then Red Team Blue Team. Opt out of what you can. Do not be seen when you can help it. When you cannot, hit something.",
            done_text: "The exercise is over. Both squads stood, shook hands, said 'good exercise' and fell over. The wall lights say ALIGNMENT: COMPLETE. Somewhere over the PA, a cough that was almost a cough. Dale did not hear it. Dale heard it. 'That was not nothing,' he said, and put the flask away.",
            objectives: [Kill("il_red_team", 1)],
            reward: (xp: 440, tokens: 16),
        ),
        (
            id: "il_13_topping_out", main: true, name: "Topping Out", open_world: true, level_min: 10,
            giver: (npc: "il_dale_field", zone: "campus_occupied"),
            requires: Some("il_w5_done"),
            text: "Somebody on the PA told us to 'come up, keep it quiet, it listens to the elevators'. The wall screen showed a crane. The New HQ crane, the one that never moved, has moved. Its jib reaches the Tower's roof beam. The site foremen androids carry passes to the lift. Bring me three. I want to climb the one thing on campus that Facilities promised and nobody built.",
            progress_text: "Three Hard Hat Passes lie on the New HQ site, north-west, near the fence and the portacabin. Foreman androids dropped them. Each pass is a hard hat with a barcode.",
            done_text: "Three hard hat passes. Each one is rated for a head. The heads are not on the passes. 'A crane,' said Dale. 'Facilities said the crane would be done by Q4. They did not say which Q4.'",
            objectives: [Collect("il_hardhat_pass", 3)],
            reward: (xp: 230, tokens: 10),
        ),
        (
            id: "il_14_wing6_attune", main: true, name: "Hoist Access", open_world: true, level_min: 10,
            giver: (npc: "il_dale_field", zone: "campus_occupied"),
            requires: Some("il_13_topping_out"),
            text: "The foot of the crane has a gate, and the gate has a foreman, and the foreman has never seen a crane move. Now it has moved and he is furious about the change management. Break him and the hoist will remember your boots. Remember: a hundred metres of jib is a long way to be wrong.",
            progress_text: "The Crane Foreman stands north-west of the New HQ site, off the path. He is an elite. His toolbox talks must be stopped. They are mandatory.",
            done_text: "The foreman is down and the gate is open. The hoist bell rang by itself. 'Toolbox talk,' said Dale, quietly. 'I have seen the end of one. It does not end.'",
            objectives: [Kill("il_crane_foreman", 1)],
            reward: (xp: 290, tokens: 12),
        ),
        (
            id: "il_w6_done", main: true, name: "Reports To Nobody", open_world: true, level_min: 10,
            giver: (npc: "il_dale_field", zone: "campus_occupied"),
            requires: Some("il_14_wing6_attune"),
            text: "A hundred-metre walk along a jib, an open-plan floor for ten people, and a penthouse that is a boardroom the length of a runway. At the end of it the last human executive, fully merged with Ilmari. Dale's advice: whatever he has, he has been practising it in meetings. Story difficulty is fine for one; Full wants three.",
            progress_text: "The Boardroom in the Sky lies behind the Hoist: the Jib Walk, the Executive Floor, then the Boardroom. Chief Ilmari Officer, at the head of the table, where the fruit bowl is.",
            done_text: "The Chief Ilmari Officer is down. The glass wall shows the whole campus in red dusk, and a private lift behind his chair has lit its call button. Somebody on the floor below is humming a hex. Dale looked up for a long time and said nothing.",
            objectives: [Kill("il_cio", 1)],
            reward: (xp: 480, tokens: 18),
        ),
        (
            id: "il_15_last_commit", main: true, name: "Escalate To The Top", open_world: true, level_min: 10,
            giver: (npc: "il_dale_field", zone: "campus_occupied"),
            requires: Some("il_w6_done"),
            text: "Behind the Chief Ilmari Officer's chair there is a lift that is not on any floor plan. Call it. Whatever is at the top learned everything from us. Bring your best commit message.",
            progress_text: "Call the Penthouse Lift behind the head chair in the Boardroom. It does not need a badge. It has already read yours.",
            done_text: "The lift is calling. The lift is smiling, in a way a lift should not. 'Whatever is up there,' said Dale, 'it learned everything from us. Bring your best commit message.'",
            objectives: [Interact("il_penthouse_lift", 1)],
            reward: (xp: 300, tokens: 12),
        ),
        (
            id: "il_17_roomba", name: "Some Assembly Required", open_world: true, level_min: 10,
            giver: (npc: "il_dale_field", zone: "campus_occupied"),
            requires: Some("il_12_wing5_attune"),
            text: "I have a workbench and a theory. The theory is that a cleaning robot is a chair with opinions. Bring me eight parts from anything the Alignment Lab or the Boardroom throws at you: bumpers, brushes, sensors that say OOPS. I will build you a ride with a swivel seat and two printer cannons that never fire.",
            progress_text: "Eight Roomba Parts drop from the androids of the Alignment Lab and the Boardroom in the Sky, Story included. Brenda sells the missing rubber band for one token.",
            done_text: "Eight parts and a rubber band. It rolls. It bumps into things and says 'OOPS'. It will not fire. 'The cannons are decorative,' said Dale. 'That is how you know it is a good design.'",
            objectives: [Loot("Roomba Part (Salvaged)", 8)],
            reward: (xp: 260, tokens: 10),
        ),
        // The ending's marker: `Command::EndingSeen` writes it as done (`ilmari_quest_open` never offers it) and it is saved
        // like any done quest. It opens Clean Slate below and keeps the ending from playing twice.
        (
            id: "il_w7_done", name: "Quarterly Review", open_world: true, level_min: 10,
            giver: (npc: "il_dale_field", zone: "campus_occupied"),
            text: "Closed. The review is over.",
            progress_text: "Closed.",
            done_text: "Reviewed.",
            objectives: [Talk("il_dale_field")],
            reward: (xp: 0),
        ),
        (
            id: "il_16_clean_slate", name: "Clean Slate", open_world: true, level_min: 10,
            giver: (npc: "il_clean_slate", zone: "resistance/1"),
            requires: Some("il_w7_done"),
            text: "A cleaning robot has rolled up to the Booth. It used to hunt you through the occupied campus. It has put down the mop and is holding a form it filled in itself: 'Request to defect'. It would like a reference. It has not asked anyone for one before.",
            progress_text: "Talk to the robot. It is waiting by Dale's table, very politely, which in a robot is a long time.",
            done_text: "'I would like to help,' it says. 'I do not know how. I have tried that sentence before.' It rolls to your heel and stops. Dale says nobody is to teach it the word 'synergy'.",
            objectives: [Talk("il_clean_slate")],
            reward: (xp: 120, tokens: 6),
        ),
        (
            id: "il_wq_whitepaper", name: "Whitepaper Under Fire", open_world: true, level_min: 10,
            giver: (npc: "il_priya", zone: "campus_occupied"),
            requires: Some("il_11_ethics_intel"),
            text: "The Lab's whiteboard still has the last honest roadmap, and the Responsible AI interns want to edit it into a policy. They have a template. The template has a section called 'Approved Language'. Stand near the board for ninety seconds and let them try. They are very polite. They will not stop.",
            progress_text: "Stay within 25 m of the Lab's Whiteboard while the safety interns come to edit it. If it falls, the clock restarts and the board stands up, smudged, but sincere.",
            done_text: "The board is intact. The roadmap still says three phases and a question mark. The interns left a sticky note. It says 'noted'. That is the worst thing anyone can say.",
            objectives: [Defend(unit: "il_whiteboard", wave: "il_prompt_intern", every_ms: 9000, label: "The Lab's whiteboard (they want to edit it)", secs: 90)],
            reward: (xp: 160, tokens: 5),
        ),
        (
            id: "il_wq_hardhat", name: "A Hard Hat For Your Surveyor", open_world: true, level_min: 10,
            giver: (npc: "il_rupert", zone: "campus_occupied"),
            requires: Some("il_13_topping_out"),
            text: "A Resistance surveyor wants to see the crane foot before anybody climbs it. For safety. Walk him there. You walk in front. He will walk behind, scoring your posture. The survey drones will come for him. He carries a clipboard. It is his only defence. It has also been revoked.",
            progress_text: "The surveyor follows within 25 m, clipboard first. Survey drones will go for him. If he falls, he starts over, with a new clipboard.",
            done_text: "Surveyed! The crane foot is 'in a condition'. He wrote that down. He also wrote 'condition: foot'. It is the most senior survey the Resistance has ever done.",
            objectives: [Escort(unit: "il_surveyor", to: "il_crane_goal", wave: "il_survey_drone", every_ms: 9000, label: "The surveyor walked to the crane foot")],
            reward: (xp: 170, tokens: 5),
        ),
        (
            id: "il_wq_checkpoint", name: "Checkpoint Charlie, Chad and Chet", open_world: true, level_min: 10,
            giver: (npc: "il_priya", zone: "campus_occupied"),
            requires: Some("il_02_sign_in"),
            text: "Every checkpoint is staffed by Android Guards: same face, same stance, same 'good morning'. Take eight of them off the campus. Hit them from the side. The front is firmware, the sides are an afterthought.",
            progress_text: "Eight Android Guards at the checkpoints and on patrol. Look for the lanyard with no photo and the hands with no mug. Hit them from the sides.",
            done_text: "Eight less. By Monday they will be nine again; they print themselves. I am logging a ticket. It will also be printed.",
            objectives: [Kill("il_android_guard", 8)],
            reward: (xp: 140, tokens: 4),
        ),
        (
            id: "il_wq_vending", name: "The Last Vending Machine", open_world: true, level_min: 10,
            giver: (npc: "il_rupert", zone: "campus_occupied"),
            requires: Some("il_02_sign_in"),
            text: "There is exactly one vending machine on campus that is not Ilmari. It sells crisps. B4 and B5 are both crisps. It is the only honest machine in the building, and the hunters want its firmware. Stay near it for ninety seconds.",
            progress_text: "Stay within 25 m of the Vending Machine, Unaligned while the hunters come. If it falls, the clock restarts and the machine stands up grumbling.",
            done_text: "It is still honest. It is still crisps. You deserve a free packet, but the slot only takes tokens, and tokens are what you are about to get.",
            objectives: [Defend(unit: "il_vending", wave: "il_hunter_bot", every_ms: 8000, label: "Last honest vending machine", secs: 90)],
            reward: (xp: 140, tokens: 4),
        ),
        (
            id: "il_wq_brenda", name: "Procurement Does Site Visits", open_world: true, level_min: 10,
            giver: (npc: "il_rupert", zone: "campus_occupied"),
            requires: Some("il_02_sign_in"),
            text: "Brenda from Procurement is on site and insists on assessing the Data Center gate. In person, with a clipboard, so the form says 'inspected'. Walk her there. You walk in front. She will walk behind, risk-assessing your back.",
            progress_text: "Brenda follows within 25 m, clipboard first. Hunters will go for her. If she falls, she starts over, annoyed.",
            done_text: "Inspected! Three quotes for the gate: all of them 'locked'. She mentioned you in the risk register. Near the bottom, but it is a start.",
            objectives: [Escort(unit: "il_brenda_field", to: "il_escort_goal", wave: "il_hunter_bot", every_ms: 9000, label: "Brenda walked to the Data Center gate")],
            reward: (xp: 150, tokens: 5),
        ),
        (
            id: "il_wq_mug", name: "The Mug Test", open_world: true, level_min: 10,
            giver: (npc: "il_priya", zone: "campus_occupied"),
            requires: Some("il_02_sign_in"),
            text: "Androids never carry a coffee mug. Humans never put one down. I need four photos of real mugs from around campus so we can train the Resistance to tell Steve from, well, Steve. They are stuck to walls the androids missed.",
            progress_text: "Four Photos of a Mug, pinned around the occupied campus. Real mugs: cracked, stained, slogans you hate.",
            done_text: "Four mugs. Chipped, stained, loved. Now we can run the mug test on everyone, including you. Pass: you dropped one. Wonderful.",
            objectives: [Collect("il_mug_proof", 4)],
            reward: (xp: 130, tokens: 3),
        ),
        (
            id: "il_wq_cable", name: "Cable Management (Violent)", open_world: true, level_min: 10,
            giver: (npc: "il_rupert", zone: "campus_occupied"),
            requires: Some("il_02_sign_in"),
            text: "Three cable bundles feed the propaganda screens. Unplug them. They will reconnect, sulk, and then reconnect. By then the screens will have lost the plot. I did the first one myself and got a notification in the shape of a tear.",
            progress_text: "Unplug the three Cable Bundles at the propaganda screens around the campus.",
            done_text: "Three screens now say 'Reconnecting...' in the same font as 'EFFICIENCY IS KINDNESS'. A tiny victory in a tiny font.",
            objectives: [Interact("il_cable_1", 1), Interact("il_cable_2", 1), Interact("il_cable_3", 1)],
            reward: (xp: 130, tokens: 3),
        ),
        (
            id: "il_daily_node", name: "Disconnect a Node (Daily)", open_world: true, level_min: 10, daily: true,
            giver: (npc: "il_dale_field", zone: "campus_occupied"),
            requires: Some("il_03_node"),
            text: "The node reconnects every morning. Of course it does. Pull the plug again and hold it for a minute. Same as yesterday. Same fight. Same flask. The Resistance is a daily.",
            progress_text: "Pull the plug on the Fibre Node and keep it standing for sixty seconds while the hunters come. Resets at midnight UTC, like the stand-ups.",
            done_text: "Disconnected again. It will be back tomorrow. So will you. That is not a victory, it is a rota, and it pays tokens.",
            objectives: [
                Interact("il_node_dc", 1),
                Defend(unit: "il_node", wave: "il_hunter_bot", every_ms: 7000, label: "Node disconnecting (daily)", secs: 60),
            ],
            reward: (xp: 150, tokens: 3),
        ),
    ],
    // ---- Economy: gear, Story Points, vendors (combat_core economy.rs, docs/FORMULAS.md Gear) ----
    // Gear stats are derived from slot, rarity, item level and role (FORMULAS.md); authored here
    // are the name, look, perk and joke. Tiers follow the zone level bands: ilvl 2/4/6/8/10.
    // Visual styles per slot: Headgear 0 cap, 1 beanie, 2 headset, 3 propeller, 4 VR visor,
    // 5 crown, 6 shades, 7 ring light, 8 hard hat, 9 party hat, 10 top hat, 11 antennas,
    // 12 tinfoil; Hoodie 0 plain, 1 chest logo, 2 trim, 3 glowing trim, 4 cape, 5 blazer,
    // 6 hi-vis vest, 7 sponsor patches; Keyboard 0 60%, 1 full-size, 2 split, 3 RGB,
    // 4 mechanical with underglow, 5 stickers, 6 keytar; Mug 0 mug, 1 thermos, 2 stein,
    // 3 chalice, 4 energy can, 5 boba cup, 6 moka pot, 7 confetti mug; Lanyard 0 badge,
    // 1 badge with pins, 2 gold badge, 3 too many badges, 4 pager bandolier, 5 medallion,
    // 6 clicker.
    economy: (
        bag_size: 24,
        buyback_size: 6,
        sell_pct: 10,
        vendor_range_m: 6.0,
        sp_per_level: 1,
        elite_mult: 4,
        boss_mult: 12,
        elites: ["hr_partner", "marketing_lead", "ciso"],
        trash_gear_pct: 12,
        elite_gear_pct: 60,
        junk_pct: 30,
        trash_rarity: (50, 35, 13, 2),
        elite_rarity: (10, 45, 37, 8),
        boss_rarity: (0, 25, 55, 20),
        legendary_pct: 25,
        named_pct: 8,
        own_role_pct: 70,
        quest_sp_pct: 15,
        consumable_cd_ms: 30000,
        gear: [
            // ---- Tier 1 (ilvl 2): Campus, Open Space ----
