            (key: "cowork_coffee", name: "Oat Latte Tap (Coworking)", zone: "campus", kind: Coffee,
             auras: [("fresh_brew", 120000)], fail_pct: 20, cooldown_ms: 3000, calm: Some((60, 120000))),
            (key: "smoothie_bar", name: "Wellness Smoothie Bar", zone: "campus", kind: Vending,
