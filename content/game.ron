            (name: "Guardrails Plate (Load-Bearing)", icon: "gear_vest", slot: Hoodie, rarity: Epic, ilvl: 20, role: Some(Tank), set: Some("hard_constraints"), source: Ilmari, drops_from: Some("il_cio"),
