            (name: "Spot Instance Voucher (Revoked)", icon: "token_invoice", price: 40, mana_pct: 30,
             description: "Restores 30% of your mana. Valid until the region goes down, which it has, so Brenda honours it out of spite."),
            (name: "Last Commit Mint (Signed Off)", icon: "revert_commit", price: 60, mana_pct: 50,
             description: "Restores 50% of your mana. The wrapper says it was reviewed. The wrapper is the only thing that was."),
        ],
