            (name: "Matcha Shot With a Story", icon: "caffeine", price: 20, mana_pct: 25, cast: Some(921),
             description: "Restores 25% of your mana and +15% haste for 20 s. The barista explains its origin. At length."),
            (name: "Sticky Note: 'Fix Later'", icon: "sticky", price: 10, cast: Some(908),
             description: "Removes one harmful effect. You will fix the rest later. You will not."),
            // Pet carriers (see `pets` below): using one adds the companion to ~/pets.
            (name: "Boxed Rubber Duck", icon: "rubber_duck", price: 40,
             description: "Companion. Use to adopt. Listens without judgement, then tells you what you did wrong."),
            (name: "Office Plant in a Sad Pot", icon: "wellness", price: 15,
             description: "Companion. Use to adopt. Watered once, in 2019, by an intern."),
            (name: "Stress Ball (Company Logo)", icon: "stress_ball", price: 25,
             description: "Companion. Use to adopt. Squeezed so often the logo is now a different company."),
            (name: "AI Copilot License Key", icon: "chatbot_rollout", price: 60,
             description: "Companion. Use to activate. Terms of service longer than your codebase."),
            (name: "Roomba Drone (Refurbished)", icon: "robot", price: 60,
             description: "Companion. Use to adopt. Sweeps up the junk you were going to ignore anyway."),
            (name: "Tamagotchi Build Pipeline", icon: "health_ping", price: 60,
             description: "Companion. Use to adopt. Feed it commits or it turns red. It turns red anyway."),
            (name: "Legacy Server Rack (Tiny)", icon: "rack_chair", price: 60,
             description: "Companion. Use to adopt. Runs the payroll system. Nobody knows how. Do not unplug."),
            (name: "Conference Wi-Fi Router (Sealed)", icon: "gear_antenna", price: 60,
             description: "Companion. Use to adopt. Four antennas, one blinking orange light, zero internet."),
            (name: "Party Leftovers Container (Sealed)", icon: "sandwich", price: 60,
             description: "Companion. Use to adopt. Silver, Teambuilding. Three canapes, one mystery skewer, forty napkins."),
