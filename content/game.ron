            (name: "All-Hands Doughnut", icon: "junk_donut", price: 16, cast: Some(944),
             description: "Heals 220 + 40% of your spell power. The announcements were bad; the glazing was excellent."),
            (name: "Fresh Batch Brew", icon: "coffee_pot", price: 12, cast: Some(945),
             description: "+40 mana regeneration for 15 s. Someone actually made a fresh pot. A miracle."),
            (name: "Emergency Desk Chocolate", icon: "chocolate", price: 15, cast: Some(923),
             description: "+10% damage and healing for 30 s. Kept in the bottom drawer for exactly this kind of sprint."),
            (name: "Sick Day Note (Signed by a Chatbot)", icon: "wellness", price: 25, cast: Some(912),
             description: "40% less damage taken for 8 s. HR accepted it. HR is also a chatbot."),
            (name: "Launch Party Pizza Box", icon: "pizza", price: 30, cast: Some(929),
             description: "Heals every ally within 10 m. Shared generously; the launch was cancelled anyway."),
            (name: "Energy Drink (Zero Sugar, Full Regret)", icon: "gear_soda", price: 22, mana_pct: 60,
