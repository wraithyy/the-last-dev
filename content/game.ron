        // ---- variety pass ----
        (name: "Core Dump (14 GB)", icon: "sticky", bonus: (max_mana: 4),
         description: "Fourteen gigabytes of memory, frozen the moment it died. Mostly cat pictures from the cache."),
        (name: "Unlabelled Backup Tape", icon: "cron", bonus: (max_hp: 5),
         description: "Could be prod. Could be someone's wedding video. Restore time: six business weeks."),
        (name: "Restore Test Certificate (Never Tested)", icon: "padlock", bonus: (max_hp: 20, spell_power: 5),
         description: "Certifies that restores work. Signed by the backup job itself, mid-failure."),
        (name: "Model Card (Mostly Redacted)", icon: "prompt_fragment", bonus: (spell_power: 3),
         description: "Intended use: everything. Limitations: [REDACTED]. Training data: 'the internet, roughly'."),
        (name: "Automation Audit Log (2,000 Pages)", icon: "sticky", bonus: (max_hp: 16, spell_power: 3),
         description: "Every ticket Rule #47 closed, reopened and closed again. Nobody has read page two."),
        (name: "Signed Go-Live Date (Non-Negotiable)", icon: "deadline", bonus: (max_hp: 20, crit_pct: 0.5),
         description: "Signed by four VPs who will all have left by then. The date is in the past already."),
        (name: "Incident Commander Armband (Expired)", icon: "standup", bonus: (max_hp: 12),
         description: "Worn for one sev-1 and every postmortem since. Smells faintly of pizza and blame."),
        (name: "Green Build Badge (Flaky)", icon: "pull_request", bonus: (spell_power: 3),
         description: "Passed on the fifth retry. Nobody changed anything. Framed anyway."),
        // ---- dungeon: The Onboarding quest goods ----
        (name: "Laptop Box (Empty)", icon: "box", bonus: (max_hp: 3),
         description: "Delivered, signed for and empty. The sticker says 'fragile', which is how you now feel."),
        // ---- Ilmari tokens: no bonus, so Ilmari quest loot never carries power into the base game ----
        (name: "Ilmari Token", icon: "access_badge", kind: Token, bonus: (),
         description: "Resistance currency, issued by Brenda, accepted by Brenda, redeemed three quotes later."),
        (name: "Blank Badge", icon: "visitor_badge", kind: Token, bonus: (),
         description: "No name, no photo, no mug. Androids print them by the pallet. Brenda collects them."),
        // ---- Ilmari 1.0 (docs/ILMARI_1_0.md D.7): the Legendary forge's currency and the Roomba's parts, tokens too ----
        (name: "Legendary Fragment", icon: "access_badge", kind: Token, bonus: (),
         description: "One fifth of a quote. Brenda promises that all five quotes are the same quote."),
        (name: "Roomba Part (Salvaged)", icon: "robot", kind: Token, bonus: (),
         description: "A bumper, a brush or a sensor that says 'OOPS'. Eight make a Roomba. Dale has a workbench."),
        // ---- The core (docs/ILMARI_1_0.md D.2.4, D.5): the quest item that lights the fourth terminal. ----
        (name: "Marie's Autonomy Log", icon: "access_badge", kind: Token, bonus: (),
         description: "A printout from a desk in the occupied campus. It counts from 3 to 97 percent and the last line is a cough."),
    ],
    // Zone ids and anchors are a contract with the client layouts (docs/COMBAT_API.md, Zones).
    // `links` are exits: the anchor the client triggers on, the zone it leads to, and the world
    // progress that opens it (None = always open).
