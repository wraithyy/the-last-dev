            packs: [
                (anchor: "pack_1", units: ["gpu_cultist", "cooling_fan"]),
                (anchor: "pack_2", units: ["token_counter", "rogue_agent"]),
                (anchor: "pack_3", units: ["gpu_cultist", "gpu_cultist", "cooling_fan"]),
                (anchor: "pack_4", units: ["rogue_agent", "token_counter"]),
                (anchor: "pack_5", units: ["gpu_cultist", "rogue_agent", "cooling_fan"]),
