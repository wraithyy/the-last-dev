            (name: "AI Copilot License Key", icon: "chatbot_rollout", price: 60,
             description: "Companion. Use to activate. Terms of service longer than your codebase."),
            (name: "Roomba Drone (Refurbished)", icon: "robot", price: 60,
             description: "Companion. Use to adopt. Sweeps up the junk you were going to ignore anyway."),
            (name: "Tamagotchi Build Pipeline", icon: "health_ping", price: 60,
