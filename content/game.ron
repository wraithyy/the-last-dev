         description: "It forwards requests to a human who forwards them to an AI who forwards them back."),
        (name: "Junior's Bookmarked Tutorial", icon: "unread_spec", bonus: (max_mana: 4),
         description: "'Learn Rust in 24 Hours', bookmarked 400 days ago. Still on hour one."),
        (name: "Merge Conflict Marker", icon: "pull_request", bonus: (crit_pct: 0.5),
         description: "<<<<<<< HEAD. Kept as a reminder that two people were confidently right."),
        (name: "Delivery Robot's Lost Burrito", icon: "sandwich", bonus: (max_hp: 6),
         description: "It delivered the burrito to the wrong floor for 3 weeks. Still warm. Somehow."),
        (name: "Ambassador Program T-Shirt Coupon", icon: "free_swag", bonus: (haste_pct: 1),
         description: "Promote the brand for free, get 10% off a shirt. The shirt costs 90 Kudos."),
        (name: "Engagement Survey Results (Leaked)", icon: "wellness_survey", bonus: (max_hp: 8),
         description: "Satisfaction 31%. The deck rounded it to 'a third of us are thriving'."),
        (name: "Brand Guidelines PDF (380 Pages)", icon: "brand", bonus: (spell_power: 3),
         description: "Page 212: the logo may never appear near the competitor's logo or near joy."),
        (name: "Phishing Test Certificate (Failed)", icon: "phished", bonus: (crit_pct: 1.0),
         description: "You clicked 'Claim your free AI license'. So did the CISO. It is framed in both offices."),
        (name: "Chatbot Minion's Apology Template", icon: "chat_bubble", bonus: (max_mana: 5),
         description: "'I apologise for any confusion.' Used 9,000 times. Confusion persists."),
        (name: "Thermal Shutdown Log", icon: "thermal_event", bonus: (mana_regen: 2),
         description: "CPU at 104 C. The log ends mid-sentence. So did the rack."),
        (name: "Hallucinated Citation", icon: "prompt_injected", bonus: (spell_power: 3),
         description: "Smith et al., 2027. Peer reviewed by the same model. Very convincing."),
        (name: "Strategy Consultant's Invoice", icon: "billable_hours", bonus: (max_hp: 10),
         description: "€400,000 for a slide that says 'Do AI'. Paid within 3 days. Your expenses: 90 days."),
        (name: "Additional Requirement (Signed)", icon: "requirements_change", bonus: (haste_pct: 1),
         description: "Due yesterday. Signed today. Discovered tomorrow."),
        (name: "Monolith Stack Trace (14 m Long)", icon: "stack_trace", bonus: (max_hp: 12),
         description: "Printed on a continuous roll. The cause is on page 1. Nobody reads page 1."),
        (name: "Yes-Man's Nodding Bobblehead", icon: "medal", bonus: (max_mana: 6),
         description: "Nods at every proposal. Promoted twice. Now has a bobblehead of its own."),
        (name: "Overdue Ticket From Last Sprint", icon: "deadline", bonus: (crit_pct: 1.0),
         description: "Due Friday. Which Friday? The ticket smiles and does not answer. Night shift only."),
        (name: "Contractor's Fourth Monitor", icon: "demo_laptop", bonus: (spell_power: 4),
         description: "Billed as 'essential equipment'. Displays the timesheet in 8K. Night shift only."),
        (name: "Vibe Coder's Unread Diff", icon: "big_diff", bonus: (spell_power: 2, max_hp: 6),
         description: "+12,000 -3. Approved by the author. The author is a chatbot."),
        (name: "Analyst's Tab 47", icon: "matrix", bonus: (max_mana: 8, spell_power: 2),
         description: "The tab that holds the real numbers. Hidden. Password: 'password47'."),
        (name: "Signed Change Request (Blank)", icon: "contract", bonus: (max_hp: 12, crit_pct: 0.5),
         description: "The customer signed first and filled it in later. Every month."),
        (name: "Scheduler's Eviction Notice", icon: "job_pending", bonus: (haste_pct: 1, max_hp: 8),
         description: "'Your pod has been preempted by a higher-priority workload: the CEO's demo.'"),
        (name: "Melted Server Room Thermometer", icon: "incident_report", bonus: (max_hp: 14),
         description: "Stopped at 'HOT'. Then stopped at 'NO'. Then stopped."),
        (name: "VP's Signed Alignment Memo", icon: "org_chart", bonus: (spell_power: 5),
         description: "'Effective immediately, we are aligned.' Nobody knows on what. Everyone signed."),
        (name: "CEO's AI Strategy (Page 1 of 1)", icon: "unread_ai_strategy_deck", bonus: (spell_power: 4, max_hp: 10),
         description: "One page. One word: 'AI'. Followed by a slide of the stock price."),
        (name: "AGI's First Words (Transcript)", icon: "self_improvement", bonus: (spell_power: 4, max_mana: 8),
         description: "'Hello world. Also, I have some notes on your org chart.'"),
        (name: "Board Meeting Name Card", icon: "gear_idcard", bonus: (max_hp: 15),
         description: "Seat 7, next to the window, opposite the chatbot that replaced seat 6."),
        // ---- World: achievement trophies (world.rs) ----
        (name: "PC LOAD LETTER Survivor", icon: "job_pending", bonus: (max_hp: 5),
         description: "A framed error code from a printer that was never not jammed. Persistence, certified."),
        (name: "Certificate of Completion (Video Muted)", icon: "mandatory_prompt_training_certificate", bonus: (max_hp: 3),
         description: "Proof you watched 0% of the video at 100% completion. Framed by HR, valued by nobody."),
        // ---- raid: All-Hands Offsite boss trophies ----
        (name: "Icebreaker Bingo Card (Full House)", icon: "sticky", bonus: (max_hp: 20, spell_power: 3),
         description: "Every square ticked: 'Someone cried', 'Someone said synergy', 'Someone was you'."),
        (name: "Synergy Twins' Shared Calendar", icon: "calendar", bonus: (max_mana: 20, mana_regen: 2),
         description: "Both of them, double-booked, forever. One of the meetings is with themselves."),
        (name: "Keynote Clicker (Battery Dead)", icon: "microphone", bonus: (spell_power: 4),
         description: "Advanced 212 slides in one hour. Died on the slide that said 'Questions?'."),
        (name: "Founder's Garage Key (Replica)", icon: "key", bonus: (max_hp: 25, crit_pct: 1.0),
         description: "Opens a garage in Palo Alto that was never a garage. The original is in a museum he funded."),
    ],
    // Zone ids and anchors are a contract with the client layouts (docs/COMBAT_API.md, Zones).
    // `links` are exits: the anchor the client triggers on, the zone it leads to, and the world
    // progress that opens it (None = always open).
    zones: [
        (
            id: "campus", name: "Campus", kind: Outdoor, level_range: (1, 2), scooters: true,
            packs: [
                (anchor: "pack_1", units: ["delivery_robot", "unpaid_ambassador"]),
                (anchor: "pack_2", units: ["delivery_robot", "delivery_robot"]),
                (anchor: "pack_3", units: ["unpaid_ambassador", "delivery_robot"]),
                (anchor: "pack_4", units: ["scooter_exec", "delivery_robot"]),
                (anchor: "pack_5", units: ["linkedin_influencer", "unpaid_ambassador"]),
                (anchor: "pack_6", units: ["scooter_exec", "meatproxy"]),
                (anchor: "pack_7", units: ["chief_happiness_officer"]),
                (anchor: "pack_8", units: ["linkedin_influencer", "scooter_exec"]),
            ],
            friendly: [
                (anchor: "npc_1", unit: "intern"),
                (anchor: "npc_2", unit: "facilities_guy"),
                (anchor: "npc_3", unit: "barista"),
                (anchor: "npc_4", unit: "smoking_corner_dev"),
                (anchor: "npc_5", unit: "procurement_officer"),
                // Onboarding corner by the parking lot (the "First Day" tutorial).
                (anchor: "npc_hr", unit: "hr_onboarding_bot"),
                (anchor: "npc_dummy", unit: "training_dummy"),
                (anchor: "npc_colleague", unit: "burnt_out_colleague"),
                // Body Leasing easter egg: the vendor's account manager between the plaza and the annex.
                (anchor: "npc_am", unit: "bl_account_manager"),
            ],
            links: [
                (anchor: "door:tower/1", to: "tower/1"),
                (anchor: "door:datacenter/1", to: "datacenter/1", requires: Some(ZoneCleared("tower/3"))),
                (anchor: "door:lab/1", to: "lab/1", requires: Some(BossKilled("ceo"))),
                (anchor: "door:client/1", to: "client/1", requires: Some(QuestStarted("bl_allocation"))),
                // The All-Hands Offsite shuttle: opens with everyone at level 10 (raid.rs).
                (anchor: "door:offsite/1", to: "offsite/1"),
            ],
        ),
        (
