            (name: "Matcha Shot With a Story", icon: "caffeine", price: 20, mana_pct: 25, cast: Some(921),
             description: "Restores 25% of your mana and +15% haste for 20 s. The barista explains its origin. At length."),
            (name: "Sticky Note: 'Fix Later'", icon: "sticky", price: 10, cast: Some(908),
             description: "Removes one harmful effect. You will fix the rest later. You will not."),
            // Pet carriers (see `pets` below): using one adds the companion to ~/pets.
            (name: "Boxed Rubber Duck", icon: "rubber_duck", price: 40,
