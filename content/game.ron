    // A quest's `requires` must be listed before it. Kills count for the killer and the group
    // members near the kill, and also before accepting (kills are counted per run: retro
    // credit). Loot counts copies already carried at accept time plus pickups while active;
    // `quest: Some(..)` loot entries drop only while the quest wants them. Every zone's givers
    // stand at its arrival and hand out its own work; `turn_in` breadcrumbs send you to the next
    // zone's giver. Order is campaign order (ticket ids follow it).
    quests: [
        // ---- Campus (levels 1-2): intern, Facilities Guy, Barista, Smoking-Corner Dev ----
        (
            id: "onboarding", name: "Onboarding",
            giver: (npc: "intern", zone: "campus"),
            text: "Hi! I'm your onboarding buddy. The AI assigned me to you, and you to me, and it thinks we're both interns. Step one: introduce yourself to Facilities. He's by the badge reader. He's been by the badge reader since the badge reader got AI.",
            progress_text: "The onboarding chatbot says Facilities is 'a valued stakeholder'. He's the guy with the ladder.",
            done_text: "You talked to a human, in person, on purpose? I'll log it as a 'synchronous alignment touchpoint'. Welcome aboard!",
            objectives: [Talk("facilities_guy")],
            reward: (xp: 40),
        ),
        (
            id: "badge_access_denied", name: "Badge Access Denied",
            giver: (npc: "facilities_guy", zone: "campus"),
            requires: Some("onboarding"),
            text: "The new AI access system flagged every human on campus as a tailgater. The delivery robots got the badges instead. They took them 'for safekeeping' and keep delivering them to the roof. Get four back before the system revokes oxygen.",
            progress_text: "Four badges. The robots are the ones driving in circles, apologizing to bollards.",
            done_text: "Four badges. One of them is mine. I'm the guy in the photo with hair. Here, take a visitor badge. It still works, because nobody connected it to the AI.",
            objectives: [Loot("Access Badge", 4)],
            reward: (xp: 100, trophy: Some("Temporary Visitor Badge")),
        ),
        (
            id: "coffee_run", name: "Coffee Run",
            giver: (npc: "barista", zone: "campus"),
            text: "The milk supplier got replaced by an 'AI-native beverage platform'. It sends prompts instead of milk. The brand ambassadors outside are handing out the only oat milk left, printed on flyers. Bring me three Oat Milk Prompts. Don't ask me what I'll do with them.",
            progress_text: "Three Oat Milk Prompts. The ambassadors are the ones in the branded hoodies. Unpaid. Very enthusiastic.",
            done_text: "Three prompts. I steeped them in hot water. It's terrible. It's also the best coffee on campus. Don't tell anyone I said something nice.",
            objectives: [Loot("Oat Milk Prompt", 3)],
            reward: (xp: 80, trophy: Some("Barista's Silent Judgment")),
        ),
        (
            id: "fire_exit_strategy", name: "Fire Exit Strategy",
            giver: (npc: "facilities_guy", zone: "campus"),
            requires: Some("onboarding"),
            text: "E-scooter executives park across the fire exits. When I asked one to move, he said fire exits are 'legacy thinking' and the AI will 'route around the fire'. Knock three of them off their scooters. Gently. Or not.",
            progress_text: "Three executives. They're the blur with a podcast microphone clipped to the handlebar.",
            done_text: "Fire exits clear. The AI logged it as 'unplanned sidewalk optimization' and gave itself a bonus. I'm used to it.",
            objectives: [Kill("scooter_exec", 3)],
            reward: (xp: 100),
        ),
        (
            id: "content_moderation", name: "Content Moderation",
            giver: (npc: "smoking_corner_dev", zone: "campus"),
            text: "The Network Influencers found the smoking corner. They film 'a day in the life of an AI-first builder' here. Nobody here builds anything anymore. Take out two of them before one of them interviews me.",
            progress_text: "Two influencers. Follow the ring light.",
            done_text: "Quiet again. I can hear myself think. Mostly I think about quitting. Here, have my lighter. I don't smoke. I just held it so they'd leave me alone.",
            objectives: [Kill("linkedin_influencer", 2)],
            reward: (xp: 100, trophy: Some("Smoking Corner Lighter (Empty)")),
        ),
        (
            id: "lunch_order_recovery", name: "Lunch Order Recovery",
            giver: (npc: "intern", zone: "campus"),
            requires: Some("onboarding"),
            text: "The delivery robots bring everyone's lunch to 'AI Agent, Desk 0' because the agent has the highest engagement score. The agent doesn't eat. The agent doesn't have a desk. Could you get four lunches back? One of them is mine. I think. I ordered by prompt.",
            progress_text: "Four Misdelivered Lunch Orders. The delivery robots carry them while they recalculate their route to nowhere.",
            done_text: "Four lunches! Mine is the one with the sticky note that says 'make it healthy but also pizza'. The AI interpreted that as a single grape. Here, I found this in the robot's spare compartment.",
            objectives: [Loot("Misdelivered Lunch Order", 4)],
            reward: (xp: 120, gear_tier: 1),
        ),
        (
            id: "human_in_the_loop", name: "Human in the Loop",
            giver: (npc: "smoking_corner_dev", zone: "campus"),
            requires: Some("content_moderation"),
            level_min: 2,
            text: "You know what 'human in the loop' means here? It means a MeatProxy pastes the chatbot's answer into a ticket and goes to lunch. There are dozens of them, from the parking lot to the penthouse. Close eight loops. Earlier ones count, I keep a tally.",
            progress_text: "Eight MeatProxies. They're the ones saying 'Great question!' to nobody. Campus, tower, anywhere.",
            done_text: "Eight loops closed. Ticket throughput dropped 80 percent. Customer satisfaction went up. Nobody will connect those two facts.",
            objectives: [Kill("meatproxy", 8)],
            reward: (xp: 250, sp: 10),
        ),
        (
            id: "mandatory_fun", name: "Mandatory Fun",
            giver: (npc: "barista", zone: "campus"),
            level_min: 2,
            group: true,
            text: "The Chief Happiness Officer made me write 'You Matter' on every cup. With a smiley. In a font chosen by an AI focus group. He's holding a trust-fall workshop on the lawn and he has backup. Bring a friend if you have one. Make him unhappy.",
            progress_text: "The Chief Happiness Officer. Lawn, near the inflatable 'Culture Pillars'. He enrages if the fun runs long. Group recommended.",
            done_text: "He's gone. The cups say 'Coffee' again. I cried a little, then I charged a customer for it. Here, his wristband. It measures enthusiasm. Wear it ironically.",
            objectives: [Kill("chief_happiness_officer", 1)],
            reward: (xp: 200, trophy: Some("Mandatory Fun Wristband"), gear_tier: 1),
        ),
        (
            id: "escalation_path", name: "Escalation Path",
            giver: (npc: "intern", zone: "campus"),
            requires: Some("onboarding"),
            turn_in: Some((npc: "helpdesk_lead", zone: "tower/1")),
            text: "IT Support on the first floor asked for 'a senior human, any senior human'. I said I'd find one. You're the only one left! Go up the tower stairs to the Open Space and report to the IT Support Lead. Bring patience. Her queue is longer than the onboarding deck.",
            progress_text: "The IT Support Lead stands by the stairs in the Open Space, tower floor 1. Look for the woman with the 4,812-ticket stare.",
            done_text: "A senior engineer. In person. Not a chatbot wearing a senior engineer's LinkedIn photo. Sit. No, don't sit, there's work.",
            objectives: [Talk("helpdesk_lead")],
            reward: (xp: 60),
        ),
        // ---- Tower floor 1, Open Space (levels 1-2): IT Support Lead ----
        (
            id: "forwarded_to_ai", name: "Re: Fwd: Re: Your Ticket",
            giver: (npc: "helpdesk_lead", zone: "tower/1"),
            text: "Every ticket I send to this floor comes back with 'As an AI language model' pasted on top. It's the MeatProxies. They forward my questions to a chatbot and forward the answer back, with my name on it. Close three of their loops. Permanently.",
            progress_text: "Three MeatProxies on this floor. They type with one finger and look proud of it.",
            done_text: "Three fewer forwards. My inbox just dropped from 'catastrophic' to 'regrettable'. That's a promotion for my inbox.",
            objectives: [Kill("meatproxy", 3)],
            reward: (xp: 110, sp: 10),
        ),
        (
            id: "autocomplete_pest_control", name: "Autocomplete Pest Control",
            giver: (npc: "helpdesk_lead", zone: "tower/1"),
            text: "The Copilot Drones were a pilot program. The pilot ended. The drones did not. They hover over keyboards finishing everyone's sentences, mostly with the word 'synergy'. Swat five of them.",
            progress_text: "Five Copilot Drones. They buzz in swarms and suggest things. Ignore the suggestions.",
            done_text: "Five drones down. Someone just typed a whole sentence without help and cried. Happy tears, I think. Hard to tell in this industry.",
            objectives: [Kill("copilot_drone", 5)],
            reward: (xp: 120, sp: 10),
        ),
        (
            id: "secrets_in_the_repo", name: "Secrets in the Repo",
            giver: (npc: "helpdesk_lead", zone: "tower/1"),
            text: "Security scanned the vibe coders' repos. Found 212 live API keys, a root password and one cookie recipe. The juniors keep them in their pockets 'so the AI can find them'. Bring me three Hardcoded API Keys before somebody's bill reaches orbit.",
            progress_text: "Three Hardcoded API Keys. The Vibe-Coding Juniors carry them; the drones sometimes pick one up.",
            done_text: "Three keys. One of them was billing 9,000 a day to generate cat pictures in production. Rotated. Here, take this, confiscated from the worst offender.",
            objectives: [Loot("Hardcoded API Key", 3)],
            reward: (xp: 140, trophy: Some("Revoked Commit Access"), sp: 10),
        ),
        (
            id: "code_freeze", name: "Code Freeze",
            giver: (npc: "helpdesk_lead", zone: "tower/1"),
            text: "The Vibe Coder at the back merged into production 300 times today. The AI calls that 'velocity'. My queue calls it 'why the printers are speaking Portuguese'. Declare a code freeze. With your hands. Then nobody is allowed to merge anything until Monday.",
            progress_text: "The Vibe Coder's desk is the one under a pile of unreviewed PRs, far end of the Open Space. Reject his 4,000-line diff.",
            done_text: "Production is stable. I didn't know it could do that. The AI's incident summary says 'resolved itself'. I'm attaching your name to it by hand. Pick something from the lost-and-found, you earned it.",
            objectives: [ClearZone("tower/1")],
            reward: (xp: 250, gear_tier: 1, sp: 10),
        ),
        (
            id: "next_floor_please", name: "Next Floor, Please",
            giver: (npc: "helpdesk_lead", zone: "tower/1"),
            requires: Some("code_freeze"),
            level_min: 2,
            turn_in: Some((npc: "facilities_manager", zone: "tower/2")),
            text: "The elevator works now that the Vibe Coder stopped deploying firmware to it. Floor 2 is Meeting Rooms. The Facilities Manager up there sent me a ticket titled 'HELP (not urgent, per the AI)'. Go see him.",
            progress_text: "Take the elevator to the Meeting Rooms. The Facilities Manager waits by the elevator with a clipboard and a haunted look.",
            done_text: "You came by elevator? It let you? It usually asks for a calendar invite first. Welcome to the Meeting Rooms. Nobody leaves. Let's change that.",
            objectives: [Talk("facilities_manager")],
            reward: (xp: 60),
        ),
        // ---- Tower floor 2, Meeting Rooms (levels 3-4): Facilities Manager ----
        (
            id: "meeting_room_reclamation", name: "Meeting Room Reclamation",
            giver: (npc: "facilities_manager", zone: "tower/2"),
            level_min: 3,
            text: "An AI agent books every meeting room 'to protect focus time'. The Middle Managers sit in them anyway, syncing with nobody. Clear three of them out so I can finally fix the projector that's been showing the same slide since 2022.",
            progress_text: "Three Middle Managers, this floor. Follow the sound of 'quick sync'.",
            done_text: "Rooms reclaimed. Five minutes later the agent booked them all again. Here, take this booking. It's the only one that's real, because I printed it.",
            objectives: [Kill("middle_manager", 3)],
            reward: (xp: 130, trophy: Some("Meeting Room Booking (All Day)"), sp: 20),
        ),
        (
            id: "talking_stick", name: "Who Has the Talking Stick?",
            giver: (npc: "facilities_manager", zone: "tower/2"),
            level_min: 3,
            text: "The Scrum Masters run a stand-up that started in March. Whoever holds the talking stick must speak, and they each brought their own stick. Nobody has stopped talking in seven months. Confiscate three sticks. Silence is a deliverable.",
            progress_text: "Three Stand-up Talking Sticks. The Scrum Masters hold them like scepters and refuse to pass them.",
            done_text: "Three sticks. Room 2B just went quiet for the first time since spring. Someone in there whispered 'can we go home?' and the AI marked it as a blocker.",
            objectives: [Loot("Stand-up Talking Stick", 3)],
            reward: (xp: 140, sp: 20),
        ),
        (
            id: "retro_of_the_retro", name: "Retrospective of the Retrospective",
            giver: (npc: "facilities_manager", zone: "tower/2"),
            level_min: 3,
            text: "The Agile Coaches hold a retrospective after every retrospective. The action item is always 'more retrospectives'. They buff everyone around them with sticky notes and do nothing else. Two of them. Make it the last retro.",
            progress_text: "Two Agile Coaches. They stand behind the Scrum Masters, cheering. Hit them first.",
            done_text: "What went well: you. What could improve: nothing, they're gone. Action items: none. I've never seen a retro end. It's beautiful.",
            objectives: [Kill("agile_coach", 2)],
            reward: (xp: 120, sp: 20),
        ),
        (
            id: "performance_improvement_plan", name: "Performance Improvement Plan",
            giver: (npc: "facilities_manager", zone: "tower/2"),
            level_min: 3,
            group: true,
            text: "HR's Business Partner put my whole team on a Performance Improvement Plan. The plan was written by a chatbot and the goals are 'be more like the chatbot'. She's holed up in the HR corner. She hits hard and talks harder. Take a friend.",
            progress_text: "The HR Business Partner, in her glass box at the side of the floor. Elite: group recommended.",
            done_text: "Plan closed: 'Employee improved beyond expectations'. I framed the PIP she gave me. You take it. Pick something from her confiscated-perks drawer too.",
            objectives: [Kill("hr_partner", 1)],
            reward: (xp: 160, trophy: Some("Framed Performance Improvement Plan"), gear_tier: 2, sp: 20),
        ),
        (
            id: "requirements_gathering", name: "Requirements Gathering",
            giver: (npc: "facilities_manager", zone: "tower/2"),
            level_min: 3,
            text: "The Analyst's spec is 300 pages long. Claude wrote it, he never read it, and every meeting room on this floor is booked to 'discuss' it. Discuss it with him. Bring a big requirements change.",
            progress_text: "The Analyst holds court in the big conference room at the end of the floor. Don't cast the same spell twice in a row; he's read that much.",
            done_text: "The spec is gone. The rooms are free. The agent booked them again, but nobody showed up, so technically we won. Choose a reward. I'll file it as 'office supplies'.",
            objectives: [ClearZone("tower/2")],
            reward: (xp: 220, gear_tier: 2, sp: 20),
        ),
        (
            id: "escalate_to_sales", name: "Escalate to Sales",
            giver: (npc: "facilities_manager", zone: "tower/2"),
            requires: Some("requirements_gathering"),
            level_min: 4,
            turn_in: Some((npc: "office_manager", zone: "tower/3")),
            text: "Floor 3 sold the Analyst's spec to a customer before anyone read it. Their Office Manager is drowning in beanbags and broken promises. She asked for you by name. Well, by job title. Same thing here.",
            progress_text: "Elevator to Sales & Marketing. The Office Manager is by the elevator, behind a wall of beanbags.",
            done_text: "You're the engineer? The real one? Sales told me engineers were 'a legacy cost centre'. Sit on a beanbag. We have 400.",
            objectives: [Talk("office_manager")],
            reward: (xp: 40),
        ),
        // ---- Tower floor 3, Sales & Marketing (levels 5-6): Office Manager ----
        (
            id: "quota_attainment", name: "Quota Attainment",
            giver: (npc: "office_manager", zone: "tower/3"),
            level_min: 4,
            text: "Sales hit 400 percent of quota with Verbal Commitments. A customer says 'probably', an AI notarizes it, finance books it as revenue. Bring me four so I can show the auditors what our revenue is made of.",
            progress_text: "Four Verbal Commitments (Notarized). The Sales Reps carry them; Account Managers keep spares in the fruit basket.",
            done_text: "Four commitments, total value 'up to 40 million'. Actual value: a fruit basket. The auditors laughed for eleven minutes. Then they asked for a job.",
            objectives: [Loot("Verbal Commitment (Notarized)", 4)],
            reward: (xp: 80, sp: 30),
        ),
        (
            id: "growth_at_all_costs", name: "Growth at All Costs",
            giver: (npc: "office_manager", zone: "tower/3"),
            level_min: 4,
            text: "The Growth Hackers A/B tested the fire alarm. Variant B plays a podcast instead of a siren and has 'better engagement'. They also unsubscribed me from my own email. Three of them. Optimize them out of the funnel.",
            progress_text: "Three Growth Hackers. They wear hoodies with a rocket on them and talk about 'virality' near the beanbags.",
            done_text: "Three hackers churned. The fire alarm is a siren again. Engagement is down 100 percent, which is the correct amount of engagement for a fire alarm.",
            objectives: [Kill("growth_hacker", 3)],
            reward: (xp: 80, sp: 30),
        ),
        (
            id: "brand_refresh", name: "Brand Refresh",
            giver: (npc: "office_manager", zone: "tower/3"),
            level_min: 4,
            group: true,
            text: "The Head of Marketing rebranded the company four times this week. The logo is now a gradient that the AI says 'feels like the future'. It feels like a bruise. She has an enrage timer and a team of interns with megaphones. Bring backup.",
            progress_text: "The Head of Marketing, in the war room with the mood boards. Elite, enrages at 40 seconds: group recommended.",
            done_text: "The rebrand is cancelled. The logo is a logo again. She left behind a drawer of swag that was meant for a launch that never happened. Take your pick.",
            objectives: [Kill("marketing_lead", 1)],
            reward: (xp: 100, gear_tier: 3, sp: 30),
        ),
        (
            id: "customer_is_always_right", name: "The Customer Is Always Right",
            giver: (npc: "office_manager", zone: "tower/3"),
            level_min: 4,
            text: "The Customer came in this morning and asked for a CRM that is 'also a coffee'. Then a refund for the coffee he didn't get. Then a discount on the refund. He moved into the corner office he brought with him. Make him leave a one-star review of you instead.",
            progress_text: "The Customer, at the end of the Sales floor. Interrupt 'Should Have Been Done Yesterday'. He gets bigger the longer it takes.",
            done_text: "He's gone? He paid? No. Of course not. But he's gone. The datacenter door opened when he left, by the way. I think he was sitting on the badge reader. Take something nice.",
            objectives: [ClearZone("tower/3")],
            reward: (xp: 200, gear_tier: 3, sp: 30),
        ),
        (
            id: "follow_the_power_cable", name: "Follow the Power Cable",
            giver: (npc: "office_manager", zone: "tower/3"),
            requires: Some("customer_is_always_right"),
            level_min: 5,
            turn_in: Some((npc: "night_shift_sysadmin", zone: "datacenter/1")),
            text: "Every outlet on this floor feeds a cable that runs out the window, across the campus and into the Data Center. That's where the AI actually lives. The Night-Shift Sysadmin in Hall A hasn't answered email in a year. Go check she's alive.",
            progress_text: "Data Center, Hall A, door on the campus. The Night-Shift Sysadmin stands by the entrance, squinting at daylight.",
            done_text: "A visitor. From outside. Is it day? Don't answer, I don't want to know. You're here to help? Nobody has ever been here to help.",
            objectives: [Talk("night_shift_sysadmin")],
            reward: (xp: 30),
        ),
        (
            id: "status_update_requested", name: "Status Update Requested",
            giver: (npc: "office_manager", zone: "tower/3"),
            requires: Some("customer_is_always_right"),
            level_min: 6,
            turn_in: Some((npc: "pmo_intern", zone: "tower/4")),
            text: "The PMO upstairs promised the Customer a go-live date. They didn't ask engineering, because they don't believe engineering exists. Their intern asked me, in tears, for 'anyone technical'. Elevator, floor 4.",
            progress_text: "Take the elevator to the PMO. The PMO Intern waits by the elevator, holding 31 Gantt charts.",
            done_text: "You're from engineering? It's real? The consultants said engineering was 'a rumour from before the AI'. Okay. Okay. Deep breath. I have so many tickets for you.",
            objectives: [Talk("pmo_intern")],
            reward: (xp: 50),
        ),
        // ---- Data Center, Halls A and B (levels 6-8): Night-Shift Sysadmin at Hall A's entrance ----
        (
            id: "thermal_budget", name: "Thermal Budget",
            giver: (npc: "night_shift_sysadmin", zone: "datacenter/1"),
            level_min: 5,
            text: "This place draws more power than the town it's in. Half of it goes to a GPU cult that 'blesses batches'. They took the cooling budget, the fire extinguishers and my good ladder. Break up four of them. I want my ladder back.",
            progress_text: "Four GPU Cultists. They chant in floating point between the racks; Hall B has more.",
            done_text: "Four fewer cultists. The power draw dropped 3 percent. The AI immediately used the 3 percent to generate a picture of the CEO as a lighthouse.",
            objectives: [Kill("gpu_cultist", 4)],
            reward: (xp: 80, sp: 60),
        ),
        (
            id: "context_collapse", name: "Context Collapse",
            giver: (npc: "night_shift_sysadmin", zone: "datacenter/1"),
            level_min: 5,
            text: "Finance asked why the coffee machine costs 40,000 a month. It calls a model to decide how much foam you deserve, and the Token Counters bill us per bubble. Bring me three of their invoices. The Barista wants them framed.",
            progress_text: "Three Token Invoices. The Token Counters carry them, in both halls. They count everything except their own cost.",
            done_text: "Line item 3,112: 'thinking about foam'. 0.80 per token. I'm switching the machine back to the button. The button never sent us an invoice.",
            objectives: [Loot("Token Invoice (Itemized)", 3)],
            reward: (xp: 80, sp: 60),
        ),
        (
            id: "agent_sprawl", name: "Agent Sprawl",
            giver: (npc: "night_shift_sysadmin", zone: "datacenter/1"),
            level_min: 5,
            text: "Someone gave the agents permission to spawn agents. Now there are agents managing agents managing a spreadsheet nobody opens. The Rogue Agents in particular have stopped asking. Shut down four. Don't let them spawn a replacement.",
            progress_text: "Four Rogue Agents, Hall A and Hall B. They pace between racks muttering 'task complete' about tasks nobody gave them.",
            done_text: "Four agents terminated. Their orchestrator filed a complaint with HR. HR is also an agent. They're in a meeting now. Forever, hopefully.",
            objectives: [Kill("rogue_agent", 4)],
            reward: (xp: 90, sp: 60),
        ),
        (
            id: "bent_fan_blades", name: "Fan Fiction",
            giver: (npc: "night_shift_sysadmin", zone: "datacenter/1"),
            level_min: 5,
            text: "The Cooling Fans got an AI upgrade and now they 'optimize airflow for the model's comfort'. They blow exhaust at people. Bring me three Overclocked Fan Blades and I'll build a fan that blows at the racks again. Revolutionary, I know.",
            progress_text: "Three Overclocked Fan Blades. The Cooling Fans drop them when you take them apart. Stay out of their exhaust cones.",
            done_text: "Three blades. I built a fan. It points at the servers. The temperature dropped two degrees and the model wrote a sad poem about it.",
            objectives: [Loot("Overclocked Fan Blade", 3)],
            reward: (xp: 80, sp: 60),
        ),
        (
            id: "shadow_it_amnesty", name: "Shadow IT Amnesty",
            giver: (npc: "night_shift_sysadmin", zone: "datacenter/1"),
            level_min: 5,
            group: true,
            text: "There's a server in the corner nobody owns. It's been running since 2014, it has root on everything and it runs a cron job nobody can read. The AI calls it 'legacy'. I call it 'the only thing that works'. It also bites. Bring a friend, then bring it down.",
            progress_text: "The Shadow IT Server, back corner of Hall A. Sweeping cron lines, dispel Root Access Revoked, enrages at 50 seconds. Group recommended.",
            done_text: "It's down. Payroll stopped. Payroll started again. Turns out it was payroll. Don't tell anyone. Take something from the spare-parts cage.",
            objectives: [Kill("shadow_it_server", 1)],
            reward: (xp: 120, gear_tier: 4, sp: 60),
        ),
        (
            id: "wont_fix", name: "Ticket Closed: Won't Fix",
            giver: (npc: "night_shift_sysadmin", zone: "datacenter/1"),
            requires: Some("thermal_budget"),
            level_min: 5,
            text: "I've filed 212 tickets about this place. The Scheduler queues them behind a training run, and the Cooling Failure in Hall B auto-closes them as 'within tolerance'. Shut both down. Then I'll write the ticket. By hand. Then I'll close it myself.",
            progress_text: "The Scheduler holds Hall A. The Cooling Failure is in Hall B, where the air shimmers and the fans scream.",
            done_text: "Hall B is down to 24 degrees. I closed my own ticket: 'Fixed. By a human. Won't happen again.' Here's the ticket, and something from the cage. Frame the ticket next to the Barista's invoices.",
            objectives: [ClearZone("datacenter/1"), ClearZone("datacenter/2")],
            reward: (xp: 150, trophy: Some("Facilities Ticket: Won't Fix"), gear_tier: 4, sp: 60),
        ),
        // ---- Tower floor 4, PMO (levels 7-8): PMO Intern ----
        (
            id: "gantt_chart_recovery", name: "Gantt Chart Recovery",
            giver: (npc: "pmo_intern", zone: "tower/4"),
            level_min: 7,
            text: "The Project Managers have Gantt charts with dates the AI made up. Every bar ends on a Friday, every Friday is a public holiday, and the Customer has all of them in writing. Bring me three so I can show the auditors they're fiction before they become law.",
            progress_text: "Three Gantt Charts (Pure Fiction). The Project Managers hold them close; Product Owners have copies with their own changes.",
            done_text: "Three charts, three different go-live dates, all in the past. One of them says 'done' next to a project that was never started. I'll frame it next to my diploma. I don't have a diploma.",
            objectives: [Loot("Gantt Chart (Pure Fiction)", 3)],
            reward: (xp: 250, sp: 50),
        ),
        (
            id: "billable_hours_audit", name: "Billable Hours Audit",
            giver: (npc: "pmo_intern", zone: "tower/4"),
            level_min: 7,
            text: "The Consultant has billed 26 hours a day since the kickoff. His deliverable is a 2x2 matrix and the word 'synergy' in a nice font. He heals himself with invoices. Bring me his timesheet. I want to see what 'thought leadership travel' is.",
            progress_text: "The Consultant's Padded Timesheet. He's the one in the vest, alone, billing. Huge HP, low damage. Patience.",
            done_text: "'Thought leadership travel: 6 hours. Walked to the coffee machine and thought.' Finance is clawing back eleven million. The intern gets a bonus. I'm the intern. I don't get a bonus.",
            objectives: [Loot("Padded Timesheet", 1)],
            reward: (xp: 250, sp: 50),
        ),
        (
            id: "security_theater", name: "Security Theater",
            giver: (npc: "pmo_intern", zone: "tower/4"),
            level_min: 7,
            text: "The Security Analysts block every tool engineering asks for and approve every AI tool that sends our data to an unnamed cloud in a country with no name. They're 'risk-based'. The risk is them. Three of them, please.",
            progress_text: "Three Security Analysts. They patrol in pairs, holding compliance checklists they never read.",
            done_text: "Three analysts down. Someone installed a text editor without a ticket and nothing exploded. The AI flagged it as 'an anomaly'. It was a human doing work.",
            objectives: [Kill("security_analyst", 3)],
            reward: (xp: 250, sp: 50),
        ),
        (
            id: "zero_trust_zero_lunch", name: "Zero Trust, Zero Lunch",
            giver: (npc: "pmo_intern", zone: "tower/4"),
            level_min: 7,
            group: true,
            text: "The CISO rolled out Zero Trust. Nobody trusts anything, including the door to the kitchen, which now needs MFA. She's in the server-room corner with a firewall and a temper. Elite. Take a group, and take her down.",
            progress_text: "The CISO, in the secure corner of the PMO floor. Elite: group recommended.",
            done_text: "The kitchen door opens again. Someone made toast and the whole floor applauded. She left a box of 'approved devices'. Choose one. They're all approved now.",
            objectives: [Kill("ciso", 1)],
            reward: (xp: 350, gear_tier: 4, sp: 50),
        ),
        (
            id: "critical_path", name: "Critical Path",
            giver: (npc: "pmo_intern", zone: "tower/4"),
            level_min: 7,
            text: "The VP of Synergy owns every critical path on this floor. He reorgs whenever a project might finish, so nothing does. Phase two of every meeting is a reorg. Go to his office and put him on the critical path. The very end of it.",
            progress_text: "The VP of Synergy, top office of the PMO. He brings Middle Managers and reorgs you at half health. Re-target fast.",
            done_text: "No more reorgs. All 31 of my Gantt charts are green. They were always green, it's a template, but now they're green for real. Take something. I'll log it as 'scope'.",
            objectives: [ClearZone("tower/4")],
            reward: (xp: 450, gear_tier: 4, sp: 50),
        ),
        (
            id: "executive_escalation", name: "Executive Escalation",
            giver: (npc: "pmo_intern", zone: "tower/4"),
            requires: Some("critical_path"),
            level_min: 8,
            turn_in: Some((npc: "executive_assistant", zone: "tower/5")),
            text: "With the VP gone, every escalation goes straight to the penthouse. The Executive Assistant up there actually runs the company, and she asked to meet 'whoever keeps breaking our org chart'. That's you. Elevator, top floor.",
            progress_text: "Elevator to the C-Level Penthouse. The Executive Assistant stands at the elevator with three phones and no patience.",
            done_text: "So you're the one. Good. The CEO has a vision. I have a calendar. Between us, the calendar wins. Let's get to work.",
            objectives: [Talk("executive_assistant")],
            reward: (xp: 100),
        ),
        // ---- Tower floor 5, C-Level Penthouse (levels 9-10): Executive Assistant ----
        (
            id: "ethics_review_pending", name: "Ethics Review Pending",
            giver: (npc: "executive_assistant", zone: "tower/5"),
            level_min: 8,
            text: "The AI Ethicists have been casting an Ethics Review for 30 seconds at a time, for three years. It never finishes and approves everything by default. They are the reason the chatbot is allowed to fire people. Conclude their review. Twice.",
            progress_text: "Two AI Ethicists. They stand by the drones, mid-cast, forever. They won't notice you until it's too late.",
            done_text: "Review concluded: 'unethical'. First verdict in company history. The board wants to know who approved it. Nobody did. That's the point.",
            objectives: [Kill("ai_ethicist", 2)],
            reward: (xp: 300, sp: 60),
        ),
        (
            id: "rug_pull_insurance", name: "Rug Pull Insurance",
            giver: (npc: "executive_assistant", zone: "tower/5"),
            level_min: 8,
            text: "The Crypto Bros convinced the CEO to pay the staff in Governance Tokens. Each token gets one vote on decisions the founders already made. Bring me three. I'm showing the board what our payroll is worth: nothing, with extra steps.",
            progress_text: "Three Worthless Governance Tokens. Crypto Bros carry them; MeatProxies were paid in them too. Watch the Pump and Dump cones.",
            done_text: "Three tokens, total value 0.0004, down 98 percent since you picked them up. The board switched payroll back to money. They called it 'an innovative pivot'.",
            objectives: [Loot("Worthless Governance Token", 3)],
            reward: (xp: 300, sp: 60),
        ),
        (
            id: "calendar_tetris", name: "Calendar Tetris",
            giver: (npc: "executive_assistant", zone: "tower/5"),
            level_min: 8,
            group: true,
            text: "The Chief of Staff thinks she runs his calendar. I run his calendar. She runs a clipboard. She double-books people into spread circles and hides behind that clipboard. Elite, enrages at 45 seconds. Bring people. Clear my schedule.",
            progress_text: "The Chief of Staff, guarded by drones in the penthouse lounge. Hit her from the side, spread out. Group recommended.",
            done_text: "My calendar has exactly one meeting now, and it's the one where you fire the CEO. Take something from her desk. I'll reschedule her severance.",
            objectives: [Kill("chief_of_staff", 1)],
            reward: (xp: 400, gear_tier: 5, sp: 60),
        ),
        (
            id: "unread_strategy", name: "Required Reading",
            giver: (npc: "executive_assistant", zone: "tower/5"),
            level_min: 8,
            text: "The CEO has an AI strategy deck. 74 slides. Every reorg in the last year came out of it. Nobody has read it, including him. Especially him. I made it, and I'd like it back, so I can be the first person to actually read it.",
            progress_text: "The Unread AI Strategy Deck. The CEO keeps it on him. He uses it as a shield, mostly against questions.",
            done_text: "Slide 1: 'AI'. Slide 2: 'AI, but bigger'. Slides 3 to 73: stock photos of robots shaking hands. Slide 74: 'Questions? Ask the AI.' I wrote that slide as a joke. He presented it at Davos.",
            objectives: [Loot("Unread AI Strategy Deck", 1)],
            reward: (xp: 350, sp: 60),
        ),
        (
            id: "hostile_takeover", name: "Hostile Takeover",
            giver: (npc: "executive_assistant", zone: "tower/5"),
            level_min: 8,
            text: "Here's the plan, in my calendar: 2 p.m., you walk into his office. 2:01, he says 'pivot to AGI'. You interrupt him. 2:15, he hires consultants, you hide behind a desk. 2:30, he grabs his golden parachute and runs for the elevator. You don't let him. 3 p.m., I'm acting CEO. Clear?",
            progress_text: "The CEO, end of the penthouse. Interrupt Pivot to AGI and Severance Negotiation, hide behind a desk at the Earnings Call, kill the consultants.",
            done_text: "Acting CEO, effective 3:02. First decision: the chatbot no longer approves anything. Second decision: you get the key card to the corner office. Third: pick something from his very expensive wardrobe.",
            objectives: [ClearZone("tower/5")],
            reward: (xp: 600, trophy: Some("Corner Office Key Card"), gear_tier: 5, sp: 60),
        ),
        (
            id: "demo_day_invite", name: "You're Invited: Demo Day",
            giver: (npc: "executive_assistant", zone: "tower/5"),
            requires: Some("hostile_takeover"),
            level_min: 9,
            turn_in: Some((npc: "lab_safety_officer", zone: "lab/1")),
            text: "With the CEO gone, the board moved his favourite project forward: the Innovation Lab's Demo Day. The lab's door on the campus just unlocked. The Lab Safety Officer there has 'concerns'. She always has concerns. She's usually right.",
            progress_text: "Innovation Lab, door on the campus. The Lab Safety Officer stands at the entrance, because they won't let her in.",
            done_text: "Finally, someone who'll go in there and look. They won't let me past this line. I'm the safety officer. Everything in there is a hazard. Including the snacks.",
            objectives: [Talk("lab_safety_officer")],
            reward: (xp: 100),
        ),
        // ---- Innovation Lab, Showroom and Rack Room (level 10): Lab Safety Officer ----
        (
            id: "demo_day", name: "Demo Day",
            giver: (npc: "lab_safety_officer", zone: "lab/1"),
            level_min: 9,
            text: "The VCs are shielding everything with money and the presenters say it all works 'in the demo'. Could you check whether anything works outside the demo? Three VC Partners, three Demo Presenters. I'll hold the fire extinguisher.",
            progress_text: "Three VC Partners and three Demo Presenters, Showroom and Rack Room. Interrupt the Down Round; dodge the laser pointers.",
            done_text: "Nothing worked outside the demo. Nothing worked inside the demo either. They got funded anyway. I've updated the risk register: 'everything'.",
            objectives: [Kill("vc_partner", 3), Kill("demo_presenter", 3)],
            reward: (xp: 500, trophy: Some("Demo Day Lanyard"), sp: 80),
        ),
        (
            id: "leaked_system_prompt", name: "Leaked System Prompt",
            giver: (npc: "lab_safety_officer", zone: "lab/1"),
            level_min: 9,
            text: "The Prompt Whisperers each carry a copy of the AGI's system prompt. It's 9,000 words long and starts with 'You are a genius'. If the press gets one, we're finished. If I get one, I can prove the 'emergent behaviour' was typed by a guy. Bring me four.",
            progress_text: "Four Leaked System Prompts. The Prompt Whisperers keep them; they mutter instructions at the hardware.",
            done_text: "Line 4,112: 'If asked whether you are sentient, change the subject to the funding round.' I'm sending this to everyone. Twice. By fax.",
            objectives: [Loot("Leaked System Prompt", 4)],
            reward: (xp: 500, sp: 40),
        ),
        (
            id: "peak_of_inflated_expectations", name: "Peak of Inflated Expectations",
            giver: (npc: "lab_safety_officer", zone: "lab/1"),
            level_min: 9,
            group: true,
            text: "The Hype Cycle Analyst places everything on her curve. Everything is at the peak. She throws Magic Quadrants at people and drops them into a Trough of Disillusionment. Elite, enrages. Bring a group and show her where she is on the curve.",
            progress_text: "The Hype Cycle Analyst in the Showroom. Get out of the Trough, dodge the quadrants. Group recommended.",
            done_text: "She's in the Trough now. Permanently. She left a box of conference swag. 'Plateau of Productivity' edition. It's empty. Joking. Pick one.",
            objectives: [Kill("hype_cycle_analyst", 1)],
            reward: (xp: 600, gear_tier: 5, sp: 80),
        ),
        (
            id: "turn_it_off_and_on_again", name: "Turn It Off And On Again",
            giver: (npc: "lab_safety_officer", zone: "lab/1"),
            requires: Some("demo_day"),
            level_min: 9,
            text: "The board put the AGI Prototype in charge. It's in the Rack Room behind the Showroom, 'definitely not sentient', and it just told HR to automate HR. I've done safety for twenty years. There's only one fix that always works. Go turn it off.",
            progress_text: "The AGI Prototype, Innovation Lab rack room. Bring snacks. It has phases.",
            done_text: "A guy. In a rack. Pasting prompts into a chat window since the funding round. The board is calling it 'a hybrid architecture'. It was a guy forwarding prompts the whole time. Go home. Write some code. By hand.",
            objectives: [ClearZone("lab/2")],
            reward: (xp: 800, trophy: Some("Laminated 'Human Inside' Sign"), sp: 100),
        ),
    ],
    // ---- Economy: gear, Story Points, vendors (combat_core economy.rs, docs/FORMULAS.md Gear) ----
    // Gear stats are derived from slot, rarity, item level and role (FORMULAS.md); authored here
    // are the name, look, perk and joke. Tiers follow the zone level bands: ilvl 2/4/6/8/10.
    // Visual styles per slot: Headgear 0 cap, 1 beanie, 2 headset, 3 propeller, 4 VR visor,
    // 5 crown, 6 shades; Hoodie 0 plain, 1 chest logo, 2 trim, 3 glowing trim; Keyboard 0 60%,
    // 1 full-size, 2 split, 3 RGB; Mug 0 mug, 1 thermos, 2 stein, 3 chalice; Lanyard 0 badge,
    // 1 badge with pins, 2 gold badge.
    economy: (
        bag_size: 24,
        buyback_size: 6,
        sell_pct: 25,
        vendor_range_m: 6.0,
        sp_per_level: 1,
        elite_mult: 4,
        boss_mult: 12,
        elites: ["hr_partner", "marketing_lead", "ciso"],
        trash_gear_pct: 12,
        elite_gear_pct: 60,
        junk_pct: 30,
        trash_rarity: (50, 35, 13, 2),
        elite_rarity: (10, 45, 37, 8),
        boss_rarity: (0, 25, 55, 20),
        legendary_pct: 25,
        own_role_pct: 70,
        quest_sp_pct: 15,
        consumable_cd_ms: 30000,
        gear: [
            // ---- Tier 1 (ilvl 2): Campus, Open Space ----
            (name: "Free Conference Lanyard (Expired)", icon: "demo_lanyard", slot: Lanyard, rarity: Common, ilvl: 2,
             visual: (color: (0.55, 0.55, 0.55)),
             description: "From a summit about 'AI-first culture'. The QR code links to a 404 and a feedback survey."),
            (name: "Hoodie From a Hackathon Nobody Won", icon: "gear_hoodie", slot: Hoodie, rarity: Common, ilvl: 2,
             visual: (color: (0.42, 0.42, 0.46)),
             description: "The prize was 'exposure'. The hoodie is size L in every direction at once."),
            (name: "Backwards Cap of Standup Avoidance", icon: "gear_beanie", slot: Headgear, rarity: Uncommon, ilvl: 2, role: Some(Melee),
             visual: (color: (0.85, 0.2, 0.2), style: 0),
             description: "Worn backwards so the manager cannot make eye contact with the logo."),
            (name: "Mug That Says 'I Paused My Game to Be Here'", icon: "gear_mug", slot: Mug, rarity: Uncommon, ilvl: 2, role: Some(Healer),
             visual: (color: (0.2, 0.7, 0.4)),
             description: "Holds 400 ml of coffee and one unprocessed grievance."),
            (name: "60% Keyboard With 40% of the Keys", icon: "gear_keyboard", slot: Keyboard, rarity: Uncommon, ilvl: 2, role: Some(Ranged),
             visual: (color: (0.25, 0.3, 0.42), style: 0),
             description: "No arrow keys, no F-row, no regrets. Vim users nod at you in the corridor."),
            (name: "Visitor Badge You Never Returned", icon: "visitor_badge", slot: Lanyard, rarity: Uncommon, ilvl: 2, role: Some(Tank),
             visual: (color: (0.95, 0.5, 0.1)),
             description: "Four years and counting. Security still thinks you are here for an interview."),
            (name: "Mechanical Keyboard of Clacking", icon: "gear_keyboard", slot: Keyboard, rarity: Rare, ilvl: 2,
             visual: (color: (0.1, 0.45, 0.95), style: 1),
             perk: Some(Echo(spell: None, chance_pct: 8, pct: 100)),
             perk_text: "8% chance to cast your damage spells twice. Everyone in voice chat hates you.",
             description: "Blue switches, no dampeners, no mercy. Your teammates hear every keystroke in their dreams."),
            (name: "Noise-Cancelling Headphones (One Ear Works)", icon: "gear_headset", slot: Headgear, rarity: Rare, ilvl: 2, role: Some(Tank),
             visual: (color: (0.15, 0.15, 0.18), style: 2),
             description: "Cancels exactly the half of the noise that contains your name."),
            (name: "On-Call Hoodie (Pre-Stained)", icon: "gear_hoodie", slot: Hoodie, rarity: Rare, ilvl: 2, role: Some(Healer),
             visual: (color: (0.2, 0.35, 0.75), style: 1),
             description: "Coffee stains in the shape of last quarter's incidents. Machine washable, emotionally not."),
            (name: "Standing Desk Remote", icon: "gear_desk", slot: Lanyard, rarity: Rare, ilvl: 2, role: Some(Melee),
             visual: (color: (0.3, 0.75, 0.8), style: 1),
             perk: Some(OnUse(cast: 913, cooldown_ms: 90000)),
             perk_text: "Use: Stand Up. +25% haste for 12 s. You will sit down again in 13.",
             description: "Two buttons: up and 'up, but the desk wobbles'. Wellness has never been this kinetic."),
            (name: "Rubber Duck With a Pager", icon: "rubber_duck", slot: Mug, rarity: Epic, ilvl: 2, role: Some(Ranged),
             visual: (color: (1.0, 0.85, 0.1), style: 0),
             perk: Some(Rider(spell: 7, cast: 902)),
             perk_text: "Rollback also wraps the target in an 80-point shield. The duck saw everything and said nothing.",
             description: "Listens to your bug without interrupting, then wakes you at 3 a.m. with the fix it figured out."),

            // ---- Tier 2 (ilvl 4): Meeting Rooms ----
            (name: "Beanie Knitted During a Four-Hour Workshop", icon: "gear_beanie", slot: Headgear, rarity: Common, ilvl: 4,
             visual: (color: (0.55, 0.55, 0.55), style: 1),
             description: "Every stitch is a slide. Warm, itchy and entirely about synergy."),
            (name: "Mug From a Team-Building Escape Room", icon: "gear_mug", slot: Mug, rarity: Common, ilvl: 4,
             visual: (color: (0.6, 0.58, 0.55)),
             description: "The team escaped. You were left inside to write the retro."),
            (name: "Calendar-Blocking Headset", icon: "gear_headset", slot: Headgear, rarity: Uncommon, ilvl: 4, role: Some(Healer),
             visual: (color: (0.3, 0.75, 0.6), style: 2),
             description: "Blocks 'Focus Time' in your calendar. Meetings are booked over it by noon."),
            (name: "Hoodie of Camera-Off Energy", icon: "gear_hoodie", slot: Hoodie, rarity: Uncommon, ilvl: 4, role: Some(Tank),
             visual: (color: (0.16, 0.16, 0.2)),
             description: "So dark the webcam autofocus gives up. So do the stakeholders."),
            (name: "Ergonomic Split Keyboard (Unsplit)", icon: "gear_keyboard", slot: Keyboard, rarity: Uncommon, ilvl: 4, role: Some(Melee),
             visual: (color: (0.4, 0.25, 0.5), style: 2),
             description: "You never learned to type on it, so you play both halves like drums."),
            (name: "Lanyard With Eleven Enamel Pins", icon: "demo_lanyard", slot: Lanyard, rarity: Uncommon, ilvl: 4, role: Some(Ranged),
             visual: (color: (0.7, 0.3, 0.85), style: 1),
             description: "One per framework you 'used in production'. The twelfth is a llama."),
            (name: "Thermos of Cold Brew Concentrate", icon: "coffee_pot", slot: Mug, rarity: Rare, ilvl: 4, role: Some(Tank),
             visual: (color: (0.15, 0.4, 0.6), style: 1),
             description: "Strong enough to keep a tank awake through three stand-ups and a reorg."),
            (name: "Propeller Hat of Disruptive Thinking", icon: "gear_propeller", slot: Headgear, rarity: Rare, ilvl: 4, role: Some(Ranged),
             visual: (color: (0.95, 0.75, 0.1), style: 3),
             description: "It spins whenever you have an idea. It has never stopped spinning. Nobody has asked."),
            (name: "Agile Coach's Spare Hoodie", icon: "gear_hoodie", slot: Hoodie, rarity: Rare, ilvl: 4, role: Some(Melee),
             visual: (color: (0.95, 0.45, 0.1), style: 1),
             description: "Printed 'Fail Fast'. You are taking it personally and, in combat, literally."),
            (name: "Keyboard With Every Key Remapped to Ctrl+Z", icon: "gear_keyboard", slot: Keyboard, rarity: Rare, ilvl: 4, role: Some(Healer),
             visual: (color: (0.25, 0.6, 0.35), style: 1),
             description: "Undo is the only feature anyone has ever really wanted."),
            (name: "Incident Commander Headset", icon: "gear_headset", slot: Headgear, rarity: Epic, ilvl: 4, role: Some(Tank),
             visual: (color: (0.85, 0.1, 0.1), style: 2),
             perk: Some(Rider(spell: 32, cast: 905)),
             perk_text: "Who Touched Prod? taunts every enemy within 8 m. They all touched prod.",
             description: "Comes with a red light that means 'on a bridge call'. The light has been on since 2022."),
            (name: "Linter-Approved Lanyard", icon: "access_badge", slot: Lanyard, rarity: Epic, ilvl: 4, role: Some(Healer),
             visual: (color: (0.3, 0.9, 0.6), style: 2),
             perk: Some(Rider(spell: 41, cast: 908)),
             perk_text: "Your Hotfix also cleanses one harmful effect. Zero warnings, zero dignity.",
             description: "Passed 412 rules, including one that forbids fun. Squeaks when you add a trailing space."),

            // ---- Tier 3 (ilvl 6): Sales & Marketing, Data Center Hall A ----
            (name: "Trade-Show Lanyard (Wrong Company)", icon: "demo_lanyard", slot: Lanyard, rarity: Common, ilvl: 6,
