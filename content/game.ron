                (anchor: "pack_2", units: ["vc_partner", "prompt_whisperer"]),
                (anchor: "pack_3", units: ["demo_presenter", "vc_partner", "prompt_whisperer"]),
            ],
            boss: Some((anchor: "boss", unit: "agi_prototype")),
            links: [
                (anchor: "door:lab/1", to: "lab/1"),
