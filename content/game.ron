            settle_ms: 6000,
            shuffle_ms: 4000,
            talk_m: 2.4,
            wrong_ms: 2500,
            place_clues: [
                "I heard your new manager sits {slot}. Or the desk does. Same thing now.",
                "Facilities moved your manager {slot}. I saw the boxes.",
                "Your manager? {slot}. Unless they got reorged while we talked.",
            ],
            role_clues: [
                "Your new manager is the {role}. Is that a person or a team?",
                "The email said you report to the {role}. It was a long email.",
                "Pretty sure it's the {role}. I'm also pretty sure about nothing anymore.",
            ],
            stale_clues: [
                "Before the reorg it was whoever sits {slot}. Probably still is. Right?",
                "Last I heard, your manager sat {slot}. That was this morning. A lifetime ago.",
                "The old org chart says {slot}. The old org chart is all I have left.",
            ],
            idle_clues: [
                "No idea. I just found out I'm in Platform. I'm a designer.",
                "Not me. I don't have reports. I have 'dotted lines'.",
