                (anchor: "pack_3", units: ["scrum_master", "agile_coach", "meatproxy"]),
                (anchor: "pack_4", units: ["middle_manager", "meatproxy"]),
                (anchor: "pack_5", units: ["scrum_master", "middle_manager"]),
                (anchor: "pack_6", units: ["hr_partner"]),
            ],
            boss: Some((anchor: "boss", unit: "analyst")),
            links: [
                (anchor: "door:campus", to: "campus"),
                (anchor: "elevator_exit", to: "tower/3", requires: Some(ZoneCleared("tower/2"))),
