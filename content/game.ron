            (name: "Conference Booth Tote Bag", icon: "box", price: 4, tier: 3,
             description: "Full of brochures for a product that is 'coming soon' and has been since the bag was printed."),
            (name: "Unlabelled Patch Cable", icon: "junk_trash", price: 3, tier: 3,
             description: "Connects something to something. Unplugging it took down billing in 2021."),
            (name: "Growth Hacker's Burner Phone", icon: "gear_ringlight", price: 6, tier: 3,
             description: "Used for 300 'organic' accounts. Vibrates constantly with fake engagement."),
            (name: "Demo Script (Do Not Deviate)", icon: "live_demo", price: 5, tier: 3,
             description: "Step 4: 'Pray.' Step 5 is crossed out and replaced with 'see step 4'."),
            (name: "Gantt Chart (Wall-Sized, Wrong)", icon: "chart", price: 5, tier: 4,
             description: "Printed on A0. Out of date before the printer finished."),
            (name: "Status Report Template v14", icon: "contract", price: 4, tier: 4,
