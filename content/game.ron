             auras: [("sugar_rush", 60000), ("protein_bar", 20000), ("expired_kombucha", 30000)]),
            (key: "departure_board", name: "Departure Board", zone: "campus", kind: Billboard, reach_m: 8.0, lines: [
                "08:12 HQ (New) - DELAYED. Reason: opening 2019.",
                "08:14 City Centre - CANCELLED. Reason: AI scheduling optimised it away.",
                "08:20 Return-to-Office Express - ON TIME. It has never been on time.",
