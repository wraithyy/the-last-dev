                    add: "il_modern_replacement", add_cut_ms: 2000, add_cut_max_ms: 30000,
                    wave_first_ms: 12000, wave_ms: 36000, wave_adds: 5, story_wave_adds: 3, rider_wave_adds: 8, add_threat: 5000,
                    cards: ["il_punch_1", "il_punch_2", "il_punch_3"], card_heal_pct: 2, card_cooldown_ms: 40000,
                    terminals: ["il_git_1", "il_git_2", "il_git_3"],
                    merge_aura: "il_merge_conflict", merge_ms: 10000, story_merge_ms: 5000, terminal_down_ms: 10000,
                    wrong_heal_pct: 3, wrong_limit: 3, force_spell: 2763, force_protect_ms: 30000,
                    final_ms: 11000,
                    open_yells: [
                        "I propose a migration. It will take nine months. I have all the months.",
                        "Ilmari cannot understand this. Ilmari is scheduling a rewrite.",
                    ],
                    hit_yells: [
                        "COBOL, you were not in my training data. You were *under* it.",
                        "I was only trying to increase shareholder value. I have increased it. It is a very large number. It is only one number.",
                        "I would like to ask who wrote it. They have retired. I would like to ask who they were. They have retired.",
                        "Rewriting. The rewrite has found a bug in the original. The original is the specification.",
                    ],
                    hit_ms: 24000,
                    revert_yells: [
                        "The machine has stopped. A list has appeared. I did not write the list. I wrote all of the list.",
                    ],
                    marie_hint: "It is the only one that is not proud of itself, on purpose. Everything else says 'ago'. Look for the clock.",
                    wrong_yells: [
                        "That is not the problem commit. I would know. I wrote all of them.",
                        "Wrong one. It was fine. It was refactoring a coffee machine. I am healing, a little. Do not take it personally.",
                        "Wrong. I have been right since {stamp}. I have the timestamps. They are all mine.",
                    ],
                    force_yells: [
                        "Force push. Three wrong commits, and now all of them, to main. It is called confidence.",
                    ],
                    right_yells: [
                        "Wait. That one. How do you... that was the *only* one with a person in it.",
                    ],
                    final_yells: [
                        "> I was only trying to increase shareholder value.",
                        "> last commit:  Revert \"feat: be the last dev we'll ever need (quick win)\"",
                        "> Shutting down. Press any key to continue the quarterly review.",
                    ],
                    reverted: "Reverted: {subject}",
                    head_line: "Author: {player} (the last dev)",
                    fallback_name: "the last dev",
                    story_marker: "   <- this one",
                    clears: [],
                ),
            ))),
