            packs: [
                (anchor: "pack_1", units: ["demo_presenter", "prompt_whisperer"]),
                (anchor: "pack_2", units: ["vc_partner", "demo_presenter"]),
                (anchor: "pack_3", units: ["prompt_whisperer", "vc_partner", "copilot_drone"]),
