    // Zone ids and anchors are a contract with the client layouts (docs/COMBAT_API.md, Zones).
    // `links` are exits: the anchor the client triggers on, the zone it leads to, and the world
    // progress that opens it (None = always open).
    zones: [
        (
            id: "campus", name: "Campus", kind: Outdoor, level_range: (1, 2), scooters: true,
            packs: [
                (anchor: "pack_1", units: ["delivery_robot", "unpaid_ambassador"]),
                (anchor: "pack_2", units: ["delivery_robot", "delivery_robot"]),
                (anchor: "pack_3", units: ["unpaid_ambassador", "delivery_robot"]),
                (anchor: "pack_4", units: ["scooter_exec", "delivery_robot"]),
                (anchor: "pack_5", units: ["linkedin_influencer", "unpaid_ambassador"]),
                (anchor: "pack_6", units: ["scooter_exec", "meatproxy"]),
                (anchor: "pack_7", units: ["chief_happiness_officer"]),
                (anchor: "pack_8", units: ["linkedin_influencer", "scooter_exec"]),
                // Open-world districts around the core, each on its own level band: Food Truck
                // Plaza 1-2, Wellness Park 2-3, Incubator Street and the Wellness Gym 3-4,
                // Garage & Station 4-5, the New HQ construction site 5.
                (anchor: "pack_9", units: ["lunch_optimizer", "lunch_optimizer"], level: Some(1)),
                (anchor: "pack_10", units: ["lunch_optimizer", "unpaid_ambassador"], level: Some(1)),
                (anchor: "pack_11", units: ["lunch_optimizer", "linkedin_influencer"], level: Some(2)),
                (anchor: "pack_12", units: ["lunch_optimizer", "lunch_optimizer", "delivery_robot"], level: Some(2)),
                (anchor: "pack_13", units: ["wellness_manager", "wellness_manager"], level: Some(2)),
                (anchor: "pack_14", units: ["wellness_manager", "mindfulness_coach"], level: Some(2)),
                (anchor: "pack_15", units: ["mindfulness_coach", "wellness_manager"], level: Some(3)),
                (anchor: "pack_16", units: ["wellness_manager", "wellness_manager", "mindfulness_coach"], level: Some(3)),
                (anchor: "pack_17", units: ["mindfulness_coach", "mindfulness_coach"], level: Some(3)),
                (anchor: "pack_18", units: ["preseed_founder", "preseed_founder"], level: Some(3)),
                (anchor: "pack_19", units: ["preseed_founder", "referral_hustler"], level: Some(3)),
                (anchor: "pack_20", units: ["referral_hustler", "referral_hustler"], level: Some(4)),
                (anchor: "pack_21", units: ["referral_hustler", "preseed_founder", "preseed_founder"], level: Some(4)),
                (anchor: "pack_22", units: ["step_counter", "step_counter"], level: Some(3)),
