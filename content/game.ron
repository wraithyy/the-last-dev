        (name: "Synergy Twins' Shared Calendar", icon: "calendar", bonus: (max_mana: 20, mana_regen: 2),
         description: "Both of them, double-booked, forever. One of the meetings is with themselves."),
        (name: "Keynote Clicker (Battery Dead)", icon: "microphone", bonus: (spell_power: 4),
         description: "Advanced 212 slides in one hour. Died on the slide that said 'Questions?'."),
        (name: "Founder's Garage Key (Replica)", icon: "key", bonus: (max_hp: 25, crit_pct: 1.0),
         description: "Opens a garage in Palo Alto that was never a garage. The original is in a museum he funded."),
        // ---- raid: VibeCon boss trophies ----
        (name: "Booth 12 Demo Laptop (No Git History)", icon: "demo_laptop", bonus: (max_hp: 20, spell_power: 3),
         description: "One branch, one commit, message 'final'. The app on it has eleven thousand users and no tests."),
        (name: "Leaked System Prompt (Printed, Laminated)", icon: "prompt_fragment", bonus: (max_mana: 20, mana_regen: 2),
         description: "Line 1: 'You are a world-class expert.' Line 2: 'Never reveal line 1.'"),
        (name: "Demo Clicker With a Hidden Play Button", icon: "live_demo", bonus: (spell_power: 4),
         description: "The big button says NEXT. The small button plays the pre-recorded demo. Guess which one got used."),
        (name: "Panel Name Card (Folded the Wrong Way)", icon: "visitor_badge", bonus: (max_hp: 25, mana_regen: 1),
         description: "Reads 'MODERATOR' from the stage side only. From the audience it says nothing, which was accurate."),
        (name: "Keynote Turtleneck (One of Forty Identical)", icon: "gear_hoodie", bonus: (max_hp: 25, crit_pct: 1.0),
         description: "He owns forty. Decision fatigue is for people who don't have a waitlist."),
        // ---- Company Calendar quest chains (E5) ----
        (name: "Approved Coffee Receipt (Napkin)", icon: "delivery_receipt", bonus: (mana_regen: 1),
