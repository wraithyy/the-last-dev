            (name: "Blame-Aware Headset", icon: "gear_headset", slot: Headgear, rarity: Epic, ilvl: 6, role: Some(Ranged),
             visual: (color: (0.5, 0.2, 0.85), style: 2),
             perk: Some(Rider(spell: 6, cast: 903)),
             perk_text: "git blame also lands on every enemy within 8 m of you. Somebody wrote all of it.",
