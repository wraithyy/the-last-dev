        // ---- DevOps (healer) ----
        (
            id: 40, name: "kill -9", icon: "kill_9", school: Arcane,
            range_m: 30.0, cast_ms: 2000, mana: 30, gcd: true, cooldown_ms: 0,
            description: "SIGKILL. No graceful shutdown, no exit hooks, no goodbye. Deals arcane damage.",
