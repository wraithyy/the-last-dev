            // ---- Tier 5 (ilvl 10): C-Level Penthouse, Innovation Lab ----
            (name: "Executive Retreat Fleece (Lost and Found)", icon: "gear_hoodie", slot: Hoodie, rarity: Common, ilvl: 10,
             visual: (color: (0.52, 0.52, 0.52)),
