                // Phase 3 (33%-0): golden handshakes (+30% damage), everything at once.
                abilities: [
                    (spell: 701, cooldown_min_ms: 24000, cooldown_max_ms: 27000, initial_ms: Some((12000, 14000)),
                        target: Caster, phases: [1, 3],
                        yells: [
                            "Motion to acquire everyone in this meeting. All in favour? Motion carries.",
                            "Hostile takeover! It's only hostile if you resist. Please don't resist.",
                        ]),
                    (spell: 700, cooldown_min_ms: 15000, cooldown_max_ms: 17000, initial_ms: Some((5000, 6000)),
                        yells: [
                            "Next slide: projections. Please stand where the line goes up.",
                            "Our forecast is aggressive. Mostly toward you.",
                        ]),
                    (spell: 703, cooldown_min_ms: 21000, cooldown_max_ms: 24000, initial_ms: Some((9000, 10000)),
                        target: RandomHostile, phases: [1, 3],
                        yells: [
                            "Stock buyback! We are buying ourselves. Huddle up and absorb the cost.",
                            "Buyback time. Shareholders, gather round. You are the shareholders now.",
                        ]),
                    (spell: 702, cooldown_min_ms: 14000, cooldown_max_ms: 16000, initial_ms: Some((4000, 5000)),
                        target: RandomHostile, phases: [2, 3],
                        yells: [
                            "Shareholder value for everyone! Spread it thin, like the bonus pool.",
                            "Diluting! Everybody gets a little bit less of everything!",
                        ]),
                    (spell: 5, cooldown_min_ms: 9000, cooldown_max_ms: 12000),
                ],
                phases: [
                    (below_hp_pct: 66, spell: Some(704), target: Caster,
                        yells: [
                            "This meeting needs more alignment. Bring in the Yes-Men.",
                            "Reshuffle! Everyone who disagrees has been promoted to 'advisor'.",
                        ]),
                    (below_hp_pct: 33, spell: Some(705), target: Caster,
                        yells: [
                            "The Board has voted itself golden handshakes. Unanimously. Retroactively.",
                            "Compensation committee approved! We approved it. We are the committee.",
                        ]),
