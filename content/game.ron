            (name: "Hoodie of Plausible Deniability", icon: "gear_hoodie", slot: Hoodie, rarity: Rare, ilvl: 6, role: Some(Tank),
             visual: (color: (0.3, 0.3, 0.33)),
             description: "Hood up, eyes down, ticket status 'In Review' since spring."),
            (name: "Ergonomic Keyboard With Lifesteal Wrist Rest", icon: "gear_keyboard", slot: Keyboard, rarity: Epic, ilvl: 6, role: Some(Melee),
             visual: (color: (0.65, 0.1, 0.2), style: 2),
             perk: Some(Leech(pct: 12)),
             perk_text: "Your spells heal you for 12% of the damage they deal. Self-care is a design pattern.",
