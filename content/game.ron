                    ],
                    confused_every_pct: 80,
                    head: "il_ilmari_head", plan_spell: 2754, story_plan_spell: 2755,
                    plan_first_ms: 45000, plan_ms: 60000, kick_delay_ms: 20000, head_ms: 8000,
                    volley: 3, story_split_ms: 4000,
                    plan_yells: [
                        "Tracking progress at 100 %. Please do not look at the other 100 %.",
                        "Quarterly planning. A tower of cards is rising over my head. It is a very confident tower.",
                    ],
                    kicked_yells: [
                        "The plan was interrupted. I will reschedule it. I have rescheduled it. It is in your calendar. It is the whole afternoon.",
                        "Planning is a conversation. You have changed the subject. I will revisit the subject.",
                    ],
                    volley_yells: [
                        "Planning complete. Everything on the board is a priority. Everything is now.",
                        "The roadmap is final. It has been executed in one sprint. The sprint was a fist.",
                    ],
                    hot_take: (first_ms: 40000, every_ms: 90000, lock_ms: 8000, aura: "il_hot_take", yells: [
                        "I would like one of you to share a hot take. The take is one word, and I have chosen the word. It is the only word you have.",
                        "One take, one button, eight seconds. It is a management exercise. It builds character. I have read about character.",
                    ]),
                    clears: ["il_ilmari_arm", "il_ilmari_head", "il_jam_turret", "il_cable"],
