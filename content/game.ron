                (name: "Fire drill test", counter: Headphones,
                 walk: (unit: "os_warden", kind: Ceo, route: "warden", speed_mps: 1.8, pause_ms: 0,
                        pauses: [(0, 26000), (1, 2000)], range_m: 4.0, half_angle_deg: 30.0, lines: ["This is a drill!"]),
                 interrupt: [
