        (name: "Laminated 'Human Inside' Sign", icon: "human_inside", bonus: (max_hp: 12, spell_power: 2),
         description: "Found taped to the inside of the AGI rack. For the fire department, presumably."),
        (name: "Demo Day Lanyard", icon: "demo_lanyard", bonus: (mana_regen: 4),
         description: "VIP access to a keynote where the product froze, rebooted and got a standing ovation."),
        // ---- enemy mechanics: trash drops and guaranteed elite drops ----
        (name: "Laptop Shield (Stickered)", icon: "demo_laptop", bonus: (max_hp: 8),
         description: "Covered in conference stickers and concerns. Blocks 60% of feedback from the front."),
        (name: "Agent Orchestration YAML (900 Lines)", icon: "stack_trace", bonus: (max_mana: 8),
         description: "Indentation is load-bearing. Nobody knows which agent owns which agent."),
        (name: "Mandatory Fun Lanyard", icon: "demo_lanyard", bonus: (max_hp: 18, spell_power: 3),
         description: "Elite drop. Proof you attended the trust fall. Nobody caught you, but you got a lanyard."),
        (name: "Admin Password on a Post-it (2014)", icon: "sticky", bonus: (spell_power: 6, crit_pct: 1.0),
         description: "Elite drop. Still valid. Still on the monitor. Root access, artisanal edition."),
        (name: "The CEO's Real Calendar", icon: "calendar", bonus: (max_hp: 25, haste_pct: 2),
         description: "Elite drop. Golf, golf, 'AI strategy' (golf). Knowing when he is busy is power."),
        (name: "Hype Cycle Chart (Annotated)", icon: "chart_up", bonus: (spell_power: 8, mana_regen: 4),
         description: "Elite drop. Someone wrote 'we are here' at every point of the curve. All correct."),
        // ---- quest drops (only while the quest wants them) and quest rewards ----
        (name: "Misdelivered Lunch Order", icon: "sandwich", bonus: (max_hp: 2),
