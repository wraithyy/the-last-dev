    // The interactive office (world.rs): off-bar spells everyone knows, props the layouts place
    // at anchor `prop:<key>` (where you stand to use them), hidden NPCs and secret achievements.
    // Prop and achievement keys are stable ids (quests may reference them later).
    world: (
        spells: [950, 951],
        props: [
            // ---- campus ----
            (key: "coffee_campus", name: "AI-Native Coffee Machine", zone: "campus", kind: Coffee,
             auras: [("fresh_brew", 120000)], fail_pct: 10, cooldown_ms: 3000, calm: Some((60, 120000))),
            (key: "billboard_campus", name: "AI Billboard", zone: "campus", kind: Billboard, reach_m: 12.0),
            (key: "days_sign_campus", name: "Days Without an AI Incident", zone: "campus", kind: DaysSign, reach_m: 6.0),
            (key: "ai_car", name: "The AI-Powered Car", zone: "campus", kind: AiCar, reach_m: 5.0),
            (key: "bike_rack", name: "Lonely Bike Rack", zone: "campus", kind: BikeRack),
            (key: "smoking_bench", name: "Sad Bench", zone: "campus", kind: Bench, reach_m: 3.0, calm: Some((50, 120000))),
            (key: "scooter_1", name: "Shared E-Scooter", zone: "campus", kind: Scooter, reach_m: 3.0, cooldown_ms: 2000, respawn_ms: 60000),
            (key: "scooter_2", name: "Shared E-Scooter", zone: "campus", kind: Scooter, reach_m: 3.0, cooldown_ms: 2000, respawn_ms: 60000),
            (key: "scooter_3", name: "Shared E-Scooter", zone: "campus", kind: Scooter, reach_m: 3.0, cooldown_ms: 2000, respawn_ms: 60000),
            (key: "scooter_4", name: "Shared E-Scooter", zone: "campus", kind: Scooter, reach_m: 3.0, cooldown_ms: 2000, respawn_ms: 60000),
            (key: "sprint_board", name: "Sprint Planning Board", zone: "campus", kind: SprintBoard, reach_m: 4.0),
            (key: "sprint_terminal", name: "Sprint Terminal", zone: "campus", kind: SprintBoard, reach_m: 3.5),
            (key: "scrum_board", name: "Daily Standup Board", zone: "campus", kind: ScrumBoard, reach_m: 4.0),
            (key: "office_dog", name: "Biscuit, the Office Dog", zone: "campus", kind: Dog, reach_m: 3.0, cooldown_ms: 2000, calm: Some((100, 120000))),
            // ---- tower ----
            (key: "coffee_open_space", name: "Office Coffee Machine", zone: "tower/1", kind: Coffee,
             auras: [("fresh_brew", 120000)], fail_pct: 10, cooldown_ms: 3000, calm: Some((60, 120000))),
            (key: "vending_open_space", name: "Snack Vending Machine", zone: "tower/1", kind: Vending,
             cost_sp: 5, fail_pct: 15, cooldown_ms: 2000, calm: Some((40, 120000)),
             auras: [("sugar_rush", 60000), ("protein_bar", 20000), ("expired_kombucha", 30000)],
             items: ["AI-Generated Motivational Quote", "Energy Drink"]),
            (key: "foosball_open_space", name: "Foosball Table", zone: "tower/1", kind: Table, calm: Some((120, 180000))),
            (key: "pingpong_open_space", name: "Ping-Pong Table", zone: "tower/1", kind: Table, calm: Some((120, 180000))),
            (key: "beanbag_open_space", name: "Bean Bag (Ergonomically Questionable)", zone: "tower/1", kind: BeanBag, reach_m: 3.0, cooldown_ms: 3000, calm: Some((150, 300000))),
            (key: "elevator_music", name: "Elevator Music Button", zone: "tower/1", kind: Music, reach_m: 3.0),
