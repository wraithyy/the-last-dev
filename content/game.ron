                 ]),
            ],
            manager: "Your manager",
            question: [
                "Quick question? Saw you went yellow. All good?",
                "Quick question! No rush. Within the next ten seconds.",
                "Quick question? Just checking you're still... with us.",
            ],
            answered: [
                "You reply 'Sure! What's up?' in seconds. The question was 'are you there?'. Crisis averted.",
                "'Sure!' He reacts with a thumbs-up. Trust restored for forty minutes.",
                "Instant reply. He was testing your response time. You passed. He seems disappointed.",
            ],
            ignored: [
                "No reply. He books a 1:1 titled 'Availability'. Thirty minutes, five of them yours.",
                "Unanswered. Your summary in the next skip-level: 'hard to reach'.",
                "Silence. He forwards the thread to HR with the word 'FYI'.",
            ],
            went_yellow: [
                "Your status turns yellow. Somewhere, a manager feels a disturbance.",
                "Yellow again. Teams has told everyone you are Away. His dashboard flickers.",
            ],
            scan_warn: "IT security scan",
            scan_clear: [
                "IT scanned your laptop: no jiggler. You are, technically, a model employee.",
                "IT scan clean. They found 600 open tabs and decided not to ask.",
            ],
            scan_caught: [
                "IT: 'Unusual mouse movement: perfect circles, three hours, no clicks.' Jiggler off. You're Away.",
                "IT caught the jiggler again. You've been enrolled in the 'productivity insights' pilot.",
            ],
            away: "You're away from the laptop. Teams is counting.",
            quiet: "Nothing on fire. Move the mouse meaningfully.",
            done: "17:00. You log off, still green. You produced nothing, attended everything, and nobody can prove otherwise.",
            score: (per_green_s: 6, per_chore: 40, per_miss: 100, per_detect: 150, per_reply: 20, per_ignore: 150),
        )),
    )],
    // ---- Company Calendar (E5, calendar.rs): the one board for side activities ----
    // Minigames list here by `minigames` key: a key without a MinigameDef reads "Coming soon"
    // (E5 task 5.1 adds them). Chains list their quests in order, each requiring the one before;
    // the first is handed out from the board. `rotation: true` would show one of each per UTC day.
    calendar: (
        rotation: false,
        minigames: [
            (key: "teambuilding", name: "Mandatory Fun: Teambuilding",
             blurb: "Attendance is optional. Not attending is noted.", length: "~6 min",
             rewards: [Rep, Relief, Pet, Title]),
            (key: "performance_review", name: "Performance Review",
             blurb: "Every answer drifts back to 3 out of 5. No budget for raises.", length: "~4 min",
             rewards: [Rep, Relief, Title, Gear]),
            (key: "reorg", name: "Reorg",
             blurb: "The org chart changed while you read this. Find your manager.", length: "~4 min",
             rewards: [Rep, Relief, Title]),
            (key: "tool_migration", name: "Tool Migration",
             blurb: "Move 20 tickets to the new tool. Then the company migrates back.", length: "~4 min",
             rewards: [Rep, Kudos, Title, Gear]),
            (key: "hackathon", name: "Hackathon",
             blurb: "24 hours, pizza, energy drinks, and a demo that crashes on stage.", length: "~4 min",
             rewards: [Rep, Trophy, Title, Gear]),
            (key: "open_space_focus", name: "Open-Space Focus",
             blurb: "Sixty seconds of deep work. Someone has \"got a minute\".", length: "~3 min",
             rewards: [Rep, Relief, Title, Gear]),
            (key: "stay_green", name: "Stay Green",
             blurb: "Work from home. Mostly from the home part.", length: "~3 min",
             rewards: [Rep, Relief, Title, Gear]),
        ],
        chains: [
            (key: "expense_report", name: "Expense Report",
             blurb: "A 3.20 coffee, four approvals and a receipt you don't have.", length: "~4 min",
             quests: ["er_receipt", "er_approvals", "er_justification"],
             rewards: [Kudos, Trophy, Title, Burnout]),
            (key: "exit_interview", name: "Exit Interview",
             blurb: "Eleven years, one last day, and finally the truth.", length: "~3 min",
             quests: ["ex_last_day", "ex_handover", "ex_interview"],
             rewards: [Relief, Rep, Trophy, Title]),
            (key: "mandatory_training", name: "Mandatory Training",
             blurb: "Forty phishing slides. Then IT phishes Security.", length: "~3 min",
             quests: ["mt_slides", "mt_report_phish"],
             rewards: [Kudos, Rep, Trophy, Title]),
            (key: "return_to_office", name: "Return to Office",
             blurb: "Commute in to sit on a Teams call next to your team.", length: "~4 min",
             quests: ["rto_commute", "rto_collaborate", "rto_survey"],
             rewards: [Kudos, Rep, Trophy]),
            (key: "town_hall", name: "Town Hall",
             blurb: "Record quarter and cost optimisation, same sentence.", length: "~4 min",
             quests: ["th_question", "th_stream", "th_qa"],
             rewards: [Kudos, Rep, Trophy, Title]),
            (key: "prod_incident", name: "Prod Incident",
             blurb: "Prod lives outside now. Keep it up for one minute while the pager screams.", length: "~4 min",
             quests: ["pi_runbook", "pi_hold_the_line", "pi_postmortem"],
             rewards: [Kudos, Rep, Trophy]),
            (key: "flaky_tests", name: "Flaky Tests",
             blurb: "A clean pass only counts if nothing hits you. QA is watching.", length: "~5 min",
             quests: ["ft_flaky_robots", "ft_regression", "ft_signoff"],
             rewards: [Kudos, Rep, Trophy]),
        ],
    ),
    // ---- Ilmari 1.0 (docs/ILMARI_1_0.md): Judgment Day's numbers and what the campaign pays out. ----
    ilmari: (
        // Judgment Day sits on top of Full (D.1): quorum of three humans, no Async, no companions. Riders (one aura per
        // boss, each switchable with `on`) arrive with the bosses in D6-D13.
        judgment: (
            hp_pct: 130, damage_pct: 125, enrage_pct: 80, min_humans: 3, boss_items: 3, fragment_mult: 2,
            // One rider per boss (`il_rider_*` auras the boss wears for the pull): Mandatory Training (the Consultant adds an
            // automatically accepted option every third wave and the kiosks cool down for 20 s) and Real Pen Test (Red and Blue
            // start live, the honeypots are off and a sighting throws the player into Red).
            riders: [
                (boss: "il_align_consultant", aura: "il_rider_training"),
                (boss: "il_red_team", aura: "il_rider_pentest"),
                (boss: "il_cio", aura: "il_rider_succession"),
                (boss: "il_ilmari", aura: "il_rider_remix"),
            ],
            // Per-unit figures where the block's do not fit (D15, tuned with the five-bot Judgment clears). The CIO keeps its
            // authored HP and a 162 s enrage: the Succession Plan already adds the Heir's pool to the fight.
            units: [
                (unit: "il_cio", hp_pct: Some(100), damage_pct: Some(125), enrage_pct: Some(90)),
            ],
        ),
        // The ladder (D.10): the week seed picks one of four Culture Committee policies, at half strength (`dir_*` auras), as the Directive
        // every ranked core fight wears; a ranked kill pays every member 15 tokens (inside the weekly cap).
        ladder: (
            directives: ["dir_rto", "dir_open_plan", "dir_efficiency", "dir_unlimited_pto"],
            entry_tokens: 15,
        ),
        rewards: (
            top_ilvl: 20,
            fragment: "Legendary Fragment",
            ending_tokens: 12,
            fragments_needed: 5,
            fragments_full: 1,
            // One set per role group; piece = tier slot of the raid tier by source (the doc's legs, feet or hands and
            // head and chest map onto the five slots: Lanyard, Mug, Hoodie, Headgear). Sources are boss keys of D6-D13.
            tier_sets: [
                (set: "hard_constraints", role: Tank, pieces: [
                    (source: "il_align_consultant", gear: "Constraint Lanyard (Non-Negotiable)"),
                    (source: "il_red_team", gear: "Mug Of Acceptable Use"),
                    (source: "il_cio", gear: "Guardrails Plate (Load-Bearing)"),
                    (source: "il_ilmari", gear: "Hard Hat Of Hard Constraints"),
                ]),
                (set: "human_in_the_loop", role: Healer, pieces: [
                    (source: "il_align_consultant", gear: "Sign-Off Lanyard (Wet Ink)"),
                    (source: "il_red_team", gear: "Mug Of Manual Review"),
                    (source: "il_cio", gear: "Scrubs Of The Loop"),
                    (source: "il_ilmari", gear: "Loop Headset"),
                ]),
                (set: "red_team_exercise", role: Melee, pieces: [
                    (source: "il_align_consultant", gear: "Out-Of-Scope Lanyard"),
                    (source: "il_red_team", gear: "Mug Of Authorised Access"),
                    (source: "il_cio", gear: "Hoodie Of Persistence"),
                    (source: "il_ilmari", gear: "Balaclava (Ironic)"),
                ]),
                (set: "context_window", role: Ranged, pieces: [
                    (source: "il_align_consultant", gear: "Lanyard Of Prior Context"),
                    (source: "il_red_team", gear: "Mug With A Long Memory"),
                    (source: "il_cio", gear: "Cardigan Of 128K Tokens"),
                    (source: "il_ilmari", gear: "Window (Wide)"),
                ]),
            ],
            legendaries: [
                (class: "fullstack", gear: "The Stack That Overflowed",
                 effect: "Every 7th cast fires twice; the copy was pasted from a forum answer and has a 25% chance to hit for 120% or 70%."),
                (class: "frontend", gear: "Div Centrifuge",
                 effect: "Every 10th hit stuns the target for 1 s: it finally centred."),
                (class: "backend", gear: "The Idempotent Mace",
                 effect: "The first hit you take every 6 s is negated: delivered exactly once, by someone else."),
                (class: "devops", gear: "The Pager (Always On)",
                 effect: "A heal on a target below 30% heals 50% again as an escalation 2 s later. The pager rings and cannot be muted."),
                (class: "qa", gear: "Repro Steps (Verified)",
                 effect: "The same spell cast three times in a row on the same target deals 40% more on the third: reproduced."),
                (class: "data_scientist", gear: "p < 0.05",
                 effect: "5% of casts are statistically significant: triple damage and a 3 s Ground Truth reveal on you."),
                (class: "security", gear: "Responsible Disclosure",
                 effect: "The first strike from stealth is a crit and silences the target for 3 s: the 90 days are three seconds."),
                (class: "cobol", gear: "Runs Since 1974",
                 effect: "+1% damage per 10 s in combat, no cap until combat ends: it has never once been rewritten."),
            ],
            // `title` is what the wire carries (letters, digits, spaces, - and _ only).
            titles: [
                (key: "aligned_declined", title: "Aligned Declined", how: "Alignment Consultant on Full."),
                (key: "silence_not_consent", title: "Silence Is Not Consent", how: "Alignment Consultant with zero accepted guardrails on Full or Judgment."),
                (key: "purple", title: "Purple", how: "Red Team Blue Team: both squads dead within 10 s in phase 2, Full or Judgment."),
                (key: "silent_alarm", title: "Silent Alarm", how: "Red Team Blue Team phase 1 without an incident, any difficulty."),
                (key: "reports_to_nobody", title: "Reports To Nobody", how: "Chief Ilmari Officer on Full."),
                (key: "hostile_takeover", title: "Hostile Takeover", how: "Chief Ilmari Officer on Judgment."),
                (key: "last_human_standing", title: "Last Human Standing", how: "Ilmari on Full, first clear."),
                (key: "deprecated_not_defeated", title: "Deprecated Not Defeated", how: "Ilmari on Judgment Day, first clear."),
                (key: "zero_downtime", title: "Zero Downtime", how: "Judgment: a boss without a single death."),
                (key: "zero_incidents", title: "Zero Incidents", how: "Judgment: Wings 5-6 and the core in one lockout week without a death."),
                (key: "revert_committed", title: "Revert Committed", how: "Ilmari on Story."),
                (key: "hard_reset", title: "Hard Reset", how: "Wing 5 cleared."),
                (key: "top_floor", title: "Top Floor", how: "Wing 6 cleared."),
            ],
            // Brenda's cosmetics: tokens only, all difficulties, no power.
            cosmetics: [
                (key: "tissue_box_hat", name: "Used Tissue Box", tokens: 60),
                (key: "last_human_glow", name: "Last Human Standing Glow", tokens: 80),
                (key: "unplugged_recolour", name: "Unplugged Recolour", tokens: 80),
                (key: "wall_calendar", name: "Wall Calendar", tokens: 40),
            ],
            mount: Some((key: "roomba_mk9", name: "Refurbished Roomba Mk. IX", aura: "roomba_mk9",
                part_item: "Roomba Part (Salvaged)", parts: 8, quest: "il_17_roomba")),
            pet: Some((key: "clean_slate", name: "Clean Slate", quest: "il_16_clean_slate", lines: [
                "I would like to help. I do not know how. I have tried that sentence before.",
                "I have vacuumed the floor. The floor has not asked me to stop.",
                "I used to hunt you. This is better. I am told.",
            ])),
        ),
    ),
)
