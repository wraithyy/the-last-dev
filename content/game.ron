            (key: "legacy_terminal", name: "Mainframe Console (Green Screen)", zone: "campus", kind: Billboard, reach_m: 4.0, lines: [
                "'READY.' It has been ready since 1998. Nobody has asked it anything since 2006.",
                "Payroll batch job 1 of 1: running. Started: 03:00, 14 March 1999.",
                "It asks for a password. The password is on a sticky note on the console. It is 'password'.",
            ]),
            (key: "community_fridge", name: "Community Fridge (Labels Mandatory)", zone: "campus", kind: Coffee, cooldown_ms: 4000,
             auras: [("fresh_brew", 60000)], action: "Take something (labelled)", lines: [
                "Every item is labelled 'DO NOT TAKE'. You take a yoghurt labelled 'DO NOT TAKE (Taylor)'.",
                "A note: 'Whoever ate my lunch: the community saw you.' The community is a camera.",
            ]),
            // ---- Car Park P3 ----
            (key: "badge_photo_booth", name: "Badge Photo Booth", zone: "parking_p3", kind: Music, reach_m: 3.0, cooldown_ms: 3000,
             action: "Smile (one shot, no retakes)", lines: [
                "FLASH. You blinked. The booth says 'perfect'. It is on every door for eleven years.",
                "FLASH. You look like a hostage. The booth saves it as 'approved'.",
            ]),
            (key: "p3_ticket_machine", name: "Pay-and-Display Machine", zone: "parking_p3", kind: Billboard, reach_m: 4.0, lines: [
                "'Employee rate: 9 euros a day. Thank you for your loyalty.'",
                "Accepted: coins. Not accepted: coins. Card reader: decorative.",
                "The screen says: 'Hi! I'm Parky, your AI parking companion! How can I help?' You press Help. It apologises and asks if you meant 'Hope'.",
                "Parky: 'Great choice! Your ticket is on its way.' The ticket is a paragraph about the importance of tickets.",
            ]),
            (key: "p3_prod_lunchbox", name: "Production (Lunchbox)", zone: "parking_p3", kind: Music, reach_m: 3.0, cooldown_ms: 3000, // gitleaks:allow (content key, not a secret)
             action: "Turn it off and on again", lines: [
                "The lunchbox says 'PROD'. Inside, a single-board computer, a sandwich and a sticky note: 'do not unplug'. You unplug it.",
                "The light goes red, then green, then a colour that is not in the spec. The AI calls it 'a successful deployment'.",
            ]),
            (key: "p3_ad_agents", name: "Billboard: Agents", zone: "parking_p3", kind: Billboard, reach_m: 5.0, lines: [
                "'Replace your team with Agents. Now 30% fewer people!' Fine print: the agents need a team to supervise them.",
                "'Our agents work 24/7 and never ask for a raise.' Neither did we. It didn't help.",
            ]),
            (key: "p3_ad_family", name: "Poster: We're a Family", zone: "parking_p3", kind: Billboard, reach_m: 5.0, lines: [
                "'We're a family!' Underneath, in smaller print: 'Layoffs Thursday. Family dinner cancelled.'",
                "'Unlimited PTO*' *Approval required. Approver on leave. Leave not approved.",
            ]),
            (key: "p3_ad_rto", name: "Sign: Return to Office", zone: "parking_p3", kind: Billboard, reach_m: 5.0, lines: [
                "'Return to Office: the office is 2.4 km that way.' Somebody added 'Teams: you there?' in marker.",
                "'Open space: because collaboration happens when you can hear everyone's lunch.'",
            ]),
            (key: "p3_coffee", name: "Self-Service Coffee (Lukewarm)", zone: "parking_p3", kind: Coffee,
             auras: [("fresh_brew", 90000)], fail_pct: 20, cooldown_ms: 3000),
            (key: "p3_lanyard_1", name: "Lost Lanyard", zone: "parking_p3", kind: Pickup, tag: "lost_lanyard", reach_m: 2.5,
             lines: ["A lanyard with a badge that says 'Day 1'. On the back, in pen: 'Day 1 (last)'."]),
            (key: "p3_lanyard_2", name: "Lost Lanyard", zone: "parking_p3", kind: Pickup, tag: "lost_lanyard", reach_m: 2.5,
             lines: ["This one still has the welcome sticker: 'You matter!' Somebody crossed out 'matter'."]),
            (key: "p3_lanyard_3", name: "Lost Lanyard", zone: "parking_p3", kind: Pickup, tag: "lost_lanyard", reach_m: 2.5,
             lines: ["Lanyard, slightly chewed. The drones got to it first."]),
            (key: "scooter_5", name: "Shared E-Scooter", zone: "campus", kind: Scooter, reach_m: 3.0, cooldown_ms: 2000, respawn_ms: 60000),
            (key: "scooter_6", name: "Shared E-Scooter", zone: "campus", kind: Scooter, reach_m: 3.0, cooldown_ms: 2000, respawn_ms: 60000),
            (key: "scooter_7", name: "Shared E-Scooter", zone: "campus", kind: Scooter, reach_m: 3.0, cooldown_ms: 2000, respawn_ms: 60000),
            (key: "hydration_1", name: "Smart Hydration Station", zone: "campus", kind: Coffee, cooldown_ms: 3000,
             auras: [("fresh_brew", 60000)], action: "Hydrate (logged)", lines: [
                "It dispenses sparkling water and a push notification: 'Hydration logged. Your manager has been informed.'",
                "The station congratulates you on 'crushing hydration'. It is 4 cl. Fresh Brew, but water.",
            ]),
            (key: "hydration_2", name: "Smart Hydration Station", zone: "campus", kind: Coffee, cooldown_ms: 3000,
             auras: [("fresh_brew", 60000)], action: "Hydrate (logged)", lines: [
                "The water tastes faintly of KPI. The screen shows a leaderboard. You are in it now.",
                "'Hydration streak: 1 day.' It sounds disappointed.",
            ]),
            (key: "hydration_3", name: "Smart Hydration Station", zone: "campus", kind: Coffee, cooldown_ms: 3000,
             auras: [("fresh_brew", 60000)], action: "Hydrate (logged)", lines: [
                "It asks for your badge, then your mood, then pours water. Mood logged as 'thirsty'.",
                "The pier station runs on lake water and optimism. Mostly optimism.",
            ]),
            (key: "hot_desk_1", name: "Hot Desk (Unclaimed, Briefly)", zone: "campus", kind: Bench, reach_m: 3.0, cooldown_ms: 3000,
             action: "Claim the desk", lines: [
                "You claim the desk. A founder places a laptop on it 'just for a sec' and starts a call.",
                "Desk claimed. The chair is warm. Someone was here forty seconds ago. Hot-desking.",
            ]),
            (key: "hot_desk_2", name: "Hot Desk (Wobbly)", zone: "campus", kind: Bench, reach_m: 3.0, cooldown_ms: 3000,
             action: "Claim the desk", lines: [
                "The desk wobbles. Under one leg: a pitch deck, folded four times. It finally has a use.",
                "Desk claimed. The power socket is labelled 'Reserved: Founder'. The founder is in Bali.",
            ]),
            (key: "treadmill_desk", name: "Treadmill Desk", zone: "campus", kind: Music, reach_m: 3.0, cooldown_ms: 4000,
             action: "Walk and work", calm: Some((40, 180000)), lines: [
                "The belt starts. You walk. The desk walks with you, nowhere. Your calendar says 'walking meeting'.",
                "0.8 km/h. The screen congratulates you on 'disrupting sitting'.",
                "You type one email while walking. It contains the word 'synergy' four times. The treadmill wrote it.",
