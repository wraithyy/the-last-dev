                 ]),
                (name: "Speakerphone Account Manager", counter: Headphones,
                 walk: (unit: "os_caller", kind: Talker, route: "caller", speed_mps: 1.3, pause_ms: 0,
                        pauses: [(0, 9000), (1, 3000)], range_m: 4.0, half_angle_deg: 30.0, lines: ["HELLO? CAN YOU HEAR ME?"]),
                 interrupt: [
                     "YES, I'M IN THE OFFICE. THE OPEN SPACE. EVERYONE CAN HEAR? GREAT!",
                     "CAN YOU HEAR ME NOW? I'LL TALK LOUDER.",
                     "LET'S TAKE THIS OFFLINE! I'M STILL ON SPEAKER!",
                 ],
                 deflected: [
                     "(Through your headphones he is a distant, angry whale.)",
                     "(He is still shouting. You hear only lo-fi beats.)",
                 ]),
                (name: "Birthday cake procession", counter: Duck,
                 walk: (unit: "os_cake", kind: Hr, route: "cake", speed_mps: 1.1, pause_ms: 0,
                        pauses: [(0, 14000), (1, 3000)], range_m: 4.0, half_angle_deg: 30.0, lines: ["Happy birthday to youuu..."]),
                 interrupt: [
                     "Happy birthday to... who is it again? Sing anyway!",
                     "Cake! You have to take a slice. It's mandatory fun.",
                     "Everyone gather round! Yes, you too. Especially you.",
                 ],
                 deflected: [
                     "Where did they go? Fine. More cake for HR.",
                     "(The procession sings over your empty chair.)",
                 ]),
                (name: "Fire drill test", counter: Headphones,
                 walk: (unit: "os_warden", kind: Ceo, route: "warden", speed_mps: 1.8, pause_ms: 0,
                        pauses: [(0, 26000), (1, 2000)], range_m: 4.0, half_angle_deg: 30.0, lines: ["This is a drill!"]),
                 interrupt: [
                     "This is a test of the fire alarm. Please evacuate. Or don't. It's a test.",
                     "Drill! Everyone out! Not you. Actually yes, you.",
                     "WEEE-OOO. That was me. The real alarm is broken.",
                 ],
                 deflected: [
                     "(Muted, the alarm sounds almost like focus.)",
                     "Headphones during a drill? Noted. Carry on.",
                 ]),
            ],
        )),
    ), (
        key: "stay_green",
        name: "Stay Green",
        blurb: "Work from home. Mostly from the home part.",
        zone: "home/1",
        length: "~3 min",
        limit_s: 210,
        department: "HR",
        hint: "Keep your Teams status green. The cat, the laundry and the neighbour have other plans.",
        how: "A working day at home in three minutes. At the laptop your status stays green; away from it the meter drains and you go yellow, which brings your manager's 'quick question?'. Hang the laundry and open the door for the courier in person, lift the cat off the keyboard, mute for the drilling and unmute when the call says you're on mute. The mouse jiggler holds your status while you're away, but IT scans for it now and then. Keys 1-4 or the buttons.",
        medals: [
            (name: "Technically Online", rep: 60, relief: 80),
            (name: "Present in Spirit", min_score: 1000, rep: 120, relief: 140, event: Some("stay_green_title")),
            (name: "Camera Off, Status Green", min_score: 1350, flawless: true, rep: 200, relief: 200,
             items: ["Webcam Hoodie (Sweatpants Implied)"], event: Some("stay_green_title")),
        ],
        stay_green: Some((
            desk_m: 1.8,
            goal_ms: 180000,
            yellow_at: 50,
            rise_per_s: 30.0,
            decay_per_s: 12.0,
            jiggler_ms: 12000,
            jiggler_rest_ms: 20000,
            ping_ms: 3000,
            reply_ms: 10000,
            scan_warn_ms: 6000,
            it_scans_s: [62, 120],
            actions: ["Mouse jiggler", "Lift the cat", "Mute", "Unmute", "Reply \"Sure!\""],
            schedule: [
                (12, "cat"), (25, "laundry"), (45, "drill"), (58, "courier"), (80, "on_mute"),
                (95, "cat"), (110, "laundry"), (130, "courier"), (150, "drill"), (162, "on_mute"),
                (172, "cat"),
            ],
            chores: [
                (key: "cat", name: "Cat on the keyboard", fix: Pet, deadline_ms: 7000,
                 start: [
                     "The cat sits on your keyboard. Teams thinks you are typing furiously.",
                     "The cat is back on the keyboard, drafting a reply to Legal.",
                     "The cat lies across the trackpad and opens 41 tabs.",
                 ],
                 done: [
                     "Cat relocated. It will be back. It always is.",
                     "You lift the cat. It looks at you the way Finance looks at a taxi receipt.",
                     "Cat removed. It sends you a calendar invite: 'Sync re: lap'.",
                 ],
                 missed: [
                     "The cat sent 'jjjjjjjjjjjj;;;;' to #exec-announcements. Three thumbs-up and a 'great energy'.",
                     "The cat accepted a meeting on your behalf. Saturday, 07:00, recurring.",
                     "The cat replied-all. Facilities now has your home address.",
                 ]),
                (key: "laundry", name: "Washer done: hang the laundry", fix: Go("laundry", 3500), deadline_ms: 30000,
                 start: [
                     "The washing machine plays its little song. Hang it now or it smells like a basement by noon.",
                     "The washer beeps again. It has the persistence of a recruiter on LinkedIn.",
                 ],
                 done: [
                     "Laundry hung. Your one call-worthy shirt is the wet one.",
                     "Laundry hung. A sock is missing. Probably reorganised into another team.",
                 ],
                 missed: [
                     "The laundry sat too long. It now smells like the office fridge.",
                     "Your one presentable shirt is damp and smells of regret. Camera stays off.",
                 ]),
                (key: "courier", name: "Courier at the door", fix: Go("door", 2000), deadline_ms: 15000,
                 start: [
                     "Doorbell! A courier. He'll wait exactly as long as it takes to fill in 'Sorry we missed you'.",
                     "Doorbell again. A parcel for the neighbour. You are the building's mailroom now.",
                 ],
                 done: [
                     "Parcel signed for. It's the ergonomic footrest you expensed in March.",
                     "You take the neighbour's parcel. It's heavy and it hums. Probably a smart kettle.",
                 ],
                 missed: [
                     "'Sorry we missed you.' The note was filled in before he rang.",
                     "The parcel is now at a depot 40 km away, open Tuesdays from 10:00 to 10:15.",
                 ]),
                (key: "drill", name: "Neighbour drilling: mute!", fix: Mute, deadline_ms: 6000,
                 start: [
                     "The neighbour starts drilling. During the all-hands. Into the wall behind your head.",
                     "BRRRRRRT. The neighbour is putting up a second shelf. For the first shelf.",
                 ],
                 done: [
                     "Muted. The all-hands goes on without hearing the drill, or you.",
                     "Muted in time. The CFO says 'headwinds' over a silence that is entirely yours.",
                 ],
                 missed: [
                     "The whole all-hands heard the drill. The CEO asks if you're 'building something'. Applause.",
                     "Two hundred people heard the drill. Someone in the chat asks if that's the layoffs.",
                 ]),
                (key: "on_mute", name: "\"You're on mute\"", fix: Unmute, deadline_ms: 8000,
                 start: [
                     "\"Sorry, I think you're on mute.\" Your name, in the important call. Everyone waits.",
                     "\"You're on mute.\" It's the client. They asked you something twenty seconds ago.",
                 ],
                 done: [
                     "Unmuted: 'Sorry, can you hear me now?' They can. They wish they couldn't.",
                     "Unmuted. You say 'agreed, let's take it offline'. It answers every question.",
                 ],
                 missed: [
                     "They moved on. Your silence was minuted as 'agreed to own it'.",
                     "\"Let's circle back once their audio works.\" They never circle back. You own the migration now.",
                 ]),
            ],
            manager: "Your manager",
            question: [
                "Quick question? Saw you went yellow. All good?",
                "Quick question! No rush. Within the next ten seconds.",
                "Quick question? Just checking you're still... with us.",
            ],
            answered: [
                "You reply 'Sure! What's up?' in seconds. The question was 'are you there?'. Crisis averted.",
                "'Sure!' He reacts with a thumbs-up. Trust restored for forty minutes.",
                "Instant reply. He was testing your response time. You passed. He seems disappointed.",
            ],
            ignored: [
                "No reply. He books a 1:1 titled 'Availability'. Thirty minutes, five of them yours.",
                "Unanswered. Your summary in the next skip-level: 'hard to reach'.",
                "Silence. He forwards the thread to HR with the word 'FYI'.",
            ],
            went_yellow: [
                "Your status turns yellow. Somewhere, a manager feels a disturbance.",
                "Yellow again. Teams has told everyone you are Away. His dashboard flickers.",
            ],
            scan_warn: "IT security scan",
            scan_clear: [
                "IT scanned your laptop: no jiggler. You are, technically, a model employee.",
                "IT scan clean. They found 600 open tabs and decided not to ask.",
            ],
            scan_caught: [
                "IT: 'Unusual mouse movement: perfect circles, three hours, no clicks.' Jiggler off. You're Away.",
                "IT caught the jiggler again. You've been enrolled in the 'productivity insights' pilot.",
            ],
            away: "You're away from the laptop. Teams is counting.",
            quiet: "Nothing on fire. Move the mouse meaningfully.",
            done: "17:00. You log off, still green. You produced nothing, attended everything, and nobody can prove otherwise.",
            score: (per_green_s: 6, per_chore: 40, per_miss: 100, per_detect: 150, per_reply: 20, per_ignore: 150),
        )),
    )],
    // ---- Company Calendar (E5, calendar.rs): the one board for side activities ----
    // Minigames list here by `minigames` key: a key without a MinigameDef reads "Coming soon"
    // (E5 task 5.1 adds them). Chains list their quests in order, each requiring the one before;
    // the first is handed out from the board. `rotation: true` would show one of each per UTC day.
    calendar: (
        rotation: false,
        minigames: [
            (key: "teambuilding", name: "Mandatory Fun: Teambuilding",
             blurb: "Attendance is optional. Not attending is noted.", length: "~6 min",
             rewards: [Rep, Relief, Pet, Title]),
            (key: "performance_review", name: "Performance Review",
             blurb: "Every answer drifts back to 3 out of 5. No budget for raises.", length: "~4 min",
             rewards: [Rep, Relief, Title, Gear]),
            (key: "reorg", name: "Reorg",
             blurb: "The org chart changed while you read this. Find your manager.", length: "~4 min",
             rewards: [Rep, Relief, Title]),
            (key: "tool_migration", name: "Tool Migration",
             blurb: "Move 20 tickets to the new tool. Then the company migrates back.", length: "~4 min",
             rewards: [Rep, Kudos, Title, Gear]),
            (key: "hackathon", name: "Hackathon",
             blurb: "24 hours, pizza, energy drinks, and a demo that crashes on stage.", length: "~4 min",
             rewards: [Rep, Trophy, Title, Gear]),
            (key: "open_space_focus", name: "Open-Space Focus",
             blurb: "Sixty seconds of deep work. Someone has \"got a minute\".", length: "~3 min",
             rewards: [Rep, Relief, Title, Gear]),
            (key: "stay_green", name: "Stay Green",
             blurb: "Work from home. Mostly from the home part.", length: "~3 min",
             rewards: [Rep, Relief, Title, Gear]),
        ],
        chains: [
            (key: "expense_report", name: "Expense Report",
             blurb: "A 3.20 coffee, four approvals and a receipt you don't have.", length: "~4 min",
             quests: ["er_receipt", "er_approvals", "er_justification"],
             rewards: [Kudos, Trophy, Title, Burnout]),
            (key: "exit_interview", name: "Exit Interview",
             blurb: "Eleven years, one last day, and finally the truth.", length: "~3 min",
             quests: ["ex_last_day", "ex_handover", "ex_interview"],
             rewards: [Relief, Rep, Trophy, Title]),
            (key: "mandatory_training", name: "Mandatory Training",
             blurb: "Forty phishing slides. Then IT phishes Security.", length: "~3 min",
             quests: ["mt_slides", "mt_report_phish"],
             rewards: [Kudos, Rep, Trophy, Title]),
            (key: "return_to_office", name: "Return to Office",
             blurb: "Commute in to sit on a Teams call next to your team.", length: "~4 min",
             quests: ["rto_commute", "rto_collaborate", "rto_survey"],
             rewards: [Kudos, Rep, Trophy]),
            (key: "town_hall", name: "Town Hall",
             blurb: "Record quarter and cost optimisation, same sentence.", length: "~4 min",
             quests: ["th_question", "th_stream", "th_qa"],
             rewards: [Kudos, Rep, Trophy, Title]),
            (key: "prod_incident", name: "Prod Incident",
             blurb: "Prod lives outside now. Keep it up for one minute while the pager screams.", length: "~4 min",
             quests: ["pi_runbook", "pi_hold_the_line", "pi_postmortem"],
             rewards: [Kudos, Rep, Trophy]),
            (key: "flaky_tests", name: "Flaky Tests",
             blurb: "A clean pass only counts if nothing hits you. QA is watching.", length: "~5 min",
             quests: ["ft_flaky_robots", "ft_regression", "ft_signoff"],
             rewards: [Kudos, Rep, Trophy]),
        ],
    ),
)
