        (name: "World's Okayest Engineer Mug", icon: "gear_mug", bonus: (max_hp: 12),
         description: "Left behind on her last day. The only honest performance review anyone here got."),
        (name: "Security Awareness Certificate (Level 1)", icon: "mandatory_prompt_training_certificate", bonus: (crit_pct: 0.5),
         description: "Expires in eleven months. Security clicked the renewal link. It was phishing."),
        (name: "Hot-Desk Booking Confirmation", icon: "room_booking", bonus: (haste_pct: 1),
