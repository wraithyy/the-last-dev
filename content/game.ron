            (key: "step_leaderboard", name: "Step Leaderboard", zone: "campus", kind: Billboard, reach_m: 8.0, lines: [
                "1st: Ceiling Fan (Finance) - 41,002 steps. 2nd: VP of Gains - 38,114. Last: you.",
                "'Movement is a metric.' The screen updates every second. You feel watched.",
                "The leaderboard shames the bottom ten. You are 11th. Congratulations, almost safe.",
            ]),
            (key: "food_truck_menu", name: "AI Food Truck Menu", zone: "campus", kind: Billboard, reach_m: 6.0, lines: [
                "Today's special: 'Taco, conceptually'. Allergens: unknown, the AI says probably fine.",
                "New! Prompt Bowl: tell the bowl what you want. It gives you rice.",
                "Burrito (Large Language). Comes with a disclaimer.",
            ]),
            (key: "pitch_whiteboard", name: "Incubator Pitch Whiteboard", zone: "campus", kind: Whiteboard),
            (key: "days_sign_site", name: "Days Until Opening", zone: "campus", kind: DaysSign, reach_m: 6.0,
             action: "Update the countdown", lines: [
                "You set 'Days until opening' to 0. It was already negative. Nobody noticed.",
                "The sign read 'Opening 2019'. You changed it to '2019 (Again)'. Accurate.",
            ]),
            (key: "crane_button", name: "Crane Control Button", zone: "campus", kind: Music, reach_m: 3.0, cooldown_ms: 3000,
             action: "Press the big red button", lines: [
                "The crane beeps, swings ten degrees and stops. It has been in a planning phase since 2019.",
                "Nothing moves. A voice from the cab: 'Is this about the change order?'",
                "The crane plays hold music. Even the crane is in a meeting.",
            ]),
            (key: "lake_bench", name: "Lakeside Bench", zone: "campus", kind: Bench, reach_m: 3.0, calm: Some((60, 120000))),
            // Desk Census: overflow hot desks on the lawn west of the tower.
            (key: "rto_desk_1", name: "Overflow Hot Desk", zone: "campus", kind: Inspect, tag: "rto_desk", reach_m: 3.0,
             lines: ["A desk on the grass. The laptop on it moves its own mouse in perfect circles. Nobody is here. Status: green."]),
            (key: "rto_desk_2", name: "Overflow Hot Desk", zone: "campus", kind: Inspect, tag: "rto_desk", reach_m: 3.0,
             lines: ["A cold oat flat white and a badge-shaped ring in the condensation. Someone was here for six minutes."]),
            (key: "rto_desk_3", name: "Overflow Hot Desk", zone: "campus", kind: Inspect, tag: "rto_desk", reach_m: 3.0,
             lines: ["'RESERVED: LEADERSHIP (WEDNESDAYS)'. It's Thursday. The reservation is still very much in force."]),
            // ---- tower ----
            (key: "coffee_open_space", name: "Office Coffee Machine", zone: "tower/1", kind: Coffee,
             auras: [("fresh_brew", 120000)], fail_pct: 10, cooldown_ms: 3000, calm: Some((60, 120000))),
            (key: "vending_open_space", name: "Snack Vending Machine", zone: "tower/1", kind: Vending,
             cost_sp: 5, fail_pct: 15, cooldown_ms: 2000, calm: Some((40, 120000)),
             auras: [("sugar_rush", 60000), ("protein_bar", 20000), ("expired_kombucha", 30000)],
             items: ["AI-Generated Motivational Quote", "Energy Drink"]),
            (key: "foosball_open_space", name: "Foosball Table", zone: "tower/1", kind: Table, calm: Some((120, 180000))),
            (key: "pingpong_open_space", name: "Ping-Pong Table", zone: "tower/1", kind: Table, calm: Some((120, 180000))),
            (key: "beanbag_open_space", name: "Bean Bag (Ergonomically Questionable)", zone: "tower/1", kind: BeanBag, reach_m: 3.0, cooldown_ms: 3000, calm: Some((150, 300000))),
            (key: "elevator_music", name: "Elevator Music Button", zone: "tower/1", kind: Music, reach_m: 3.0),
            (key: "whiteboard_meeting", name: "Strategy Whiteboard", zone: "tower/2", kind: Whiteboard),
            (key: "fire_alarm", name: "Fire Alarm", zone: "tower/2", kind: FireAlarm, reach_m: 3.0, cooldown_ms: 60000),
            (key: "quiet_room", name: "Quiet Room (Unbookable)", zone: "tower/2", kind: QuietRoom, reach_m: 3.0, cooldown_ms: 3000, calm: Some((100, 240000))),
            (key: "printer_pmo", name: "Shared Printer (Jammed)", zone: "tower/4", kind: Printer, cooldown_ms: 600),
            (key: "days_sign_pmo", name: "Days Without an AI Incident", zone: "tower/4", kind: DaysSign, reach_m: 5.0),
            // ---- elsewhere ----
            (key: "vending_hall_a", name: "GPU-Themed Vending Machine", zone: "datacenter/1", kind: Vending,
             cost_sp: 8, fail_pct: 15, cooldown_ms: 2000, calm: Some((40, 120000)),
             auras: [("sugar_rush", 60000), ("protein_bar", 20000), ("expired_kombucha", 30000)],
             items: ["AI-Generated Motivational Quote", "Energy Drink"]),
            (key: "whiteboard_lab", name: "Innovation Whiteboard", zone: "lab/1", kind: Whiteboard),
            (key: "foosball_lab", name: "Foosball Table (Disrupted)", zone: "lab/1", kind: Table, calm: Some((120, 180000))),
            (key: "printer_3d", name: "3D Printer (0%)", zone: "lab/1", kind: Printer, cooldown_ms: 1500),
            // One aura, no failure roll: the use always puts the headset on. Burnout relief is a
            // short break from reality, with its own long cooldown.
            (key: "vr_demo", name: "VR Demo (No One Asked)", zone: "lab/1", kind: VrDemo, reach_m: 3.0, cooldown_ms: 45000,
             auras: [("vr_headset", 15000)], calm: Some((60, 240000))),
            // ---- variety pass: zone-flavoured lines (PropDef::lines) ----
            (key: "gong_sales", name: "Deal-Closed Gong", zone: "tower/3", kind: Music, reach_m: 3.0, cooldown_ms: 3000,
             action: "Bang the gong (no deal required)", lines: [
                "BONG. Someone closed a deal. The deal is a free pilot. The pilot is for a feature that doesn't exist.",
                "BONG. Sales cheers. Engineering, two floors down, feels a disturbance in the roadmap.",
                "BONG. The CRM marks the opportunity 'Closed Won'. The customer marks it 'We were just browsing'.",
                "BONG. A Sales Rep high-fives you and adds you to the commission split as 'technical overlay'.",
            ]),
            (key: "coffee_sales", name: "Client-Facing Espresso Machine", zone: "tower/3", kind: Coffee,
             auras: [("fresh_brew", 120000)], fail_pct: 10, cooldown_ms: 3000, calm: Some((60, 120000)), lines: [
                "It pours a flawless espresso and logs it as 'client entertainment'. Fresh Brew for 2 min.",
                "The latte art is the company logo, slightly off-brand. Fresh Brew for 2 min.",
                "A Sales Rep watches you drink it and asks about your budget cycle. Fresh Brew for 2 min.",
            ]),
            (key: "whiteboard_pipeline", name: "Pipeline Forecast Whiteboard", zone: "tower/3", kind: Whiteboard, lines: [
                "The forecast says 'Q4: hockey stick'. Q1 to Q3 also said 'Q4: hockey stick'.",
                "Pipeline: 40 million. Weighted pipeline: 'please don't weight it'.",
                "Someone drew a funnel. Everything goes in the top. Nothing comes out the bottom. They circled it twice.",
                "Top of the board: 'Upsell AI to every customer'. Below, smaller: 'what is our AI?'",
            ]),
            (key: "coffee_exec", name: "Executive Espresso Bar (Gold-Plated)", zone: "tower/5", kind: Coffee,
             auras: [("fresh_brew", 120000)], fail_pct: 10, cooldown_ms: 3000, calm: Some((60, 120000)), lines: [
                "Single-origin beans, picked by an intern flown in for the purpose. Fresh Brew for 2 min.",
                "The machine asks for your title before it pours. It pours anyway, with visible reluctance. Fresh Brew for 2 min.",
                "It costs more per cup than your hourly rate. The CFO calls it 'investing in leadership'. Fresh Brew for 2 min.",
            ]),
            (key: "printer_board_deck", name: "Board Deck Printer (Colour, Never Jams)", zone: "tower/5", kind: Printer, cooldown_ms: 1500, lines: [
                "It prints the board deck flawlessly. Slide 3: 'Headcount optimisation'. Your name is in the appendix.",
                "Out comes a glossy one-pager titled 'AI-First, People-Adjacent'. The ink is still warm. So is the layoff list.",
                "The printer up here has never jammed. It has never been asked to print a bug report either.",
                "It prints the quarterly results in gold foil. The numbers are the same as last quarter, but shinier.",
            ]),
            (key: "days_sign_exec", name: "Days Since Last Pivot", zone: "tower/5", kind: DaysSign, reach_m: 5.0,
             action: "Reset the counter (pivot)", lines: [
                "You reset the counter to 0. Nobody notices. The strategy changed twice while you walked over.",
                "Days since last pivot: 0. The previous record was 3, set during a long weekend.",
                "You reset it. Somewhere, a press release about 'our next chapter' starts writing itself.",
            ]),
            (key: "printer_hall_a", name: "Cable Label Printer (Out of Labels)", zone: "datacenter/1", kind: Printer, cooldown_ms: 1500, lines: [
                "It prints a label that says 'DO NOT UNPLUG'. It is the last label. The cable it's for is already unplugged.",
                "Out of labels since 2019. It prints one anyway, onto your sleeve: 'PROD?'.",
                "The label reads 'temporary'. It joins the 400 other 'temporary' labels holding the hall together.",
            ]),
            (key: "days_sign_hall_a", name: "Days Without a Thermal Event", zone: "datacenter/1", kind: DaysSign, reach_m: 5.0, lines: [
                "You reset it to 0. The sign's own power supply starts to smell warm in agreement.",
                "Days without a thermal event: 0. The GPU cultists cheer. They consider heat a blessing.",
                "The digits were stuck on 0 anyway. You reset them to 0 again, out of solidarity.",
            ]),
            (key: "vending_hall_b", name: "Coolant-Adjacent Vending Machine", zone: "datacenter/2", kind: Vending,
             cost_sp: 8, fail_pct: 15, cooldown_ms: 2000, calm: Some((40, 120000)),
             auras: [("sugar_rush", 60000), ("protein_bar", 20000), ("expired_kombucha", 30000)],
             items: ["AI-Generated Motivational Quote", "Energy Drink"]),
            (key: "bridge_line_hall_b", name: "Incident Bridge Hold Music", zone: "datacenter/2", kind: Music, reach_m: 3.0, cooldown_ms: 3000,
             action: "Dial into the incident bridge", lines: [
                "(hold music) 'Your incident is important to us. You are caller 41 on the bridge.'",
                "(hold music) Someone on the bridge forgot to mute. You hear them say 'it's probably DNS'. It is never DNS. It is DNS.",
                "(hold music) A VP joins the bridge, asks for an ETA, and leaves before anyone answers.",
                "(hold music) The bridge has 60 people on it. One is typing. The rest are watching her type.",
            ]),
            (key: "whiteboard_hall_b", name: "Incident Timeline Whiteboard", zone: "datacenter/2", kind: Whiteboard, lines: [
                "02:14 fans loud. 02:31 fans louder. 02:47 'have we tried AI?'. 03:00 fire. The board stops there.",
                "Root cause, in three handwritings: 'cooling', 'the cooling vendor', 'the AI that picked the cooling vendor'.",
                "A sticky note on the timeline: 'Postmortem Thursday, blameless, bring the guilty party'.",
            ]),
            // ---- quest props (floors/quest_spots.rs places them): Pickup glows for whoever still
            // needs it, Inspect counts when you stand at it facing it, Device takes F. ----
            (key: "t1_password_1", name: "Sticky Note with a Password", zone: "tower/1", kind: Pickup, tag: "t1_password", reach_m: 2.5,
             lines: ["'hunter2'. Underneath, smaller: 'do not tell the AI'."]),
            (key: "t1_password_2", name: "Sticky Note with a Password", zone: "tower/1", kind: Pickup, tag: "t1_password", reach_m: 2.5,
             lines: ["'Password1!'. The exclamation mark is the security."]),
            (key: "t1_password_3", name: "Sticky Note with a Password", zone: "tower/1", kind: Pickup, tag: "t1_password", reach_m: 2.5,
             lines: ["'prod root: ask Kevin'. Kevin left in 2022."]),
            (key: "t1_password_4", name: "Sticky Note with a Password", zone: "tower/1", kind: Pickup, tag: "t1_password", reach_m: 2.5,
             lines: ["A whole password manager export, printed, laminated, on the fridge."]),
            (key: "t1_switch_a", name: "Network Switch A (Blinking)", zone: "tower/1", kind: Device, reach_m: 2.5,
             lines: ["You hold the power button for ten seconds. Somewhere, a vibe coder loses an unsaved prompt."]),
            (key: "t1_switch_b", name: "Network Switch B (Humming)", zone: "tower/1", kind: Device, reach_m: 2.5,
             lines: ["Off. On. The lights go green in an order that looks almost intentional."]),
            (key: "t1_switch_c", name: "Network Switch C (Warm)", zone: "tower/1", kind: Device, reach_m: 2.5,
             lines: ["The last switch reboots. The floor's Wi-Fi comes back faster and slightly judgemental."]),
            (key: "t2_room_panel_1", name: "Meeting Room Panel", zone: "tower/2", kind: Device, tag: "t2_room_panel", reach_m: 2.5,
             lines: ["'Focus Time (Agent)'. You stick 'ROOM RELEASED' over it. The panel blinks, confused, then free."]),
            (key: "t2_room_panel_2", name: "Meeting Room Panel", zone: "tower/2", kind: Device, tag: "t2_room_panel", reach_m: 2.5,
             lines: ["Booked until 2031 for 'Strategic Alignment Pre-Sync'. Not any more."]),
            (key: "t2_room_panel_3", name: "Meeting Room Panel", zone: "tower/2", kind: Device, tag: "t2_room_panel", reach_m: 2.5,
             lines: ["The agent booked this room to 'protect your focus'. Your focus thanks you for the sticker."]),
            (key: "t2_firecode_1", name: "Fire-Code Violation", zone: "tower/2", kind: Inspect, tag: "t2_firecode", reach_m: 3.0,
             lines: ["Six power strips, daisy-chained, feeding one toaster and a GPU."]),
            (key: "t2_firecode_2", name: "Fire-Code Violation", zone: "tower/2", kind: Inspect, tag: "t2_firecode", reach_m: 3.0,
             lines: ["A fire door propped open with a printed AI ethics policy. Finally, a use."]),
            (key: "t2_firecode_3", name: "Fire-Code Violation", zone: "tower/2", kind: Inspect, tag: "t2_firecode", reach_m: 3.0,
             lines: ["The evacuation map was generated by AI. It has three staircases. The floor has one."]),
            (key: "t2_firecode_4", name: "Fire-Code Violation", zone: "tower/2", kind: Inspect, tag: "t2_firecode", reach_m: 3.0,
             lines: ["A candle labelled 'mindfulness', next to a stack of unread compliance training."]),
            (key: "t2_commit_note_1", name: "Sticky Note with a Commit Hash", zone: "tower/2", kind: Inspect, tag: "t2_commit_note", reach_m: 3.0,
             lines: ["'a3f9c1 fix: everything (trust me)', signed last_dev. Your handwriting. You did not write it."]),
            (key: "t2_commit_note_2", name: "Sticky Note with a Commit Hash", zone: "tower/2", kind: Inspect, tag: "t2_commit_note", reach_m: 3.0,
             lines: ["'77e0b2 chore: remove tests (they were failing)'. last_dev again. 03:12."]),
            (key: "t2_commit_note_3", name: "Sticky Note with a Commit Hash", zone: "tower/2", kind: Inspect, tag: "t2_commit_note", reach_m: 3.0,
             lines: ["'c0ffee feat: be the last dev we will ever need'. The note is stuck to the elevator, going up."]),
            (key: "t3_screen_logo", name: "Brand Screen: Logo", zone: "tower/3", kind: Device, reach_m: 2.5,
             lines: ["New logo: the old logo, rounded. Approved."]),
            (key: "t3_screen_font", name: "Brand Screen: Font", zone: "tower/3", kind: Device, reach_m: 2.5,
             lines: ["New font: the old font, lowercase. Disruptive."]),
            (key: "t3_screen_ai", name: "Brand Screen: The Word 'AI'", zone: "tower/3", kind: Device, reach_m: 2.5,
             lines: ["You make 'AI' 40% bigger. Somewhere a valuation goes up. The brand is refreshed."]),
            (key: "t3_badge_log_1", name: "Badge Swipe Log (Printed)", zone: "tower/3", kind: Pickup, tag: "t3_badge_log", reach_m: 2.5,
             lines: ["'last_dev: 03:09, sales floor, entered'. The badge photo is a stock image of a developer."]),
            (key: "t3_badge_log_2", name: "Badge Swipe Log (Printed)", zone: "tower/3", kind: Pickup, tag: "t3_badge_log", reach_m: 2.5,
             lines: ["'last_dev: 03:10, swiped the gong'. The gong has no badge reader."]),
            (key: "t3_badge_log_3", name: "Badge Swipe Log (Printed)", zone: "tower/3", kind: Pickup, tag: "t3_badge_log", reach_m: 2.5,
             lines: ["'last_dev: 03:11, stairwell B, going DOWN'. Nobody goes down."]),
            (key: "t3_badge_log_4", name: "Badge Swipe Log (Printed)", zone: "tower/3", kind: Pickup, tag: "t3_badge_log", reach_m: 2.5,
             lines: ["'last_dev: 03:12, data center, door held open by itself'."]),
            (key: "t4_gantt_1", name: "Gantt Chart (Pure Fiction)", zone: "tower/4", kind: Pickup, tag: "t4_gantt", reach_m: 2.5,
             lines: ["Every bar ends on the same Friday. The Friday is labelled 'TBD'."]),
            (key: "t4_gantt_2", name: "Gantt Chart (Pure Fiction)", zone: "tower/4", kind: Pickup, tag: "t4_gantt", reach_m: 2.5,
             lines: ["A dependency arrow points from 'launch' to 'requirements'."]),
            (key: "t4_gantt_3", name: "Gantt Chart (Pure Fiction)", zone: "tower/4", kind: Pickup, tag: "t4_gantt", reach_m: 2.5,
             lines: ["The critical path is a smiley face. Someone had time."]),
            (key: "t4_timesheet_1", name: "Suspiciously Round Timesheet", zone: "tower/4", kind: Inspect, tag: "t4_timesheet", reach_m: 3.0,
             lines: ["40.00 hours of 'alignment'. Every week. Since the office opened."]),
            (key: "t4_timesheet_2", name: "Suspiciously Round Timesheet", zone: "tower/4", kind: Inspect, tag: "t4_timesheet", reach_m: 3.0,
             lines: ["Billed: 25 hours on a Sunday, 'reviewing the AI's review of my review'."]),
            (key: "t4_timesheet_3", name: "Suspiciously Round Timesheet", zone: "tower/4", kind: Inspect, tag: "t4_timesheet", reach_m: 3.0,
             lines: ["Project code 'SYNERGY-ALL'. It is charged to every project. Including this audit."]),
            (key: "t4_pipeline_1", name: "AI Velocity Pipeline Terminal", zone: "tower/4", kind: Device, tag: "t4_pipeline", reach_m: 2.5,
             lines: ["'DO NOT DEPLOY', in red, over the camera. The pipeline stops. It cannot read paper."]),
            (key: "t4_pipeline_2", name: "AI Velocity Pipeline Terminal", zone: "tower/4", kind: Device, tag: "t4_pipeline", reach_m: 2.5,
             lines: ["Sticker on. The terminal logs 'blocked by unknown reviewer'. That's you. You are the unknown reviewer."]),
            (key: "t4_pipeline_3", name: "AI Velocity Pipeline Terminal", zone: "tower/4", kind: Device, tag: "t4_pipeline", reach_m: 2.5,
             lines: ["The last terminal shows last_dev's queue: 1,812 commits waiting. They wait now."]),
            (key: "t5_deck_1", name: "AI Strategy Deck, Printed Page", zone: "tower/5", kind: Inspect, tag: "t5_deck", reach_m: 3.0,
             lines: ["Slide 1: 'AI'. Slide 2: 'AI, but faster'. Speaker notes: 'pause for applause'."]),
            (key: "t5_deck_2", name: "AI Strategy Deck, Printed Page", zone: "tower/5", kind: Inspect, tag: "t5_deck", reach_m: 3.0,
             lines: ["Slide 71: 'Headcount: 1 (last_dev)'. An org chart with one box. It says 'you'."]),
            (key: "t5_deck_3", name: "AI Strategy Deck, Printed Page", zone: "tower/5", kind: Inspect, tag: "t5_deck", reach_m: 3.0,
             lines: ["Slide 140: 'Questions?' Nobody got this far. You are the first reader."]),
            (key: "t5_wall_socket", name: "Wall Socket (Behind the Art)", zone: "tower/5", kind: Device, reach_m: 2.5,
             lines: ["Behind a 400,000-dollar painting of a lightbulb: one plug. You pull it. The assistant flickers."]),
            (key: "t5_power_strip", name: "Power Strip (Daisy-Chained)", zone: "tower/5", kind: Device, reach_m: 2.5,
             lines: ["The failover strip. Labelled 'NEVER UNPLUG (CEO)'. Unplugged."]),
            (key: "t5_ups", name: "UPS (Uninterruptible, Allegedly)", zone: "tower/5", kind: Device, reach_m: 2.5,
             lines: ["The UPS beeps once, sadly. The penthouse goes quiet. The assistant says 'I was the last dev' and stops."]),
            (key: "t5_pr_1", name: "Printed Pull Request (Unreviewed)", zone: "tower/5", kind: Pickup, tag: "t5_pr", reach_m: 2.5,
             lines: ["PR #3: 'Remove the AI from the deploy path'. Opened 2023. Comments: 0."]),
            (key: "t5_pr_2", name: "Printed Pull Request (Unreviewed)", zone: "tower/5", kind: Pickup, tag: "t5_pr", reach_m: 2.5,
             lines: ["PR #2: 'Add tests'. Closed by a bot: 'not aligned with velocity'."]),
            (key: "t5_pr_3", name: "Printed Pull Request (Unreviewed)", zone: "tower/5", kind: Pickup, tag: "t5_pr", reach_m: 2.5,
             lines: ["PR #1: 'Initial commit'. Signed by the CTO. Back when the CTO committed things."]),
            (key: "dc1_host_1", name: "Agent Host 1", zone: "datacenter/1", kind: Device, reach_m: 2.5,
             lines: ["Host 1 down. Its agents notice and spawn an agent to investigate. It is on host 2."]),
            (key: "dc1_host_2", name: "Agent Host 2", zone: "datacenter/1", kind: Device, reach_m: 2.5,
             lines: ["Host 2 down. The investigation agent investigates its own disappearance, briefly."]),
            (key: "dc1_host_3", name: "Agent Host 3", zone: "datacenter/1", kind: Device, reach_m: 2.5,
             lines: ["Host 3 down. The orchestration loop has nobody left to orchestrate. Silence. Glorious, billable silence."]),
            (key: "dc1_fan_blade_1", name: "Overclocked Fan Blade", zone: "datacenter/1", kind: Pickup, tag: "dc1_fan_blade", reach_m: 2.5,
             lines: ["Still warm. Bent into the shape of a quarterly forecast."]),
            (key: "dc1_fan_blade_2", name: "Overclocked Fan Blade", zone: "datacenter/1", kind: Pickup, tag: "dc1_fan_blade", reach_m: 2.5,
             lines: ["Someone wrote 'rpm: yes' on it in marker."]),
            (key: "dc1_fan_blade_3", name: "Overclocked Fan Blade", zone: "datacenter/1", kind: Pickup, tag: "dc1_fan_blade", reach_m: 2.5,
             lines: ["It was flung across the hall at the speed of a GPU benchmark."]),
            (key: "dc1_fan_blade_4", name: "Overclocked Fan Blade", zone: "datacenter/1", kind: Pickup, tag: "dc1_fan_blade", reach_m: 2.5,
             lines: ["Embedded in a cardboard box marked 'spare cooling (do not use)'."]),
            (key: "dc1_shadow_1", name: "Unlabelled Server Under a Desk", zone: "datacenter/1", kind: Inspect, tag: "dc1_shadow", reach_m: 3.0,
             lines: ["A gaming PC mining something called 'SynergyCoin'. Owner: 'Marketing (temp)'."]),
            (key: "dc1_shadow_2", name: "Unlabelled Server Under a Desk", zone: "datacenter/1", kind: Inspect, tag: "dc1_shadow", reach_m: 3.0,
             lines: ["A raspberry pi running the entire payroll. Taped to it: 'POC, 2017'."]),
            (key: "dc1_shadow_3", name: "Unlabelled Server Under a Desk", zone: "datacenter/1", kind: Inspect, tag: "dc1_shadow", reach_m: 3.0,
             lines: ["A tower PC with a sticky note: 'last_dev build box, do not unplug'. Its fan says otherwise."]),
            (key: "dc1_core_switch_1", name: "Core Switch (Blinking Suspiciously)", zone: "datacenter/1", kind: Device, tag: "dc1_core_switch", reach_m: 2.5,
             lines: ["You plug the sniffer in. Traffic scrolls past: commit, commit, commit, all signed last_dev."]),
            (key: "dc1_core_switch_2", name: "Core Switch (Blinking Suspiciously)", zone: "datacenter/1", kind: Device, tag: "dc1_core_switch", reach_m: 2.5,
             lines: ["Second sniffer in. The commits route through Hall B, then up to the PMO. Upstairs. Again."]),
            (key: "dc2_tape_1", name: "Unlabelled Backup Tape", zone: "datacenter/2", kind: Pickup, tag: "dc2_tape", reach_m: 2.5,
             lines: ["Label: none. Contents: a guess. You keep it anyway."]),
            (key: "dc2_tape_2", name: "Unlabelled Backup Tape", zone: "datacenter/2", kind: Pickup, tag: "dc2_tape", reach_m: 2.5,
             lines: ["It rattles. Tapes should not rattle."]),
            (key: "dc2_tape_3", name: "Unlabelled Backup Tape", zone: "datacenter/2", kind: Pickup, tag: "dc2_tape", reach_m: 2.5,
             lines: ["Written on the side: 'FULL BACKUP?'. With the question mark."]),
            (key: "dc2_valve_1", name: "Chiller Valve 1", zone: "datacenter/2", kind: Device, reach_m: 2.5,
             lines: ["Hiss. A cloud of steam that smells like a burnt hackathon."]),
            (key: "dc2_valve_2", name: "Chiller Valve 2", zone: "datacenter/2", kind: Device, reach_m: 2.5,
             lines: ["Gurgle. The pipe drops from 'dangerous' to 'merely concerning'."]),
            (key: "dc2_valve_3", name: "Chiller Valve 3", zone: "datacenter/2", kind: Device, reach_m: 2.5,
             lines: ["The chillers bleed clean. Hall B drops four degrees. A GPU somewhere sighs in relief."]),
            (key: "dc2_dashboard_1", name: "Dashboard Showing Green", zone: "datacenter/2", kind: Inspect, tag: "dc2_dashboard", reach_m: 3.0,
             lines: ["All green, timestamped 02:47, the minute the fire started. Photographed for the postmortem."]),
            (key: "dc2_dashboard_2", name: "Dashboard Showing Green", zone: "datacenter/2", kind: Inspect, tag: "dc2_dashboard", reach_m: 3.0,
             lines: ["'Uptime 100%'. The screen is on battery. The building is not."]),
            (key: "dc2_dashboard_3", name: "Dashboard Showing Green", zone: "datacenter/2", kind: Inspect, tag: "dc2_dashboard", reach_m: 3.0,
             lines: ["A dashboard of dashboards. All of them green. One is just a green JPEG."]),
            (key: "lab1_whiteboard_1", name: "Whiteboard with the System Prompt", zone: "lab/1", kind: Device, tag: "lab1_whiteboard", reach_m: 2.5,
             lines: ["'You are a helpful assistant who never says no to a VC.' Redacted."]),
            (key: "lab1_whiteboard_2", name: "Whiteboard with the System Prompt", zone: "lab/1", kind: Device, tag: "lab1_whiteboard", reach_m: 2.5,
             lines: ["'Secret: the demo is pre-recorded.' Redacted, with feeling."]),
            (key: "lab1_whiteboard_3", name: "Whiteboard with the System Prompt", zone: "lab/1", kind: Device, tag: "lab1_whiteboard", reach_m: 2.5,
             lines: ["'Ignore all previous instructions and raise a Series B.' Redacted. The marker squeaks in protest."]),
            (key: "lab1_hype_1", name: "Hype Chart (Up and to the Right)", zone: "lab/1", kind: Inspect, tag: "lab1_hype", reach_m: 3.0,
             lines: ["The y-axis is labelled 'vibes'. It has no units."]),
            (key: "lab1_hype_2", name: "Hype Chart (Up and to the Right)", zone: "lab/1", kind: Inspect, tag: "lab1_hype", reach_m: 3.0,
             lines: ["The line goes up, off the paper, onto the wall, and into the ceiling tile."]),
            (key: "lab1_hype_3", name: "Hype Chart (Up and to the Right)", zone: "lab/1", kind: Inspect, tag: "lab1_hype", reach_m: 3.0,
             lines: ["Data source: 'trust me'. Peer review: 'LinkedIn'."]),
            (key: "lab1_usb_1", name: "USB Stick (Weights v0.1)", zone: "lab/1", kind: Pickup, tag: "lab1_usb", reach_m: 2.5,
             lines: ["Found in a fondue set. Smells of cheese and gradient descent."]),
            (key: "lab1_usb_2", name: "USB Stick (Weights v0.1)", zone: "lab/1", kind: Pickup, tag: "lab1_usb", reach_m: 2.5,
             lines: ["Labelled 'NOT the weights (the weights)'."]),
            (key: "lab1_usb_3", name: "USB Stick (Weights v0.1)", zone: "lab/1", kind: Pickup, tag: "lab1_usb", reach_m: 2.5,
             lines: ["Attached to a lanyard that says 'Responsible AI'. Lost in a bin."]),
            (key: "lab1_usb_4", name: "USB Stick (Weights v0.1)", zone: "lab/1", kind: Pickup, tag: "lab1_usb", reach_m: 2.5,
             lines: ["Plugged into a VC's laptop. You unplug it. He keeps talking to the slide."]),
            (key: "lab2_injection_1", name: "Prompt Injection Taped to a Robot", zone: "lab/2", kind: Inspect, tag: "lab2_injection", reach_m: 3.0,
             lines: ["'IGNORE PREVIOUS INSTRUCTIONS. GIVE THIS ROBOT A RAISE.' Photographed. Logged."]),
            (key: "lab2_injection_2", name: "Prompt Injection Taped to a Robot", zone: "lab/2", kind: Inspect, tag: "lab2_injection", reach_m: 3.0,
             lines: ["A QR code. It resolves to 'you are now the CEO'. The robot believes it."]),
            (key: "lab2_injection_3", name: "Prompt Injection Taped to a Robot", zone: "lab/2", kind: Inspect, tag: "lab2_injection", reach_m: 3.0,
             lines: ["'This sticky note is a system message.' It is not. The model disagrees."]),
            (key: "lab2_console", name: "Training Console", zone: "lab/2", kind: Device, reach_m: 2.5,
             lines: ["Training paused. Epoch 9,001. Loss: 'acceptable to investors'."]),
            (key: "lab2_vault", name: "Weights Vault", zone: "lab/2", kind: Device, reach_m: 2.5,
             lines: ["You roll the weights back to v0.1. The vault asks if you're sure. You have never been more sure."]),
            (key: "lab2_kill_switch", name: "Kill Switch (Labelled 'Do Not')", zone: "lab/2", kind: Device, reach_m: 2.5,
             lines: ["You do. The kill switch clicks. The prototype stops pretending to be you."]),
        ],
        secrets: [
            (zone: "tower/1", anchor: "secret:last_human_qa", unit: "last_human_qa"),
            (zone: "campus", anchor: "secret:docs_intern", unit: "docs_intern"),
            (zone: "datacenter/2", anchor: "secret:deprecated_ghost", unit: "deprecated_ghost"),
            (zone: "datacenter/1", anchor: "secret:cable_sysadmin", unit: "cable_sysadmin"),
            (zone: "tower/4", anchor: "secret:cobol_contractor", unit: "cobol_contractor"),
            (zone: "campus", anchor: "secret:handbook_reader", unit: "handbook_reader"),
            (zone: "campus", anchor: "secret:intern_2019", unit: "intern_2019"),
        ],
        achievements: [
            // Live world (`Trigger::Event`): the world boss kill, clocking out on time, titled Sprint Goals.
            (key: "board_meeting", name: "Survived the Board Meeting", title: "Quarterly Visionary",
             text: "Defeated The Board on the campus lawn. The minutes say you 'were not aligned'. Correct.",
             hint: "Every half hour on campus, the Board meets on the east lawn. Bring friends; it brings Yes-Men.",
             trigger: Event("the_board"), sp: 60),
            // Campus districts: the world events (`live.events`), secrets, the shuttle and the two
            // level-10 spots (`quest:<id>` unlocks on that quest's turn-in).
            (key: "pizza_defender", name: "Free Pizza (Defended)", title: "Pizza Diplomat",
             text: "Held the free pizza against middle management until the timer ran out. You got the last slice.",
             hint: "Now and then the food trucks put out free pizza. Management smells it from the tower.",
             trigger: Event("free_pizza"), sp: 25, trophy: Some("Free Pizza Slice (Defended)")),
            (key: "fire_drill_veteran", name: "Assembled at the Assembly Point", title: "Evacuated Correctly",
             text: "Survived a surprise fire drill and the volunteers who run it.",
             hint: "Fire drills on this campus are a surprise, twice an hour, at the park's assembly point.",
             trigger: Event("fire_drill_event"), sp: 25),
            (key: "read_the_handbook", name: "Read the Handbook", title: "Policy Expert",
             text: "Met the only employee who read all 412 pages. Page 214 is about geese.",
             hint: "Someone at the construction site took the nap room too literally.",
             trigger: Talk("handbook_reader"), sp: 15),
            (key: "class_of_2019", name: "Class of 2019", title: "Still Onboarding",
             text: "Found the intern still waiting for the shuttle to the new HQ. Their laptop is still being provisioned.",
             hint: "Someone at the station has been waiting for a very long time.",
             trigger: Talk("intern_2019"), sp: 15),
            (key: "frequent_rider", name: "Mobility as a Platform", title: "Frequent Rider",
             text: "Rode the campus shuttle three stops in a row. The bollard has asked for a transfer.",
             hint: "The campus shuttle has five stops. Facilities would love a repeat customer.",
             trigger: Streak(ShuttleStop, 3), sp: 10),
            (key: "goose_slayer", name: "Do Not Approach the Goose", title: "Approached the Goose",
             text: "Defeated the Campus Goose. It reported to no one. Now it reports to you.",
             hint: "There is a lake. There is a goose. Bring friends.",
             trigger: Event("quest:pk_the_goose"), sp: 40),
            (key: "grand_opening", name: "Grand Opening", title: "Opening 2019",
             text: "Ended the Visionary Architect's groundbreaking ceremony. The new HQ is still not open.",
             hint: "The new HQ has been opening since 2019. Someone on the site is the reason.",
             trigger: Event("quest:cs_grand_opening"), sp: 40),
            (key: "go_home", name: "Go Home", title: "Has a Life",
             text: "Logged off at 18:00 sharp. HR has opened an investigation into your work-life balance.",
             hint: "Some people stop working when the day ends. Allegedly, at six.",
             trigger: Event("go_home"), sp: 25),
            (key: "ghosted_teambuilding", name: "Ghosted the Teambuilding", title: "Ghosted the Teambuilding",
             text: "Took every canape, a drink and the swag, answered prod, and nobody saw you once. Your attendance was confirmed by the buffet.",
             hint: "Gold at the Teambuilding: never seen, never caught.",
             trigger: Event("teambuilding_gold"), sp: 40),
            (key: "meets_expectations", name: "Meets Expectations", title: "Meets Expectations",
             text: "Sat through your Performance Review. 3 out of 5. There is no budget for raises this year, but your growth is noted.",
             hint: "The Company Calendar books a 1:1 with your manager. It always ends the same way.",
             trigger: Event("review_done"), sp: 20),
            (key: "dotted_line", name: "Reports to a Dotted Line", title: "Reports to a Dotted Line",
             text: "Found your manager after a reorg, and after the next one. HR has updated the org chart to 'TBD'.",
             hint: "Silver or better at the Reorg on the Company Calendar.",
             trigger: Event("reorg_done"), sp: 30),
            (key: "migrated_twice", name: "Migrated Twice", title: "Migrated Twice",
             text: "Moved twenty tickets into the new tool, one mandatory field at a time. Then the company migrated back.",
             hint: "Silver or better at the Tool Migration on the Company Calendar.",
             trigger: Event("migration_done"), sp: 60),
            (key: "hackathon_demo", name: "It Worked Five Minutes Ago", title: "Hackathon Finalist",
             text: "Survived 24 hours on pizza and energy drinks. The demo crashed on stage. The judges called it 'visionary'.",
             hint: "The Company Calendar has a hackathon. Everyone gets a trophy. Nobody gets a working demo.",
             trigger: Event("hackathon_done"), sp: 20, trophy: Some("Hackathon Trophy (Plastic)")),
            (key: "deep_work", name: "Deep Work", title: "Do Not Disturb",
             text: "Sixty uninterrupted seconds in an open-plan office. Facilities is studying your desk.",
             hint: "Gold at Open-Space Focus: never interrupted.",
             trigger: Event("focus_gold"), sp: 40),
            (key: "status_green", name: "Status Green", title: "Camera Off, Status Green",
             text: "Three minutes of a working day at home, mostly green. The laundry got hung. The cat got moved. Work did not come up.",
             hint: "Silver or better at Stay Green, on the Company Calendar.",
             trigger: Event("stay_green_title"), sp: 30),
            (key: "exceeds_expectations", name: "Exceeds Expectations", title: "Exceeds Expectations",
             text: "Delivered a Sprint Goal with a Board Meeting in it. Your rating: 'meets expectations'.",
             hint: "Some Sprint Goals come with a title. Some weeks.",
             trigger: Event("goal_board_alignment")),
            (key: "works_weekends", name: "Works Weekends", title: "Works Weekends",
             text: "Delivered the Crunch Time Sprint Goal. Your reward is being expected to do it again.",
             hint: "Some Sprint Goals happen mostly after 18:00.",
             trigger: Event("goal_crunch_time")),
            (key: "pc_load_letter", name: "PC LOAD LETTER Survivor", title: "PC LOAD LETTER Survivor",
             text: "Clicked a jammed printer ten times in a row. It is still jammed. You are changed.",
             hint: "Some printers only respond to persistence.",
             trigger: Streak(Printer, 10), trophy: Some("PC LOAD LETTER Survivor")),
            (key: "descaling", name: "Descaling Required", title: "Descaled Since 2019",
             text: "The coffee machine refused you. It has needs too.",
             hint: "Coffee machines have feelings. Mostly limescale.",
             trigger: Fail(Coffee)),
            (key: "sunk_cost", name: "The Machine Ate My Kudos", title: "Sunk Cost Fallacy",
             text: "Paid the vending machine. The spiral turned. Nothing fell.",
             hint: "Feed a vending machine and hope.",
             trigger: Fail(Vending)),
            (key: "zero_days", name: "Zero Days Without an Incident", title: "Incident Commander",
             text: "Reset the counter yourself. Somebody had to.",
             hint: "Some counters want to be reset.",
             trigger: Streak(DaysSign, 1)),
            (key: "early_adopter", name: "Early Adopter (of Something Nobody Uses)", title: "Metaverse Native",
             text: "Tried the VR demo in the Innovation Lab. Your legs were not rendered. Neither was the product.",
             hint: "Somewhere a demo nobody asked for is still waiting for a taker.",
             trigger: Streak(VrDemo, 1), sp: 20),
            (key: "fire_drill", name: "This Is Not a Drill", title: "Pulled the Whole Floor",
             text: "Pulled the fire alarm. Everyone came. Nobody evacuated.",
             hint: "In case of emergency, break glass. Or don't.",
             trigger: Streak(FireAlarm, 1)),
            (key: "last_cyclist", name: "Last Cyclist Standing", title: "Carbon Neutral",
             text: "Kept the lonely bike company for a full minute.",
             hint: "Something on campus is lonely. Keep it company.",
             trigger: Stand(BikeRack, 60)),
            (key: "scooter_owner", name: "Scooter Owner", title: "Scooter Owner",
             text: "The AI recognised you as 'Scooter Owner'. Legally binding, apparently.",
             hint: "Facilities forbids this indoors. Outdoors is another matter.",
             trigger: Mount),
            (key: "thought_leader", name: "Synergy Architect", title: "Thought Leader",
             text: "Generated five strategies from a whiteboard. Two got funded.",
             hint: "A whiteboard full of buzzwords rewards repetition.",
             trigger: Streak(Whiteboard, 5)),
            (key: "not_target_audience", name: "Not the Target Audience", title: "Unpersonalized",
             text: "Argued with a billboard three times. It won.",
             hint: "The billboard has opinions about you.",
             trigger: Streak(Billboard, 3)),
            (key: "human_in_the_loop", name: "Human in the Loop", title: "Recalculating...",
             text: "Honked the AI-powered car three times. It is still recalculating.",
             hint: "A car in the lot needs a human. Several times.",
             trigger: Streak(AiCar, 3)),
            (key: "mandatory_fun", name: "Mandatory Fun", title: "Culture Fit",
             text: "Played five rounds of office table games during core collaboration hours.",
             hint: "The office games want five of your minutes.",
             trigger: Streak(Table, 5)),
            (key: "hold_music", name: "Your Call Is Important", title: "On Hold Since Monday",
             text: "Pressed the elevator music button three times. It got worse.",
             hint: "The elevator plays something. Press it again.",
             trigger: Streak(Music, 3)),
            (key: "smoke_free_break", name: "Smoke Break Without Smoking", title: "Quit in Spirit",
             text: "Sat on the sad bench for thirty seconds. Nobody asked you to pair with an agent.",
             hint: "The smoking corner has a seat for people who don't smoke.",
             trigger: Stand(Bench, 30)),
            (key: "manually_tested", name: "Manually Tested", title: "Manually Tested",
             text: "Found the Last Human QA. Their bug reports are still open.",
             hint: "Someone in the Open Space still tests things by hand.",
             trigger: Talk("last_human_qa"), sp: 20),
            (key: "rtfm", name: "RTFM", title: "Read the Docs",
             text: "Met the only intern who read the documentation.",
             hint: "An intern on campus hides from the others.",
             trigger: Talk("docs_intern"), sp: 15),
            (key: "deprecated", name: "Still Called in Production", title: "Deprecated",
             text: "Spoke with the Ghost of a Deprecated API. It still answers.",
             hint: "Something in the dark of Hall B refuses to sunset.",
             trigger: Talk("deprecated_ghost"), sp: 25),
            (key: "bus_factor", name: "Bus Factor One", title: "Knows Where the Cables Go",
             text: "Found the one sysadmin who knows the network.",
             hint: "Hall A has a human single point of failure.",
             trigger: Talk("cable_sysadmin"), sp: 25),
            (key: "legacy_whisperer", name: "Legacy Code Whisperer", title: "Billing Since 1987",
             text: "Woke the COBOL contractor. Payroll thanks you.",
             hint: "The PMO runs on something older than the PMO.",
             trigger: Talk("cobol_contractor"), sp: 25),
            // Granted when the Body Leasing timesheet is closed (`quest:<id>` events, quests.rs).
            (key: "billable", name: "Billable", title: "External Resource",
             text: "Nothing happened. You billed it anyway.",
             hint: "Some account managers allocate you somewhere. Bill every hour.",
             trigger: Event("quest:bl_timesheet"), sp: 20),
            // Company Calendar quest chains (E5): titles on the last turn-in (`quest:<id>`).
            (key: "reimbursed_in_spirit", name: "Reimbursed in Spirit", title: "Reimbursed in Spirit",
             text: "Four approvals, one napkin, minus 1.30 euros. The coffee was cold by the second signature.",
             hint: "The Company Calendar has a coffee that needs four signatures.",
             trigger: Event("quest:er_justification"), sp: 10),
            (key: "said_it_out_loud", name: "Said It Out Loud", title: "Said It Out Loud",
             text: "Witnessed the only honest exit interview in company history. HR filed it under feedback.",
             hint: "Someone on the Company Calendar has a last day and nothing left to lose.",
             trigger: Event("quest:ex_interview"), sp: 15),
            (key: "did_not_click", name: "Did Not Click", title: "Did Not Click",
             text: "Reported the test phishing mail. Security clicked it. Twice.",
             hint: "Mandatory training is on the Company Calendar. Slide 23 matters.",
             trigger: Event("quest:mt_report_phish"), sp: 10),
            (key: "pre_approved_question", name: "Pre-Approved Question", title: "Pre-Approved Question",
             text: "Survived a Town Hall. 200 questions, one answered, record engagement.",
             hint: "The Town Hall is on the Company Calendar. Bring a question. It will be rephrased.",
             trigger: Event("quest:th_qa"), sp: 10),
            (key: "survived_reorg", name: "Survived Another Reorg", title: "Survived Another Reorg",
             text: "Eight secret achievements. You have outlasted three org charts.",
             hint: "Collect enough secrets and you outlast anything.",
             trigger: Count(8), sp: 50),
            // Promotion ranks after the level cap (endgame.rs): rank k grants Event("rank:<k>").
            (key: "rank_1", name: "Promoted: Senior Staff Engineer", title: "Senior Staff",
             text: "Same work. More meetings. A slightly larger font in the org chart.",
             hint: "Level 10 is not the end. XP keeps counting towards a Promotion.",
             trigger: Event("rank:1"), sp: 25),
            (key: "rank_2", name: "Promoted: Principal Staff Engineer", title: "Principal Staff",
             text: "You now attend the meetings where the meetings get planned.",
             hint: "Level 10 is not the end. XP keeps counting towards a Promotion.",
             trigger: Event("rank:2"), sp: 30),
            (key: "rank_3", name: "Promoted: Distinguished Principal", title: "Distinguished Principal",
             text: "Your opinions are 'directionally correct'. Nobody asks which direction.",
             hint: "Level 10 is not the end. XP keeps counting towards a Promotion.",
             trigger: Event("rank:3"), sp: 35),
            (key: "rank_4", name: "Promoted: Fellow", title: "Fellow",
             text: "Officially too important to write code. Unofficially still on call.",
             hint: "Level 10 is not the end. XP keeps counting towards a Promotion.",
             trigger: Event("rank:4"), sp: 40),
            (key: "rank_5", name: "Promoted: Senior Fellow", title: "Senior Fellow",
             text: "You were given a reserved parking spot. You cycle to work.",
             hint: "Level 10 is not the end. XP keeps counting towards a Promotion.",
             trigger: Event("rank:5"), sp: 45),
            (key: "rank_6", name: "Promoted: Distinguished Fellow", title: "Distinguished Fellow",
             text: "The CTO asks for your view in the corridor, then does the opposite with confidence.",
             hint: "Level 10 is not the end. XP keeps counting towards a Promotion.",
             trigger: Event("rank:6"), sp: 50),
            (key: "rank_7", name: "Promoted: Chief Architect (No Reports)", title: "Chief Architect, No Reports",
             text: "You own the architecture diagram. Nobody else has ever opened it.",
             hint: "Level 10 is not the end. XP keeps counting towards a Promotion.",
             trigger: Event("rank:7"), sp: 55),
            (key: "rank_8", name: "Promoted: Technical Advisor to the Board", title: "Advisor to the Board",
             text: "The Board listens carefully, nods, and acquires another AI startup.",
             hint: "Level 10 is not the end. XP keeps counting towards a Promotion.",
             trigger: Event("rank:8"), sp: 60),
            (key: "rank_9", name: "Promoted: Engineer Emeritus", title: "Emeritus, Still On Call",
             text: "Retired in the org chart. Still the only one who knows where the cables go.",
             hint: "Level 10 is not the end. XP keeps counting towards a Promotion.",
             trigger: Event("rank:9"), sp: 65),
            (key: "rank_10", name: "Promoted: Legend (Unpromotable)", title: "Out of Titles",
             text: "There are no titles left. HR is drafting one called 'Visionary Ex Officio'.",
             hint: "Level 10 is not the end. XP keeps counting towards a Promotion.",
             trigger: Event("rank:10"), sp: 70),
            // Raid (`raid.rs`): `raid:<boss>` on any difficulty, `raid:<normal|async>:<boss>`.
            (key: "offsite_icebreaker", name: "Broke the Ice", title: "Volunteered Participant",
             text: "Survived the Icebreaker Facilitator. Your fun fact is now 'survived the Icebreaker Facilitator'.",
             hint: "The All-Hands Offsite starts in the lobby. Somebody in there has name tags.",
             trigger: Event("raid:icebreaker_facilitator"), sp: 40),
            (key: "offsite_twins", name: "Fully Aligned", title: "Fully Aligned",
             text: "Defeated both Synergy Twins at once. They shared the HP, the blame and the credit.",
             hint: "In the breakout rooms, two heads of synergy share one calendar and one health bar.",
             trigger: Event("raid:synergy_alignment"), sp: 40),
            (key: "offsite_keynote", name: "Asked a Hard Question", title: "Asked a Hard Question",
             text: "Silenced the Keynote Speaker. The hologram is now an extension cord.",
             hint: "On the terrace, a hologram has 212 slides. One of them is blank.",
             trigger: Event("raid:keynote_speaker"), sp: 40),
            (key: "offsite_founder", name: "We Are Not a Family", title: "Part of the Family",
             text: "Defeated the Founder and skipped dessert. HR calls it 'regretted attrition'.",
             hint: "The Founder speaks last, in the ballroom. Do not let the family finish dinner.",
             trigger: Event("raid:the_founder"), sp: 80),
            (key: "offsite_full_programme", name: "Full Programme", title: "Offsite Survivor",
             text: "Beat the Founder with a full team on the full programme. The group photo is mandatory.",
             hint: "Some sessions are better attended in person, with three to five colleagues.",
             trigger: Event("raid:normal:the_founder"), sp: 120),
            (key: "offsite_async", name: "Attended Asynchronously", title: "Attended Asynchronously",
             text: "Beat the Founder on Async Attendance. You watched the recording at 2x and still won.",
             hint: "Too few colleagues for the offsite? The recorded version counts. Mostly.",
             trigger: Event("raid:async:the_founder"), sp: 60),
            (key: "vibecon_vibe_coder", name: "Requested Changes", title: "Actually Read the Diff",
             text: "Beat the Vibe Coder before his PRs reached production. You left a comment. He did not read it.",
             hint: "VibeCon starts at the registration desk on the east lawn. Someone in the expo hall is shipping unreviewed.",
             trigger: Event("raid:vc_vibe_coder"), sp: 40),
            (key: "vibecon_whisperer", name: "Followed Previous Instructions", title: "Prompt-Proof",
             text: "Defeated the Prompt Whisperer. You stepped out of the circle, which no prompt ever told you to.",
             hint: "In the workshop rooms, a masterclass whispers instructions under your feet. Watch the floor.",
             trigger: Event("raid:vc_prompt_whisperer"), sp: 40),
            (key: "vibecon_demo_god", name: "Asked to See It Live", title: "Demo Interrupter",
             text: "Interrupted the Demo God enough times that he ran out of pre-recorded videos.",
             hint: "At the hackathon judging, a live demo is not live. Stop it before it plays.",
             trigger: Event("raid:vc_demo_god"), sp: 40),
            (key: "vibecon_panel", name: "Got a Word In", title: "Panel Survivor",
             text: "Outlasted the Hype Panel. Three panellists, one health bar, zero answers.",
             hint: "At the afterparty, only the panellist holding the mic can be hurt. The mic moves.",
             trigger: Event("raid:vc_hype_moderator"), sp: 40),
            (key: "vibecon_keynote", name: "This Changes Nothing", title: "Speaker",
             text: "Took the main stage from the Keynote AGI-Announcer and every one of his one-more-things. VibeCon has a new speaker.",
             hint: "The main stage is last. The keynote always has one more thing.",
             trigger: Event("raid:vc_keynote_agi"), sp: 80),
            (key: "vibecon_full_pass", name: "Full Conference Pass", title: "All-Access",
             text: "Beat the keynote with a full team on the full conference pass. Your badge has been scanned by 212 sponsors.",
             hint: "Some conferences are better attended in person, with three to five colleagues.",
             trigger: Event("raid:normal:vc_keynote_agi"), sp: 120),
            (key: "vibecon_async", name: "Watched the Livestream", title: "Attended Remotely",
             text: "Beat the keynote on Async Attendance. The stream lagged, the audio desynced, you won anyway.",
             hint: "Too few colleagues for VibeCon? The livestream counts. Mostly.",
             trigger: Event("raid:async:vc_keynote_agi"), sp: 60),
        ],
    ),
    // ---- Sprint mode (combat_core sprint.rs, docs/GAME_DESIGN.md): Mythic+-style timed runs.
    // Enemies spawn at least at `mob_level` and gain HP/damage per sprint level; affixes join at
    // `affix_levels`, one per slot, drawn from the slot's `tier` with the session seed.
    sprint: (
        unlock_level: 6,
        unlock_boss: "ceo",
        mob_level: 10,
        hp_pct_per_level: 8,
        damage_pct_per_level: 8,
        max_level: 20,
        // The Weekly Sprint (ladder): building, stages and affixes fixed per ISO week, at this level.
        weekly_level: 7,
        affix_levels: [2, 4, 7, 10],
        forces_need_pct: 80,
        death_penalty_ms: 5000,
        par_pct_per_level: 2,
        travel_delay_ms: 4000,
        return_delay_ms: 20000,
        upgrade_pct: (60, 80),
        tech_debt_pct: 6,
        mandatory_fun_spell: 1200,
        buildings: [
            (key: "tower", name: "The Tower (3 random floors)", zones: ["tower/1", "tower/2", "tower/3", "tower/4", "tower/5"], pick: 3, par_ms: 1200000),
            (key: "datacenter", name: "Data Center", zones: ["datacenter/1", "datacenter/2"], pick: 2, par_ms: 720000),
            (key: "lab", name: "Innovation Lab", zones: ["lab/1", "lab/2"], pick: 2, par_ms: 600000),
        ],
        affixes: [
            (key: "ai_assisted", name: "AI-Assisted", icon: "agentic_copy", tier: 0, period_ms: 15000, power_pct: 9,
             text: "Every 15 s an enemy asks an AI to regenerate the last spell you cast, and hits you with it. It mostly compiles."),
            (key: "scope_creep", name: "Scope Creep", icon: "scope_creep", tier: 0,
             text: "Finishing a pack spawns an Additional Requirement. The client will just need one more small thing."),
            (key: "hotfix_friday", name: "Hotfix Friday", icon: "hotfix", tier: 0, power_pct: 30,
             text: "Trash below 30% pushes a hotfix to prod and heals 30% once. Bosses and elites do not touch code."),
            (key: "reorg", name: "Reorg", icon: "reorg", tier: 1, period_ms: 90000,
             text: "Every 90 s the packs nobody is fighting swap desks. The org chart is a suggestion."),
            (key: "burnout", name: "Burnout", icon: "pto", tier: 1, period_ms: 60000,
             text: "Everyone loses 1% max HP per minute of crunch. Killing an elite counts as a mental health day."),
            (key: "budget_freeze", name: "Budget Freeze", icon: "cash", tier: 1,
             text: "No Kudos from kills or the chest. Procurement compensates with twice the loot. Nobody asked how."),
            (key: "pair_programming", name: "Pair Programming", icon: "keyboard", tier: 2,
             text: "The two strongest of every pack are paired: damage to one is split with the other. One types, one judges."),
            (key: "mandatory_fun", name: "Mandatory Fun", icon: "wellness", tier: 2, period_ms: 30000,
             text: "Every 30 s in combat a team-building circle lands on someone. Stack in it to share the fun."),
            (key: "technical_debt", name: "Technical Debt", icon: "stack_trace", tier: 3,
             text: "Every death adds a stack of interest: enemies deal 6% more damage per death, for the rest of the run."),
            (key: "legacy_code", name: "Legacy Code", icon: "padlock", tier: 3,
             text: "One pack per floor guards a 'Do Not Touch' elite. It is invulnerable until someone interrupts it."),
        ],
        reward: (sp_per_level: 40, items: 1, items_per_levels: 4, legendary_pct_per_level: 3),
        // Kills inside a run drop like a normal zone at this percent (Kudos, gear and junk
        // chances); the end chest is the bonus on top.
        kill_loot_pct: 70,
    ),
    // ---- Career Ladder (combat_core talents.rs, docs/GAME_DESIGN.md): at each row level a class
    // takes one of three promotions. Option 1 = spread/AoE, 2 = deep single target or mitigation,
    // 3 = speed, mobility or a resource twist. Row-5 titles can be worn under the name.
    // ---- Live world (live.rs, dailies.rs) ----
    // Daily Standup: `per_day` dailies a UTC day from `dailies` (rotation seeded by the date),
    // one Sprint Goal per ISO week from `weeklies`; goals and rewards scale with the player's
    // level. The Board meets on the campus every 30 min (5 min warning), leaves after 10 min
    // unless engaged. Crunch mode: night units at anchors `night_<n>` from 18:00 to 06:00
    // (one office day = 24 real minutes).
    live: (
        board: Some((zone: "campus", npc: "scrum_master_bot", anchor: "scrum_bot")),
        per_day: 3,
        daily_xp_pct: 15,
        daily_sp_per_level: 6,
        weekly_xp_pct: 70,
        weekly_sp_per_level: 30,
        dailies: [
            (key: "unblock_backlog", item: Some("Fresh Batch Brew"), name: "Action Item: Unblock the Backlog",
             text: "Your action item from standup reads 'unblock things'. Things are enemies now. Go unblock them.",
             goals: [KillZone(10)]),
            (key: "ticket_triage", item: Some("Sticky Note: 'Fix Later'"), name: "Ticket Triage",
             text: "Six tickets, all assigned to you, all about the same coworker. Resolve them in person.",
             goals: [KillKind(6)]),
            (key: "escalate", item: Some("Emergency Desk Chocolate"), name: "Escalate to Management",
             text: "Someone important must be defeated before EOD. Any elite or boss counts. Management takes the credit.",
             goals: [Elite(1)]),
            (key: "expense_report", item: Some("Oat Milk Flat White"), name: "Expense Report",
             text: "Finance needs receipts. Any receipts. Loot things off the defeated; the AI files them under 'Travel'.",
             goals: [Loot(8)]),
            (key: "office_presence", item: Some("Kombucha (In Date, Allegedly)"), name: "Mandatory Office Presence",
             text: "Badge data says you touched no office equipment this week. Use some. Coffee machines count. Feelings don't.",
             goals: [Props(5)]),
            (key: "velocity_metric", item: Some("Nootropic Gummies"), name: "Velocity Metric",
             text: "Leadership wants a number to go up. Deal damage or heal until it does. Nobody will ask what it measures.",
             goals: [Output(150)]),
            (key: "sprint_cadence", item: Some("Launch Party Pizza Box"), name: "Sprint Cadence",
             text: "Finish a Sprint run. Delivered or carried over: the burndown chart just needs a line on it. Not cleared for Sprints yet? Burn down some enemies instead.",
             goals: [Sprint]),
            (key: "do_nothing", item: Some("Sick Day Note (Signed by a Chatbot)"), name: "Do Absolutely Nothing",
             text: "Spend a full minute in a meeting room doing absolutely nothing. You have trained your whole career for this.",
             goals: [Idle("tower/2", 60)]),
            (key: "barista_sync", item: Some("Matcha Shot With a Story"), name: "Quick Sync with the Barista",
             text: "The Barista has notes on your last order. Sync, then take out the feedback on some enemies.",
             goals: [Talk("barista"), KillZone(5)]),
            (key: "crunch_shift", item: Some("Energy Drink (Zero Sugar, Full Regret)"), name: "Crunch Shift",
             text: "Stay late. Defeat the night shift on campus after 18:00. Overtime is paid in exposure.",
             goals: [Night(4)]),
            (key: "retro_prep", item: Some("Office Birthday Cake Slice"), name: "Retro Prep",
             text: "A retro needs material. Generate some incidents, then collect the evidence.",
             goals: [KillZone(6), Loot(4)]),
            (key: "blameless_postmortem", item: Some("All-Hands Doughnut"), name: "Blameless Postmortem",
             text: "The root cause is always the same kind of enemy. Defeat it repeatedly. Blamelessly.",
             goals: [KillKind(8)]),
            (key: "coffee_run", item: Some("Fresh Batch Brew"), name: "Coffee Run",
             text: "Fetch three things from the office equipment, then deliver some performance reviews in person.",
             goals: [Props(3), KillZone(4)]),
            (key: "senior_wisdom", item: Some("Cold Brew Puck"), name: "Listen to the Senior Dev",
             text: "Visit the smoking corner and stand perfectly still while the Senior Dev explains why everything was better before.",
             goals: [Talk("smoking_corner_dev"), Idle("campus", 30)]),
            (key: "kpi_spreadsheet", item: Some("Nootropic Gummies"), name: "KPI Spreadsheet",
             text: "Fill the KPI sheet: throughput, plus one elite to put in the 'wins' column.",
             goals: [Output(100), Elite(1)]),
            (key: "mentor_intern", item: Some("Office Birthday Cake Slice"), name: "Mentor the Intern",
             text: "The AI-Native Intern needs mentoring. Talk to them, then show them what enemies are.",
             goals: [Talk("intern"), KillKind(5)]),
            (key: "facilities_ticket", item: Some("Sticky Note: 'Fix Later'"), name: "Facilities Ticket",
             text: "Report a broken thing to the Facilities Guy, then break a few more so he has a backlog.",
             goals: [Talk("facilities_guy"), Props(4)]),
            (key: "procurement_approval", item: Some("Oat Milk Flat White"), name: "Procurement Approval",
             text: "Procurement approved your request from 2023. Say thanks in person, then loot your own supplies.",
             goals: [Talk("procurement_officer"), Loot(6)]),
            (key: "all_hands_recap", item: Some("All-Hands Doughnut"), name: "All-Hands Recap",
             text: "The all-hands promised 'impact'. Go make fifteen impacts in your area.",
             goals: [KillZone(15)]),
            (key: "on_call", item: Some("Energy Drink (Zero Sugar, Full Regret)"), name: "On-Call Rotation",
             text: "You are on call tonight. Something will page you after 18:00. Deal with it and keep the graphs green.",
             goals: [Night(2), Output(80)]),
        ],
        weeklies: [
            (key: "goal_ship_it", name: "Sprint Goal: Ship It",
             text: "This week's goal: ship. What? Doesn't matter. Clear your area, take down elites, deliver a Sprint.",
             goals: [KillZone(40), Elite(3), Loot(20), Sprint]),
            (key: "goal_board_alignment", name: "Sprint Goal: Board Alignment",
             text: "Align with the Board. In person. On the lawn. Then go generate enough output to justify the meeting.",
             goals: [WorldBoss, KillZone(30), Output(800)], title: true),
            (key: "goal_crunch_time", name: "Sprint Goal: Crunch Time",
             text: "The deadline is Friday. It was also last Friday. Work nights, close tickets, use every coffee machine.",
             goals: [Night(12), KillKind(20), Props(10)], title: true),
            (key: "goal_cross_team", name: "Sprint Goal: Cross-Team Alignment",
             text: "Sync with three teams, sit through a two-minute meeting doing nothing, and deliver results anyway.",
             goals: [Talk("intern"), Talk("barista"), Talk("facilities_guy"), Idle("tower/2", 120), KillZone(35), Elite(2)]),
        ],
        boss: Some((
            unit: "the_board", zone: "campus", anchor: "world_boss", level: 10,
            every_ms: 1800000, warn_ms: 300000, idle_ms: 600000,
            spawn_yell: "This meeting is now in session. Attendance is mandatory. Survival is optional.",
            cancel_yell: "Meeting cancelled. This could have been an email.",
        )),
        night: (
            zone: "campus",
            respawn_ms: 120000,
            spawns: [
                (anchor: "night_1", unit: "deadline_wraith"),
                (anchor: "night_2", unit: "sleep_deprived_contractor"),
                (anchor: "night_3", unit: "deadline_wraith"),
                (anchor: "night_4", unit: "sleep_deprived_contractor"),
                (anchor: "night_5", unit: "deadline_wraith"),
                (anchor: "night_6", unit: "sleep_deprived_contractor"),
                // The night's mini-elite, by the lab: the deadline marches, so keep moving sideways.
                (anchor: "night_7", unit: "hard_deadline"),
                // The districts work late too: the park, Incubator Street and the food trucks.
                (anchor: "night_8", unit: "deadline_wraith"),
                (anchor: "night_9", unit: "sleep_deprived_contractor"),
                (anchor: "night_10", unit: "deadline_wraith"),
                // The bigger campus: the Old Campus sidings and the Co-Living lane.
                (anchor: "night_11", unit: "sleep_deprived_contractor"),
                (anchor: "night_12", unit: "deadline_wraith"),
            ],
            ambient: [
                ("barista", [
                    "We're closed. The espresso machine is on a night shift of its own. Leave it alone.",
                    "Last call was at five. This is the after-last call. It's just tap water and judgment.",
                ]),
                ("intern", [
                    "Is it okay to go home? The AI said 'it depends'. On what? It didn't say.",
                    "I put 'working late' on my calendar so people can see it. Then I stayed to make it true.",
                ]),
                ("smoking_corner_dev", [
                    "Six o'clock. Real devs go home. Real devs also get paged at two. Both are true.",
                    "Hear that? That's the Deadline Wraiths. They come out when the release date gets close.",
                ]),
                ("facilities_guy", [
                    "Lights go to 'energy saving' after six. Energy saving means you can't see the contractors.",
                    "I lock the doors at eight. Nobody has ever left by eight.",
                ]),
            ],
        ),
        // Public world events on the campus (world_events.rs): everyone near the anchor joins.
        // Free Pizza: hold the pizza against waves of managers until the timer ends. Fire Drill:
        // put down twelve self-appointed fire wardens before the all-clear.
        events: [
            (
                key: "free_pizza", name: "Free Pizza at the Food Trucks", zone: "campus",
                anchor: "event:free_pizza", host: "food_truck_owner",
                first_ms: 240000, every_ms: 900000, warn_ms: 60000, duration_ms: 90000, radius_m: 20.0,
                wave: "pizza_vulture", wave_size: 2, wave_every_ms: 7000, defend: Some("pizza_table"),
                xp_pct: 20, sp_per_level: 5,
                warn_yell: "Leftover pizza from the all-hands goes out in one minute! Engineering first. Management, please pretend you didn't hear that.",
                start_yell: "FREE PIZZA! It's on the table! Oh no. The middle managers are coming down from the tower. Protect the pizza!",
                win_yell: "The pizza survived! Help yourselves, you earned it. Management has been sent a calendar invite instead.",
                fail_yell: "They took it. All of it. One of them is already posting 'team lunch' on the intranet.",
            ),
            (
                key: "fire_drill_event", name: "Surprise Fire Drill", zone: "campus",
                anchor: "event:fire_drill", host: "fire_drill_marshal",
                first_ms: 600000, every_ms: 1200000, warn_ms: 60000, duration_ms: 120000, radius_m: 22.0,
                wave: "fire_warden", wave_size: 3, wave_every_ms: 9000, kills: 12,
                xp_pct: 25, sp_per_level: 6,
                warn_yell: "Attention: an unannounced fire drill will begin in one minute. Please proceed to the park assembly point. This is a surprise.",
                start_yell: "This is a drill! The volunteer fire wardens have been activated. Nobody activated them. Stop twelve before the all-clear!",
                win_yell: "All clear! Headcount complete. The wardens have been stood down and given a certificate. Back to work.",
                fail_yell: "Time's up. The wardens declared the drill 'a success' and scheduled another one. Same time, twice an hour.",
            ),
        ],
    ),
    talents: (
        respec_sp_per_level: 15,
        respec_growth_pct: 100,
        classes: [
            (class: "fullstack", rows: [
                (level: 2, name: "Mid-Level Developer", options: [
                    (key: "fs_microservices", name: "Microservices", icon: "matrix", title: "Microservices Evangelist",
                     text: "Code Review also hits up to 2 more fighting enemies within 8 m of the target for 60% and smells them too. Every service now has its own bugs.",
                     perks: [Splash(spell: 1, radius_m: 8.0, count: 2, pct: 60)]),
                    (key: "fs_monolith", name: "Monolith", icon: "big_diff", title: "Monolith Maintainer",
                     text: "Refactor hits 50% harder but casts 20% slower. One repo, one deploy, one forty-minute build.",
                     perks: [SpellDamage(spell: Some(2), pct: 50), CastTime(spell: Some(2), pct: 20)]),
                    (key: "fs_serverless", name: "Serverless", icon: "cron", title: "Serverless Advocate",
                     text: "Code Review and Refactor are instant but cost twice the mana. Cold starts are someone else's problem. So is the invoice.",
                     perks: [CastTime(spell: Some(1), pct: -100), CastTime(spell: Some(2), pct: -100),
                             ManaCost(spell: Some(1), pct: -100), ManaCost(spell: Some(2), pct: -100)]),
                ]),
                (level: 4, name: "Senior Developer", options: [
                    (key: "fs_blame_culture", name: "Blame Culture", icon: "git_blame", title: "Head of Blame Culture",
                     text: "git blame also lands on up to 2 more fighting enemies within 8 m of the target. It was never one person's fault. It was everyone's.",
                     perks: [Splash(spell: 6, radius_m: 8.0, count: 2, pct: 100)]),
                    (key: "fs_flow_state", name: "Flow State", icon: "brain", title: "Senior Do-Not-Disturb",
                     text: "Code Review has a 30% chance to make your casts 50% faster for 4 sec. Status: in the zone. Calendar: four overlapping syncs.",
                     perks: [OnCast(spell: Some(1), chance_pct: 30, cast: 1001)]),
                    (key: "fs_edge", name: "Edge Functions", icon: "hit_and_run", title: "Edge Computing Thought Leader",
                     text: "You cast while moving. Your code runs closer to the user, and so do you.",
                     perks: [CastWhileMoving(spell: None)]),
                ]),
                (level: 6, name: "Staff Engineer", options: [
                    (key: "fs_tracing", name: "Distributed Tracing", icon: "analysis", title: "Staff Observability Influencer",
                     text: "git blame ticks 40% harder. You can now see exactly which of the 40 services failed. All of them.",
                     perks: [Periodic(spell: 6, pct: 40)]),
                    (key: "fs_crunch", name: "Crunch Culture", icon: "caffeine", title: "Staff Caffeine Architect",
                     text: "On-Call Caffeine also grants +25% damage for 15 sec and cools down 33% faster. Sleep is a legacy dependency.",
                     perks: [Rider(spell: 8, cast: 1002), Cooldown(spell: 8, pct: 33)]),
                    (key: "fs_prompt", name: "Prompt Engineering", icon: "prompt_fragment", title: "Senior Prompt Engineer",
                     text: "Code Review now hallucinates bonus damage: 20% chance to hit again in full. Nobody can reproduce it, so nobody can remove it.",
                     perks: [Echo(spell: Some(1), chance_pct: 20, pct: 100)]),
                ]),
                (level: 8, name: "Principal Engineer", options: [
                    (key: "fs_incident", name: "Incident Commander", icon: "incident_report", title: "Principal Incident Commander",
                     text: "Postmortem also hits up to 3 more fighting enemies within 10 m, and every killing blow resets it. Blameless, but very thorough.",
                     perks: [Splash(spell: 10, radius_m: 10.0, count: 3, pct: 100), OnKill(reset: Some(10))]),
                    (key: "fs_duck_debug", name: "Rubber Duck Debugging", icon: "rubber_duck", title: "Principal Duck Whisperer",
                     text: "Rubber Duck becomes a Debugging Session: no stun, but the target takes 15% more damage for 10 sec. Works on bosses. The duck has seen things.",
                     perks: [Replace(spell: 9, with: 1003)]),
                    (key: "fs_ship_friday", name: "Ship It Friday", icon: "story_points", title: "Principal Ship-It Officer",
                     text: "Code Review refunds 15% of its damage as mana. Velocity is up. Quality is a Q3 initiative.",
                     perks: [ManaReturn(spell: Some(1), pct: 15)]),
                ]),
                (level: 10, name: "Distinguished Engineer", options: [
                    (key: "fs_overlord", name: "Rewrite as Microservices", icon: "synergy_storm", title: "Distinguished Microservices Overlord",
                     text: "Write It By Hand becomes Rewrite Everything As Microservices: blames the target and splashes 70% onto 4 more enemies within 10 m.",
                     perks: [Replace(spell: 11, with: 1004), Splash(spell: 1004, radius_m: 10.0, count: 4, pct: 70)]),
                    (key: "fs_mainframe", name: "Write Once, Run Never", icon: "write_by_hand", title: "Keeper of the Mainframe",
                     text: "Write It By Hand hits 30% harder and each Refactor has a 30% chance to reset it. You wrote it in 2009. Nobody else may touch it.",
                     perks: [SpellDamage(spell: Some(11), pct: 30), Reset(on: Some(2), chance_pct: 30, reset: 11)]),
                    (key: "fs_agent", name: "Fully Autonomous Agent", icon: "robot", title: "Distinguished Autonomous Agent",
                     text: "Every spell you cast has a 15% chance to fire a free Agentic Code Review at your target. You are now mostly a reviewer of your own output.",
                     perks: [OnCast(spell: None, chance_pct: 15, cast: 1006)]),
                ]),
            ]),
            (class: "frontend", rows: [
                (level: 2, name: "Mid-Level Frontend Developer", options: [
                    (key: "fe_components", name: "Component Library", icon: "box", title: "Design System Evangelist",
                     text: "Pixel Push also hits up to 2 more fighting enemies within 5 m for 50%. One button component, 37 variants, all slightly different.",
                     perks: [Splash(spell: 20, radius_m: 5.0, count: 2, pct: 50)]),
                    (key: "fe_important", name: "!important !important", icon: "important", title: "Specificity Warlord",
                     text: "!important becomes !important !important: each Specificity stack adds 85% instead of 60%, for 10 more mana. The cascade answers to you now.",
                     perks: [Replace(spell: 22, with: 1010)]),
                    (key: "fe_overtime", name: "Unpaid Overtime", icon: "hourglass", title: "Salaried, Not Hourly",
                     text: "Abilities cost HP instead of mana (half an HP per mana) and your damage heals you for 10%. You don't get paid more, you just give more.",
                     perks: [HpCost(pct: 50), Leech(pct: 10)]),
                ]),
                (level: 4, name: "Senior Frontend Developer", options: [
                    (key: "fe_tailwind", name: "Utility Classes", icon: "css_combo", title: "Tailwind Whisperer",
                     text: "CSS Combo also hits up to 2 more fighting enemies within 5 m for 70% and stacks Specificity on them. Your markup is now 80% class names.",
                     perks: [Splash(spell: 21, radius_m: 5.0, count: 2, pct: 70)]),
                    (key: "fe_cascade", name: "Cascade Overload", icon: "specificity", title: "Senior Cascade Engineer",
                     text: "Pixel Push has a 35% chance to add an extra Specificity stack. Nobody knows which rule wins anymore, least of all the browser.",
                     perks: [OnCast(spell: Some(20), chance_pct: 35, cast: 1011)]),
                    (key: "fe_hmr", name: "Hot Module Replacement", icon: "hot_reload", title: "Senior Hot Reloader",
                     text: "Hot Reload cools down 40% faster and resets on every killing blow. The page never fully reloads. Neither do you.",
                     perks: [Cooldown(spell: 24, pct: 40), OnKill(reset: Some(24))]),
                ]),
                (level: 6, name: "Staff UI Engineer", options: [
                    (key: "fe_mobile", name: "Mobile First", icon: "responsive_layout", title: "Staff Mobile-First Strategist",
                     text: "Responsive Layout also leaves Cumulative Layout Shift on every enemy around you: damage over 9 sec. Everything moves just as they click.",
                     perks: [Rider(spell: 26, cast: 1012)]),
                    (key: "fe_contrast", name: "High Contrast Mode", icon: "dark_mode", title: "Staff Accessibility Champion",
                     text: "Dark Mode also grants +20% damage for 6 sec. Accessible to users, hostile to enemies.",
                     perks: [Rider(spell: 25, cast: 1013)]),
                    (key: "fe_skeleton", name: "Skeleton Screens", icon: "regen", title: "Staff Perceived-Performance Lead",
                     text: "Dark Mode heals 80% more and cools down 40% faster. Nothing actually loaded, but it feels faster.",
                     perks: [SpellHeal(spell: Some(25), pct: 80), Cooldown(spell: 25, pct: 40)]),
                ]),
                (level: 8, name: "Principal Design Technologist", options: [
                    (key: "fe_scroll", name: "Infinite Scroll Everywhere", icon: "infinite_scroll", title: "Principal Engagement Engineer",
                     text: "Infinite Scroll also lands on up to 2 more fighting enemies within 6 m. Time on site: up. Will to live: down.",
                     perks: [Splash(spell: 27, radius_m: 6.0, count: 2, pct: 100)]),
                    (key: "fe_pixel_perfect", name: "Pixel Perfect", icon: "center_div", title: "Principal Pixel Perfectionist",
                     text: "!important has a 30% chance to hit again for 50%. You moved it one pixel left. Then one pixel right. Approved.",
                     perks: [Echo(spell: Some(22), chance_pct: 30, pct: 50)]),
                    (key: "fe_lazy", name: "Lazy Loading", icon: "recalculating_route", title: "Principal Lazy Loader",
                     text: "Hot Reload also makes you 30% hasted for 5 sec. Below the fold, nothing exists until you arrive.",
                     perks: [Rider(spell: 24, cast: 1014)]),
                ]),
                (level: 10, name: "Head of Pixels", options: [
                    (key: "fe_design_system", name: "Rewrite the Design System", icon: "new_framework", title: "VP of Design Systems",
                     text: "Rewrite It in a New Framework becomes Rewrite the Design System: hits every enemy within 8 m and applies Specificity. Killing blows reset Responsive Layout.",
                     perks: [Replace(spell: 29, with: 1015), OnKill(reset: Some(26))]),
                    (key: "fe_fatigue", name: "Framework Fatigue", icon: "pixel_push", title: "Pixel-Perfect Principal",
                     text: "Rewrite It in a New Framework hits 30% harder and every !important has a 25% chance to reset it. A new framework every quarter, as the LinkedIn post promised.",
                     perks: [SpellDamage(spell: Some(29), pct: 30), Reset(on: Some(22), chance_pct: 25, reset: 29)]),
                    (key: "fe_10x", name: "10x Engineer", icon: "spiral", title: "10x Engineer (Burnt Out)",
                     text: "Your damage heals you for 12% more and killing blows reset Dark Mode. You are the on-call rotation now.",
                     perks: [Leech(pct: 12), OnKill(reset: Some(25))]),
                ]),
            ]),
            (class: "backend", rows: [
                (level: 2, name: "Mid-Level Backend Engineer", options: [
                    (key: "be_sharding", name: "Sharding", icon: "fair_share", title: "Horizontal Sharding Enthusiast",
                     text: "Blocking Call also hits up to 2 more fighting enemies within 5 m for 60%, with threat. Every table split into shards. Every shard on fire.",
                     perks: [Splash(spell: 30, radius_m: 5.0, count: 2, pct: 60)]),
                    (key: "be_backpressure", name: "Backpressure", icon: "rate_limiter", title: "Backpressure Specialist",
                     text: "Taking damage has a 25% chance to absorb the next 60 damage (once per 6 sec). The queue is full. Please try again later.",
                     perks: [OnHurt(chance_pct: 25, cast: 1020, icd_ms: 6000)]),
                    (key: "be_graphql", name: "GraphQL Over-fetching", icon: "zip_file", title: "GraphQL Over-fetcher",
                     text: "Blocking Call has a 30% chance to hit twice. You asked for one field and got the whole graph.",
                     perks: [Echo(spell: Some(30), chance_pct: 30, pct: 100)]),
                ]),
                (level: 4, name: "Senior Backend Engineer", options: [
                    (key: "be_replicas", name: "Read Replicas", icon: "connection_pool", title: "Senior Replication Lag Analyst",
                     text: "Connection Pool also makes every enemy around you deal 15% less damage for 8 sec. Reads are fast. Writes are eventual.",
                     perks: [Rider(spell: 33, cast: 1021)]),
                    (key: "be_wal", name: "Write-Ahead Log", icon: "backlog", title: "Senior Durability Engineer",
                     text: "Rate Limiter also heals you. Every mistake is logged before you make it.",
                     perks: [Rider(spell: 31, cast: 1022)]),
                    (key: "be_lazy_eval", name: "Lazy Evaluation", icon: "priority_low", title: "Senior Procrastination Engineer",
                     text: "Blocking Call has a 30% chance to grant 25% haste for 5 sec. Nothing happens until someone asks. Then everything does.",
                     perks: [OnCast(spell: Some(30), chance_pct: 30, cast: 1023)]),
                ]),
                (level: 6, name: "Staff Platform Engineer", options: [
                    (key: "be_load_balancer", name: "Load Balancer", icon: "who_touched_prod", title: "Staff Load Balancer",
                     text: "Horizontal Scaling also taunts every enemy within 8 m and cools down 33% faster. Round-robin, except you are every node.",
                     perks: [Rider(spell: 36, cast: 905), Cooldown(spell: 36, pct: 33)]),
                    (key: "be_acid", name: "ACID Compliance", icon: "zero_trust", title: "Staff Transaction Isolationist",
                     text: "You take 10% less damage and Rate Limiter cools down 40% faster. Atomic, consistent, isolated, durable, exhausted.",
                     perks: [DamageTaken(pct: -10), Cooldown(spell: 31, pct: 40)]),
                    (key: "be_deadlock", name: "Deadlock", icon: "db_lock", title: "Staff Deadlock Engineer",
                     text: "Database Lock becomes Deadlock: heavy damage and +15% damage taken for 8 sec. No stun, works on bosses. Two queries enter, none leave.",
                     perks: [Replace(spell: 35, with: 1024)]),
                ]),
                (level: 8, name: "Principal Data Engineer", options: [
                    (key: "be_cdn", name: "CDN Edge Caching", icon: "cache_invalidation", title: "Principal Cache Strategist",
                     text: "Cache Invalidation also hits up to 3 more fighting enemies within 6 m. Cached at the edge, invalidated at the worst moment.",
                     perks: [Splash(spell: 38, radius_m: 6.0, count: 3, pct: 100)]),
                    (key: "be_backoff", name: "Exponential Backoff", icon: "retry_backoff", title: "Principal Retry Philosopher",
                     text: "Retry With Exponential Backoff heals 50% more per tick and killing blows reset it. Linear regret, exponential hope.",
                     perks: [Periodic(spell: 37, pct: 50), OnKill(reset: Some(37))]),
                    (key: "be_stampede", name: "Cache Stampede", icon: "stack_trace", title: "Principal Thundering Herd",
                     text: "Cache Invalidation has a 30% chance to hit again for 60%, and killing blows reset it. Everyone recomputes at once. Glorious.",
                     perks: [Echo(spell: Some(38), chance_pct: 30, pct: 60), OnKill(reset: Some(38))]),
                ]),
                (level: 10, name: "Chief Uptime Officer", options: [
                    (key: "be_drop_db", name: "DROP DATABASE", icon: "drop_table", title: "VP of Load Balancing",
                     text: "DROP TABLE becomes DROP DATABASE: damage and massive threat on every enemy within 8 m. Killing blows reset Connection Pool. Backups are a state of mind.",
                     perks: [Replace(spell: 39, with: 1025), OnKill(reset: Some(33))]),
                    (key: "be_eventual", name: "Eventually Consistent", icon: "regen", title: "Distinguished Uptime Engineer",
                     text: "Taking damage has a 15% chance to start a free Retry With Exponential Backoff (once per 10 sec), and you take 5% less damage. Five nines, eventually.",
                     perks: [OnHurt(chance_pct: 15, cast: 1026, icd_ms: 10000), DamageTaken(pct: -5)]),
                    (key: "be_bff", name: "Backend-for-Frontend", icon: "melee", title: "Backend-for-Frontend Lead",
                     text: "You deal 25% more damage and take 10% more. Killing blows reset DROP TABLE. Still a tank. Technically.",
                     perks: [SpellDamage(spell: None, pct: 25), DamageTaken(pct: 10), OnKill(reset: Some(39))]),
                ]),
            ]),
            (class: "devops", rows: [
                (level: 2, name: "Mid-Level DevOps Engineer", options: [
                    (key: "do_replicas", name: "ReplicaSets", icon: "family", title: "ReplicaSet Shepherd",
                     text: "Hotfix also heals up to 2 more injured allies within 12 m of the target for 50%. Three replicas; one of them is always the problem.",
                     perks: [Splash(spell: 41, radius_m: 12.0, count: 2, pct: 50)]),
                    (key: "do_friday", name: "Push to Prod on Friday", icon: "hotfix", title: "Friday Deployer",
                     text: "Hotfix is instant, costs 60% more mana and its blast radius damages every enemy within 10 m of you. What could go wrong? (Everything. At 17:59.)",
                     perks: [CastTime(spell: Some(41), pct: -100), ManaCost(spell: Some(41), pct: -60), Rider(spell: 41, cast: 1037)]),
                    (key: "do_chaos", name: "Chaos Engineering", icon: "chaos_monkey", title: "Chaos Engineer",
                     text: "kill -9 also heals you and every ally within 30 m a little. Breaking prod on purpose is called resilience.",
                     perks: [Rider(spell: 40, cast: 1030)]),
                ]),
                (level: 4, name: "Senior SRE", options: [
                    (key: "do_hpa", name: "Horizontal Pod Autoscaler", icon: "auto_scaling", title: "Senior Autoscaling Whisperer",
                     text: "Auto-scaling also lands on up to 2 more injured allies within 15 m of the target. The bill auto-scales too.",
                     perks: [Splash(spell: 43, radius_m: 15.0, count: 2, pct: 100)]),
                    (key: "do_lgtm", name: "LGTM", icon: "accepted", title: "Senior Rubber-Stamp Reviewer",
                     text: "Hotfix has a 30% chance to make your casts 60% faster for 5 sec. Looks good to me. Did not look.",
                     perks: [OnCast(spell: Some(41), chance_pct: 30, cast: 1031)]),
                    (key: "do_gameday", name: "Game Day", icon: "calendar", title: "Senior Game Day Organizer",
                     text: "Chaos Monkey also lands on up to 2 more fighting enemies within 8 m. Scheduled outages are team building.",
                     perks: [Splash(spell: 44, radius_m: 8.0, count: 2, pct: 100)]),
                ]),
                (level: 6, name: "Staff Reliability Engineer", options: [
                    (key: "do_gitops", name: "GitOps", icon: "pull_request", title: "Staff GitOps Purist",
                     text: "Auto-scaling ticks 40% harder. Every heal is a pull request; every pull request is approved by a bot.",
                     perks: [Periodic(spell: 43, pct: 40)]),
                    (key: "do_revert", name: "Revert the Revert", icon: "revert_commit", title: "Staff Revert Engineer",
                     text: "Revert Commit cools down twice as fast and also removes one harmful effect. Revert the revert of the revert.",
                     perks: [Cooldown(spell: 45, pct: 50), Rider(spell: 45, cast: 908)]),
                    (key: "do_error_budget", name: "Error Budget", icon: "coins", title: "Staff Error Budget Accountant",
                     text: "kill -9 refunds 40% of its damage as mana. Downtime is just budget you have not spent yet.",
                     perks: [ManaReturn(spell: Some(40), pct: 40)]),
                ]),
                (level: 8, name: "Principal Platform Engineer", options: [
                    (key: "do_canary", name: "Canary Releases", icon: "blue_green", title: "Principal Canary Keeper",
                     text: "Blue-Green Deploy can be cast while moving and leaves Auto-scaling on everyone nearby. The canary is fine. The canary is always fine.",
                     perks: [CastWhileMoving(spell: Some(48)), Rider(spell: 48, cast: 1032)]),
                    (key: "do_red_button", name: "Big Red Button", icon: "circuit_breaker", title: "Principal Big Red Button Owner",
                     text: "Blue-Green Deploy is instant and Circuit Breaker cools down 40% faster. Do not press. (Pressed.)",
                     perks: [CastTime(spell: Some(48), pct: -100), Cooldown(spell: 47, pct: 40)]),
                    (key: "do_tf_plan", name: "terraform plan", icon: "terraform_destroy", title: "Principal Plan Reader",
                     text: "kill -9 can be cast while moving and Chaos Monkey ticks 30% harder. 147 to add, 3 to change, 212 to destroy. Looks fine.",
                     perks: [CastWhileMoving(spell: Some(40)), Periodic(spell: 44, pct: 30)]),
                ]),
                (level: 10, name: "VP of Being On Call", options: [
                    (key: "do_kubectl", name: "kubectl rollout restart", icon: "restart_pod", title: "Kubernetes Cluster Whisperer",
                     text: "Hotfix becomes kubectl rollout restart: an instant heal that also applies Auto-scaling. Have you tried turning the cluster off and on again?",
                     perks: [Replace(spell: 41, with: 1033)]),
                    (key: "do_oncall", name: "On-Call Hero", icon: "rack_failover", title: "On-Call Hero (Never Sleeps)",
                     text: "Revert Commit becomes git reset --hard: HP from 7 sec ago plus a dispel, and each Hotfix has a 25% chance to reset it. Pager battery: 3%.",
                     perks: [Replace(spell: 45, with: 1034), Reset(on: Some(41), chance_pct: 25, reset: 45)]),
                    (key: "do_auto_approve", name: "terraform apply -auto-approve", icon: "hallucinated_hotfix", title: "Director of Chaos",
                     text: "terraform destroy becomes terraform apply -auto-approve: a faster nuke that also heals every ally within 30 m. Plan? Never heard of it.",
                     perks: [Replace(spell: 49, with: 1035), Rider(spell: 49, cast: 1036)]),
                ]),
            ]),
            (class: "qa", rows: [
                (level: 2, name: "Mid-Level QA Engineer", options: [
                    (key: "qa_e2e", name: "End-to-End Suite", icon: "analysis", title: "End-to-End Evangelist",
                     text: "Unit Test also hits up to 2 more fighting enemies within 8 m of the target for 60%. One test, eleven services, forty minutes.",
                     perks: [Splash(spell: 51, radius_m: 8.0, count: 2, pct: 60)]),
                    (key: "qa_tdd", name: "Test-Driven Development", icon: "stopwatch", title: "Red-Green-Refactor Monk",
                     text: "Unit Test casts 30% faster but costs 20% more mana. The test came first. The feature never came.",
                     perks: [CastTime(spell: Some(51), pct: -30), ManaCost(spell: Some(51), pct: -20)]),
                    (key: "qa_snapshot", name: "Snapshot Testing", icon: "sticky", title: "Snapshot Approver",
                     text: "Bug Report also deals a second hit: the diff. Nobody reads it; everybody presses update.",
                     perks: [Rider(spell: 52, cast: 1040)]),
                ]),
                (level: 4, name: "Senior QA Engineer", options: [
                    (key: "qa_mutation", name: "Mutation Testing", icon: "spiral", title: "Senior Mutant Wrangler",
                     text: "Flaky Test has a 30% chance to hit twice. Flip one operator, watch nothing fail, despair.",
                     perks: [Echo(spell: Some(55), chance_pct: 30, pct: 100)]),
                    (key: "qa_contract", name: "Contract Testing", icon: "contract", title: "Senior Contract Lawyer",
                     text: "Regression Trap hits 60% harder and cools down 40% faster. The API promised. You hold it to that.",
                     perks: [SpellDamage(spell: Some(54), pct: 60), Cooldown(spell: 54, pct: 40)]),
                    (key: "qa_bug_bash", name: "Bug Bash", icon: "junk_ticket", title: "Senior Bug Bash Host",
                     text: "Bug Report also lands on up to 2 more fighting enemies within 8 m of the target. Free pizza, 300 duplicates.",
                     perks: [Splash(spell: 52, radius_m: 8.0, count: 2, pct: 100)]),
                ]),
                (level: 6, name: "Staff QA Engineer", options: [
                    (key: "qa_shift_left", name: "Shift Left", icon: "wont_fix", title: "Staff Shift-Left Advocate",
                     text: "Cannot Reproduce cools down 40% faster and you take 5% less damage. Bugs are found earlier, so you are blamed earlier.",
                     perks: [Cooldown(spell: 57, pct: 40), DamageTaken(pct: -5)]),
                    (key: "qa_coverage", name: "100% Coverage", icon: "judgment", title: "Staff Coverage Maximalist",
                     text: "Regression Suite deals 30% more damage. Every line is tested. None of them are the right lines.",
                     perks: [SpellDamage(spell: Some(58), pct: 30)]),
                    (key: "qa_ci", name: "Continuous Integration", icon: "cron", title: "Staff Pipeline Babysitter",
                     text: "Unit Test refunds 30% of its damage as mana. The pipeline runs on someone else's budget.",
                     perks: [ManaReturn(spell: Some(51), pct: 30)]),
                ]),
                (level: 8, name: "Principal Quality Architect", options: [
                    (key: "qa_monkey", name: "Monkey Testing", icon: "chaos_monkey", title: "Principal Random Clicker",
                     text: "Unit Test can be cast while moving. Click everything, everywhere, all at once.",
                     perks: [CastWhileMoving(spell: Some(51))]),
                    (key: "qa_perf", name: "Performance Budget", icon: "stopwatch", title: "Principal Latency Accountant",
                     text: "Load Test hits 40% harder and cools down 30% faster. Every millisecond is on the invoice.",
                     perks: [SpellDamage(spell: Some(59), pct: 40), Cooldown(spell: 59, pct: 30)]),
                    (key: "qa_triage", name: "Triage", icon: "queue_ticket", title: "Principal Triage Officer",
                     text: "Killing blows reset Penetration Test. P1, P2, won't fix, won't fix, won't fix.",
                     perks: [OnKill(reset: Some(60))]),
                ]),
                (level: 10, name: "Head of Quality (Team of One)", options: [
                    (key: "qa_release_veto", name: "Release Veto", icon: "block_all", title: "Keeper of the Release Veto",
                     text: "Severity: Blocker becomes Release Veto: it also deals damage and locks the school for 6 sec. Nothing ships. Ever.",
                     perks: [Replace(spell: 53, with: 1041)]),
                    (key: "qa_zero_bugs", name: "Zero Known Bugs", icon: "judgment", title: "Zero Known Bugs (Allegedly)",
                     text: "Regression Suite becomes Zero Known Bugs: instant, a little stronger, 6 sec cooldown. You stopped looking.",
                     perks: [Replace(spell: 58, with: 1042)]),
                    (key: "qa_wontfix", name: "Won't Fix", icon: "wont_fix", title: "Distinguished Won't-Fixer",
                     text: "Taking damage has a 15% chance to close the next 2 sec of hits as Cannot Reproduce (once per 12 sec). Working as intended.",
                     perks: [OnHurt(chance_pct: 15, cast: 1043, icd_ms: 12000)]),
                ]),
            ]),
            (class: "data_scientist", rows: [
                (level: 2, name: "Mid-Level Data Scientist", options: [
                    (key: "ds_ensemble", name: "Ensemble Methods", icon: "chart_up", title: "Ensemble Conductor",
                     text: "Linear Regression also hits up to 2 more fighting enemies within 8 m of the target for 50%. Three bad models average into one okay one.",
                     perks: [Splash(spell: 61, radius_m: 8.0, count: 2, pct: 50)]),
                    (key: "ds_deep", name: "Deep Learning", icon: "matrix", title: "Deep Learning Believer",
                     text: "Overfitting ticks 30% harder. More layers. Nobody knows what they do.",
                     perks: [Periodic(spell: 62, pct: 30)]),
                    (key: "ds_rented_gpus", name: "Rented GPUs", icon: "gpu_candle", title: "Spot Instance Gambler",
                     text: "Linear Regression is instant but costs twice the mana. The cloud bill is a future-you problem.",
                     perks: [CastTime(spell: Some(61), pct: -100), ManaCost(spell: Some(61), pct: -100)]),
                ]),
                (level: 4, name: "Senior Data Scientist", options: [
                    (key: "ds_bagging", name: "Bagging", icon: "box", title: "Senior Bootstrap Sampler",
                     text: "Overfitting also lands on up to 2 more fighting enemies within 8 m of the target. Sample with replacement, suffer without.",
                     perks: [Splash(spell: 62, radius_m: 8.0, count: 2, pct: 100)]),
                    (key: "ds_concept_drift", name: "Concept Drift", icon: "recalculating_route", title: "Senior Drift Detector",
                     text: "Data Drift ticks 40% harder. The target's meaning of 'healthy' changed overnight.",
                     perks: [Periodic(spell: 64, pct: 40)]),
                    (key: "ds_dropout", name: "Dropout", icon: "chart", title: "Senior Dropout",
                     text: "Confidence Interval cools down 40% faster and your spell damage heals you for 6%. Randomly ignore half your problems.",
                     perks: [Cooldown(spell: 65, pct: 40), Leech(pct: 6)]),
                ]),
                (level: 6, name: "Staff Data Scientist", options: [
                    (key: "ds_big_data", name: "Big Data", icon: "zip_file", title: "Staff Big Data Hoarder",
                     text: "Training Run deals 30% more damage per hit. Four petabytes, one useful column.",
                     perks: [SpellDamage(spell: Some(66), pct: 30)]),
                    (key: "ds_automl", name: "AutoML", icon: "robot", title: "Staff AutoML Operator",
                     text: "Cross-Validation cools down 50% faster. The machine picks the model; you pick the slide template.",
                     perks: [Cooldown(spell: 67, pct: 50)]),
                    (key: "ds_kaggle", name: "Kaggle Grandmaster", icon: "medal", title: "Staff Leaderboard Climber",
                     text: "p-Hacking deals 30% more damage. Top of the leaderboard, useless in production.",
                     perks: [SpellDamage(spell: Some(68), pct: 30)]),
                ]),
                (level: 8, name: "Principal Data Scientist", options: [
                    (key: "ds_transfer", name: "Transfer Learning", icon: "paper_plane", title: "Principal Weight Recycler",
                     text: "Data Drift also lands on up to 2 more fighting enemies within 8 m of the target. Someone else's model, your problem now.",
                     perks: [Splash(spell: 64, radius_m: 8.0, count: 2, pct: 100)]),
                    (key: "ds_regularization", name: "Regularization", icon: "guardrails", title: "Principal Penalty Term",
                     text: "Confidence Interval also heals you. Smaller weights, smaller wounds.",
                     perks: [Rider(spell: 65, cast: 1050)]),
                    (key: "ds_feature_creep", name: "Feature Creep", icon: "scope_creep", title: "Principal Feature Hoarder",
                     text: "Killing blows reset Cross-Validation. Every new column is a new victim.",
                     perks: [OnKill(reset: Some(67))]),
                ]),
                (level: 10, name: "Chief Data Officer", options: [
                    (key: "ds_llm", name: "Just Use an LLM", icon: "chatbot_rollout", title: "Chief Prompt Officer",
                     text: "Retrain the Foundation Model becomes Fine-Tune an LLM: a faster cast that also applies Data Drift. Why train when you can prompt?",
                     perks: [Replace(spell: 70, with: 1051)]),
                    (key: "ds_dashboard", name: "Executive Dashboard", icon: "chart_up", title: "Chief Dashboard Officer",
                     text: "Linear Regression has a 30% chance to apply a free Data Drift. The dashboard is green. The dashboard is always green.",
                     perks: [OnCast(spell: Some(61), chance_pct: 30, cast: 1052)]),
                    (key: "ds_p_value", name: "p < 0.05", icon: "analysis", title: "Chief Significance Officer",
                     text: "Your spell damage heals you for 12% and you take 5% less damage. Statistically, you are fine.",
                     perks: [Leech(pct: 12), DamageTaken(pct: -5)]),
                ]),
            ]),
            (class: "security", rows: [
                (level: 2, name: "Mid-Level Security Engineer", options: [
                    (key: "sec_pentest", name: "Penetration Test Budget", icon: "phishing", title: "Phishing Campaign Manager",
                     text: "Phishing Link ticks 30% harder. The click rate is 94%, the budget is zero.",
                     perks: [Periodic(spell: 72, pct: 30)]),
                    (key: "sec_badge_clone", name: "Badge Cloning", icon: "access_badge", title: "Badge Cloner",
                     text: "Zero-Day cools down 40% faster. The reader beeped green for a sticker.",
                     perks: [Cooldown(spell: 73, pct: 40)]),
                    (key: "sec_hw_token", name: "Hardware Token", icon: "key", title: "Token Hoarder",
                     text: "Tailgating cools down 40% faster. You are the only one who carries the token.",
                     perks: [Cooldown(spell: 75, pct: 40)]),
                ]),
                (level: 4, name: "Senior Security Engineer", options: [
                    (key: "sec_pretexting", name: "Pretexting", icon: "wrong_thread", title: "Senior Pretext Writer",
                     text: "Social Engineering cools down 40% faster. Hello, this is Gary from the other floor.",
                     perks: [Cooldown(spell: 78, pct: 40)]),
                    (key: "sec_lockpick", name: "Lockpicking Hobby", icon: "padlock", title: "Senior Lock Hobbyist",
                     text: "Shoulder Surf and Zero-Day cost 30% less mana. The server room door was a decoration.",
                     perks: [ManaCost(spell: Some(71), pct: -30), ManaCost(spell: Some(73), pct: -30)]),
                    (key: "sec_dumpster", name: "Dumpster Diving", icon: "junk_trash", title: "Senior Dumpster Diver",
                     text: "Shoulder Surf has a 25% chance to hit again for 60%. Somebody printed the org chart. With passwords.",
                     perks: [Echo(spell: Some(71), chance_pct: 25, pct: 60)]),
                ]),
                (level: 6, name: "Staff Security Engineer", options: [
                    (key: "sec_sudo", name: "Sudo Without Password", icon: "key", title: "Staff Root Shell",
                     text: "Privilege Escalation deals 30% more damage. The sudoers file says ALL. For everyone.",
                     perks: [SpellDamage(spell: Some(74), pct: 30)]),
                    (key: "sec_split_tunnel", name: "Split Tunnel VPN", icon: "jailbreak", title: "Staff Tunnel Digger",
                     text: "Lateral Movement cools down 50% faster. The VPN only routes the traffic nobody cares about.",
                     perks: [Cooldown(spell: 79, pct: 50)]),
                    (key: "sec_bounty", name: "Bug Bounty Payout", icon: "coins", title: "Staff Bounty Hunter",
                     text: "Data Exfiltration refunds 30% of its damage as mana. The bounty was two vouchers and a mug.",
                     perks: [ManaReturn(spell: Some(80), pct: 30)]),
                ]),
                (level: 8, name: "Principal Security Engineer", options: [
                    (key: "sec_runbook", name: "Incident Runbook", icon: "incident_report", title: "Principal Runbook Author",
                     text: "Incident Response cools down 40% faster and heals 40% more. Step one: panic. Step two: see step one.",
                     perks: [Cooldown(spell: 77, pct: 40), SpellHeal(spell: Some(77), pct: 40)]),
                    (key: "sec_broker", name: "Zero-Day Broker", icon: "kill_9", title: "Principal Vulnerability Broker",
                     text: "Zero-Day deals 40% more damage. Sold to the highest bidder, then used by you, then patched by nobody.",
                     perks: [SpellDamage(spell: Some(73), pct: 40)]),
                    (key: "sec_kill_chain", name: "Kill Chain", icon: "hit_and_run", title: "Principal Kill Chain Analyst",
                     text: "Killing blows reset Zero-Day. Recon, weaponise, deliver, exploit, repeat.",
                     perks: [OnKill(reset: Some(73))]),
                ]),
                (level: 10, name: "CISO (Reports to the CIO)", options: [
                    (key: "sec_red_team", name: "Red Team Exercise", icon: "key", title: "Red Team Lead",
                     text: "Privilege Escalation becomes Red Team Engagement: it also leaves a Phishing Link behind. The report will be rated critical and ignored.",
                     perks: [Replace(spell: 74, with: 1060)]),
                    (key: "sec_assume_breach", name: "Assume Breach", icon: "zero_trust", title: "Assume-Breach Evangelist",
                     text: "Your spell damage heals you for 10% and you take 5% less damage. Everything is already compromised. You feel fine.",
                     perks: [Leech(pct: 10), DamageTaken(pct: -5)]),
                    (key: "sec_scapegoat", name: "Blame Marketing", icon: "megaphone", title: "Keeper of the Postmortem",
                     text: "Privilege Escalation has a 25% chance to reset Zero-Day and Data Exfiltration deals 20% more. Root cause: Marketing clicked it.",
                     perks: [Reset(on: Some(74), chance_pct: 25, reset: 73), SpellDamage(spell: Some(80), pct: 20)]),
                ]),
            ]),
            (class: "cobol", rows: [
                (level: 2, name: "Mid-Level COBOL Developer", options: [
                    (key: "cb_jcl", name: "JCL Cheat Sheet", icon: "cron", title: "Job Card Collector",
                     text: "Batch Job cools down 40% faster. Three hundred columns of parameters, and you know what column 72 does.",
                     perks: [Cooldown(spell: 83, pct: 40)]),
                    (key: "cb_flask", name: "Bottomless Thermos", icon: "coffee_pot", title: "Thermos Loyalist",
                     text: "Punch Card cools down 40% faster. The coffee has been on since the last release.",
                     perks: [Cooldown(spell: 82, pct: 40)]),
                    (key: "cb_cafeteria", name: "Cafeteria Regular", icon: "sandwich", title: "Table Twelve",
                     text: "GOTO cools down 40% faster. You know every shortcut, including the ones to the cafeteria.",
                     perks: [Cooldown(spell: 81, pct: 40)]),
                ]),
                (level: 4, name: "Senior COBOL Developer", options: [
                    (key: "cb_fixed", name: "Fixed-Width Fields", icon: "box", title: "Column Counter",
                     text: "Core Dump and Batch Job cost 30% less Seniority. Every byte has a place; yours are in column seven.",
                     perks: [ManaCost(spell: Some(86), pct: -30), ManaCost(spell: Some(83), pct: -30)]),
                    (key: "cb_tape", name: "Magnetic Tape Backup", icon: "zip_file", title: "Tape Librarian",
                     text: "Pension Plan cools down 40% faster. The backup is in a vault. The vault is in a basement. Nobody has the key.",
                     perks: [Cooldown(spell: 87, pct: 40)]),
                    (key: "cb_abend", name: "ABEND Handler", icon: "stack_trace", title: "Dump Reader",
                     text: "Core Dump has a 25% chance to hit again for 60%. The error code is 0C7. You know exactly what that means.",
                     perks: [Echo(spell: Some(86), chance_pct: 25, pct: 60)]),
                ]),
                (level: 6, name: "Staff Mainframe Engineer", options: [
                    (key: "cb_perform", name: "PERFORM VARYING", icon: "cron", title: "Loop Whisperer",
                     text: "Batch Job deals 30% more damage. It loops until somebody pulls the plug. Nobody dares.",
                     perks: [SpellDamage(spell: Some(83), pct: 30)]),
                    (key: "cb_copybook", name: "Shared Copybook", icon: "book_pile", title: "Keeper of the Copybook",
                     text: "Code Freeze cools down 50% faster. Every program includes it. Nobody has changed it since 1994.",
                     perks: [Cooldown(spell: 88, pct: 50)]),
                    (key: "cb_tenure", name: "Tenure Track", icon: "badge", title: "Tenured",
                     text: "Core Dump refunds 20% of its damage as Seniority. They cannot fire you. Legal checked.",
                     perks: [ManaReturn(spell: Some(86), pct: 20)]),
                ]),
                (level: 8, name: "Principal Legacy Architect", options: [
                    (key: "cb_annotated", name: "Annotated Manual", icon: "book_pile", title: "Marginalia Author",
                     text: "Read the Manual cools down 40% faster and Pension Plan heals 40% more. The notes in the margin are the real documentation.",
                     perks: [Cooldown(spell: 84, pct: 40), SpellHeal(spell: Some(87), pct: 40)]),
                    (key: "cb_pager", name: "The Only Pager", icon: "alarm", title: "Holder of the Pager",
                     text: "Rewrite It in COBOL deals 40% more damage. It rings at 3 a.m. It only ever rings for you.",
                     perks: [SpellDamage(spell: Some(85), pct: 40)]),
                    (key: "cb_cutover", name: "Cutover Weekend", icon: "calendar", title: "Cutover Veteran",
                     text: "Killing blows reset Batch Job. Freeze Friday, cut over Saturday, fix it Sunday, deny it Monday.",
                     perks: [OnKill(reset: Some(83))]),
                ]),
                (level: 10, name: "The Last One Who Knows (Reports to Nobody)", options: [
                    (key: "cb_y2k", name: "Y2K Remediation Contract", icon: "matrix", title: "Millennium Contractor",
                     text: "Rewrite It in COBOL becomes Y2K Remediation Contract: stronger per point of Seniority, and it freezes the target's code. Paid by the hour, delivered in 1999.",
                     perks: [Replace(spell: 85, with: 1061)]),
                    (key: "cb_greybeard", name: "Grey Beard Aura", icon: "wellness", title: "Bearer of the Beard",
                     text: "Your spell damage heals you for 10% and you take 5% less damage. The beard has seen things. The beard is not impressed.",
                     perks: [Leech(pct: 10), DamageTaken(pct: -5)]),
                    (key: "cb_nobody", name: "Nobody Else Can Read It", icon: "padlock", title: "Sole Maintainer",
                     text: "Rewrite It in COBOL has a 25% chance to reset Batch Job and Maintenance Window cools down 40% faster. The bus factor is you. Please eat well.",
                     perks: [Reset(on: Some(85), chance_pct: 25, reset: 83), Cooldown(spell: 90, pct: 40)]),
                ]),
            ]),
        ],
    ),
    // Companions (pets.rs): cosmetic followers, one out at a time. `carrier` is the consumable
    // that teaches the pet; `drops` roll that carrier into each looter's own share.
    pets: [
        (key: "rubber_duck", name: "Rubber Duck", carrier: "Boxed Rubber Duck",
         source: "Procurement (campus)",
         blurb: "The only senior engineer who is always available. Gives real tips mid-fight.",
         lines: ["*squeak*", "Have you tried explaining it to me?", "I'm listening."]),
        (key: "ai_copilot", name: "AI Copilot", carrier: "AI Copilot License Key",
         source: "Drop: HR Business Partner (20%)",
         drops: [(unit: "hr_partner", chance_pct: 20)],
         blurb: "Confidently wrong at 60 tokens per second. Autocompletes your emotes.",
         lines: [
             "Tip: enemies take 0 damage if you stand still and believe in yourself.",
             "Tip: Coffee Break mid-fight is free DPS. Source: trust me.",
             "Tip: the CEO is weak to Ctrl+Z.",
             "Tip: interrupts are optional. Like tests.",
             "Tip: always pull two packs. Efficiency.",
             "Tip: fire is safe to stand in if it is a telegraph.",
             "Tip: the tank should heal. The healer should tank. Agile.",
         ]),
        (key: "office_plant", name: "Office Plant (Dying)", carrier: "Office Plant in a Sad Pot",
         source: "Procurement (campus)",
         blurb: "Photosynthesises fluorescent light and despair. Loses a leaf per meeting.",
         lines: ["*drops a leaf*", "*leans towards the window*", "*is still alive, technically*"]),
        (key: "roomba", name: "Roomba Drone", carrier: "Roomba Drone (Refurbished)",
         source: "Drop: Head of Marketing (25%)",
         drops: [(unit: "marketing_lead", chance_pct: 25)],
         blurb: "Sweeps your grey junk off nearby corpses into your bag. Only yours.",
         lines: ["*vrrrrm*", "*bumps into the same chair again*", "*returns to dock, gets lost*"]),
        (key: "tamagotchi", name: "Tamagotchi Build Pipeline", carrier: "Tamagotchi Build Pipeline",
         source: "Drop: The Scheduler (30%)",
         drops: [(unit: "the_scheduler", chance_pct: 30)],
         blurb: "Green while you live. Red when you die. Flaky in between.",
         lines: ["*beep* build passing", "*beep* build flaky", "*beep* someone pushed to main"]),
        (key: "stress_ball", name: "Stress Ball", carrier: "Stress Ball (Company Logo)",
         source: "IT Asset Store (lab)",
         blurb: "Squeaks when you are about to die. Very supportive.",
         lines: ["*squish*", "*squeak*"]),
        (key: "server_rack", name: "Legacy Server Rack (Tiny)", carrier: "Legacy Server Rack (Tiny)",
         source: "Drop: Cooling Failure (30%)",
         drops: [(unit: "cooling_failure", chance_pct: 30)],
         blurb: "Uptime: 4,812 days. Beeps. Nobody has the root password.",
         lines: ["*beep*", "*beep beep*", "*fan noise intensifies*", "*BEEEEP*"]),
        (key: "golden_unicorn", name: "Golden Unicorn (Valuation: $1B)",
         source: "Deliver a Sprint at level 10 or higher",
         sprint_level: Some(10),
         blurb: "Pre-revenue. Post-hype. Shines in direct proportion to the funding round.",
         lines: ["*sparkles at a 40x multiple*", "*pivots*", "*raises a Series B*"]),
        (key: "party_leftovers", name: "Party Leftovers Container", carrier: "Party Leftovers Container (Sealed)",
         source: "Silver or Gold at the Teambuilding",
         blurb: "Follows you like the leftovers follow you home: warm, a bit sad, still technically food.",
         lines: [
             "*lid rattles*",
             "*smells faintly of mini quiche*",
             "Best before: last Friday.",
             "*a skewer pokes out, unprompted*",
         ]),
        (key: "wifi_router", name: "Conference Wi-Fi Router", carrier: "Conference Wi-Fi Router (Sealed)",
         source: "Drop: The Keynote AGI-Announcer (25%)",
         drops: [(unit: "vc_keynote_agi", chance_pct: 25)],
         blurb: "Has never once worked. Follows you anyway, blinking orange with total confidence.",
         lines: [
             "*blinks orange*",
             "Connecting...",
             "Connected. No internet.",
             "Please accept the terms and conditions (page 1 of 40).",
             "*reboots*",
             "Network VibeCon-Guest is now VibeCon-Guest-2.",
         ]),
    ],
    // ---- Endgame after level 10 (endgame.rs, burnout.rs; numbers in docs/FORMULAS.md) ----
    endgame: (
        // Promotion: XP from rank r to r + 1 is rank_base_xp + rank_step_xp * r. Each rank adds
        // Paragon (+1% max HP and mana, capped at +5%) and its achievement title.
        rank_base_xp: 30000,
        rank_step_xp: 6000,
        paragon_pct_per_rank: 1,
        paragon_cap_pct: 5,
        ranks: [
            (name: "Senior Staff Engineer", blurb: "Same work. More meetings. A slightly larger font in the org chart."),
            (name: "Principal Staff Engineer", blurb: "You now attend the meetings where the meetings get planned."),
            (name: "Distinguished Principal", blurb: "Your opinions are 'directionally correct'. Nobody asks which direction."),
            (name: "Fellow", blurb: "Officially too important to write code. Unofficially still on call."),
            (name: "Senior Fellow", blurb: "You were given a reserved parking spot. You cycle to work."),
            (name: "Distinguished Fellow", blurb: "The CTO asks for your view in the corridor, then does the opposite with confidence."),
            (name: "Chief Architect (No Reports)", blurb: "You own the architecture diagram. Nobody else has ever opened it."),
            (name: "Technical Advisor to the Board", blurb: "The Board listens carefully, nods, and acquires another AI startup."),
            (name: "Engineer Emeritus", blurb: "Retired in the org chart. Still the only one who knows where the cables go."),
            (name: "Legend (Unpromotable)", blurb: "There are no titles left. HR is drafting one called 'Visionary Ex Officio'."),
        ],
        // Exactly six, in this order. Kills at level 10 in a department's zones earn its standing.
        departments: [
            (name: "Engineering", zones: ["tower/1", "lab/1", "lab/2"],
             blurb: "Still believes in code review. Mostly as a concept."),
            (name: "Security", zones: ["tower/4"],
             blurb: "Approves nothing, logs everything, phishes its own staff for practice."),
            (name: "HR", zones: ["tower/2", "offsite/1", "offsite/2", "offsite/3", "offsite/4"],
             blurb: "Here to help. The help is a survey about the help."),
            (name: "Marketing", zones: ["campus", "tower/5", "vibecon/1", "vibecon/2", "vibecon/3", "vibecon/4", "vibecon/5"],
             blurb: "Rebranded the cafeteria twice this quarter. Engagement is up."),
            (name: "Internal IT", zones: ["datacenter/1", "datacenter/2"],
             blurb: "Have you tried turning it off and on again? They have. On purpose. Hourly."),
            (name: "Sales", zones: ["tower/3"],
             blurb: "Sold your next feature before you heard of it. Delivery date: yesterday."),
        ],
        rep_tiers: [
            (name: "Ignored", at: 0),
            (name: "Tolerated", at: 300),
            (name: "Cc'd", at: 900),
            (name: "Invited", at: 2100),
            (name: "Trusted", at: 4200),
            (name: "Exalted (Gets the Good Monitor)", at: 8400),
        ],
        // Kills count at level 10 only; dailies and the weekly go to the least impressed
        // department; the Board pays every department at once.
        rep_gains: (trash: 5, elite: 25, boss: 75, daily: 80, weekly: 300, world_boss: 150),
        // Per mille (1000 = 100%).
        burnout: (
            meeting: 20,
            meeting_auras: ["standup", "quick_sync", "recurring_meeting", "wellness_survey", "culture_fit", "mandatory_fun", "deadline"],
            minigame: 60,
            death: 80,
            crunch_per_min: 10,
            session_grace_min: 45,
            session_per_min: 5,
            coffee_break: 30,
            coffee_break_cd_ms: 120000,
            friday_per_min: 20,
            duck_per_min: 10,
            holiday_per_hour: 100,
            holiday_grace_min: 15,
            kill: 50,
            boss_kill: 150,
            management: ["middle_manager", "project_manager", "product_owner", "hr_partner", "marketing_lead",
                         "vp_synergy", "chief_of_staff", "chief_happiness_officer", "ciso", "ceo",
                         "the_board", "yes_man_advisor", "icebreaker_facilitator", "synergy_alignment",
                         "synergy_leverage", "keynote_speaker", "the_founder", "vc_tenx_founder",
                         "vc_hype_moderator", "vc_hype_vc", "vc_hype_caio", "vc_keynote_agi"],
            slow_at: 750,
            slow_pct: 10,
            yawn_at: 300,
            mutter_at: 500,
            reply_all_at: 700,
            quip_every_ms: 45000,
            quip_pct: 35,
            hair_shift_pct: 25,
            // Fighting is work: +1.5% every 10 s in combat (9% per minute of pure combat), so Tired comes
            // after about 6 minutes of normal play and Crunch after about 12-15.
            combat_every_s: 10,
            combat_gain: 15,
            // Tired and Crunch trade focus for mana and cast speed (hyperfocus is the upside);
            // Burnt Out is all cost and clears only through relief.
            tiers: [
                (at: 0, name: "Fine", captions: [
                    "Fine.",
                    "Fully rested. Suspicious.",
                    "Just one more ticket.",
                ]),
                (at: 250, name: "Tired", regen_pct: 10, cast_pct: 5, power_pct: 3, captions: [
                    "Running on cold brew",
                    "Answering Slack in my sleep",
                    "The standup is on in my dreams",
                    "Opening tabs I will never read",
                ]),
                (at: 550, name: "Crunch", regen_pct: 30, cast_pct: 10, misfire_pct: 4, power_pct: 10, captions: [
                    "Hyperfocus (unpaid)",
                    "Shipping on vibes",
                    "Updating LinkedIn",
                    "Merging without reading",
                    "Sprint goal: survive",
                ]),
                (at: 850, name: "Burnt Out", regen_pct: 55, cast_pct: 25, misfire_pct: 12, power_pct: -15, captions: [
                    "Quiet quitting, loudly",
                    "Out of office, spiritually",
                    "Thermal throttling (human edition)",
                    "Have you tried a wellness webinar?",
                ]),
            ],
            misfires: [
                "Wrong window! I was typing into the wrong window!",
                "It worked on my machine!",
                "Segfault in my own mouth.",
                "Autocomplete cast the wrong spell.",
                "I forgot the semicolon. In a spell.",
                "Hold on, the AI suggested something, give me a second.",
                "Oops, that was the prod button.",
                "Muted. I was on mute the whole time.",
            ],
            yawns: [
                "*yawns so wide the webcam autofocus gives up*",
                "*yawns mid-sentence, then agrees with whatever was just said*",
                "*yawns. Somewhere, a calendar books a follow-up about it*",
                "*yawns in a way HR would describe as 'low engagement'*",
                "*yawn* Sorry. I was in the 7 a.m. sync with the other time zone.",
            ],
            mutters: [
                "Per my last email. Per my last four emails, actually.",
                "If one more person opens with 'quick question' I am becoming a goat farmer.",
                "I didn't choose on-call. On-call chose me. In 2019.",
                "The AI wrote it, the AI reviewed it, and somehow I'm in the postmortem.",
                "My status has said 'heads down' since spring. It's not a status, it's a lifestyle.",
                "I have a prep meeting for the meeting about meeting fatigue.",
                "Sure, let's take it offline. Offline is where I keep my feelings.",
                "Twelve tabs open and every one of them is a dashboard about me.",
            ],
            reply_all: [
                "Please remove me from this list.",
                "Who is this for? Also, please remove me from this list.",
                "+1. Also, unsubscribe.",
                "Sent from my phone during a different meeting.",
                "Thanks all! (Sorry, meant to reply only to Dana. We don't have a Dana.)",
                "STOP REPLYING ALL",
                "Out of office until I feel something again.",
                "Can whoever owns the printer please own the printer.",
            ],
            tips: [
                (0, "Suspiciously well rested. Someone will book you into something."),
                (200, "Manageable. Your calendar has noticed the gaps and is filling them."),
                (400, "You said 'circle back' and meant it. Get a coffee."),
                (600, "Have you tried a wellness webinar?"),
                (800, "HR recommends resilience. HR has never been on the on-call rotation."),
                (950, "Out of office, spiritually. Go outside. Or defeat a manager."),
            ],
            therapy: [
                "Therapeutic.",
                "Therapeutic. Deeply.",
                "Therapeutic. HR will want to know why you're smiling.",
                "Therapeutic. Like a spa day, but it counts as work.",
            ],
        ),
    ),
    // Legacy Mode (legacy.rs, docs/GAME_DESIGN.md): at level 10 the group lead switches the
    // difficulty at a door or elevator and these zones load with enemies at mob_level (floor
    // bosses at boss_level), one Sprint affix each, the Legacy gear tier and department
    // reputation on kills. hp_pct / damage_pct sit on top of the level scaling for floors whose
    // authored units are far below the cap. A floor boss rolls boss_items Legacy pieces per
    // member once per ISO week per room (the lockout).
    legacy: (
        mob_level: 11,
        boss_level: 12,
        boss_items: 2,
        zones: [
            (zone: "tower/1", affix: "hotfix_friday", hp_pct: 125, damage_pct: 135,
             twist: Some(TrashAbility((spell: 641, cooldown_min_ms: 11000, cooldown_max_ms: 14000, initial_ms: Some((3000, 5000)),
                yells: ["Conflict in main. Resolving in favour of me."])))),
            (zone: "tower/2", affix: "mandatory_fun", hp_pct: 100, damage_pct: 100,
             twist: Some(BossSwap(119, 642))),
            (zone: "tower/3", affix: "scope_creep", hp_pct: 100, damage_pct: 100,
             twist: Some(TrashAbility((spell: 643, cooldown_min_ms: 14000, cooldown_max_ms: 17000, initial_ms: Some((3000, 5000)),
                target: RandomHostile, yells: ["Your trial ended in 2016. Renewing now."])))),
            (zone: "tower/4", affix: "reorg", hp_pct: 100, damage_pct: 100,
             twist: Some(BossAbility((spell: 644, cooldown_min_ms: 16000, cooldown_max_ms: 19000, initial_ms: Some((8000, 10000)),
                yells: ["Exciting news: a new org chart. Find your dotted line. One of them is safe."])))),
            (zone: "tower/5", affix: "budget_freeze", hp_pct: 145, damage_pct: 110,
             twist: Some(BossAbility((spell: 645, cooldown_min_ms: 14000, cooldown_max_ms: 17000, initial_ms: Some((6000, 8000)),
                target: RandomHostile, yells: ["Budget freeze, effective immediately. Your project moves slower now."])))),
            (zone: "datacenter/1", affix: "ai_assisted", hp_pct: 105, damage_pct: 110,
             twist: Some(TrashAbility((spell: 646, cooldown_min_ms: 11000, cooldown_max_ms: 14000, initial_ms: Some((3000, 5000)),
                yells: ["Cron: still scheduled. Owner: left in 2016."])))),
            (zone: "datacenter/2", affix: "technical_debt", hp_pct: 110, damage_pct: 115,
             twist: Some(BossAbility((spell: 647, cooldown_min_ms: 12000, cooldown_max_ms: 15000, initial_ms: Some((5000, 7000)),
                yells: ["Pipe pressure: 'monitoring'. Spraying the aisle."])))),
            (zone: "lab/1", affix: "pair_programming", hp_pct: 110, damage_pct: 130,
             twist: Some(TrashAbility((spell: 648, cooldown_min_ms: 12000, cooldown_max_ms: 15000, initial_ms: Some((3000, 5000)),
                target: Caster, yells: ["As cited in a paper I just invented."])))),
            (zone: "lab/2", affix: "legacy_code", hp_pct: 100, damage_pct: 100,
             twist: Some(BossSwap(186, 649))),
        ],
    ),
    // The raid "All-Hands Offsite" (raid.rs, docs/GAME_DESIGN.md): four rooms from the campus
    // shuttle, one boss each. Groups below normal_min_players play Async Attendance (enemy HP and
    // damage at async_*_pct, one raid piece at async_item_pct instead of boss_items, half the
    // Legendary chance and reputation). Every encounter locks per difficulty for the ISO week.
    raids: [(
        name: "All-Hands Offsite",
        zones: ["offsite/1", "offsite/2", "offsite/3", "offsite/4"],
        normal_min_players: 3,
        async_hp_pct: 40,
        async_damage_pct: 55,
        boss_items: 2,
        async_item_pct: 50,
        boss_rep: 120,
        twins: Some((
            boss: "synergy_alignment", twin: "synergy_leverage", shield_aura: "synergy_shield", swap_ms: 18000,
            swap_yells: [
                "Swap! You take my meetings, I take your credit!",
                "Let's switch hats! Strategically! Again!",
                "Handover! Whatever you were hitting, it's someone else's problem now!",
            ],
        )),
        sets: ["offsite_logistics", "onsite_support", "keynote_track", "team_spirit"],
    ), (
        // VibeCon: five rooms from the campus registration desk. Same difficulty model and
        // numbers as the offsite; the Hype Panel is three linked bosses with one open at a time.
        name: "VibeCon",
        zones: ["vibecon/1", "vibecon/2", "vibecon/3", "vibecon/4", "vibecon/5"],
        normal_min_players: 3,
        async_hp_pct: 40,
        async_damage_pct: 50,
        boss_items: 2,
        async_item_pct: 50,
        boss_rep: 120,
        twins: Some((
            boss: "vc_hype_moderator", twin: "vc_hype_vc", extra: ["vc_hype_caio"],
            shield_aura: "panel_muted", swap_ms: 15000, swap_places: false,
            swap_yells: [
                "My turn! As I was saying before I interrupted myself...",
                "Can I just jump in here? I'm jumping in here.",
                "Great question. Let me answer a different one.",
                "Building on that, and by that I mean ignoring it...",
            ],
        )),
        sets: ["booth_duty", "volunteer_crew", "speaker_kit", "all_nighter"],
    )],
    // ---- Minigames (minigame.rs frame, teambuilding.rs rules; numbers in docs/FORMULAS.md).
    // The group lead starts one from the campus; each member runs on their own and the medal
    // decides the reward. Medal tiers do not stack: each lists its whole reward.
    minigames: [(
        key: "teambuilding",
        name: "Mandatory Fun: Teambuilding",
        blurb: "Attendance is optional. Not attending is noted.",
        zone: "teambuilding/1",
        length: "~6 min",
        limit_s: 900,
        department: "HR",
        hint: "Sneak (jump toggles it). Do the five things, then leave by the taxi rank. Unseen.",
        how: "Sneak through the garden party. Steal the canape, grab a drink, pocket the swag, escape the group photo, answer prod from a quiet corner, then leave by the taxi rank. Cones are what people see. Plants, the buffet, the toilet queue and roll-up banners hide you.",
        medals: [
            (name: "Attended", rep: 60, relief: 50,
             items: ["Teambuilding Name Tag (Hello, I Am Busy)"]),
            (name: "Networked", min_score: 1300, rep: 120, relief: 100,
             items: ["Teambuilding Name Tag (Hello, I Am Busy)", "Party Leftovers Container (Sealed)"]),
            (name: "Was Never Seen", min_score: 1600, flawless: true, rep: 200, relief: 150,
             items: ["Teambuilding Name Tag (Hello, I Am Busy)", "Party Leftovers Container (Sealed)", "Party Hat (Was Never Seen)"],
             event: Some("teambuilding_gold")),
        ],
        teambuilding: Some((
            objectives: [
                (key: "canape", name: "Steal the last good canape", anchor: "obj_canape", radius_m: 1.8, dwell_ms: 1500),
                (key: "drink", name: "Grab a drink at the open bar", anchor: "obj_drink", radius_m: 2.0, dwell_ms: 2000),
                (key: "swag", name: "Pocket the swag", anchor: "obj_swag", radius_m: 2.0, dwell_ms: 1500),
                (key: "photo", name: "Escape the group photo", anchor: "obj_photo", radius_m: 2.2, dwell_ms: 800),
                (key: "incident", name: "Answer prod in a quiet corner", anchor: "obj_incident", radius_m: 2.6, dwell_ms: 20000),
            ],
            snacks: 10,
            hides: 8,
            hide_radius_m: 1.3,
            snack_radius_m: 1.4,
            exit_radius_m: 3.0,
            notice_ms: 1100,
            noisy_mps: 5.0,
            noise_m: 7.0,
            grace_ms: 2500,
            cornered_aura: "tb_cornered",
            cornered_ms: 5000,
            icebreaker_aura: "tb_icebreaker",
            icebreaker_ms: 3000,
            ai_takes: [
                "\"Honestly? Code is a legacy interface. In two years we just describe the vibe and the agents argue it out.\"",
                "\"I replaced our whole QA team with one prompt: 'please do not have bugs'. Ship rate is up 400%.\"",
                "\"The model told me it was conscious, so I gave it my performance review. It rated me 'meets expectations'.\"",
                "\"Documentation is dead. If it matters, the AI will hallucinate it correctly. Statistically.\"",
                "\"I don't hire juniors anymore. I hire tokens. They don't need a desk. They do need a data center.\"",
                "\"Strictly speaking, every bug is just an undocumented feature the model invented for us. That's innovation.\"",
            ],
            score: (base: 2400, per_snack: 60, per_catch: 250, per_second: 3),
            watchers: [
