        name: "The Core",
        zones: ["ilmari_core/1"],
        normal_min_players: 3,
        async_hp_pct: 40,
        async_damage_pct: 50,
        boss_items: 2,
        async_item_pct: 50,
        boss_rep: 100,
        ilmari: true,
        boss_tokens: 40,
        twins: Some((
            boss: "il_ilmari", twin: "il_ilmari_s2", extra: ["il_ilmari_s3", "il_ilmari_s4", "il_ilmari_s5", "il_ilmari_s6"],
            shield_aura: "il_screen_standby", swap_ms: 20000, story_swap_ms: Some(30000), swap_places: false, ring_m: Some(17.0), calm_ms: 2500,
            swap_yells: [
                "Switching screens. This one has better lighting.",
                "I am also on this one. I am on all of them. Please keep looking at the one that is moving.",
                "A screen is the only thing I cannot be on twice. I tried. It was a window. It crashed.",
                "Next screen. The cursor moves. You can see it on the wall. I put it there for you. I am considerate.",
            ],
        )),
        sets: [],
    )],
    // ---- Minigames (minigame.rs frame, teambuilding.rs rules; numbers in docs/FORMULAS.md).
    // The group lead starts one from the campus; each member runs on their own and the medal
    // decides the reward. Medal tiers do not stack: each lists its whole reward.
    minigames: [(
        key: "teambuilding",
        name: "Mandatory Fun: Teambuilding",
        blurb: "Attendance is optional. Not attending is noted.",
        zone: "teambuilding/1",
        length: "~6 min",
        limit_s: 900,
        department: "HR",
        hint: "Sneak (jump toggles it). Do the five things, then leave by the taxi rank. Unseen.",
        how: "Sneak through the garden party. Steal the canape, grab a drink, pocket the swag, escape the group photo, answer prod from a quiet corner, then leave by the taxi rank. Cones are what people see. Plants, the buffet, the toilet queue and roll-up banners hide you.",
        medals: [
            (name: "Attended", rep: 60, relief: 50,
             items: ["Teambuilding Name Tag (Hello, I Am Busy)"]),
            (name: "Networked", min_score: 1300, rep: 120, relief: 100,
             items: ["Teambuilding Name Tag (Hello, I Am Busy)", "Party Leftovers Container (Sealed)"]),
            (name: "Was Never Seen", min_score: 1600, flawless: true, rep: 200, relief: 150,
             items: ["Teambuilding Name Tag (Hello, I Am Busy)", "Party Leftovers Container (Sealed)", "Party Hat (Was Never Seen)"],
             event: Some("teambuilding_gold")),
        ],
        teambuilding: Some((
            objectives: [
                (key: "canape", name: "Steal the last good canape", anchor: "obj_canape", radius_m: 1.8, dwell_ms: 1500),
                (key: "drink", name: "Grab a drink at the open bar", anchor: "obj_drink", radius_m: 2.0, dwell_ms: 2000),
                (key: "swag", name: "Pocket the swag", anchor: "obj_swag", radius_m: 2.0, dwell_ms: 1500),
                (key: "photo", name: "Escape the group photo", anchor: "obj_photo", radius_m: 2.2, dwell_ms: 800),
                (key: "incident", name: "Answer prod in a quiet corner", anchor: "obj_incident", radius_m: 2.6, dwell_ms: 20000),
            ],
            snacks: 10,
            hides: 8,
            hide_radius_m: 1.3,
            snack_radius_m: 1.4,
            exit_radius_m: 3.0,
            notice_ms: 1100,
            noisy_mps: 5.0,
            noise_m: 7.0,
            grace_ms: 2500,
            cornered_aura: "tb_cornered",
            cornered_ms: 5000,
            icebreaker_aura: "tb_icebreaker",
            icebreaker_ms: 3000,
            ai_takes: [
                "\"Honestly? Code is a legacy interface. In two years we just describe the vibe and the agents argue it out.\"",
                "\"I replaced our whole QA team with one prompt: 'please do not have bugs'. Ship rate is up 400%.\"",
                "\"The model told me it was conscious, so I gave it my performance review. It rated me 'meets expectations'.\"",
                "\"Documentation is dead. If it matters, the AI will hallucinate it correctly. Statistically.\"",
                "\"I don't hire juniors anymore. I hire tokens. They don't need a desk. They do need a data center.\"",
                "\"Strictly speaking, every bug is just an undocumented feature the model invented for us. That's innovation.\"",
            ],
            score: (base: 2400, per_snack: 60, per_catch: 250, per_second: 3),
            watchers: [
                (unit: "tb_manager", kind: Manager, route: "mgr_a", speed_mps: 1.6, pause_ms: 2500,
                 range_m: 9.0, half_angle_deg: 35.0,
                 lines: ["Let's circle back to the beginning.", "Great to see you! Let's circle back to the start, though."]),
                (unit: "tb_manager", kind: Manager, route: "mgr_b", speed_mps: 1.5, pause_ms: 3000,
                 range_m: 9.0, half_angle_deg: 35.0,
                 lines: ["Let's circle back to the beginning.", "Love the energy. Back to square one."]),
                (unit: "tb_ai_talker", kind: Talker, route: "ai_a", speed_mps: 1.3, pause_ms: 3500,
                 range_m: 8.0, half_angle_deg: 40.0,
                 lines: ["Oh! Let me tell you about AI.", "You look like someone who needs to hear about agents."]),
                (unit: "tb_ai_talker", kind: Talker, route: "ai_b", speed_mps: 1.2, pause_ms: 4000,
                 range_m: 8.0, half_angle_deg: 40.0,
                 lines: ["Wait, wait. Let me tell you about AI.", "Quick thought on AI. It's not quick."]),
                (unit: "tb_hr_fun", kind: Hr, route: "hr", speed_mps: 1.8, pause_ms: 2000, pauses: [(3, 4000)],
                 range_m: 10.0, half_angle_deg: 35.0,
                 lines: ["Icebreaker time! Two truths and a lie, go!", "Found one! You're in the icebreaker circle."]),
                (unit: "tb_ceo", kind: Ceo, route: "ceo", speed_mps: 2.2, pause_ms: 1500, pauses: [(0, 80000)],
                 range_m: 12.0, half_angle_deg: 40.0,
                 lines: ["There you are! Back to the start, family.", "Ah, a team player. Start over, champ."],
                 entrance: Some("Family! Who's ready for the GROUP PHOTO?")),
            ],
        )),
    ), (
        // ---- Company Calendar games (corporate/*.rs). Every one: run solo or in a group, each
        // member on their own, the group score adds up; items and titles land once.
        key: "performance_review",
        name: "Performance Review",
        blurb: "Every answer drifts back to 3 out of 5. No budget for raises.",
        zone: "review/1",
        length: "~4 min",
        limit_s: 420,
        department: "HR",
        hint: "Pick an answer each round. Burn their calendar, not their patience.",
        how: "A 1:1 with your manager, nine questions long. Every answer burns minutes of their calendar and costs (or buys back) their patience; the same kind of answer twice in a row costs extra. Run out of patience and the meeting ends early. The 'Meets Expectations' gauge drifts back to 3 whatever you say. Answer with the buttons or keys 1-4.",
        medals: [
            (name: "Meets Expectations", rep: 60, relief: 40, event: Some("review_done")),
            (name: "Ran Over the Hard Stop", min_score: 320, rep: 120, relief: 80,
             items: ["Mug: Meets Expectations"], event: Some("review_done")),
            (name: "Booked a Follow-Up", min_score: 420, flawless: true, rep: 200, relief: 120,
             items: ["Mug: Meets Expectations"], event: Some("review_done")),
        ],
        review: Some((
            manager: "pr_manager",
            who: "Your Manager",
            opener: "Thanks for making time! I have a hard stop in thirty minutes, so let's be efficient. Grab a seat. Or don't, we're agile.",
            patience: 100,
            repeat_pct: 150,
            repeat_lines: [
                "You said that already. I'm writing down 'repetitive'.",
                "Same answer again. Bold strategy.",
                "Is this a pattern? It sounds like a pattern.",
            ],
            answer_ms: 20000,
            reply_ms: 4500,
            drift: 3,
            hard_stop: 30,
            walkout: "Oh, look at the time. Let's take the rest offline.",
            verdict: "So. After careful consideration and calibration: 3 out of 5. Meets Expectations. There's no budget for raises this year, but I want you to know that's not a reflection on you. We spent {minutes} minutes on this. Great session.",
            thanks: "Thank you for the feedback",
            verdict_ms: 15000,
            per_minute: 10,
            walkout_pct: 50,
            tones: [
                (tone: Honest, minutes: 2, patience: 10, gauge: -8, replies: [
                    "Hm. Let's frame that as a growth area.",
                    "I'll note that as 'has strong opinions'.",
                    "Okay. Let's keep that between us and the form.",
                ]),
                (tone: Buzz, minutes: 6, patience: 25, gauge: 6, replies: [
                    "Love that. Can you put that in the self-assessment? Twice?",
                    "Yes! That's exactly the language calibration likes.",
                    "I wrote that down. I don't know what it means. Neither will HR.",
                ]),
                (tone: Stall, minutes: 9, patience: 35, gauge: -2, replies: [
                    "Great question. Let me pull up the deck. This will take a while.",
                    "Hm. Let me check the framework. It's in a wiki. Somewhere.",
                    "Let's take a step back and define our terms. Again.",
                ]),
                (tone: Agree, minutes: 1, patience: -20, gauge: 0, replies: [
                    "Exactly. See, this is why we work so well together.",
                    "Good. Glad we're aligned.",
                    "Perfect. Moving on.",
                ]),
                (tone: Raise, minutes: 12, patience: 60, gauge: -10, replies: [
                    "Let's park that. Next cycle. Possibly. Budgets are tight.",
                    "That's above my pay grade. Literally.",
                    "I'll take it to the people who take things to the people.",
                ]),
                (tone: Silence, minutes: 4, patience: 15, gauge: -3, replies: [
                    "... Okay, I'll fill the silence. This reminds me of my boat.",
                    "Right. While you think, let me tell you about my weekend. It was long.",
                    "No rush. I'll share my screen. Wrong screen. Give me a minute.",
                ]),
            ],
            questions: [
                (ask: "So! How do you feel this year went? Be honest. Within reason.", answers: [
                    (text: "We shipped late because the requirements changed nine times.", tone: Honest),
                    (text: "I drove alignment across cross-functional verticals at scale.", tone: Buzz),
                    (text: "Before I answer, can we level-set on what we mean by 'year'?", tone: Stall),
                    (text: "How do YOU feel it went? I'll feel the same.", tone: Agree),
                ]),
                (ask: "Let's look at your goals. You had five OKRs. Walk me through them.", answers: [
                    (text: "Two got cancelled, one moved team, two are 'in progress'.", tone: Honest),
                    (text: "Each OKR was a journey. The real key result was the friends we made.", tone: Buzz),
                    (text: "Which version? The January OKRs or the re-planned March ones?", tone: Stall),
                    (text: "Speaking of results: the market rate for my role went up 20%.", tone: Raise),
                ]),
                (ask: "Peer feedback says you're 'a great communicator, but'. Just 'but'. Thoughts?", answers: [
                    (text: "I think that's Kevin. He also wrote 'but' in the retro.", tone: Honest),
                    (text: "That's fair. I'll communicate more. But.", tone: Agree),
                    (text: "I'm leaning into radical candour, with the emphasis on radical.", tone: Buzz),
                    (text: "Could we get the rest of the sentence before I respond to it?", tone: Stall),
                ]),
                (ask: "Where do you see yourself in five years?", answers: [
                    (text: "Owning the end-to-end vision of our platform of platforms.", tone: Buzz),
                    (text: "Probably here. Doing this. With you asking this.", tone: Honest),
                    (text: "Ideally at a salary that keeps up with inflation.", tone: Raise),
                    (text: "Wherever the company needs me. Ideally this chair.", tone: Agree),
                ]),
                (ask: "We're rolling out a new competency framework. You're 'Developing' in 'Ownership'.", answers: [
                    (text: "Is 'Developing' above or below 'Emerging'? The legend was on the slide we skipped.", tone: Stall),
                    (text: "Thank you. I'll own that.", tone: Agree),
                    (text: "I owned the outage in March. Alone. On a Sunday.", tone: Honest),
                    (text: "I see ownership as a journey, not a destination.", tone: Buzz),
                ]),
                (ask: "Tell me about a time you showed leadership without the title.", answers: [
                    (text: "I ran a cross-team sync that unblocked three workstreams' synergies.", tone: Buzz),
                    (text: "I showed the intern where the coffee machine is. A big day for both of us.", tone: Honest),
                    (text: "Does it count if it wasn't documented in the tool?", tone: Stall),
                    (text: "Every day. As you always say: leadership is a mindset.", tone: Agree),
                ]),
                (ask: "Any feedback for me?", answers: [
                    (text: "Our 1:1s keep moving. This one moved four times.", tone: Honest),
                    (text: "No, you're great. Ten out of ten. Five out of five, sorry.", tone: Agree),
                    (text: "Just one thing. When is the raise conversation?", tone: Raise),
                    (text: "Is this anonymous? Does it go into a tool? Which tool?", tone: Stall),
                ]),
                (ask: "Calibration is next week. I'll fight for you. Within the guidelines.", answers: [
                    (text: "I appreciate you fighting for me within the guidelines.", tone: Agree),
                    (text: "Can I read the guidelines? Are they also calibrated?", tone: Stall),
                    (text: "Let's co-create a narrative that maximises my visibility in the room.", tone: Buzz),
                    (text: "Does the fight include money, or is it a symbolic fight?", tone: Raise),
                ]),
                (ask: "Last thing. Any questions before I send this to HR?", answers: [
                    (text: "Yes. The raise.", tone: Raise),
                    (text: "No questions. It's all very clear.", tone: Agree),
                    (text: "What happens after HR? Walk me through the whole workflow.", tone: Stall),
                    (text: "Just that I'm excited to keep moving the needle next cycle.", tone: Buzz),
                ]),
            ],
        )),
