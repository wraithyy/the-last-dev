        key: "reorg",
        name: "Reorg",
        blurb: "The org chart changed while you read this. Find your manager.",
        zone: "reorg/1",
        length: "~4 min",
        limit_s: 360,
        department: "Engineering",
        hint: "Walk up to colleagues for clues, then ask the right one: 'Are you my manager?'",
        how: "Five reorgs. Each one moves the desks and the partitions and deals everyone a new name and role. Walk up to colleagues for clues: one knows where your manager sits, one knows their role, one repeats what was true before the reorg, the rest know nothing. Then ask the right one. Wrong guesses cost points; the faster you find them, the more you score.",
        medals: [
            (name: "Found Someone", min_score: 150, rep: 60, relief: 40),
            (name: "Knows the Org Chart", min_score: 900, rep: 120, relief: 80, event: Some("reorg_done")),
            (name: "Reorg-Proof", min_score: 1150, flawless: true, rep: 200, relief: 120, event: Some("reorg_done")),
        ],
        reorg: Some((
            npcs: ["rg_colleague_1", "rg_colleague_2", "rg_colleague_3", "rg_colleague_4", "rg_colleague_5", "rg_colleague_6"],
            names: ["Dana", "Sam", "Alex", "Robin", "Kim", "Jordan", "Max", "Charlie"],
            roles: [
