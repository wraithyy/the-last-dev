        (
            id: "tower/4", name: "PMO", kind: Indoor, level_range: (7, 8),
            packs: [
                (anchor: "pack_1", units: ["project_manager", "meatproxy"]),
                (anchor: "pack_2", units: ["product_owner", "middle_manager"]),
                (anchor: "pack_3", units: ["consultant"]),
                (anchor: "pack_4", units: ["security_analyst", "security_analyst"]),
                (anchor: "pack_5", units: ["project_manager", "product_owner", "security_analyst"]),
