    // The interactive office (world.rs): off-bar spells everyone knows, props the layouts place
    // at anchor `prop:<key>` (where you stand to use them), hidden NPCs and secret achievements.
    // Prop and achievement keys are stable ids (quests may reference them later).
    world: (
        spells: [950, 951],
        props: [
            // ---- campus ----
            (key: "coffee_campus", name: "AI-Native Coffee Machine", zone: "campus", kind: Coffee,
             auras: [("fresh_brew", 120000)], fail_pct: 10, cooldown_ms: 3000),
            (key: "billboard_campus", name: "AI Billboard", zone: "campus", kind: Billboard, reach_m: 12.0),
            (key: "days_sign_campus", name: "Days Without an AI Incident", zone: "campus", kind: DaysSign, reach_m: 6.0),
            (key: "ai_car", name: "The AI-Powered Car", zone: "campus", kind: AiCar, reach_m: 5.0),
            (key: "bike_rack", name: "Lonely Bike Rack", zone: "campus", kind: BikeRack),
