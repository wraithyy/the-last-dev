        (
            id: "tower/3", name: "Sales & Marketing", kind: Indoor, level_range: (5, 6),
            packs: [
                (anchor: "pack_1", units: ["sales_rep", "account_manager"]),
                (anchor: "pack_2", units: ["linkedin_influencer", "growth_hacker"]),
                (anchor: "pack_3", units: ["sales_rep", "growth_hacker", "meatproxy"]),
                (anchor: "pack_4", units: ["account_manager", "sales_rep", "linkedin_influencer"]),
                (anchor: "pack_5", units: ["growth_hacker", "meatproxy"]),
                (anchor: "pack_6", units: ["marketing_lead"]),
