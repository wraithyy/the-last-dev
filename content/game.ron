    // Playable classes; the first is the default. Base stats and auto attack come from `unit`.
    // Bars are keys 1..=0 in order; each spell's `learn_level` decides when it is usable.
    classes: [
        (
            key: "fullstack", name: "Fullstack Engineer", role: Ranged, unit: "senior_engineer",
            blurb: "Knows everything a little, gets blamed for all of it.\nReviews, refactors and rolls back from 30 m away.",
