        (
            key: "scrum_master_bot", name: "Scrum Master Bot", title: "Standup Is Mandatory", level: 5, hostile: false,
            max_hp: 200, max_mana: 0, spell_power: 0, crit_pct: 0, haste_pct: 0,
            mana_regen_per_5s_combat: 0,
            xp_reward: 0, loot: [], ai: None,
            idle_pose: Some(Chatting),
            yells: (
                talk: [
                    "Good morning! What did you do yesterday, what will you do today, and why is it late?",
                    "Today's standup will be fifteen minutes. I have scheduled forty-five, as a buffer.",
                    "Your OKRs are trending. I will not say which way. Pick up a ticket.",
                    "Blockers? Please phrase them as opportunities. Then resolve them yourself.",
                    "Attendance is tracked. Enthusiasm is also tracked. Yours is in the red.",
                ],
                ambient_ms: 28000,
                ambient: [
                    "Standup in five! Please stand. Sitting standups are a retro topic.",
                    "Reminder: the daily is daily. That is what daily means.",
                    "I have moved your ticket to 'In Progress' on your behalf. You're welcome.",
                    "Reminder: compliance training is due. It was due last year too. It is always due.",
                ],
            ),
        ),
