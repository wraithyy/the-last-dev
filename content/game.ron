        key: "open_space_focus",
        name: "Open-Space Focus",
        blurb: "Sixty seconds of deep work. Someone has \"got a minute\".",
        zone: "openspace/1",
        length: "~3 min",
        limit_s: 300,
        department: "Engineering",
        hint: "Stay at your desk. Time the right defence as each colleague arrives.",
        how: "Hold sixty seconds of uninterrupted deep work at your desk in the middle pod. Colleagues walk up from the edges: headphones for phone calls and alarms, the 'In a meeting' status for 'got a minute?', duck for the birthday cake. A defence lasts 2.5 seconds and then rests, so time it to the arrival. Keys 1-3 or the buttons.",
        medals: [
            (name: "Got Some Work Done", rep: 60, relief: 60),
            (name: "Mostly Undisturbed", min_score: 900, rep: 120, relief: 120),
            (name: "Do Not Disturb", min_score: 1200, flawless: true, rep: 200, relief: 180,
             items: ["Noise-Cancelling Headphones (Decorative)"], event: Some("focus_gold")),
        ],
        focus: Some((
            desk_m: 3.6,
            goal_ms: 60000,
            action_ms: 2500,
            cooldown_ms: 4500,
            actions: ["Headphones", "Status: In a meeting", "Duck"],
            warn_ms: 6000,
            done: "Sixty seconds of deep work. You wrote one line of code. Your manager pings: 'Got a minute?'",
            away: "You are away from your desk. Deep work pauses. Nobody notices.",
            quiet: "Nobody is coming. Type faster.",
            score: (base: 1500, per_deflect: 15, per_interrupt: 150, per_second: 4),
            disturbers: [
