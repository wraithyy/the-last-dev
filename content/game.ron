            (name: "Change Freeze Calendar", icon: "calendar", price: 4, tier: 4,
             description: "Every week is a change freeze. Changes happen anyway, but nervously."),
            (name: "Unread Board Pack (600 Pages)", icon: "unread_spec", price: 8, tier: 5,
