    // Trophies: every loot item. Bonuses are permanent; duplicates stack up to ITEM_STACK_CAP (3).
    // crit_pct accepts tenths (0.5); everything else is whole numbers.
    items: [
        (name: "Pasted Chat Transcript", icon: "chat_bubble", bonus: (max_hp: 4),
         description: "40 screens of 'As an AI language model'. Pinned to your shirt, it counts as armor here."),
        (name: "Reply Sent to the Wrong Thread", icon: "wrong_thread", bonus: (haste_pct: 1),
         description: "Recall failed, courage did not. You type faster now that the whole company is CC'd."),
        (name: "Regenerated Response (v7)", icon: "regen", bonus: (mana_regen: 3),
         description: "Versions 1 to 6 were also fine. Each retry restores a little mana and none of the dignity."),
        (name: "Unreviewed Pull Request", icon: "pull_request", bonus: (max_hp: 5),
         description: "+4,812 -0, zero reviewers. Nobody will approve it, so carrying it is worth 5 max HP."),
        (name: "final_final_v3_actually_works.zip", icon: "zip_file", bonus: (crit_pct: 1.0),
         description: "It does not actually work. It opens on the demo laptop, which is the only place that matters."),
        (name: "Accepted Suggestion", icon: "accepted", bonus: (max_mana: 4),
         description: "Tab, Tab, Tab, ship. Nobody read it, nobody will, and the mana bar has never looked fuller."),
        (name: "Prompt Fragment", icon: "prompt_fragment", bonus: (spell_power: 1),
         description: "'...and make it pop. Do not hallucinate.'"),
        (name: "Mechanical Keyboard with No Keycaps", icon: "keyboard", bonus: (haste_pct: 1),
         description: "Loud, blue-switched and capless. Every keystroke is a statement; HR has received several."),
        (name: "Tests (Commented Out)", icon: "tests_off", bonus: (crit_pct: 0.5),
         description: "// TODO: fix flaky tests. The suite is green because nothing runs. Ship it, crit it, regret it."),
        (name: "Burndown Chart (Flat)", icon: "chart", bonus: (max_hp: 4),
         description: "Horizontal since sprint 3. Stable, reliable, and excellent at absorbing blame."),
        (name: "Sticky Note: 'Blocker?'", icon: "sticky", bonus: (max_mana: 4),
         description: "Posted by whoever caused it, owned by nobody. Radiates 4 mana of passive aggression."),
        (name: "Laminated Agile Manifesto", icon: "manifesto", bonus: (max_hp: 5),
         description: "Four values, twelve principles, one laminate. Wipe it clean after every retro."),
        (name: "Recurring Meeting Invite", icon: "calendar", bonus: (haste_pct: 1),
         description: "Weekly until 2031, no agenda. You learn to move quickly just to be late for it."),
        (name: "Lanyard of Authority", icon: "badge", bonus: (max_hp: 8),
         description: "Opens zero doors but ends one in three arguments. The badge photo is from 2014."),
        (name: "Pizza Party Voucher (Expired)", icon: "pizza", bonus: (max_mana: 4),
         description: "Redeemable for morale until last quarter. The cold slice you imagine is worth 4 mana."),
        (name: "Unlimited PTO Policy (Blank)", icon: "pto", bonus: (mana_regen: 3),
         description: "Unlimited, and approved by nobody. Reading it restores mana; so does never taking it."),
        (name: "Wellness Survey, Question 1 of 84", icon: "wellness", bonus: (max_hp: 4),
         description: "'How are you feeling today?' Do not answer honestly. 83 questions remain."),
        (name: "90-Page Analysis (Unread)", icon: "brain", bonus: (max_mana: 5),
         description: "Commissioned, billed, filed. The answer is in there, 90 pages from the executive summary."),
        (name: "Chart That Goes Up", icon: "chart_up", bonus: (spell_power: 1),
         description: "No axis, no units, full conviction. Every spell lands harder with a hockey stick behind it."),
        (name: "Executive Summary of the Summary", icon: "spiral", bonus: (crit_pct: 1.0),
         description: "One word from a one-pager of a 90-page analysis: 'Strong.' Hits harder than the analysis did."),
        (name: "Signed Contract for a Feature That Doesn't Exist", icon: "contract", bonus: (max_hp: 5),
         description: "Delivery date: yesterday. Legally binding, technically fictional, heavy enough to stop a blow."),
        (name: "Fruit Basket (Corporate)", icon: "box", bonus: (max_mana: 5),
         description: "Four bananas and a card: 'Thanks for the weekend!' Tastes like 5 mana and quiet resignation."),
        (name: "Humblebrag Post (Unposted)", icon: "megaphone", bonus: (crit_pct: 0.5),
         description: "'Humbled to announce I pressed send.' 400 likes, zero context, still a draft."),
        (name: "Dark Pattern, Slightly Used", icon: "hook", bonus: (haste_pct: 1),
         description: "The 'No thanks, I enjoy losing money' button, lightly worn. Gets you out of talks faster."),
        (name: "Brand Guidelines (412 Pages)", icon: "brand", bonus: (max_hp: 6),
         description: "Page 311 forbids the exact blue you are wearing. Dense enough to stop a stapler."),
        (name: "Webinar Registration Link", icon: "webinar", bonus: (max_mana: 4),
         description: "Join 14 attendees to learn nothing live. The recording will go unwatched as well."),
        (name: "Logo, Slightly Rounder", icon: "logo", bonus: (crit_pct: 0.5),
         description: "Eleventh revision, corners 2px softer, invoice 40k. Every crit looks nicer with it."),
        (name: "Change Request #4,127", icon: "mailbox", bonus: (max_hp: 8),
         description: "'Small tweak, should only take a minute.' Filed after go-live. Surviving it builds character."),
        (name: "One-Star Review", icon: "thumb_down", bonus: (crit_pct: 1.0),
         description: "'Would not use again. Used it daily.' Painful, accurate, and oddly motivating."),
        (name: "Purchase Order (Unsigned)", icon: "cash", bonus: (max_mana: 6),
         description: "Approved in principle, signed in spirit, paid in 120 days. Hope fills the mana pool."),
        (name: "Gantt Chart, All Red", icon: "hourglass", bonus: (haste_pct: 1),
         description: "Every bar overdue, every owner 'on it'. Panic makes you quicker; the plan does nothing."),
        (name: "Backlog Item from 2021", icon: "backlog", bonus: (max_hp: 4),
         description: "'As a user I want it to work.' Priority: medium. Has survived 212 refinements."),
        (name: "Invoice: 'Synergy', 40 Hours", icon: "coins", bonus: (max_mana: 5),
         description: "40 hours, no deliverable, paid in full. Synergy cannot be defined, but it can be billed."),
        (name: "2x2 Matrix", icon: "matrix", bonus: (spell_power: 1),
         description: "Every problem fits in four boxes and none gets solved. Consultants call it a framework."),
        (name: "Sticky Note with Admin Password", icon: "key", bonus: (mana_regen: 4),
