        // ---- variety pass ----
        (name: "Core Dump (14 GB)", icon: "sticky", bonus: (max_mana: 4),
         description: "Fourteen gigabytes of memory, frozen the moment it died. Mostly cat pictures from the cache."),
        (name: "Unlabelled Backup Tape", icon: "cron", bonus: (max_hp: 5),
         description: "Could be prod. Could be someone's wedding video. Restore time: six business weeks."),
        (name: "Restore Test Certificate (Never Tested)", icon: "padlock", bonus: (max_hp: 20, spell_power: 5),
         description: "Certifies that restores work. Signed by the backup job itself, mid-failure."),
        (name: "Model Card (Mostly Redacted)", icon: "prompt_fragment", bonus: (spell_power: 3),
         description: "Intended use: everything. Limitations: [REDACTED]. Training data: 'the internet, roughly'."),
        (name: "Automation Audit Log (2,000 Pages)", icon: "sticky", bonus: (max_hp: 16, spell_power: 3),
         description: "Every ticket Rule #47 closed, reopened and closed again. Nobody has read page two."),
        (name: "Signed Go-Live Date (Non-Negotiable)", icon: "deadline", bonus: (max_hp: 20, crit_pct: 0.5),
         description: "Signed by four VPs who will all have left by then. The date is in the past already."),
        (name: "Incident Commander Armband (Expired)", icon: "standup", bonus: (max_hp: 12),
         description: "Worn for one sev-1 and every postmortem since. Smells faintly of pizza and blame."),
        (name: "Green Build Badge (Flaky)", icon: "pull_request", bonus: (spell_power: 3),
         description: "Passed on the fifth retry. Nobody changed anything. Framed anyway."),
