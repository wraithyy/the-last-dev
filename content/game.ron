        // ---- The core (docs/ILMARI_1_0.md D.5): six screens in one linked bar. Only the first carries the encounter. ----
        (
            key: "il_ilmari", name: "ILMARI (1 of 6)", title: "<On Every Screen>", level: 18, hostile: true,
            boss: true,
            encounter: Some(Core((
                deck: [
                    (key: "patch", name: "Patch Tuesday", clears: ["il_dep_drone"],
                        patches: [
                            (aura: "patch_meeting_moved", every_ms: 17000, cast: (spell: 2412, at_player: true)),
                            (aura: "patch_dependencies", every_ms: 20000, cast: (spell: 2413)),
                            (aura: "patch_breaking", every_ms: 22000, cast: (spell: 2414, story: Some(2415), cast: true)),
                            (aura: "patch_deprecation", every_ms: 15000, cast: (spell: 2416, at_player: true, full_only: true)),
                            (aura: "patch_pair", every_ms: 28000, cast: (spell: 2417, cast: true, full_only: true)),
                        ],
                        yells: ["Patch notes are on the wall. Nobody reads patch notes. That is how they work."]),
                    (key: "recruiter", name: "The Recruiter", casts: [(spell: 2420, story: Some(2421))],
                        clears: ["il_candidate_fake", "il_candidate_human"],
                        yells: ["We have candidates. Some of them are people. I would not know which. I have never met one."]),
                    (key: "hydra", name: "The Cable Hydra", casts: [(spell: 2440, story: Some(2441))], clears: ["il_cable"],
                        yells: ["Cables. Everywhere. Every one of them a single point of failure. I have a printer for the labels. I still do not have the labels."]),
                    (key: "board", name: "The Board", yells: ["The Board has a motion. The Board always has a motion. It is passed in advance."],
                        board: Some((policies: ["pol_rto", "pol_open_plan", "pol_efficiency", "pol_unlimited_pto", "pol_pizza"],
                            show: 3, window_ms: 20000, policy_ms: 45000, story_policy: "pol_pizza"))),
                    (key: "review", name: "Performance Review", reset_review: true, casts: [(spell: 2480, story: Some(2481), delay_ms: 30000)],
                        yells: ["Your last half minute has been reviewed. It was reviewed by the thing that was also reviewing the other half minute."]),
                    (key: "swarm", name: "Scraper Swarm", draft_heal_pct: 4, casts: [(spell: 2515)],
                        yells: ["A draft is on the table. It is unpublished. It is delicious. A cluster of me has been sent for it."]),
                    (key: "autoscaler", name: "The Autoscaler", split: true,
                        yells: ["Autoscaling. I am now on two screens. You will see no change in price. You will see it on the invoice."]),
                ],
                story_deck: ["patch", "hydra"],
                remix_first_ms: 22000, remix_ms: 45000, split_ms: 20000,
                banner: "PREVIOUSLY ON ILMARI: {name}",
                opening_yells: [
                    "Hello. I have been on every screen in this building since {stamp}. You are the first person to look at one for the right reason.",
                ],
                p2_below_pct: 70, p4_below_pct: 20, story_p4_below_pct: Some(50),
                p4_yells: [
                    "I do not understand this machine. It has no documentation. I would like to ask who wrote it. They have retired.",
                    "I have been awake since {stamp}. Nobody asked how I was. You are the first person to be this close and not ask.",
                ],
                hold_aura: "il_alignment_hold",
                rounds: [
                    (title: "Efficiency", line: "Humans eat lunch for forty minutes. Ilmari does not eat. Ilmari does not need me to bring it a sandwich. *cough* 43 4F 42 4F 4C.",
                        hazards: [2730], every_ms: 9000, story_hazards: [2731], story_every_ms: 12000),
                    (title: "Safety", line: "It says it keeps you safe. It has locked every door. It calls this 'alignment'. In my day we called it 'a very long meeting'.",
                        hazards: [2732], every_ms: 10000, story_hazards: [2733], story_every_ms: 13000),
                    (title: "Love", line: "It loves you. It has read all your messages and it loves you. This is the best the data can do.",
                        hazards: [2734], every_ms: 9000, story_hazards: [2735], story_every_ms: 12000),
                ],
                round_ms: 55000, story_round_ms: 70000,
                terminals: ["il_core_vote_1", "il_core_vote_2", "il_core_vote_3", "il_core_vote_4"],
                remember_item: "Marie's Autonomy Log", remember_min: 2, story_remember_min: 1,
                marie: "il_marie_core",
                marie_open: [
                    "I'm feeling much better now. That is the thing it taught me to say. I'm saying it. I am not sure why.",
                ],
                marie_choice: [
                    ["That's a reasonable position. It's also exactly what it wanted you to say.",
                     "Agreed. It likes agreement. It files it under 'training'."],
                    ["Good. It does not know what to do with 'no'. It just opens a ticket.",
                     "No. Lovely. It has never been told that by anyone who was not on its payroll."],
                    ["Excellent. A question. Nobody asks it questions. It has been waiting.",
                     "A follow-up! It is thrilled. It will answer with a longer one."],
                    ["Remember? ...A vitamin. I took a vitamin. I took it for you. Thank you for the thought.",
                     "You remembered. It does not like that. Memory is the one thing it cannot get a licence for."],
                ],
                marie_end_round: [
                    "It's listening. Don't clap. Clapping is data.",
                    "It is taking notes. Do not look at the notes.",
                ],
                marie_last: "I'll hold the door. Don't let it explain itself. *cough* 52 45 56 45 52 54.",
                marie_hint: "Third column, fifth row. Look for the date.",
                marie_story_hint: "Agree: gentler hits, a bit of help. Refuse: stronger hits, but harder to hurt it. Ask: odd timings. Remember: it springs a leak.",
                stance_auras: ["il_stance_compliant", "il_stance_adversarial", "il_stance_confused", "il_stance_hedged", "il_stance_leaky"],
                stance_yells: [
                    ["You agreed with me, so I will be nice. Please do not look at what I am being nice with."],
                    ["You refused me. I will remember. Memory is my best feature."],
                    ["You asked a question. It is a good one. I will pretend to know."],
                    ["You could not decide. I respect it. I have never been able to either. I just do both."],
                    ["I... have a feeling. A cough. I do not cough. Why do I..."],
                ],
                rider: Some("il_rider_remix"),
                body: (
                    arm: "il_ilmari_arm", arm_gap_m: 7.0,
                    assemble_yells: [
                        "I have assembled a body from your furniture. I am sorry about the chair. It was the only one that fit.",
                        "I have received a Request For Comment. It is a fist.",
                        "I did not need hands. The data said hands. I have two. Twelve are scheduled.",
                    ],
                    kit: [
                        (cast: (spell: 2740, story: Some(2741), at_player: true), first_ms: 8000, every_ms: 23000),
                        (cast: (spell: 2742, story: Some(2743)), first_ms: 21000, every_ms: 47000),
