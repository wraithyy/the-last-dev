            (name: "Delivery Robot Sticker (Torn)", icon: "robot", price: 2, tier: 1,
             description: "The robot was kicked so often it now has a union."),
            (name: "Dried-Out Whiteboard Marker", icon: "write_by_hand", price: 2, tier: 2,
