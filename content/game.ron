                (anchor: "pack_27", units: ["rto_commuter", "rto_commuter"], level: Some(5)),
                (anchor: "pack_28", units: ["rto_commuter", "autonomous_valet", "rto_commuter"], level: Some(5)),
                (anchor: "pack_29", units: ["site_foreman", "survey_drone"], level: Some(5)),
                (anchor: "pack_30", units: ["site_foreman", "site_foreman"], level: Some(5)),
