            yells: (
                periodic_ms: 10000,
                aggro: [
                    "You're late. The meeting started in Q2.",
                    "Ah, the workforce. We were just discussing you. In past tense.",
                    "This is a closed-door session. The door is closed. On you.",
                ],
                periodic: [
                    "Item one: AI. Item two: also AI. Item three: lunch, catered by AI.",
                    "Let's take this offline. Offline is where we keep the layoffs.",
                    "Per the minutes of the last meeting, you were supposed to be gone by now.",
                    "We have reviewed your performance. We have also reviewed your replacement's.",
                    "Can everyone see my screen? It's a chart of your salary going down.",
                    "We are not a family. We are a portfolio.",
                    "Remember: we are aligned. We are always aligned. That is the agenda.",
                ],
                low_hp: [
                    "Minute this: the Board is concerned.",
                    "We may need to postpone the quarter.",
                ],
                player_killed: [
                    "Motion to remove that employee: carried.",
                    "Another headcount, right-sized.",
                ],
                death: [
                    "Meeting... adjourned... without... action items...",
                    "Let the record show... we had... a vision...",
                ],
                evade: ["This meeting has run over. Rescheduling. Indefinitely."],
            ),
