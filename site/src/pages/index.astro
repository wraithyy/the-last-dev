---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import coffee from '@phosphor-icons/core/assets/regular/coffee.svg?raw';
import github from '@phosphor-icons/core/assets/regular/github-logo.svg?raw';
import play from '@phosphor-icons/core/assets/regular/play.svg?raw';
import { BASE, REPO, VERSION } from '../version';
import arrow from '@phosphor-icons/core/assets/regular/arrow-up-right.svg?raw';
import expand from '@phosphor-icons/core/assets/regular/corners-out.svg?raw';
import roles from '../assets/shots/roles.png';
import rolesStage from '../assets/shots/roles-stage.png';
import campus from '../assets/shots/campus.png';
import jira from '../assets/shots/jira.png';
import map from '../assets/shots/map.png';
import food from '../assets/shots/food.png';
import sales from '../assets/shots/sales.png';

const GAME = `${BASE}play/`;
const COFFEE = 'https://buymeacoffee.com/wraithyy';

// Copy below is lifted from the game itself (content/game.ron, copy.rs), not written for the site.
const route = [
  { zone: 'Car Park P3', lvl: 'Lv 1', note: 'Every run starts here. A vibecoder ships to prod from his hatchback.' },
  { zone: 'Synergy Campus', lvl: 'Lv 1-2', note: 'Open world, 12 districts from Food Truck Plaza to Executive Hill. Scooters included.' },
  { zone: 'The Tower', lvl: 'Lv 1-10', note: 'Open Space, Meeting Rooms, Sales & Marketing, PMO, C-Level Penthouse.' },
  { zone: 'Data Center', lvl: 'Lv 6-8', note: 'Two halls. Opens after floor 3. Keep cool.' },
  { zone: 'Innovation Lab', lvl: 'Lv 10', note: 'Showroom and Rack Room. The AGI Prototype was a guy forwarding prompts.' },
  { zone: 'Raids', lvl: 'Endgame', note: 'All-Hands Offsite and VibeCon, plus Legacy Mode floors with weekly lockouts.' },
];

const classes = [
  {
    name: 'Fullstack Engineer', role: 'Ranged',
    text: 'Knows everything a little, gets blamed for all of it. Reviews, refactors and rolls back from 30 m away.',
    abilities: 'Code Review, Refactor, Guardrails',
  },
  {
    name: 'Frontend Developer', role: 'Melee',
    text: 'Twelve frameworks this year, one div still a pixel off. Stacks Specificity up close, cashes it in with !important.',
    abilities: 'Pixel Push, CSS Combo, !important',
  },
  {
    name: 'Backend Engineer', role: 'Tank',
    text: 'Nobody notices the API until it is down. Then only you. Taunts, rate-limits and soaks what the DPS keep pulling.',
    abilities: 'Blocking Call, Rate Limiter, Who Touched Prod?',
  },
  {
    name: 'DevOps Engineer', role: 'Healer',
    text: 'Keeps prod alive at 3 a.m. so the AI can take credit at 9. Hotfixes, auto-scales and reverts your last five seconds.',
    abilities: 'kill -9, Hotfix, SIGSTOP, Restart Pod',
  },
  {
    name: 'QA Engineer', role: 'Ranged',
    text: 'Finds the bug the AI swore was a feature, then files it. Debuffs, roots and blocks from 30 m; ships nothing untested.',
    abilities: 'Unit Test, Bug Report, Severity: Blocker',
  },
  {
    name: 'Data Scientist', role: 'Ranged',
    text: 'Ninety percent cleaning data, ten percent explaining the chart. Stacks slow damage, spreads it around, waits for significance.',
    abilities: 'Linear Regression, Overfitting, Early Stopping',
  },
  {
    name: 'Security Engineer', role: 'Melee',
    text: 'The only one who did not click the link. Sneaks in, stacks Exploit Chain, finishes before anyone notices.',
    abilities: 'Shoulder Surf, Phishing Link, Zero-Day, Privilege Escalation, Tailgating',
  },
  {
    name: 'COBOL Greybeard', role: 'Melee',
    text: 'The only one who can read the system the whole company runs on. Slow, heavy and unkillable; spends Seniority on big strikes.',
    abilities: 'GOTO, Punch Card, Batch Job, Read the Manual, Rewrite It in COBOL, Core Dump',
  },
];

const controls = [
  { group: 'Move', keys: [['W A S D', 'run and turn'], ['Q E', 'strafe'], ['Space', 'jump'], ['Right mouse', 'steer camera']] },
  { group: 'Fight', keys: [['Tab', 'next hostile target'], ['1 to 0', 'action bar spells'], ['F', 'talk, loot, open ticket']] },
  { group: 'Office tools', keys: [['J', '~/jira quest log'], ['N', 'campus map'], ['B', '~/trophies'], ['Esc', 'menu and keybindings']] },
];

const tips = [
  'The AI summarised this loading screen. The summary is 40% longer.',
  'J opens your Jira. Nobody else will.',
  'N opens the campus map, last updated by a human in 2021.',
  'The chatbot rollout is “on track”. The track is a circle.',
  'If this screen takes too long, a consultant will be assigned to it.',
  'Dying sends you to the graveyard, which HR renamed “the re-onboarding zone”.',
  'The board measures AI adoption in tokens burned. Please do not turn the lights off on your way out.',
];

const yells = [
  { who: 'CEO', line: 'Team, big news: we are pivoting to AGI. Effective this sentence.' },
  { who: 'CEO', line: "Let me share my vision. It's mostly the word 'agentic'." },
  { who: 'AGI Prototype', line: 'According to a study I just invented, you lose.' },
  { who: 'Fullstack Engineer', line: 'Why is the password in the README? Why is there a README?' },
  { who: 'AGI Prototype', line: 'Beginning Alignment Training. Your feedback will be used against you.' },
];

// Mirrors assets/CREDITS.md; every link points at the author or the exact pack used.
const gi = (a: string) => `https://github.com/game-icons/icons/tree/master/${a}`;
const credits = [
  {
    group: '3D models and cursors',
    items: [
      { who: 'Quaternius', what: 'Ultimate Animated Character Pack', href: 'https://quaternius.com', license: 'CC0' },
      { who: 'Kenney', what: 'furniture, campus props and cursors', href: 'https://kenney.nl', license: 'CC0' },
    ],
  },
  {
    group: 'Icons',
    items: [
      { who: 'J. W. Bjerk (eleazzaar)', what: 'Painterly Spell Icons', href: 'https://opengameart.org/content/painterly-spell-icons-part-1', license: 'CC BY 3.0' },
      { who: 'Delapouite', what: 'game-icons.net glyphs', href: gi('delapouite'), license: 'CC BY 3.0' },
      { who: 'Lorc', what: 'game-icons.net glyphs', href: gi('lorc'), license: 'CC BY 3.0' },
      { who: 'Rihlsul, sbed, PriorBlue, Guard13007, Caro Asercion, Andy Meneely', what: 'game-icons.net glyphs', href: 'https://game-icons.net', license: 'CC BY 3.0' },
    ],
  },
  {
    group: 'Music',
    items: [
      { who: 'Alex McCulloch (Pro Sensory)', what: 'Elevator Music', href: 'https://opengameart.org/content/elevator-music', license: 'CC0' },
      { who: 'Juhani Junkala', what: 'Epic Boss Battle', href: 'https://opengameart.org/content/boss-battle-music', license: 'CC0' },
    ],
  },
  {
    group: 'Sound effects',
    items: [
      { who: 'Kenney', what: 'interface, impact, RPG, sci-fi, UI and voiceover packs', href: 'https://kenney.nl/assets/category:Audio', license: 'CC0' },
      { who: 'unicaegames', what: 'Keyboard Soundpack 1', href: 'https://opengameart.org/content/keyboard-soundpack-1-typing-and-single-keystrokes', license: 'CC0' },
      { who: 'bart', what: 'Squeak toy sounds', href: 'https://opengameart.org/content/squeak-toy-sounds', license: 'CC0' },
      { who: 'qubodup', what: 'Liquid / bottle / drink set', href: 'https://opengameart.org/content/liquid-bottle-drink-set', license: 'CC0' },
      { who: 'artisticdude', what: 'Swishes sound pack', href: 'https://opengameart.org/content/swishes-sound-pack', license: 'CC0' },
      { who: 'rubberduck', what: '30 CC0 SFX loops', href: 'https://opengameart.org/content/30-cc0-sfx-loops', license: 'CC0' },
    ],
  },
  {
    group: 'Fonts and site icons',
    items: [
      { who: 'JetBrains', what: 'JetBrains Mono', href: 'https://github.com/JetBrains/JetBrainsMono', license: 'OFL 1.1' },
      { who: 'Vercel', what: 'Geist', href: 'https://github.com/vercel/geist-font', license: 'OFL 1.1' },
      { who: 'Phosphor', what: 'Phosphor Icons', href: 'https://phosphoricons.com', license: 'MIT' },
    ],
  },
];

const stack = [
  { name: 'Rust', why: 'The whole thing: sim, client and server in one workspace.' },
  { name: 'Bevy 0.19', why: '3D rendering, UI, audio. No engine editor, everything is code.' },
  { name: 'WebAssembly', why: 'wasm-bindgen and wasm-opt ship the native build to the browser.' },
  { name: 'axum + tokio', why: 'Optional co-op server over WebSockets, hosted on Render.' },
  { name: 'Service worker', why: 'Offline-first PWA. Online co-op is opt-in, never required.' },
  // TODO(wraithy): confirm this describes how you actually used it.
  { name: 'Claude Code', why: 'Pair programmer. Reviewed by a human, which is the joke.' },
];
---

<Base ogImage={new URL(roles.src, Astro.site).href}>
  <main id="top">
    <section class="hero wrap">
      <div class="hero-copy">
        <p class="eyebrow">// onboarding.rs: the AI already picked a role for you. Ignore it.</p>
        <h1>The last human dev versus the AI&nbsp;rollout.</h1>
        <p class="lede">A free browser RPG with classic MMO combat. Close Jira tickets, climb the office tower, unplug the AGI.</p>
        <div class="ctas">
          <a class="btn btn-primary" href="#arcade" data-play><Fragment set:html={play} />Play now</a>
          <a class="btn btn-ghost" href={REPO}><Fragment set:html={github} />Source code</a>
        </div>
      </div>
    </section>

    <section id="arcade" class="wrap arcade" aria-label="Play The Last Dev">
      <div class="player" data-src={GAME}>
        <Image src={campus} alt="" widths={[1280]} sizes="(min-width: 1200px) 1136px, 100vw" />
        <button class="btn btn-primary btn-start" type="button"><Fragment set:html={play} />Start the game here</button>
      </div>
      <div class="player-bar">
        <span class="muted">Runs in your browser. The first load is a big download, after that it works offline. <a href={`${BASE}changelog/`}>v{VERSION}: what's new</a></span>
        <span class="player-actions">
          <button class="btn btn-ghost btn-sm" type="button" data-fullpage aria-pressed="false"><Fragment set:html={expand} /><span>Full page</span></button>
          <a class="btn btn-ghost btn-sm" href={GAME}>Open in new tab<Fragment set:html={arrow} /></a>
        </span>
      </div>
    </section>
    <div class="wrap install">
      <p class="muted"><strong>Runs on WebGPU:</strong> Chrome, Edge or Safari 26+. Your browser doesn't have it? It's obsolete. So are you, according to the AI roadmap.</p>
      <div class="install-box">
        <div>
          <h3>Install it. Recommended.</h3>
          <p class="muted">Fullscreen, no browser chrome, offline play, launches like a game. It's the only app on your work laptop IT didn't approve.</p>
          <p class="muted small">Chrome or Edge (desktop and Android): open the game and press its Install button. iOS Safari: Share, then Add to Home Screen.</p>
        </div>
        <a class="btn btn-ghost" href={`${GAME}?install`}>Install the game<Fragment set:html={arrow} /></a>
      </div>
    </div>
    <script is:inline>
      // Click-to-load: the wasm build is large, so nobody downloads it just by opening the landing page.
      const player = document.querySelector('.player');
      // The game's key handlers sit on its canvas, so focus that, not just the frame (same origin, so reachable).
      const focusGame = (frame) => (frame.contentDocument?.getElementById('bevy') ?? frame).focus();
      const start = () => {
        const existing = player.querySelector('iframe');
        if (existing) return existing;
        const frame = document.createElement('iframe');
        frame.src = player.dataset.src;
        frame.title = 'The Last Dev';
        frame.allow = 'fullscreen; autoplay; gamepad';
        frame.addEventListener('load', () => focusGame(frame));
        player.replaceChildren(frame);
        // Nothing on the landing keeps animating while the game owns the GPU.
        document.body.classList.add('playing');
        return frame;
      };
      const play = () => {
        // Touch controls need the whole screen; a phone-sized embed is worse than the game's own page.
        if (matchMedia('(max-width: 767px), (pointer: coarse)').matches) location.href = player.dataset.src;
        else start();
      };
      player.querySelector('.btn-start').addEventListener('click', play);
      document.querySelector('[data-play]').addEventListener('click', play);
      // Fills the window instead of the Fullscreen API, whose Esc exit would fight the game's Esc menu.
      const arcade = document.getElementById('arcade');
      const fullBtn = document.querySelector('[data-fullpage]');
      fullBtn.addEventListener('click', () => {
        const full = arcade.classList.toggle('is-full');
        document.body.style.overflow = full ? 'hidden' : '';
        fullBtn.setAttribute('aria-pressed', String(full));
        fullBtn.querySelector('span').textContent = full ? 'Exit full page' : 'Full page';
        focusGame(start());
      });
    </script>

    <section id="game" class="wrap section reveal">
      <h2>A long, loving roast of AI-first corporations.</h2>
      <p class="body">Your company pushed AI onto every task for no reason. You start at level 1 in Car Park P3, close the tickets the AI forgot, climb five floors to the CEO (“Chief AI Evangelist”) and shut down the AGI. Your hair thins as your HP drops. When you die, an AI agent backfills your role.</p>
      <ol class="route">
        {route.map((r) => (
          <li>
            <span class="lvl">{r.lvl}</span>
            <strong>{r.zone}</strong>
            <span class="muted">{r.note}</span>
          </li>
        ))}
      </ol>
      <p class="muted small">Plus a client office on body leasing, your own apartment and company calendar events from Teambuilding to a Reorg: 28 zones and over 140 quests.</p>
    </section>

    <section id="roles" class="wrap section reveal">
      <h2>Pick a role. The AI will ignore it.</h2>
      <figure class="roles-shot">
        <Image src={rolesStage} alt="The eight playable roles on the role picker stage: Fullstack, Frontend, Backend, DevOps, QA, Data Scientist, Security and COBOL Greybeard" widths={[800, 1280]} sizes="(min-width: 1200px) 1136px, 100vw" />
      </figure>
      <div class="roles">
        {classes.map((c, i) => (
          <article class="role">
            <kbd>{i + 1}</kbd>
            <div>
              <h3>{c.name}</h3>
              <span class="tag">{c.role}</span>
            </div>
            <div>
              <p>{c.text}</p>
              <p class="abilities">{c.abilities}</p>
            </div>
          </article>
        ))}
      </div>
      <p class="muted small">Every role also owns a few world props: only DevOps can restart the frozen rack, only the Greybeard can revive the mainframe. The Fullstack Engineer can try any of them, and might break it.</p>
    </section>

    <section id="coop" class="wrap section reveal">
      <h2>Bring the team. Someone has to tank the CEO.</h2>
      <p class="body">The game is single-player and works offline. Co-op is opt-in: 2 to 5 players share one world, and the server runs the fight so nobody's laptop gets to be authoritative.</p>
      <ol class="coop-how">
        <li><kbd>Esc</kbd><span>Open <strong>Co-op</strong>. The public server is already filled in.</span></li>
        <li><kbd>Create</kbd><span>Get a room code like <code>MERGE-CONFLICT-42</code> and send it to your team.</span></li>
        <li><kbd>Join</kbd><span>Enter the code, or pick a public room from the “Open standups” list.</span></li>
      </ol>
      <p class="muted small">The public server runs on a free plan. After about 15 idle minutes it sleeps, and the first connection takes 30 to 60 seconds to wake it.</p>

      <h3 class="sub">Run your own server</h3>
      <p class="body">One Rust binary, no accounts, no secrets, no database. It hosts rooms over WebSocket and can serve the game client too.</p>
      <div class="servers">
        <details open>
          <summary>On your LAN</summary>
          <pre><code>cargo build -p server --release
./target/release/the-last-dev-server --web-dir ./web</code></pre>
          <p>It prints its address, for example <code>http://192.168.1.20:7777/</code>. Everyone on the network opens that URL and plays from there. Build the client first with <code>./scripts/build-web.sh</code>, and open TCP 7777 in the firewall if nobody can connect.</p>
        </details>
        <details>
          <summary>On a VPS, for the hosted game</summary>
          <p>Browsers only allow <code>wss://</code> from an https page, so put a TLS proxy in front. Caddy gets the certificate on its own:</p>
          <pre><code>game.example.com &#123;
  reverse_proxy 127.0.0.1:7777
&#125;</code></pre>
          <pre><code>TLD_ALLOWED_ORIGINS=https://wraithyy.github.io \
the-last-dev-server --bind 127.0.0.1:7777</code></pre>
          <p>Then enter <code>wss://game.example.com</code> in Esc &gt; Co-op. There is a <code>Dockerfile</code> if you prefer a container.</p>
        </details>
        <details>
          <summary>On Render, free tier</summary>
          <p>Fork the repo, then in Render pick <strong>New &gt; Blueprint</strong> and select your fork. <code>render.yaml</code> sets up the Docker service, the health check and the Frankfurt region. When it is live, enter <code>wss://&lt;name&gt;.onrender.com</code> in Esc &gt; Co-op.</p>
        </details>
      </div>
      <p class="muted small">All flags, limits and the protocol are in <a href={`${REPO}/blob/main/docs/SERVER.md`}>docs/SERVER.md</a>.</p>
    </section>

    <section id="controls" class="wrap section reveal">
      <h2>How to play</h2>
      <p class="body">Tab-target combat like the MMOs you grew up on. Every key is rebindable in the Esc menu and follows physical positions, so Czech and other layouts work.</p>
      <div class="controls">
        {controls.map((g) => (
          <div class="control-group">
            <h3>{g.group}</h3>
            <dl>
              {g.keys.map(([k, v]) => (
                <div><dt><kbd>{k}</kbd></dt><dd>{v}</dd></div>
              ))}
            </dl>
          </div>
        ))}
      </div>
    </section>

    <section id="screens" class="section reveal">
      <div class="wrap">
        <h2>Inside the open space</h2>
      </div>
      <div class="wrap gallery">
        <figure>
          <Image src={map} alt="The campus map with every district and the zone tree with locked and open doors" widths={[640, 1280]} sizes="(min-width: 768px) 50vw, 100vw" />
          <figcaption>The campus map, last updated by a human in 2021.</figcaption>
        </figure>
        <figure>
          <Image src={sales} alt="A Data Scientist fighting on the Sales and Marketing floor under a Close Deals sign" widths={[640, 1280]} sizes="(min-width: 768px) 50vw, 100vw" />
          <figcaption>Sales &amp; Marketing. Fully autonomous by Q3. Which year?</figcaption>
        </figure>
        <figure>
          <Image src={food} alt="Food Truck Plaza with a sign reading Now with AI tacos" widths={[640, 1280]} sizes="(min-width: 768px) 50vw, 100vw" />
          <figcaption>Food Truck Plaza. Now with AI tacos.</figcaption>
        </figure>
        <figure>
          <Image src={jira} alt="The in-game Jira quest log next to the AI-Native Intern" widths={[640, 1280]} sizes="(min-width: 768px) 50vw, 100vw" />
          <figcaption>Quests are Jira tickets. Velocity: whatever the dashboard needs.</figcaption>
        </figure>
      </div>
    </section>

    <section class="section jokes reveal" aria-labelledby="jokes-h">
      <div class="wrap">
        <h2 id="jokes-h">Loading tips, verbatim</h2>
      </div>
      <div class="marquee" aria-hidden="true">
        <div class="marquee-track">
          {[...tips, ...tips].map((t) => <span>Tip: {t}</span>)}
        </div>
      </div>
      <ul class="sr-only">{tips.map((t) => <li>{t}</li>)}</ul>
      <div class="wrap yells">
        {yells.map((y) => (
          <blockquote>
            <p>“{y.line}”</p>
            <cite>{y.who} yells</cite>
          </blockquote>
        ))}
      </div>
    </section>

    <section class="wrap section reveal">
      <h2>What it's built with</h2>
      <dl class="stack">
        {stack.map((s) => (
          <div><dt>{s.name}</dt><dd>{s.why}</dd></div>
        ))}
      </dl>
      <p class="muted small">Original game. No Blizzard assets, code, text or data.</p>
    </section>

    <section id="credits" class="wrap section reveal">
      <h2>Made with other people's great work</h2>
      <p class="body">Everything below is free to use. Thank you. Per-file details are in <a href={`${REPO}/blob/main/assets/CREDITS.md`}>assets/CREDITS.md</a>.</p>
      <div class="credits">
        {credits.map((c) => (
          <div>
            <h3>{c.group}</h3>
            <ul>
              {c.items.map((i) => (
                <li><a href={i.href}>{i.who}</a><span class="muted">{i.what}, {i.license}</span></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section id="me" class="wrap section reveal">
      <div>
        <h2>Hi, I'm Wraithy.</h2>
        <p class="body">Frontend architect from Liberec with 10+ years of React and TypeScript. I architect frontend platforms that other teams build on. The Last Dev is a side project in Rust, a game about the thing my industry keeps trying to replace us with.</p>
        <!-- TODO(wraithy): your own "why I made this" story, two or three sentences. -->
        <p class="quote">AI speeds me up; it doesn't steer. Vibecoding is not engineering.</p>
        <div class="ctas">
          <a class="btn btn-ghost" href="https://jkvapil.cz">jkvapil.cz<Fragment set:html={arrow} /></a>
          <a class="btn btn-ghost" href="https://github.com/wraithyy"><Fragment set:html={github} />@wraithyy</a>
        </div>
      </div>
    </section>

    <section class="wrap coffee reveal">
      <h2>Free to play. No ads. No AI upsell.</h2>
      <p class="body">If it made you laugh during a stand-up, a coffee keeps the last dev awake for the next floor.</p>
      <a class="btn btn-coffee" href={COFFEE}><Fragment set:html={coffee} />Buy me a coffee</a>
    </section>
  </main>
</Base>
